@if (_isVisible)
{
    <div class="tk-dialog-backdrop" @onclick="HandleBackdropClick">
        <div class="tk-dialog-box tk-dialog-@_type @(_isLeaving ? "tk-dialog-leave" : "tk-dialog-enter")"
             @onclick:stopPropagation="true">

            <div class="tk-dialog-icon-wrap tk-dialog-icon-@_type">
                <span class="material-symbols-outlined">@GetIcon(_type)</span>
            </div>

            <div class="tk-dialog-content">
                <h3 class="tk-dialog-title">@_title</h3>
                <p class="tk-dialog-message">@_message</p>
            </div>

            <div class="tk-dialog-actions">
                <button class="tk-dialog-btn tk-dialog-btn-cancel" @onclick="Cancel">
                    <span class="material-symbols-outlined">close</span>
                    @CancelText
                </button>
                <button class="tk-dialog-btn tk-dialog-btn-confirm tk-dialog-confirm-@_type"
                        @onclick="Confirm">
                    <span class="material-symbols-outlined">check</span>
                    @ConfirmText
                </button>
            </div>
        </div>
    </div>
}

@code {
    // ─── Parameters ───────────────────────────────────────────

    [Parameter] public string ConfirmText { get; set; } = "Xác nhận";
    [Parameter] public string CancelText { get; set; } = "Hủy";
    [Parameter] public EventCallback<bool> OnClose { get; set; }
    [Parameter] public bool CloseOnBackdrop { get; set; } = true;

    // ─── State ────────────────────────────────────────────────

    private bool _isVisible = false;
    private bool _isLeaving = false;
    private string _title = "Xác nhận";
    private string _message = "Bạn có chắc muốn thực hiện hành động này?";
    private string _type = "warning"; // danger | warning | info | success

    // ─── Public API ──────────────────────────────────────────

    /// <summary>Hiển thị dialog. Type: danger | warning | info | success</summary>
    public void Show(string title, string message, string type = "warning")
    {
        _title = title;
        _message = message;
        _type = type;
        _isLeaving = false;
        _isVisible = true;
        StateHasChanged();
    }

    public void ShowDanger(string title, string message)  => Show(title, message, "danger");
    public void ShowWarning(string title, string message) => Show(title, message, "warning");
    public void ShowInfo(string title, string message)    => Show(title, message, "info");
    public void ShowSuccess(string title, string message) => Show(title, message, "success");

    // ─── Actions ─────────────────────────────────────────────

    private async Task Confirm()
    {
        await CloseDialog(true);
    }

    private async Task Cancel()
    {
        await CloseDialog(false);
    }

    private async Task HandleBackdropClick()
    {
        if (CloseOnBackdrop) await CloseDialog(false);
    }

    private async Task CloseDialog(bool result)
    {
        _isLeaving = true;
        StateHasChanged();
        await Task.Delay(250);
        _isVisible = false;
        await OnClose.InvokeAsync(result);
    }

    private static string GetIcon(string type) => type switch
    {
        "danger"  => "delete_forever",
        "warning" => "warning",
        "success" => "check_circle",
        _         => "help"
    };
}

<style>
    /* ── Backdrop ────────────────────────────────────────────── */
    .tk-dialog-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(15, 23, 42, 0.45);
        backdrop-filter: blur(3px);
        z-index: 9000;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1rem;
        animation: tk-dialog-backdrop-in 0.2s ease;
    }

    @@keyframes tk-dialog-backdrop-in {
        from { opacity: 0; }
        to   { opacity: 1; }
    }

    /* ── Box ─────────────────────────────────────────────────── */
    .tk-dialog-box {
        background: #fff;
        border-radius: 20px;
        box-shadow: 0 25px 60px -12px rgba(0,0,0,0.25);
        padding: 2rem 2rem 1.5rem;
        max-width: 420px;
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: 1rem;
        position: relative;
    }

    /* ── Enter / Leave ──────────────────────────────────────── */
    .tk-dialog-enter {
        animation: tk-dialog-in 0.28s cubic-bezier(0.34,1.56,0.64,1);
    }

    .tk-dialog-leave {
        animation: tk-dialog-out 0.22s ease-in forwards;
    }

    @@keyframes tk-dialog-in {
        from { opacity: 0; transform: scale(0.85) translateY(20px); }
        to   { opacity: 1; transform: scale(1) translateY(0); }
    }

    @@keyframes tk-dialog-out {
        from { opacity: 1; transform: scale(1); }
        to   { opacity: 0; transform: scale(0.9) translateY(10px); }
    }

    /* ── Icon ───────────────────────────────────────────────── */
    .tk-dialog-icon-wrap {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 0.25rem;
    }

    .tk-dialog-icon-wrap .material-symbols-outlined {
        font-size: 2rem;
    }

    .tk-dialog-icon-danger  { background: #fef2f2; color: #ef4444; }
    .tk-dialog-icon-warning { background: #fff7ed; color: #f97316; }
    .tk-dialog-icon-info    { background: #eff6ff; color: #1b6ec2; }
    .tk-dialog-icon-success { background: #f0fdf4; color: #22c55e; }

    /* ── Content ─────────────────────────────────────────────── */
    .tk-dialog-title {
        font-size: 1.1rem;
        font-weight: 800;
        color: #0f172a;
        margin: 0 0 0.35rem 0;
    }

    .tk-dialog-message {
        font-size: 0.9rem;
        color: #64748b;
        line-height: 1.6;
        margin: 0;
    }

    /* ── Actions ─────────────────────────────────────────────── */
    .tk-dialog-actions {
        display: flex;
        gap: 0.75rem;
        width: 100%;
        margin-top: 0.5rem;
    }

    .tk-dialog-btn {
        flex: 1;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.35rem;
        padding: 0.6rem 1rem;
        border-radius: 10px;
        font-size: 0.875rem;
        font-weight: 600;
        cursor: pointer;
        border: none;
        transition: all 0.15s ease;
    }

    .tk-dialog-btn .material-symbols-outlined { font-size: 1rem; }

    .tk-dialog-btn-cancel {
        background: #f1f5f9;
        color: #475569;
        border: 1.5px solid #e2e8f0;
    }

    .tk-dialog-btn-cancel:hover {
        background: #e2e8f0;
        color: #1e293b;
    }

    /* Confirm button màu theo type */
    .tk-dialog-btn-confirm { color: #fff; }

    .tk-dialog-confirm-danger  { background: #ef4444; }
    .tk-dialog-confirm-danger:hover  { background: #dc2626; }

    .tk-dialog-confirm-warning { background: #f97316; }
    .tk-dialog-confirm-warning:hover { background: #ea6c0a; }

    .tk-dialog-confirm-info    { background: #1b6ec2; }
    .tk-dialog-confirm-info:hover    { background: #1558a0; }

    .tk-dialog-confirm-success { background: #22c55e; }
    .tk-dialog-confirm-success:hover { background: #16a34a; }
</style>
