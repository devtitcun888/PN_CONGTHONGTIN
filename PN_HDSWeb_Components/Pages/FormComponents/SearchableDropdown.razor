@typeparam TValue

<div class="tk-sdrop-wrapper @(Disabled ? "tk-sdrop-disabled" : "")" id="tk-sdrop-@_uid">

    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="tk-sdrop-label">@Label</label>
    }

    <div class="tk-sdrop-control @(_isOpen ? "is-open" : "") @(HasValue ? "has-value" : "")"
         @onclick="ToggleDropdown">

        @* Hiển thị giá trị đã chọn *@
        <span class="tk-sdrop-value">
            @if (HasValue)
            {
                @(SelectedItem?.Text ?? Value?.ToString() ?? "")
            }
            else
            {
                <span class="tk-sdrop-placeholder">@Placeholder</span>
            }
        </span>

        <div class="tk-sdrop-actions">
            @* Nút clear *@
            @if (Clearable && HasValue)
            {
                <button class="tk-sdrop-clear" @onclick="Clear" @onclick:stopPropagation="true" tabindex="-1"
                        title="Xóa chọn">
                    <span class="material-symbols-outlined">close</span>
                </button>
            }
            <span class="material-symbols-outlined tk-sdrop-arrow @(_isOpen ? "rotated" : "")">expand_more</span>
        </div>
    </div>

    @* Dropdown panel *@
    @if (_isOpen)
    {
        <div class="tk-sdrop-panel">
            @* Search box *@
            <div class="tk-sdrop-search-wrap">
                <span class="material-symbols-outlined tk-sdrop-search-icon">search</span>
                <input class="tk-sdrop-search"
                       type="text"
                       placeholder="Tìm kiếm..."
                       @bind="_searchText"
                       @bind:event="oninput"
                       @ref="_searchInput"
                       autocomplete="off" />
                @if (!string.IsNullOrEmpty(_searchText))
                {
                    <button class="tk-sdrop-search-clear" @onclick="() => _searchText = string.Empty">
                        <span class="material-symbols-outlined">close</span>
                    </button>
                }
            </div>

            @* Danh sách kết quả *@
            <div class="tk-sdrop-list">
                @{
                    var filtered = FilteredItems.ToList();
                    if (!filtered.Any())
                    {
                        <div class="tk-sdrop-empty">
                            <span class="material-symbols-outlined">search_off</span>
                            Không tìm thấy kết quả
                        </div>
                    }
                    else
                    {
                        string? lastGroup = null;
                        foreach (var item in filtered)
                        {
                            // Group header
                            if (item.Group != lastGroup && item.Group != null)
                            {
                                lastGroup = item.Group;
                                <div class="tk-sdrop-group">@item.Group</div>
                            }

                            bool isSelected = EqualityComparer<TValue>.Default.Equals(item.Value, Value);
                            <div class="tk-sdrop-item @(isSelected ? "active" : "")"
                                 @onclick="() => OnItemSelected(item)">
                                @if (isSelected)
                                {
                                    <span class="material-symbols-outlined tk-sdrop-check">check</span>
                                }
                                <span>@item.Text</span>
                            </div>
                        }
                    }
                }
            </div>
        </div>
    }
</div>

@* Overlay trong suốt để đóng dropdown khi click ra ngoài *@
@if (_isOpen)
{
    <div class="tk-sdrop-overlay" @onclick="Close"></div>
}

@code {
    // ─── SelectItem model ─────────────────────────────────────
    public class SelectItem
    {
        public TValue Value { get; set; } = default!;
        public string Text { get; set; } = "";
        public string? Group { get; set; }
    }

    // ─── Parameters ───────────────────────────────────────────

    [Parameter] public TValue? Value { get; set; }
    [Parameter] public EventCallback<TValue?> ValueChanged { get; set; }
    [Parameter] public List<SelectItem> Items { get; set; } = new();
    [Parameter] public string Placeholder { get; set; } = "-- Chọn --";
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public bool Clearable { get; set; } = true;
    [Parameter] public bool Disabled { get; set; } = false;

    // ─── State ────────────────────────────────────────────────

    private bool _isOpen = false;
    private string _searchText = "";
    private string _uid = Guid.NewGuid().ToString("N")[..8];
    private ElementReference _searchInput;

    private bool HasValue => Value != null && !EqualityComparer<TValue>.Default.Equals(Value, default);
    private SelectItem? SelectedItem => Items.FirstOrDefault(i => EqualityComparer<TValue>.Default.Equals(i.Value, Value));

    private IEnumerable<SelectItem> FilteredItems
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_searchText))
                return Items;

            var keyword = _searchText.Trim().ToLower();
            return Items.Where(i =>
                i.Text.ToLower().Contains(keyword) ||
                (i.Group?.ToLower().Contains(keyword) ?? false));
        }
    }

    // ─── Actions ─────────────────────────────────────────────

    private async Task ToggleDropdown()
    {
        if (Disabled) return;
        _isOpen = !_isOpen;
        _searchText = "";
        if (_isOpen)
        {
            // Focus vào ô tìm kiếm sau khi mở
            await Task.Delay(50);
            try { await _searchInput.FocusAsync(); } catch { }
        }
    }

    private void Close()
    {
        _isOpen = false;
        _searchText = "";
    }

    // ĐÃ SỬA LỖI Ở ĐÂY: Đổi tên hàm từ SelectItem thành OnItemSelected
    private async Task OnItemSelected(SelectItem item)
    {
        _isOpen = false;
        _searchText = "";
        await ValueChanged.InvokeAsync(item.Value);
    }

    private async Task Clear()
    {
        await ValueChanged.InvokeAsync(default);
    }
}

<style>
    /* ── Wrapper ─────────────────────────────────────────────── */
    .tk-sdrop-wrapper {
        position: relative;
        display: block;
    }

    .tk-sdrop-disabled {
        opacity: 0.55;
        pointer-events: none;
    }

    /* ── Label ──────────────────────────────────────────────── */
    .tk-sdrop-label {
        display: block;
        font-size: 0.82rem;
        font-weight: 600;
        color: #374151;
        margin-bottom: 0.35rem;
    }

    /* ── Control (trigger button) ───────────────────────────── */
    .tk-sdrop-control {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        border: 1.5px solid #d1d5db;
        border-radius: 9px;
        padding: 0.5rem 0.75rem;
        background: #fff;
        cursor: pointer;
        min-height: 40px;
        transition: border-color 0.18s, box-shadow 0.18s;
        user-select: none;
    }

    .tk-sdrop-control:hover:not(.tk-sdrop-disabled .tk-sdrop-control) {
        border-color: #1b6ec2;
    }

    .tk-sdrop-control.is-open {
        border-color: #1b6ec2;
        box-shadow: 0 0 0 3px rgba(27,110,194,0.12);
    }

    .tk-sdrop-value {
        flex: 1;
        min-width: 0;
        font-size: 0.875rem;
        color: #1e293b;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .tk-sdrop-placeholder {
        color: #9ca3af;
    }

    /* ── Actions (clear + arrow) ─────────────────────────────── */
    .tk-sdrop-actions {
        display: flex;
        align-items: center;
        gap: 2px;
        flex-shrink: 0;
    }

    .tk-sdrop-clear, .tk-sdrop-search-clear {
        background: none;
        border: none;
        padding: 0;
        cursor: pointer;
        color: #9ca3af;
        display: flex;
        align-items: center;
        border-radius: 50%;
        transition: color 0.15s, background 0.15s;
    }

    .tk-sdrop-clear:hover, .tk-sdrop-search-clear:hover { color: #ef4444; }
    .tk-sdrop-clear .material-symbols-outlined { font-size: 1rem; }

    .tk-sdrop-arrow {
        font-size: 1.15rem;
        color: #9ca3af;
        transition: transform 0.2s ease;
    }

    .tk-sdrop-arrow.rotated { transform: rotate(180deg); }

    /* ── Dropdown Panel ─────────────────────────────────────── */
    .tk-sdrop-panel {
        position: absolute;
        top: calc(100% + 6px);
        left: 0;
        right: 0;
        background: #fff;
        border: 1.5px solid #d1d5db;
        border-radius: 10px;
        box-shadow: 0 10px 30px -5px rgba(0,0,0,0.12), 0 4px 12px -4px rgba(0,0,0,0.08);
        z-index: 1050;
        overflow: hidden;
        animation: tk-sdrop-open 0.18s cubic-bezier(0.34,1.3,0.64,1);
    }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        
    @@keyframes tk-sdrop-open {
        from { opacity: 0; transform: translateY(-6px) scale(0.98); }
        to   { opacity: 1; transform: translateY(0) scale(1); }
    }

    /* Search */
    .tk-sdrop-search-wrap {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.5rem 0.6rem;
        border-bottom: 1px solid #f1f5f9;
    }

    .tk-sdrop-search-icon {
        font-size: 1rem;
        color: #9ca3af;
        flex-shrink: 0;
    }

    .tk-sdrop-search {
        flex: 1;
        border: none;
        outline: none;
        font-size: 0.875rem;
        background: transparent;
        color: #1e293b;
    }

    .tk-sdrop-search-clear .material-symbols-outlined { font-size: 1rem; }

    /* List */
    .tk-sdrop-list {
        max-height: 240px;
        overflow-y: auto;
        padding: 0.3rem 0;
    }

    .tk-sdrop-list::-webkit-scrollbar { width: 5px; }
    .tk-sdrop-list::-webkit-scrollbar-track { background: transparent; }
    .tk-sdrop-list::-webkit-scrollbar-thumb { background: #d1d5db; border-radius: 10px; }

    .tk-sdrop-item {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.5rem 0.85rem;
        font-size: 0.875rem;
        color: #1e293b;
        cursor: pointer;
        transition: background 0.12s;
    }

    .tk-sdrop-item:hover { background: #eff6ff; }

    .tk-sdrop-item.active {
        background: #eff6ff;
        color: #1b6ec2;
        font-weight: 600;
    }

    .tk-sdrop-check { font-size: 0.95rem; color: #1b6ec2; }

    /* Group header */
    .tk-sdrop-group {
        padding: 0.4rem 0.85rem 0.2rem;
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: #94a3b8;
    }

    /* Empty */
    .tk-sdrop-empty {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.4rem;
        padding: 1.5rem;
        font-size: 0.85rem;
        color: #9ca3af;
    }

    .tk-sdrop-empty .material-symbols-outlined { font-size: 1.2rem; }

    /* Click-outside overlay */
    .tk-sdrop-overlay {
        position: fixed;
        inset: 0;
        z-index: 1049;
    }
</style>