@if (IsFullscreen)
{
    @* Fullscreen overlay *@
    @if (IsLoading)
    {
        <div class="tk-loading-fullscreen">
            <div class="tk-loading-inner">
                <div class="tk-spinner">
                    <div class="tk-spinner-ring"></div>
                    <div class="tk-spinner-ring tk-ring-2"></div>
                </div>
                @if (!string.IsNullOrEmpty(Message))
                {
                    <p class="tk-loading-msg">@Message</p>
                }
            </div>
        </div>
    }
}
else
{
    @* Bọc content *@
    <div class="tk-loading-host">
        @if (IsLoading)
        {
            <div class="tk-loading-overlay">
                <div class="tk-loading-inner">
                    <div class="tk-spinner">
                        <div class="tk-spinner-ring"></div>
                        <div class="tk-spinner-ring tk-ring-2"></div>
                    </div>
                    @if (!string.IsNullOrEmpty(Message))
                    {
                        <p class="tk-loading-msg">@Message</p>
                    }
                </div>
            </div>
        }
        @ChildContent
    </div>
}

@code {
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public string Message { get; set; } = "";
    [Parameter] public bool IsFullscreen { get; set; } = false;
    [Parameter] public RenderFragment? ChildContent { get; set; }
}

<style>
    /* ── Host container ──────────────────────────────────────── */
    .tk-loading-host {
        position: relative;
    }

    /* ── Overlay trong host ───────────────────────────────────── */
    .tk-loading-overlay {
        position: absolute;
        inset: 0;
        background: rgba(255, 255, 255, 0.82);
        backdrop-filter: blur(2px);
        z-index: 100;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: inherit;
        animation: tk-loading-fade-in 0.2s ease;
    }

    /* ── Fullscreen ───────────────────────────────────────────── */
    .tk-loading-fullscreen {
        position: fixed;
        inset: 0;
        background: rgba(255, 255, 255, 0.88);
        backdrop-filter: blur(4px);
        z-index: 9998;
        display: flex;
        align-items: center;
        justify-content: center;
        animation: tk-loading-fade-in 0.2s ease;
    }

    @@keyframes tk-loading-fade-in {
        from { opacity: 0; }
        to   { opacity: 1; }
    }

    /* ── Center inner ─────────────────────────────────────────── */
    .tk-loading-inner {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
    }

    /* ── Spinner ──────────────────────────────────────────────── */
    .tk-spinner {
        width: 44px;
        height: 44px;
        position: relative;
    }

    .tk-spinner-ring {
        position: absolute;
        inset: 0;
        border-radius: 50%;
        border: 3px solid transparent;
        border-top-color: #1b6ec2;
        animation: tk-spin 0.85s ease-in-out infinite;
    }

    .tk-ring-2 {
        inset: 6px;
        border-top-color: #93c5fd;
        animation-duration: 1.1s;
        animation-direction: reverse;
    }

    @@keyframes tk-spin {
        to { transform: rotate(360deg); }
    }

    /* ── Message ─────────────────────────────────────────────── */
    .tk-loading-msg {
        font-size: 0.875rem;
        color: #475569;
        font-weight: 500;
        margin: 0;
        white-space: nowrap;
    }
</style>
