<div class="tk-empty-state">
    <div class="tk-empty-icon-wrap">
        <span class="material-symbols-outlined tk-empty-icon">@Icon</span>
    </div>
    <div class="tk-empty-text">
        <h4 class="tk-empty-title">@Title</h4>
        @if (!string.IsNullOrEmpty(Subtitle))
        {
            <p class="tk-empty-subtitle">@Subtitle</p>
        }
    </div>
    @if (!string.IsNullOrEmpty(ActionText) && OnAction.HasDelegate)
    {
        <button class="tk-empty-action" @onclick="OnAction">
            <span class="material-symbols-outlined">add</span>
            @ActionText
        </button>
    }
</div>

@code {
    [Parameter] public string Icon { get; set; } = "inbox";
    [Parameter] public string Title { get; set; } = "Không có dữ liệu";
    [Parameter] public string Subtitle { get; set; } = "";
    [Parameter] public string ActionText { get; set; } = "";
    [Parameter] public EventCallback OnAction { get; set; }
}

<style>
    .tk-empty-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
        padding: 3rem 2rem;
        text-align: center;
    }

    .tk-empty-icon-wrap {
        width: 72px;
        height: 72px;
        background: #f1f5f9;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 0.25rem;
    }

    .tk-empty-icon {
        font-size: 2rem;
        color: #94a3b8;
    }

    .tk-empty-title {
        font-size: 1rem;
        font-weight: 700;
        color: #1e293b;
        margin: 0;
    }

    .tk-empty-subtitle {
        font-size: 0.875rem;
        color: #64748b;
        margin: 0.2rem 0 0 0;
        line-height: 1.5;
    }

    .tk-empty-action {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        margin-top: 0.5rem;
        padding: 0.5rem 1.25rem;
        background: #1b6ec2;
        color: #fff;
        border: none;
        border-radius: 9px;
        font-size: 0.875rem;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.15s, box-shadow 0.15s;
    }

    .tk-empty-action:hover {
        background: #1558a0;
        box-shadow: 0 4px 12px rgba(27,110,194,0.3);
    }

    .tk-empty-action .material-symbols-outlined {
        font-size: 1rem;
    }
</style>
