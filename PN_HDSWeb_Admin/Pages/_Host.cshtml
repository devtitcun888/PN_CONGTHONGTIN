</body>
</html>

<script>
    // ── LOADING OVERLAY CONTROLLER ──────────────────────────────────────────
    (function () {
        // Cơ chế: Blazor component (TopNavbar) gọi window.hideAppLoading()
        // sau khi toàn bộ dữ liệu đã load xong.
        var _hidden = false;

        // Hàm này được Blazor gọi qua JS Interop khi dữ liệu sẵn sàng
        window.hideAppLoading = function (delayMs) {
            if (_hidden) return;
            _hidden = true;
            setTimeout(function () {
                var el = document.getElementById('app-loading');
                if (!el) return;
                el.classList.add('hide');
                setTimeout(function () { el.remove(); }, 100);
            }, delayMs || 0);
        };

        // FALLBACK: tự ẩn sớm nếu Blazor/JS interop chưa kịp gọi hideAppLoading
        // Giảm thời gian chờ để tránh cảm giác "Đang tải hệ thống" bị lâu.
        setTimeout(function () {
            if (!_hidden) {
                console.warn('[AppLoading] Fallback hide (2.5s timeout).');
                window.hideAppLoading(0);
            }
        }, 2500);
    })();

    // ── BLAZOR RECONNECTION HANDLER ─────────────────────────────────────────
    // Ghi đè Blazor.defaultReconnectionHandler để kiểm soát UI khi mất kết nối
    window.Blazor = window.Blazor || {};
    Blazor.defaultReconnectionHandler = {
        onConnectionDown: function (options, error) {
            var toast  = document.getElementById('bl-reconnect-toast');
            var label  = document.getElementById('bl-reconnect-attempt');
            var overlay = document.getElementById('bl-error-overlay');
            if (overlay) overlay.classList.add('hide');
            if (!toast) return;
            toast.classList.remove('hide');
            if (label) label.textContent = 'Đang thử kết nối lại, vui lòng chờ...';
        },
        onConnectionUp: function () {
            var toast = document.getElementById('bl-reconnect-toast');
            if (!toast) return;
            toast.classList.add('hide');
        },
        onMaximumRetryCountExceeded: function (options) {
            // Đã thử hết số lần → hiện modal lỗi
            var toast   = document.getElementById('bl-reconnect-toast');
            var overlay = document.getElementById('bl-error-overlay');
            var desc    = document.getElementById('bl-error-desc');
            if (toast)   toast.classList.add('hide');
            if (desc)    desc.textContent = 'Không thể kết nối lại với máy chủ sau nhiều lần thử. Vui lòng kiểm tra mạng và tải lại trang.';
            if (overlay) overlay.classList.remove('hide');
        }
    };

    // ── SESSION HELPER ──────────────────────────────────────────────────────
    window.sessionHelper = {
        validateSession: function () {
            try {
                var oldSession = localStorage.getItem('UserSession');
                if (oldSession) {
                    try {
                        JSON.parse(oldSession);
                        var tabId = localStorage.getItem('SharedTabId');
                        if (tabId) { localStorage.setItem('UserSession_' + tabId, oldSession); }
                    } catch (e) { }
                    localStorage.removeItem('UserSession');
                }
                if (!localStorage.getItem('SharedTabId')) {
                    var newTabId = 'tab_' + Date.now() + '_' + Math.random().toString(36).substr(2, 9);
                    localStorage.setItem('SharedTabId', newTabId);
                }
            } catch (e) {
                console.error('Error in validateSession:', e);
            }
        },
        clearSession: function () {
            try {
                var tabId = localStorage.getItem('SharedTabId');
                if (tabId) { localStorage.removeItem('UserSession_' + tabId); }
                localStorage.removeItem('selectedLevel');
                localStorage.removeItem('selectedLevelText');
            } catch (e) { console.error('Error clearing session:', e); }
        }
    };

    document.addEventListener('DOMContentLoaded', function () {
        window.sessionHelper.validateSession();
    });
</script>
