    <script src="/js/scn-khen.js" defer></script>
    <script src="/js/scn-khcn.js" defer></script>

    <!--
        BLAZOR SERVER — script duy nhất cần thiết cho Blazor Server app
        KHÔNG cần: blazor.webassembly.js, blazor.web.js (dành cho WebAssembly/Unified mode)
    -->
    <script src="_framework/blazor.server.js"></script>

    <script>
        // Ẩn loading mặc định sớm hơn nếu DOM đã sẵn sàng
        document.addEventListener('DOMContentLoaded', function () {
            setTimeout(function () {
                if (window.hideAppLoading) {
                    window.hideAppLoading(0);
                }
            }, 800);
