    <!-- CKEditor Styles -->
@*     <link rel="stylesheet" href="https://cdn.ckeditor.com/ckeditor5/47.6.1/ckeditor5.css" crossorigin />
    <link rel="stylesheet" href="https://cdn.ckeditor.com/ckeditor5-premium-features/47.6.1/ckeditor5-premium-features.css" crossorigin /> *@
    <!--
        GOOGLE FONTS — Tải ASYNC (không block render)
        Trick: media="print" → browser load không block → onload chuyển về media="all"
        noscript fallback cho trường hợp JS tắt
    -->
    <link rel="preload" as="style"
          href="https://fonts.googleapis.com/css2?family=Merriweather:wght@400;700&display=swap"
          onload="this.rel='stylesheet'" />
    <noscript>
        <link href="https://fonts.googleapis.com/css2?family=Merriweather:wght@400;700&display=swap" rel="stylesheet">
    </noscript>

    <link rel="preload" as="style"
          href="https://fonts.googleapis.com/icon?family=Material+Icons|Material+Icons+Round"
          onload="this.rel='stylesheet'" />
    <noscript>
        <link href="https://fonts.googleapis.com/icon?family=Material+Icons|Material+Icons+Round" rel="stylesheet">
    </noscript>

    <link rel="preload" as="style"
          href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap"
          onload="this.rel='stylesheet'" />
    <noscript>
        <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap" rel="stylesheet">
    </noscript>

    <!-- LOCAL CSS (phục vụ từ server → không block nhiều) -->
    <link rel="stylesheet" href="css/app.css" asp-append-version="true" />
    <link rel="stylesheet" href="css/public-layout-fix.css" asp-append-version="true" />
    <!-- EV RENTAL PUBLIC CSS -->
    <link rel="stylesheet" href="css/ev-public.css" asp-append-version="true" />
    <!-- EV RENTAL ADMIN CSS -->
    <link rel="stylesheet" href="css/ev-admin.css" asp-append-version="true" />

    <!-- QUILL RICH TEXT EDITOR -->
    <link rel="stylesheet" href="https://cdn.quilljs.com/1.3.7/quill.snow.css" />
    <!-- BLAZOR CSS ISOLATION — Bắt buộc có để các file .razor.css hoạt động -->
    @* <link rel="stylesheet" href="PN_HDSWeb_Admin.styles.css" /> *@

    <!-- HEAD FOR COMPONENTS (BLAZOR) -->
    <component type="typeof(HeadOutlet)" render-mode="Server" />

</head>
<body>
    <!-- LOADING OVERLAY -->
    <div id="app-loading" class="app-loading">
        <div class="loading-card">
            <div class="spinner"></div>
            <div class="loading-text">Đang tải hệ thống...</div>
        </div>
    </div>

    <!-- APP ROOT -->
    <component type="typeof(App)" render-mode="Server" />

    <!-- BLAZOR ERROR UI (giữ lại để Blazor runtime nhận diện, CSS ẩn đi) -->
    <div id="blazor-error-ui"></div>

    <!-- RECONNECTION TOAST: Hiện khi Blazor đang thử kết nối lại -->
    <div id="bl-reconnect-toast" class="bl-reconnect-toast hide">
        <div class="toast-header">
            <div class="toast-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 22C6.477 22 2 17.523 2 12S6.477 2 12 2s10 4.477 10 10"/>
                    <path d="M12 6v6l4 2"/>
                    <path d="M22 12a10 10 0 0 0-1.5-5.25"/>
                </svg>
            </div>
            <div>
                <div class="toast-title">Đang kết nối lại...</div>
                <div class="toast-sub" id="bl-reconnect-attempt">Đang thử lại, vui lòng chờ.</div>
            </div>
        </div>
        <div class="toast-progress"><div class="toast-progress-bar"></div></div>
    </div>

    <!-- ERROR MODAL: Hiện khi lỗi nghiêm trọng không thể tự phục hồi -->
    <div id="bl-error-overlay" class="bl-error-overlay hide">
        <div class="bl-error-card">
            <div class="bl-error-icon-wrap">
                <svg viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"/>
                    <line x1="12" y1="8" x2="12" y2="12"/>
                    <line x1="12" y1="16" x2="12.01" y2="16"/>
                </svg>
            </div>
            <div class="bl-error-title">Đã xảy ra sự cố</div>
            <div class="bl-error-desc" id="bl-error-desc">
                Kết nối với máy chủ bị gián đoạn. Vui lòng tải lại trang để tiếp tục sử dụng.
            </div>
            <div class="bl-error-actions">
                <button class="bl-btn-reload" onclick="location.reload()">
                    ↺ &nbsp;Tải lại trang
                </button>
                <button class="bl-btn-dismiss" onclick="document.getElementById('bl-error-overlay').classList.add('hide')">
                    Bỏ qua
                </button>
            </div>
        </div>
    </div>

    <!--
        SECURITY: Load secureStorage TRƯỚC các script khác
        Đặt trước Blazor để sẵn sàng khi Blazor interop bắt đầu
    -->
    <script src="~/js/secureStorage.js" asp-append-version="true"></script>

    <!-- CHART.JS — Load trước Blazor để AppUtils.initCharts sẵn sàng -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js" defer></script>
    <script src="js/chart-manager.js" asp-append-version="true" defer></script>

    <!-- BOOTSTRAP — defer: không block parser, load song song với HTML parsing -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" defer></script>

    <!-- RADZEN -->
    <script src="_content/Radzen.Blazor/Radzen.Blazor.js" defer></script>

    <!-- LOCAL SCRIPTS -->
    <script src="~/js/app-utils.js" asp-append-version="true" defer></script>
    <script src="~/js/chart-helper.js" asp-append-version="true" defer></script>
    <script src="~/js/site.js" asp-append-version="true" defer></script>
    <script src="/js/excelfunctions.js" asp-append-version="true" defer></script>
    <script src="/js/vgcaplugin.js" asp-append-version="true" defer></script>
    <script src="/js/jsfunction.js" asp-append-version="true" defer></script>
    <script src="/js/session-helper.js" asp-append-version="true" defer></script>
    <script src="~/js/hub-grid.js" asp-append-version="true" defer></script>
    <script src="/js/public-header.js" asp-append-version="true" defer></script>
    <!-- EV RENTAL PUBLIC JS -->
    <script src="/js/ev-public.js" asp-append-version="true" defer></script>

    <!-- QUILL JS + CKEDITOR + SCN KHEN EDITOR -->
    <script src="https://cdn.quilljs.com/1.3.7/quill.min.js" defer></script>
@*     <script src="https://cdn.ckeditor.com/ckeditor5/47.6.1/ckeditor5.umd.js" crossorigin="anonymous" defer></script>
    <script src="https://cdn.ckeditor.com/ckeditor5-premium-features/47.6.1/ckeditor5-premium-features.umd.js" crossorigin="anonymous" defer></script> *@
 @*    <script src="https://cdn.ckbox.io/ckbox/2.9.2/ckbox.js" crossorigin="anonymous" defer></script> *@
    <script src="/js/scn-khen.js" defer></script>
    <script src="/js/scn-khcn.js" defer></script>
    <script src="/js/adminSidebar.js" defer></script>
    <!--
        BLAZOR SERVER — script duy nhất cần thiết cho Blazor Server app
        KHÔNG cần: blazor.webassembly.js, blazor.web.js (dành cho WebAssembly/Unified mode)
    -->
    <script src="_framework/blazor.server.js"></script>

    <script>
        // Ẩn loading mặc định sớm hơn nếu DOM đã sẵn sàng
        document.addEventListener('DOMContentLoaded', function () {
            setTimeout(function () {
                if (window.hideAppLoading) {
                    window.hideAppLoading(0);
                }
            }, 800);
        });
    </script>

</body>
</html>

<script>
    // ── LOADING OVERLAY CONTROLLER ──────────────────────────────────────────
    (function () {
        // Cơ chế: Blazor component (TopNavbar) gọi window.hideAppLoading()
        // sau khi toàn bộ dữ liệu đã load xong.
        var _hidden = false;

        // Hàm này được Blazor gọi qua JS Interop khi dữ liệu sẵn sàng
        window.hideAppLoading = function (delayMs) {
            if (_hidden) return;
            _hidden = true;
            setTimeout(function () {
                var el = document.getElementById('app-loading');
                if (!el) return;
                el.classList.add('hide');
                setTimeout(function () { el.remove(); }, 100);
            }, delayMs || 0);
        };

        // FALLBACK: tự ẩn sớm nếu Blazor/JS interop chưa kịp gọi hideAppLoading
        // Giảm thời gian chờ để tránh cảm giác "Đang tải hệ thống" bị lâu.
        setTimeout(function () {
            if (!_hidden) {
                console.warn('[AppLoading] Fallback hide (2.5s timeout).');
                window.hideAppLoading(0);
            }
        }, 2500);
    })();

    // ── BLAZOR RECONNECTION HANDLER ─────────────────────────────────────────
    // Ghi đè Blazor.defaultReconnectionHandler để kiểm soát UI khi mất kết nối
    window.Blazor = window.Blazor || {};
    Blazor.defaultReconnectionHandler = {
        onConnectionDown: function (options, error) {
            var toast  = document.getElementById('bl-reconnect-toast');
            var label  = document.getElementById('bl-reconnect-attempt');
            var overlay = document.getElementById('bl-error-overlay');
            if (overlay) overlay.classList.add('hide');
            if (!toast) return;
            toast.classList.remove('hide');
            if (label) label.textContent = 'Đang thử kết nối lại, vui lòng chờ...';
        },
        onConnectionUp: function () {
            var toast = document.getElementById('bl-reconnect-toast');
            if (!toast) return;
            toast.classList.add('hide');
        },
        onMaximumRetryCountExceeded: function (options) {
            // Đã thử hết số lần → hiện modal lỗi
            var toast   = document.getElementById('bl-reconnect-toast');
            var overlay = document.getElementById('bl-error-overlay');
            var desc    = document.getElementById('bl-error-desc');
            if (toast)   toast.classList.add('hide');
            if (desc)    desc.textContent = 'Không thể kết nối lại với máy chủ sau nhiều lần thử. Vui lòng kiểm tra mạng và tải lại trang.';
            if (overlay) overlay.classList.remove('hide');
        }
    };

    // ── SESSION HELPER ──────────────────────────────────────────────────────
    window.sessionHelper = {
        validateSession: function () {
            try {
                var oldSession = localStorage.getItem('UserSession');
                if (oldSession) {
                    try {
                        JSON.parse(oldSession);
                        var tabId = localStorage.getItem('SharedTabId');
                        if (tabId) { localStorage.setItem('UserSession_' + tabId, oldSession); }
                    } catch (e) { }
                    localStorage.removeItem('UserSession');
                }
                if (!localStorage.getItem('SharedTabId')) {
                    var newTabId = 'tab_' + Date.now() + '_' + Math.random().toString(36).substr(2, 9);
                    localStorage.setItem('SharedTabId', newTabId);
                }
            } catch (e) {
                console.error('Error in validateSession:', e);
            }
        },
        clearSession: function () {
            try {
                var tabId = localStorage.getItem('SharedTabId');
                if (tabId) { localStorage.removeItem('UserSession_' + tabId); }
                localStorage.removeItem('selectedLevel');
                localStorage.removeItem('selectedLevelText');
            } catch (e) { console.error('Error clearing session:', e); }
        }
    };

    document.addEventListener('DOMContentLoaded', function () {
        if (window.sessionHelper && typeof window.sessionHelper.validateSession === 'function') {
            window.sessionHelper.validateSession();
        }
    });
</script>
