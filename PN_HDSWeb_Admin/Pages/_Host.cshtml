@page "/"
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@namespace PN_HDSWeb_Admin.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html lang="vi">
<head>
    <title>TITKUL – Hệ thống quản lý giáo dục</title>

    <!-- META -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="~/" />

    <!-- PRECONNECT: Gợi ý browser kết nối sẵn đến Google Fonts (giảm DNS + TLS handshake) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- RADZEN -->
    <link rel="stylesheet" href="_content/Radzen.Blazor/css/material-base.css">

    <!-- MUD BLAZOR -->
    <link rel="stylesheet" href="_content/MudBlazor/MudBlazor.min.css" />

    <!--
        GOOGLE FONTS — Tải ASYNC (không block render)
        Trick: media="print" → browser load không block → onload chuyển về media="all"
        noscript fallback cho trường hợp JS tắt
    -->
    <link rel="preload" as="style"
          href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700;900&display=swap"
          onload="this.rel='stylesheet'" />
    <noscript>
        <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700;900&display=swap" rel="stylesheet">
    </noscript>

    <link rel="preload" as="style"
          href="https://fonts.googleapis.com/icon?family=Material+Icons|Material+Icons+Round"
          onload="this.rel='stylesheet'" />
    <noscript>
        <link href="https://fonts.googleapis.com/icon?family=Material+Icons|Material+Icons+Round" rel="stylesheet">
    </noscript>

    <link rel="preload" as="style"
          href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap"
          onload="this.rel='stylesheet'" />
    <noscript>
        <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap" rel="stylesheet">
    </noscript>

    <!-- LOCAL CSS (phục vụ từ server → không block nhiều) -->
    <link rel="stylesheet" href="css/app.css" asp-append-version="true" />
    <link rel="stylesheet" href="css/SchoolManagement.css" asp-append-version="true" />
    <link rel="stylesheet" href="css/StudyManagement.css" asp-append-version="true" />
    <link rel="stylesheet" href="css/Notification.css" asp-append-version="true" />
    <link rel="stylesheet" href="css/TrainManagement.css" asp-append-version="true" />
    <link rel="stylesheet" href="css/PrimaryRating.css" asp-append-version="true" />
    <link rel="stylesheet" href="/css/hocba-unified.css" asp-append-version="true" />

    <!-- QUILL RICH TEXT EDITOR -->
    <link rel="stylesheet" href="https://cdn.quilljs.com/1.3.7/quill.snow.css" />

    <!-- BLAZOR CSS ISOLATION — Bắt buộc có để các file .razor.css hoạt động -->
    @* <link rel="stylesheet" href="PN_HDSWeb_Admin.styles.css" /> *@

    <!-- HEAD FOR COMPONENTS (BLAZOR) -->
    <component type="typeof(HeadOutlet)" render-mode="Server" />

</head>
<style>
    /* ── APP LOADING ────────────────────────────────────────────── */
    .app-loading {
        position: fixed;
        inset: 0;
        background: rgba(255, 255, 255, 0.65);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        z-index: 9999;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: opacity 0.5s ease, visibility 0.5s ease;
    }

        .app-loading.hide {
            opacity: 0;
            visibility: hidden;
        }

    .loading-card {
        background: rgba(255, 255, 255, 0.9);
        border-radius: 16px;
        padding: 28px 36px;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
        text-align: center;
        min-width: 260px;
        animation: floatIn 0.6s ease;
    }

    .loading-text {
        margin-top: 14px;
        font-size: 15px;
        font-weight: 600;
        color: #333;
        letter-spacing: 0.3px;
    }

    /* Spinner */
    .spinner {
        width: 42px;
        height: 42px;
        border: 4px solid #e5e7eb;
        border-top-color: #0d6efd;
        border-radius: 50%;
        animation: spin 0.9s linear infinite;
        margin: auto;
    }

    @@keyframes spin {
        to { transform: rotate(360deg); }
    }

    @@keyframes floatIn {
        from { opacity: 0; transform: translateY(10px) scale(0.95); }
        to   { opacity: 1; transform: translateY(0)    scale(1);    }
    }

    /* ── ẨN THANH ĐỎ MẶC ĐỊNH CỦA BLAZOR ──────────────────────── */
    #blazor-error-ui { display: none !important; }

    /* ── RECONNECTION TOAST (góc phải dưới) ────────────────────── */
    .bl-reconnect-toast {
        position: fixed;
        bottom: 24px;
        right: 24px;
        z-index: 99999;
        width: 320px;
        background: #fff;
        border-radius: 14px;
        box-shadow: 0 8px 32px rgba(0,0,0,.18), 0 1.5px 4px rgba(0,0,0,.08);
        padding: 18px 20px 14px;
        display: flex;
        flex-direction: column;
        gap: 10px;
        border-left: 4px solid #f59e0b;
        animation: toastIn 0.35s cubic-bezier(.4,0,.2,1);
        transition: opacity 0.3s, transform 0.3s;
    }
    .bl-reconnect-toast.hide {
        opacity: 0;
        transform: translateY(16px);
        pointer-events: none;
    }
    .bl-reconnect-toast .toast-header {
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .bl-reconnect-toast .toast-icon {
        width: 32px; height: 32px;
        border-radius: 50%;
        background: #fef3c7;
        display: flex; align-items: center; justify-content: center;
        flex-shrink: 0;
    }
    .bl-reconnect-toast .toast-icon svg { width: 18px; height: 18px; }
    .bl-reconnect-toast .toast-title {
        font-weight: 700;
        font-size: 14px;
        color: #1e293b;
    }
    .bl-reconnect-toast .toast-sub {
        font-size: 12.5px;
        color: #64748b;
        line-height: 1.5;
    }
    .bl-reconnect-toast .toast-progress {
        height: 4px;
        border-radius: 99px;
        background: #e2e8f0;
        overflow: hidden;
    }
    .bl-reconnect-toast .toast-progress-bar {
        height: 100%;
        background: linear-gradient(90deg, #f59e0b, #fbbf24);
        border-radius: 99px;
        animation: progressPulse 1.6s ease-in-out infinite;
        width: 60%;
    }
    @@keyframes toastIn {
        from { opacity: 0; transform: translateY(20px); }
        to   { opacity: 1; transform: translateY(0); }
    }
    @@keyframes progressPulse {
        0%   { margin-left: -60%; }
        100% { margin-left: 100%; }
    }

    /* ── ERROR MODAL (lỗi nghiêm trọng) ────────────────────────── */
    .bl-error-overlay {
        position: fixed;
        inset: 0;
        z-index: 99998;
        background: rgba(15, 23, 42, 0.55);
        backdrop-filter: blur(6px);
        -webkit-backdrop-filter: blur(6px);
        display: flex;
        align-items: center;
        justify-content: center;
        animation: fadeOverlay 0.3s ease;
    }
    .bl-error-overlay.hide {
        display: none;
    }
    .bl-error-card {
        background: #fff;
        border-radius: 20px;
        padding: 36px 40px;
        max-width: 400px;
        width: 90%;
        text-align: center;
        box-shadow: 0 24px 64px rgba(0,0,0,.22);
        animation: floatIn 0.4s cubic-bezier(.4,0,.2,1);
    }
    .bl-error-icon-wrap {
        width: 64px; height: 64px;
        border-radius: 50%;
        background: #fef2f2;
        display: flex; align-items: center; justify-content: center;
        margin: 0 auto 20px;
    }
    .bl-error-icon-wrap svg { width: 32px; height: 32px; color: #ef4444; }
    .bl-error-title {
        font-size: 18px;
        font-weight: 800;
        color: #1e293b;
        margin-bottom: 8px;
    }
    .bl-error-desc {
        font-size: 14px;
        color: #64748b;
        line-height: 1.65;
        margin-bottom: 28px;
    }
    .bl-error-actions {
        display: flex;
        gap: 10px;
        justify-content: center;
    }
    .bl-btn-reload {
        padding: 10px 24px;
        border-radius: 10px;
        border: none;
        background: linear-gradient(135deg, #3b82f6, #6366f1);
        color: #fff;
        font-weight: 700;
        font-size: 14px;
        cursor: pointer;
        box-shadow: 0 4px 14px rgba(99,102,241,.35);
        transition: transform 0.15s, box-shadow 0.15s;
    }
    .bl-btn-reload:hover {
        transform: translateY(-1px);
        box-shadow: 0 6px 20px rgba(99,102,241,.45);
    }
    .bl-btn-dismiss {
        padding: 10px 18px;
        border-radius: 10px;
        border: 1.5px solid #e2e8f0;
        background: #f8fafc;
        color: #64748b;
        font-weight: 600;
        font-size: 14px;
        cursor: pointer;
        transition: background 0.15s;
    }
    .bl-btn-dismiss:hover { background: #f1f5f9; }
    @@keyframes fadeOverlay {
        from { opacity: 0; }
        to   { opacity: 1; }
    }
</style>
<body>
    <!-- LOADING OVERLAY -->
    <div id="app-loading" class="app-loading">
        <div class="loading-card">
            <div class="spinner"></div>
            <div class="loading-text">Đang tải hệ thống...</div>
        </div>
    </div>

    <!-- APP ROOT -->
    <component type="typeof(App)" render-mode="Server" />

    <!-- BLAZOR ERROR UI (giữ lại để Blazor runtime nhận diện, CSS ẩn đi) -->
    <div id="blazor-error-ui"></div>

    <!-- RECONNECTION TOAST: Hiện khi Blazor đang thử kết nối lại -->
    <div id="bl-reconnect-toast" class="bl-reconnect-toast hide">
        <div class="toast-header">
            <div class="toast-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 22C6.477 22 2 17.523 2 12S6.477 2 12 2s10 4.477 10 10"/>
                    <path d="M12 6v6l4 2"/>
                    <path d="M22 12a10 10 0 0 0-1.5-5.25"/>
                </svg>
            </div>
            <div>
                <div class="toast-title">Đang kết nối lại...</div>
                <div class="toast-sub" id="bl-reconnect-attempt">Đang thử lại, vui lòng chờ.</div>
            </div>
        </div>
        <div class="toast-progress"><div class="toast-progress-bar"></div></div>
    </div>

    <!-- ERROR MODAL: Hiện khi lỗi nghiêm trọng không thể tự phục hồi -->
    <div id="bl-error-overlay" class="bl-error-overlay hide">
        <div class="bl-error-card">
            <div class="bl-error-icon-wrap">
                <svg viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"/>
                    <line x1="12" y1="8" x2="12" y2="12"/>
                    <line x1="12" y1="16" x2="12.01" y2="16"/>
                </svg>
            </div>
            <div class="bl-error-title">Đã xảy ra sự cố</div>
            <div class="bl-error-desc" id="bl-error-desc">
                Kết nối với máy chủ bị gián đoạn. Vui lòng tải lại trang để tiếp tục sử dụng.
            </div>
            <div class="bl-error-actions">
