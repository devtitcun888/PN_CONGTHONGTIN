    </div>

    <!--
        SECURITY: Load secureStorage TRƯỚC các script khác
        Đặt trước Blazor để sẵn sàng khi Blazor interop bắt đầu
    -->
    <script src="~/js/secureStorage.js" asp-append-version="true"></script>

    <!-- CHART.JS — Load trước Blazor để AppUtils.initCharts sẵn sàng -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js" defer></script>
    <script src="js/chart-manager.js" asp-append-version="true" defer></script>

    <!-- BOOTSTRAP — defer: không block parser, load song song với HTML parsing -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" defer></script>

    <!-- RADZEN -->
    <script src="_content/Radzen.Blazor/Radzen.Blazor.js" defer></script>

    <!-- LOCAL SCRIPTS -->
    <script src="~/js/app-utils.js" asp-append-version="true" defer></script>
    <script src="~/js/chart-helper.js" asp-append-version="true" defer></script>
    <script src="~/js/site.js" asp-append-version="true" defer></script>
    <script src="/js/excelfunctions.js" asp-append-version="true" defer></script>
    <script src="/js/vgcaplugin.js" asp-append-version="true" defer></script>
    <script src="/js/jsfunction.js" asp-append-version="true" defer></script>
