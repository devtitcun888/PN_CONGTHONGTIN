@page "/admin/settings/edit/{Id?}"
@using PN_HDSWeb_Admin.Services.Admin
@inject IAdminSiteSettingService AdminSiteSettingService
@inject NavigationManager Nav

<div class="admin-form-shell">
    <div class="admin-form-card">
        <div class="admin-form-header">
            <h1>Cấu hình site</h1>
            <p>Thêm mới hoặc chỉnh sửa cấu hình hệ thống.</p>
        </div>

        @if (model == null)
        {
            <p>Đang tải...</p>
        }
        else
        {
            <div class="admin-form-grid">
                <label>
                    Key
                    <input class="admin-input" @bind="model.SettingKey" />
                </label>
                <label>
                    Value
                    <textarea class="admin-input" @bind="model.SettingValue"></textarea>
                </label>
                <label>
                    Group
                    <input class="admin-input" @bind="model.SettingGroup" />
                </label>
                <label>
                    Mô tả
                    <textarea class="admin-input" @bind="model.Description"></textarea>
                </label>
                <label>
                    Trạng thái
                    <select class="admin-input" @bind="IsActiveText">
                        <option value="true">Đang bật</option>
                        <option value="false">Tắt</option>
                    </select>
                </label>
            </div>

            <div class="admin-form-actions">
                <button class="btn btn-primary" @onclick="SaveAsync">Lưu</button>
                <button class="btn btn-secondary" @onclick='@(() => Nav.NavigateTo("/admin/settings"))'>Quay lại</button>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public string? Id { get; set; }
    private AdminSiteSettingDetail? model;
    private string IsActiveText = "true";

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(Id))
        {
            model = await AdminSiteSettingService.GetSettingByIdAsync(Id);
        }

        model ??= new AdminSiteSettingDetail
        {
            MaTruongBo = PN_PublicVariables.MaTruong,
            IsActive = true
        };

        IsActiveText = model.IsActive.ToString().ToLowerInvariant();
    }

    private async Task SaveAsync()
    {
        model!.IsActive = bool.TryParse(IsActiveText, out var active) && active;

        if (string.IsNullOrWhiteSpace(model.Id))
            await AdminSiteSettingService.CreateSettingAsync(model);
        else
            await AdminSiteSettingService.UpdateSettingAsync(model);

        Nav.NavigateTo("/admin/settings");
    }
}
