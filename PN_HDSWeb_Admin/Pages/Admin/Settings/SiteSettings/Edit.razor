@page "/admin/settings/edit/{Id?}"
@using PN_HDSWeb_Admin.Services.Admin
@inject IAdminSiteSettingService AdminSiteSettingService
@inject NavigationManager Nav

<div class="admin-form-shell">
    <div class="admin-form-card">
        <div class="admin-form-header">
            <h1>@(IsEditMode ? "Sửa cấu hình site" : "Thêm cấu hình site")</h1>
            <p>Quản lý từng key cấu hình cho website theo đúng trường.</p>
        </div>

        @if (model == null)
        {
            <p>Đang tải...</p>
        }
        else
        {
            <div class="admin-settings-layout">
                <div class="admin-settings-form">
                    <div class="admin-form-grid">
                        <label>
                            Key
                            <input class="admin-input" @bind="model.SettingKey" placeholder="Ví dụ: site_name" />
                            <small class="field-hint">Key nên viết dạng snake_case, không dấu, không khoảng trắng.</small>
                        </label>

                        <label>
                            Group
                            <select class="admin-input" @bind="model.SettingGroup">
                                @foreach (var group in SettingGroups)
                                {
                                    <option value="@group">@group</option>
                                }
                            </select>
                            <small class="field-hint">Nhóm giúp phân loại cấu hình theo nghiệp vụ.</small>
                        </label>

                        <label class="span-2">
                            Value
                            <textarea class="admin-input admin-textarea" rows="6" @bind="model.SettingValue" placeholder="Nội dung cấu hình hoặc JSON"></textarea>
                            <small class="field-hint">Nếu là JSON, hãy dán đúng định dạng để public đọc được.</small>
                        </label>

                        <label class="span-2">
                            Mô tả
                            <textarea class="admin-input admin-textarea" rows="3" @bind="model.Description" placeholder="Mô tả ngắn về ý nghĩa của key"></textarea>
                        </label>

                        <label>
                            Trạng thái
                            <select class="admin-input" @bind="IsActiveText">
                                <option value="true">Đang bật</option>
                                <option value="false">Tắt</option>
                            </select>
                        </label>
                    </div>

                    <div class="admin-form-actions">
                        <button type="button" class="btn btn-primary" @onclick="SaveAsync">Lưu</button>
                        <button type="button" class="btn btn-secondary" @onclick="GoBack">Quay lại</button>
                    </div>
                </div>

                <aside class="admin-preview-box">
                    <h3>Gợi ý nhanh</h3>
                    <p><strong>Nhóm:</strong> @model.SettingGroup</p>
                    <p><strong>Key:</strong> @model.SettingKey</p>
                    <p><strong>Trạng thái:</strong> @(IsActiveText == "true" ? "Đang bật" : "Tắt")</p>
                    <div>
                        <strong>Ví dụ key chuẩn</strong>
                        <ul class="simple-list">
                            <li>site_name</li>
                            <li>school_logo</li>
                            <li>contact_hotline</li>
                            <li>footer_json_info</li>
                            <li>homepage_featured_posts_limit</li>
                        </ul>
                    </div>
                </aside>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public string? Id { get; set; }
    private AdminSiteSettingDetail? model;
    private string IsActiveText = "true";
    private bool IsEditMode => !string.IsNullOrWhiteSpace(Id);

    private static readonly List<string> SettingGroups = new()
    {
        "general",
        "school",
        "contact",
        "homepage",
        "footer",
        "seo",
        "feature",
        "upload"
    };

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(Id))
        {
            model = await AdminSiteSettingService.GetSettingByIdAsync(Id);
        }

        model ??= new AdminSiteSettingDetail
        {
            MaTruongBo = PN_PublicVariables.MaTruong,
            SettingGroup = "general",
            IsActive = true
        };

        if (string.IsNullOrWhiteSpace(model.SettingGroup))
            model.SettingGroup = "general";

        IsActiveText = model.IsActive.ToString().ToLowerInvariant();
    }

    private async Task SaveAsync()
    {
        model!.IsActive = bool.TryParse(IsActiveText, out var active) && active;

        if (string.IsNullOrWhiteSpace(model.Id))
            await AdminSiteSettingService.CreateSettingAsync(model);
        else
            await AdminSiteSettingService.UpdateSettingAsync(model);

        Nav.NavigateTo("/admin/settings");
    }

    private void GoBack()
    {
        Nav.NavigateTo("/admin/settings");
    }
}
