@page "/admin/settings/edit/{Id?}"
@using PN_HDSWeb_Admin.Services.Admin
@inject IAdminSiteSettingService AdminSiteSettingService
@inject NavigationManager Nav
<div class="ss-root">
    <!-- Breadcrumb -->
    <div class="ss-topbar">
        <nav class="ss-breadcrumb">
            <a href="/admin">Trang quản trị</a>
            <span class="ss-breadcrumb-sep">›</span>
            <a href="/admin/settings">Cấu hình site</a>
            <span class="ss-breadcrumb-sep">›</span>
            <span class="ss-breadcrumb-current">@(IsEditMode ? "Chỉnh sửa" : "Tạo mới")</span>
        </nav>
        <button class="ss-btn ss-btn-ghost ss-btn-sm" type="button" @onclick="GoBack">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 12H5M12 5l-7 7 7 7" /></svg>
            Quay lại
        </button>
    </div>

    <!-- Hero -->
    <div class="ss-hero">
        <h1>@(IsEditMode ? "Sửa cấu hình site" : "Thêm cấu hình site")</h1>
        <p>Quản lý từng key cấu hình cho website theo đúng trường.</p>
    </div>

    @if (model == null)
    {
        <div class="ss-loading">
            <div class="ss-spinner"></div>
            <span>Đang tải dữ liệu...</span>
        </div>
    }
    else
    {
        <div class="ss-layout">
            <!-- Cột chính: Form -->
            <div class="ss-main-col">
                <div class="ss-card">
                    <div class="ss-card-header">
                        <div class="ss-card-header-icon">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /></svg>
                        </div>
                        <h2>Thông tin cấu hình</h2>
                    </div>
                    <div class="ss-card-body">
                        <div class="u-grid-2">
                            <div class="ss-field u-span-full">
                                <label class="ss-label">Cấu hình public thường dùng</label>
                                <select class="ss-input" value="@selectedTemplateKey" @onchange="ApplyTemplate">
                                    <option value="">Tự nhập key</option>
                                    @foreach (var item in PublicSettingTemplates)
                                    {
                                        <option value="@item.Key">@item.Label</option>
                                    }
                                </select>
                                <span class="ss-hint">Chọn nhanh để map đúng key public đang đọc.</span>
                            </div>
                            <div class="ss-field">
                                <label class="ss-label">Key</label>
                                <input class="ss-input" @bind="model.SettingKey" placeholder="Ví dụ: site_name" />
                                <span class="ss-hint">Key nên viết dạng snake_case, không dấu, không khoảng trắng.</span>
                            </div>
                            <div class="ss-field">
                                <label class="ss-label">Group</label>
                                <select class="ss-input" @bind="model.SettingGroup">
                                    @foreach (var group in SettingGroups)
                                    {
                                        <option value="@group">@group</option>
                                    }
                                </select>
                                <span class="ss-hint">Nhóm giúp phân loại cấu hình theo nghiệp vụ.</span>
                            </div>
                            <div class="ss-field u-span-full">
                                <label class="ss-label">Value</label>
                                <textarea class="ss-input" rows="6" @bind="model.SettingValue" placeholder="Nội dung cấu hình hoặc JSON"></textarea>
                                <span class="ss-hint">Nếu là JSON, hãy dán đúng định dạng để public đọc được.</span>
                            </div>
                            <div class="ss-field u-span-full">
                                <label class="ss-label">Mô tả</label>
                                <textarea class="ss-input" rows="3" @bind="model.Description" placeholder="Mô tả ngắn về ý nghĩa của key"></textarea>
                            </div>
                            <div class="ss-field">
                                <label class="ss-label">Trạng thái</label>
                                <select class="ss-input" @bind="IsActiveText">
                                    <option value="true">Đang bật</option>
                                    <option value="false">Tắt</option>
                                </select>
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(errorMessage))
                        {
                            <div class="ss-form-error">@errorMessage</div>
                        }

                        <div class="ss-action-bar">
                            <button type="button" class="ss-btn ss-btn-primary" @onclick="SaveAsync">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z" /><polyline points="17 21 17 13 7 13" /><polyline points="7 3 7 8 15 8" /></svg>
                                Lưu
                            </button>
                            <button type="button" class="ss-btn ss-btn-ghost" @onclick="GoBack">Hủy</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Cột phụ: Gợi ý nhanh -->
            <div class="ss-side-col">
                <div class="ss-preview-box">
                    <h3>Gợi ý nhanh</h3>
                    <p><strong>Nhóm:</strong> @model.SettingGroup</p>
                    <p><strong>Key:</strong> @model.SettingKey</p>
                    <p><strong>Trạng thái:</strong> @(IsActiveText == "true" ? "Đang bật" : "Tắt")</p>
                    <div>
                        <strong>Key public đang dùng</strong>
                        <ul>
                            @foreach (var item in PublicSettingTemplates.Take(6))
                            {
                                <li>@item.Key</li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public string? Id { get; set; }
    private AdminSiteSettingDetail? model;
    private string IsActiveText = "true";
    private string selectedTemplateKey = string.Empty;
    private string? errorMessage;
    private bool IsEditMode => !string.IsNullOrWhiteSpace(Id);

    private readonly record struct SettingTemplate(string Key, string Group, string Label, string Description);

    private static readonly List<SettingTemplate> PublicSettingTemplates = new()
    {
        new("site_name", "general", "Tên site / thương hiệu", "Tên hiển thị chính ở header, footer và title public."),
        new("site_slogan", "general", "Slogan dưới tên site", "Dòng mô tả ngắn hiển thị dưới tên site."),
        new("school_name", "school", "Tên trường", "Tên trường ưu tiên cao hơn site_name khi public hiển thị thương hiệu."),
        new("school_logo", "school", "Logo trường", "URL logo dùng cho header public, footer và admin brand."),
        new("school_address", "school", "Địa chỉ trường", "Địa chỉ hiển thị ở footer và trang liên hệ."),
        new("school_phone", "school", "Số điện thoại trường", "Số điện thoại chung hiển thị ở footer."),
        new("school_email", "school", "Email trường", "Email liên hệ hiển thị ở footer."),
        new("school_website", "school", "Website trường", "Liên kết website chính trong footer."),
        new("contact_hotline", "contact", "Hotline", "Hotline liên hệ, được dùng nếu chưa có school_phone."),
        new("contact_facebook", "contact", "Facebook", "URL Facebook hiển thị ở footer."),
        new("contact_youtube", "contact", "YouTube", "URL YouTube hiển thị ở footer."),
        new("contact_zalo", "contact", "Zalo", "URL Zalo hiển thị ở footer."),
        new("footer_text", "footer", "Mô tả footer", "Đoạn giới thiệu ngắn trong footer public."),
        new("footer_show_logo", "footer", "Bật/tắt logo footer", "true hoặc false."),
        new("footer_show_contact", "footer", "Bật/tắt khối liên hệ footer", "true hoặc false."),
        new("footer_show_social", "footer", "Bật/tắt mạng xã hội footer", "true hoặc false."),
        new("homepage_featured_posts_limit", "homepage", "Số tin nổi bật trang chủ", "Số từ 1 đến 12."),
        new("homepage_latest_posts_limit", "homepage", "Số tin mới trang chủ", "Số từ 1 đến 24."),
        new("homepage_documents_limit", "homepage", "Số văn bản trang chủ", "Số từ 1 đến 24."),
        new("feature_news_enabled", "feature", "Bật/tắt tin tức", "true hoặc false."),
        new("feature_documents_enabled", "feature", "Bật/tắt văn bản", "true hoặc false."),
        new("feature_banners_enabled", "feature", "Bật/tắt banner", "true hoặc false."),
        new("feature_search_enabled", "feature", "Bật/tắt tìm kiếm", "true hoặc false.")
    };

    private static readonly List<string> SettingGroups = new()
    {
        "general",
        "school",
        "contact",
        "homepage",
        "footer",
        "seo",
        "feature",
        "upload"
    };

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(Id))
        {
            model = await AdminSiteSettingService.GetSettingByIdAsync(Id);
        }

        model ??= new AdminSiteSettingDetail
        {
            MaTruongBo = PN_PublicVariables.MaTruong,
            SettingGroup = "general",
            IsActive = true
        };

        if (string.IsNullOrWhiteSpace(model.SettingGroup))
            model.SettingGroup = "general";

        IsActiveText = model.IsActive.ToString().ToLowerInvariant();
        selectedTemplateKey = PublicSettingTemplates.Any(item => string.Equals(item.Key, model.SettingKey, StringComparison.OrdinalIgnoreCase))
            ? model.SettingKey ?? string.Empty
            : string.Empty;
    }

    private async Task SaveAsync()
    {
        errorMessage = null;

        if (string.IsNullOrWhiteSpace(model?.SettingKey))
        {
            errorMessage = "Vui lòng nhập key cấu hình.";
            return;
        }

        model.SettingKey = model.SettingKey.Trim();
        model.SettingGroup = string.IsNullOrWhiteSpace(model.SettingGroup) ? "general" : model.SettingGroup.Trim();
        model!.IsActive = bool.TryParse(IsActiveText, out var active) && active;

        if (string.IsNullOrWhiteSpace(model.Id))
            await AdminSiteSettingService.CreateSettingAsync(model);
        else
            await AdminSiteSettingService.UpdateSettingAsync(model);

        Nav.NavigateTo("/admin/settings");
    }

    private void GoBack() => Nav.NavigateTo("/admin/settings");

    private void ApplyTemplate(ChangeEventArgs args)
    {
        selectedTemplateKey = args.Value?.ToString() ?? string.Empty;
        var template = PublicSettingTemplates.FirstOrDefault(item => string.Equals(item.Key, selectedTemplateKey, StringComparison.OrdinalIgnoreCase));
        if (string.IsNullOrWhiteSpace(template.Key) || model == null)
            return;

        model.SettingKey = template.Key;
        model.SettingGroup = template.Group;
        if (string.IsNullOrWhiteSpace(model.Description))
            model.Description = template.Description;
    }
}
