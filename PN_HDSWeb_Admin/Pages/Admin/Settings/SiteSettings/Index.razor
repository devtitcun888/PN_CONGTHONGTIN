@page "/admin/settings"
@attribute [Authorize(Roles = "Administrator")]
@using PN_HDSWeb_Admin.Services.Admin
@inject IAdminSiteSettingService AdminSiteSettingService
@inject NavigationManager Nav
@inject IJSRuntime JS


<div class="st-root">

    <!-- Topbar -->
    <div class="st-topbar">
        <nav class="st-breadcrumb">
            <a href="/admin">Trang quản trị</a>
            <span class="st-breadcrumb-sep">›</span>
            <span class="st-breadcrumb-current">Cấu hình site</span>
        </nav>
    </div>

    <!-- Hero -->
    <div class="st-hero">
        <div class="st-hero-text">
            <h1>Cấu hình site</h1>
            <p>Quản lý các thông số cấu hình đang được public layout và trang chủ sử dụng.</p>
        </div>
    </div>

    <div class="st-sync-note">
        <div>
            <strong>Đã đồng bộ với public</strong>
            <span>Các key như site_name, site_slogan, school_logo, footer_text, contact_* và homepage_* sẽ được trang public đọc trực tiếp khi đang bật.</span>
        </div>
        <a href="/" target="_blank" rel="noopener noreferrer">Xem public</a>
    </div>

    <!-- Toolbar -->
    <div class="st-toolbar">

        <div class="st-search-wrap">
            <span class="st-search-icon">
                <svg width="15"
                     height="15"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2.5">

                    <circle cx="11" cy="11" r="8" />
                    <line x1="21" y1="21" x2="16.65" y2="16.65" />

                </svg>
            </span>

            <input class="st-input"
                   placeholder="Tìm theo key, value hoặc nhóm..."
                   @bind="keyword"
                   @bind:event="oninput" />
        </div>

        <select class="st-input st-filter-select" @bind="groupFilter">
            <option value="">Tất cả nhóm</option>
            @foreach (var group in AvailableGroups)
            {
                <option value="@group">@group</option>
            }
        </select>

        <button class="st-btn st-btn-primary"
                @onclick="GoCreateAsync">

            <svg width="15"
                 height="15"
                 viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="2.5">

                <line x1="12" y1="5" x2="12" y2="19" />
                <line x1="5" y1="12" x2="19" y2="12" />

            </svg>

            Thêm mới
        </button>

    </div>

    <!-- Content -->
    <div class="st-content">

        @if (items == null)
        {
            <div class="st-loading">
                Đang tải dữ liệu...
            </div>
        }
        else if (!FilteredItems.Any())
        {
            <div class="st-card">
                <div class="st-empty">
                    <h3>Không có cấu hình phù hợp</h3>
                    <p>Thử đổi từ khóa hoặc nhóm lọc, hoặc tạo cấu hình mới.</p>
                </div>
            </div>
        }
        else
        {
            <div class="st-card">

                <table class="st-table">

                    <thead>
                        <tr>
                            <th>Key</th>
                            <th>Value</th>
                            <th>Group</th>
                            <th>Trạng thái</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in FilteredItems)
                        {
                            <tr>

                                <td>
                                    <div class="st-key">
                                        @item.SettingKey
                                    </div>
                                </td>

                                <td>
                                    <div class="st-value">
                                        @item.SettingValue
                                    </div>
                                </td>

                                <td>
                                    <span class="st-group">
                                        @item.SettingGroup
                                    </span>
                                </td>

                                <td>

                                    @if (item.IsActive)
                                    {
                                        <span class="st-badge st-badge-active">
                                            <span class="dot"></span>
                                            Đang bật
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="st-badge st-badge-inactive">
                                            <span class="dot"></span>
                                            Đã tắt
                                        </span>
                                    }

                                </td>

                                <td>

                                    <div class="st-actions">

                                        <button class="st-btn st-btn-ghost"
                                                @onclick="@(() => Nav.NavigateTo($"/admin/settings/edit/{item.Id}"))">

                                            Sửa
                                        </button>

                                        <button class="st-btn-danger"
                                                @onclick="@(() => DeleteAsync(item))">

                                            Xóa
                                        </button>

                                        <button class="st-btn st-btn-ghost"
                                                @onclick="@(() => ToggleActiveAsync(item))">

                                            @(item.IsActive ? "Tắt" : "Bật")
                                        </button>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

                <!-- Pagination -->
                <div class="st-pagination">

                    <div class="st-pagination-info">
                        Hiển thị <strong>@FilteredItems.Count</strong>
                        trong tổng số <strong>@items.Count</strong> cấu hình
                    </div>

                    <div class="st-pages">
                        <span class="st-page-note">Danh sách này lọc trực tiếp trên dữ liệu đã tải.</span>
                    </div>

                </div>

            </div>
        }

    </div>

</div>

@code {
    private List<AdminSiteSettingItem>? items;
    private string keyword = string.Empty;
    private string groupFilter = string.Empty;

    private List<string> AvailableGroups => (items ?? new List<AdminSiteSettingItem>())
        .Select(item => item.SettingGroup ?? string.Empty)
        .Where(group => !string.IsNullOrWhiteSpace(group))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(group => group)
        .ToList();

    private List<AdminSiteSettingItem> FilteredItems => (items ?? new List<AdminSiteSettingItem>())
        .Where(MatchesFilter)
        .ToList();

    private bool MatchesFilter(AdminSiteSettingItem item)
    {
        var matchesGroup = string.IsNullOrWhiteSpace(groupFilter)
            || string.Equals(item.SettingGroup, groupFilter, StringComparison.OrdinalIgnoreCase);

        if (!matchesGroup)
            return false;

        if (string.IsNullOrWhiteSpace(keyword))
            return true;

        var value = keyword.Trim();
        return Contains(item.SettingKey, value)
            || Contains(item.SettingValue, value)
            || Contains(item.SettingGroup, value);
    }

    private static bool Contains(string? source, string value)
        => !string.IsNullOrWhiteSpace(source)
           && source.Contains(value, StringComparison.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        items = await AdminSiteSettingService.GetSettingsAsync(PN_PublicVariables.MaTruong);
    }

    private Task GoCreateAsync()
    {
        Nav.NavigateTo("/admin/settings/edit");
        return Task.CompletedTask;
    }

    private async Task DeleteAsync(AdminSiteSettingItem item)
    {
        if (await JS.InvokeAsync<bool>("confirm", $"Xóa cấu hình '{item.SettingKey}'?"))
        {
            await AdminSiteSettingService.DeleteSettingAsync(item.Id ?? string.Empty);
            items = await AdminSiteSettingService.GetSettingsAsync(PN_PublicVariables.MaTruong);
        }
    }

    private async Task ToggleActiveAsync(AdminSiteSettingItem item)
    {
        if (await JS.InvokeAsync<bool>("confirm", $"Bạn có muốn {(item.IsActive ? "tắt" : "bật")} cấu hình '{item.SettingKey}'?"))
        {
            await AdminSiteSettingService.SetActiveAsync(item.Id ?? string.Empty, !item.IsActive);
            items = await AdminSiteSettingService.GetSettingsAsync(PN_PublicVariables.MaTruong);
        }
    }
}

