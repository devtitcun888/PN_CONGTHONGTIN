@page "/admin/banners"
@attribute [Authorize(Roles = "Administrator")]
@using PN_HDSWeb_Admin.Services.Admin
@inject IAdminBannerService AdminBannerService
@inject NavigationManager Nav
@inject IJSRuntime JS

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700&family=Instrument+Serif:ital@0;1&display=swap');

    :root {
        --bn-bg: #f4f6fb;
        --bn-surface: #ffffff;
        --bn-surface-2: #f8fafd;
        --bn-border: #e4e9f2;
        --bn-primary: #3b6ef6;
        --bn-primary-hover: #2554e0;
        --bn-primary-soft: #eef2fe;
        --bn-text: #0f1b35;
        --bn-text-2: #5a6a8a;
        --bn-text-3: #94a3b8;
        --bn-success: #22c55e;
        --bn-success-soft: #f0fdf4;
        --bn-danger: #ef4444;
        --bn-danger-soft: #fff5f5;
        --bn-warning: #f59e0b;
        --bn-warning-soft: #fffbeb;
        --bn-radius: 16px;
        --bn-radius-sm: 10px;
        --bn-shadow: 0 4px 24px rgba(15,27,53,.07);
        --bn-transition: .2s cubic-bezier(.4,0,.2,1);
    }

    .bn-root * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    .bn-root {
        min-height: 100vh;
        background: var(--bn-bg);
        font-family: 'Be Vietnam Pro', sans-serif;
        color: var(--bn-text);
    }

    /* ── Topbar ── */
    .bn-topbar {
        padding: 20px 32px 0;
    }

    .bn-breadcrumb {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 13px;
        color: var(--bn-text-2);
    }

        .bn-breadcrumb a {
            color: var(--bn-primary);
            text-decoration: none;
            font-weight: 500;
        }

            .bn-breadcrumb a:hover {
                text-decoration: underline;
            }

    .bn-breadcrumb-sep {
        color: var(--bn-text-3);
    }

    .bn-breadcrumb-current {
        color: var(--bn-text);
        font-weight: 600;
    }

    /* ── Hero ── */
    .bn-hero {
        padding: 20px 32px 0;
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
    }

    .bn-hero-text h1 {
        font-family: 'Instrument Serif', serif;
        font-size: 30px;
        font-weight: 400;
        line-height: 1.2;
        letter-spacing: -.3px;
        color: var(--bn-text);
    }

    .bn-hero-text p {
        margin-top: 6px;
        font-size: 13.5px;
        color: var(--bn-text-2);
    }

    /* ── Toolbar ── */
    .bn-toolbar {
        padding: 20px 32px 0;
        display: flex;
        justify-content: flex-end;
    }

    /* ── Buttons ── */
    .bn-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        padding: 10px 18px;
        border-radius: var(--bn-radius-sm);
        border: 1.5px solid transparent;
        font-family: inherit;
        font-size: 13.5px;
        font-weight: 600;
        cursor: pointer;
        transition: all var(--bn-transition);
        white-space: nowrap;
    }

    .bn-btn-primary {
        background: var(--bn-primary);
        border-color: var(--bn-primary);
        color: white;
        box-shadow: 0 2px 12px rgba(59,110,246,.25);
    }

        .bn-btn-primary:hover {
            background: var(--bn-primary-hover);
            border-color: var(--bn-primary-hover);
            transform: translateY(-1px);
            box-shadow: 0 4px 18px rgba(59,110,246,.35);
        }

    .bn-btn-ghost {
        background: var(--bn-surface);
        border-color: var(--bn-border);
        color: var(--bn-text-2);
    }

        .bn-btn-ghost:hover {
            border-color: var(--bn-primary);
            background: var(--bn-primary-soft);
            color: var(--bn-primary);
        }

    .bn-btn-danger {
        background: none;
        border: none;
        color: var(--bn-danger);
        padding: 8px 10px;
        border-radius: 8px;
        cursor: pointer;
        transition: background var(--bn-transition);
        font-family: inherit;
        font-size: 13px;
        font-weight: 600;
    }

        .bn-btn-danger:hover {
            background: var(--bn-danger-soft);
        }

    /* ── Content ── */
    .bn-content {
        padding: 20px 32px 40px;
    }

    /* ── Card ── */
    .bn-card {
        background: var(--bn-surface);
        border: 1px solid var(--bn-border);
        border-radius: var(--bn-radius);
        box-shadow: var(--bn-shadow);
        overflow: hidden;
        animation: bn-fadeup .35s ease both;
    }

    @@keyframes bn-fadeup {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* ── Table ── */
    .bn-table {
        width: 100%;
        border-collapse: collapse;
    }

        .bn-table thead tr {
            background: var(--bn-surface-2);
            border-bottom: 1px solid var(--bn-border);
        }

        .bn-table th {
            padding: 12px 16px;
            text-align: left;
            font-size: 11.5px;
            text-transform: uppercase;
            letter-spacing: .5px;
            font-weight: 700;
            color: var(--bn-text-3);
            white-space: nowrap;
        }

        .bn-table td {
            padding: 14px 16px;
            font-size: 13.5px;
            color: var(--bn-text);
            border-bottom: 1px solid var(--bn-border);
            vertical-align: middle;
        }

        .bn-table tbody tr:last-child td {
            border-bottom: none;
        }

        .bn-table tbody tr {
            transition: background var(--bn-transition);
        }

            .bn-table tbody tr:hover {
                background: var(--bn-surface-2);
            }

    /* ── Banner info ── */
    .bn-title {
        font-weight: 600;
        color: var(--bn-text);
        line-height: 1.5;
    }

    .bn-position {
        display: inline-flex;
        align-items: center;
        padding: 4px 8px;
        border-radius: 7px;
        background: var(--bn-primary-soft);
        color: var(--bn-primary);
        font-size: 12px;
        font-weight: 700;
        font-family: monospace;
    }

    .bn-sort {
        font-weight: 600;
        color: var(--bn-text-2);
    }

    /* ── Badge ── */
    .bn-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 10px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
    }

        .bn-badge .dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
        }

    .bn-badge-active {
        background: var(--bn-success-soft);
        color: #166534;
    }

        .bn-badge-active .dot {
            background: var(--bn-success);
        }

    .bn-badge-inactive {
        background: #f1f5f9;
        color: #64748b;
    }

        .bn-badge-inactive .dot {
            background: #94a3b8;
        }

    /* ── Actions ── */
    .bn-actions {
        display: flex;
        align-items: center;
        gap: 6px;
        flex-wrap: wrap;
    }

    /* ── Empty / Loading ── */
    .bn-loading,
    .bn-empty {
        padding: 60px 24px;
        text-align: center;
        color: var(--bn-text-3);
        font-size: 14px;
    }

    .bn-empty h3 {
        font-size: 15px;
        color: var(--bn-text-2);
        margin-bottom: 6px;
    }

    /* ── Responsive ── */
    @@media (max-width: 768px) {
        .bn-topbar,
        .bn-hero,
        .bn-toolbar,
        .bn-content {
            padding-left: 16px;
            padding-right: 16px;
        }

        .bn-hero {
            flex-direction: column;
            align-items: flex-start;
        }

        .bn-card {
            overflow-x: auto;
        }

        .bn-table {
            min-width: 720px;
        }
    }
</style>

<div class="bn-root">

    <!-- Topbar -->
    <div class="bn-topbar">
        <nav class="bn-breadcrumb">
            <a href="/admin">Trang quản trị</a>
            <span class="bn-breadcrumb-sep">›</span>
            <span class="bn-breadcrumb-current">Banner</span>
        </nav>
    </div>

    <!-- Hero -->
    <div class="bn-hero">
        <div class="bn-hero-text">
            <h1>Quản lý banner</h1>
            <p>Quản lý banner hiển thị trên website.</p>
        </div>
    </div>

    <!-- Toolbar -->
    <div class="bn-toolbar">

        <button class="bn-btn bn-btn-primary"
                @onclick='@(() => Nav.NavigateTo("/admin/banners/edit"))'>

            <svg width="15" height="15"
                 viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="2.5">

                <line x1="12" y1="5" x2="12" y2="19" />
                <line x1="5" y1="12" x2="19" y2="12" />

            </svg>

            Thêm mới
        </button>

    </div>

    <!-- Content -->
    <div class="bn-content">

        @if (items == null)
        {
            <div class="bn-loading">
                Đang tải dữ liệu...
            </div>
        }
        else if (!items.Any())
        {
            <div class="bn-card">
                <div class="bn-empty">
                    <h3>Chưa có banner</h3>
                    <p>Bắt đầu bằng cách tạo banner đầu tiên.</p>
                </div>
            </div>
        }
        else
        {
            <div class="bn-card">

                <table class="bn-table">

                    <thead>
                        <tr>
                            <th>Tiêu đề</th>
                            <th>Vị trí</th>
                            <th>Thứ tự</th>
                            <th>Trạng thái</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in items)
                        {
                            <tr>

                                <td>
                                    <div class="bn-title">
                                        @item.Title
                                    </div>
                                </td>

                                <td>
                                    <span class="bn-position">
                                        @item.Position
                                    </span>
                                </td>

                                <td>
                                    <span class="bn-sort">
                                        #@item.SortOrder
                                    </span>
                                </td>

                                <td>

                                    @if (item.IsActive)
                                    {
                                        <span class="bn-badge bn-badge-active">
                                            <span class="dot"></span>
                                            Đang bật
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="bn-badge bn-badge-inactive">
                                            <span class="dot"></span>
                                            Đã tắt
                                        </span>
                                    }

                                </td>

                                <td>

                                    <div class="bn-actions">

                                        <button class="bn-btn bn-btn-ghost"
                                                @onclick='@(() => Nav.NavigateTo($"/admin/banners/edit/{item.Id}"))'>

                                            Sửa
                                        </button>

                                        <button class="bn-btn-danger"
                                                @onclick="() => DeleteAsync(item)">

                                            Xóa
                                        </button>

                                        <button class="bn-btn bn-btn-ghost"
                                                @onclick="() => ToggleActiveAsync(item)">

                                            @(item.IsActive ? "Tắt" : "Bật")
                                        </button>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>

@code {
    private List<AdminBannerItem>? items;

    protected override async Task OnInitializedAsync()
    {
        items = await AdminBannerService.GetBannersAsync(PN_PublicVariables.MaTruong);
    }

    private async Task DeleteAsync(AdminBannerItem item)
    {
        if (await JS.InvokeAsync<bool>("confirm", $"Xóa banner '{item.Title}'?"))
        {
            await AdminBannerService.DeleteBannerAsync(item.Id ?? string.Empty);
            items = await AdminBannerService.GetBannersAsync(PN_PublicVariables.MaTruong);
        }
    }

    private async Task ToggleActiveAsync(AdminBannerItem item)
    {
        if (await JS.InvokeAsync<bool>("confirm", $"Bạn có muốn {(item.IsActive ? "tắt" : "bật")} banner '{item.Title}'?"))
        {
            await AdminBannerService.SetActiveAsync(item.Id ?? string.Empty, !item.IsActive);
            items = await AdminBannerService.GetBannersAsync(PN_PublicVariables.MaTruong);
        }
    }
}
