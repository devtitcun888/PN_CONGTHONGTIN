@page "/admin/banners/edit/{Id?}"
@using Microsoft.AspNetCore.Components.Forms
@using PN_HDSWeb_Admin.Services.Admin
@inject IAdminBannerService AdminBannerService
@inject IAdminFileStorageService FileStorage
@inject NavigationManager Nav

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700&family=Instrument+Serif:ital@0;1&display=swap');

    :root {
        --bn-bg: #f4f6fb;
        --bn-surface: #ffffff;
        --bn-surface-2: #f8fafd;
        --bn-border: #e4e9f2;
        --bn-border-focus: #3b6ef6;
        --bn-primary: #3b6ef6;
        --bn-primary-hover: #2554e0;
        --bn-primary-soft: #eef2fe;
        --bn-text: #0f1b35;
        --bn-text-2: #5a6a8a;
        --bn-text-3: #a0aec0;
        --bn-radius: 14px;
        --bn-radius-sm: 9px;
        --bn-shadow: 0 4px 24px rgba(15,27,53,.07);
        --bn-shadow-lg: 0 8px 40px rgba(15,27,53,.12);
        --bn-transition: .2s cubic-bezier(.4,0,.2,1);
    }

    .bn-root * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    .bn-root {
        font-family: 'Be Vietnam Pro', sans-serif;
        background: var(--bn-bg);
        min-height: 100vh;
        color: var(--bn-text);
    }

    /* Breadcrumb */
    .bn-topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 20px 32px 0;
        gap: 12px;
    }

    .bn-breadcrumb {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 13px;
        color: var(--bn-text-2);
    }

    .bn-breadcrumb a {
        color: var(--bn-primary);
        text-decoration: none;
        font-weight: 500;
    }

    .bn-breadcrumb a:hover { text-decoration: underline; }

    .bn-breadcrumb-sep { color: var(--bn-text-3); }

    .bn-breadcrumb-current {
        color: var(--bn-text);
        font-weight: 600;
    }

    /* Hero */
    .bn-hero {
        padding: 24px 32px 0;
    }

    .bn-hero h1 {
        font-family: 'Instrument Serif', serif;
        font-size: 28px;
        font-weight: 400;
        letter-spacing: -.3px;
        line-height: 1.2;
    }

    .bn-hero p {
        margin-top: 4px;
        font-size: 13.5px;
        color: var(--bn-text-2);
    }

    /* Layout */
    .bn-layout {
        display: grid;
        grid-template-columns: 1fr 340px;
        gap: 24px;
        padding: 24px 32px 40px;
        max-width: 1400px;
    }

    @@media (max-width: 1100px) {
        .bn-layout { grid-template-columns: 1fr; }
        .bn-topbar, .bn-hero { padding-left: 20px; padding-right: 20px; }
        .bn-layout { padding: 20px; }
    }

    /* Card */
    .bn-card {
        background: var(--bn-surface);
        border: 1px solid var(--bn-border);
        border-radius: var(--bn-radius);
        box-shadow: var(--bn-shadow);
        overflow: hidden;
        animation: bn-fadeup .3s ease both;
    }

    .bn-card-header {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 18px 22px 16px;
        border-bottom: 1px solid var(--bn-border);
        background: var(--bn-surface-2);
    }

    .bn-card-header-icon {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        background: var(--bn-primary-soft);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--bn-primary);
        flex-shrink: 0;
    }

    .bn-card-header h2 {
        font-size: 14px;
        font-weight: 600;
        color: var(--bn-text);
    }

    .bn-card-body { padding: 22px; }

    /* Form */
    .bn-form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }

    .bn-field { margin-bottom: 18px; }
    .bn-field:last-child { margin-bottom: 0; }

    .bn-label {
        display: block;
        font-size: 12.5px;
        font-weight: 600;
        color: var(--bn-text-2);
        text-transform: uppercase;
        letter-spacing: .4px;
        margin-bottom: 7px;
    }

    .bn-input {
        width: 100%;
        padding: 10px 14px;
        border: 1.5px solid var(--bn-border);
        border-radius: var(--bn-radius-sm);
        font-family: inherit;
        font-size: 14px;
        color: var(--bn-text);
        background: var(--bn-surface);
        transition: border-color var(--bn-transition), box-shadow var(--bn-transition);
        outline: none;
    }

    .bn-input:focus {
        border-color: var(--bn-border-focus);
        box-shadow: 0 0 0 3px rgba(59,110,246,.12);
    }

    select.bn-input { cursor: pointer; }

    /* File upload zone */
    .bn-file-zone {
        border: 2px dashed var(--bn-border);
        border-radius: var(--bn-radius-sm);
        padding: 16px;
        text-align: center;
        cursor: pointer;
        transition: all var(--bn-transition);
        background: var(--bn-surface-2);
    }

    .bn-file-zone:hover {
        border-color: var(--bn-primary);
        background: var(--bn-primary-soft);
    }

    .bn-file-zone p {
        font-size: 13px;
        color: var(--bn-text-2);
        margin-top: 8px;
    }

    .bn-file-zone strong { color: var(--bn-primary); }

    .bn-file-zone input[type=file] { display: none; }

    /* Preview image */
    .bn-preview-card {
        background: var(--bn-surface);
        border: 1px solid var(--bn-border);
        border-radius: var(--bn-radius);
        padding: 22px;
        box-shadow: var(--bn-shadow);
        font-size: 13px;
        color: var(--bn-text-2);
    }

    .bn-preview-card h3 {
        font-size: 14px;
        font-weight: 600;
        color: var(--bn-text);
        margin-bottom: 16px;
    }

    .bn-preview-image {
        width: 100%;
        aspect-ratio: 16 / 9;
        border-radius: var(--bn-radius-sm);
        object-fit: cover;
        border: 1px solid var(--bn-border);
        background: var(--bn-surface-2);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--bn-text-3);
        font-size: 13px;
        overflow: hidden;
    }

    .bn-preview-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    /* Buttons */
    .bn-btn {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 10px 20px;
        border-radius: var(--bn-radius-sm);
        font-family: inherit;
        font-size: 13.5px;
        font-weight: 600;
        cursor: pointer;
        border: 1.5px solid transparent;
        transition: all var(--bn-transition);
        white-space: nowrap;
    }

    .bn-btn:disabled { opacity: .5; cursor: not-allowed; }

    .bn-btn-primary {
        background: var(--bn-primary);
        color: white;
        border-color: var(--bn-primary);
        box-shadow: 0 2px 12px rgba(59,110,246,.25);
    }

    .bn-btn-primary:hover:not(:disabled) {
        background: var(--bn-primary-hover);
        border-color: var(--bn-primary-hover);
        box-shadow: 0 4px 18px rgba(59,110,246,.35);
        transform: translateY(-1px);
    }

    .bn-btn-ghost {
        background: transparent;
        color: var(--bn-text-2);
        border-color: var(--bn-border);
    }

    .bn-btn-ghost:hover:not(:disabled) {
        border-color: var(--bn-text-2);
        color: var(--bn-text);
        background: var(--bn-surface-2);
    }

    .bn-btn-sm { padding: 7px 14px; font-size: 12.5px; }

    .bn-action-bar {
        display: flex;
        gap: 10px;
        margin-top: 24px;
    }

    /* Loading */
    .bn-loading {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 14px;
        min-height: 50vh;
        color: var(--bn-text-2);
        font-size: 14px;
    }

    .bn-spinner {
        width: 28px;
        height: 28px;
        border: 3px solid var(--bn-border);
        border-top-color: var(--bn-primary);
        border-radius: 50%;
        animation: bn-spin .75s linear infinite;
    }

    @@keyframes bn-spin { to { transform: rotate(360deg); } }
    @@keyframes bn-fadeup {
        from { opacity: 0; transform: translateY(12px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .bn-main-col > .bn-card { animation-delay: .06s; }
    .bn-side-col > .bn-card { animation-delay: .1s; }
</style>

<div class="bn-root">
    <!-- Breadcrumb -->
    <div class="bn-topbar">
        <nav class="bn-breadcrumb">
            <a href="/admin">Trang quản trị</a>
            <span class="bn-breadcrumb-sep">›</span>
            <a href="/admin/banners">Banner</a>
            <span class="bn-breadcrumb-sep">›</span>
            <span class="bn-breadcrumb-current">@(string.IsNullOrWhiteSpace(Id) ? "Tạo mới" : "Chỉnh sửa")</span>
        </nav>
        <button class="bn-btn bn-btn-ghost bn-btn-sm" type="button" @onclick="GoBackAsync">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 12H5M12 5l-7 7 7 7" /></svg>
            Quay lại
        </button>
    </div>

    <!-- Hero -->
    <div class="bn-hero">
        <h1>@(string.IsNullOrWhiteSpace(Id) ? "Thêm banner" : "Sửa banner")</h1>
        <p>Thêm mới hoặc chỉnh sửa banner hiển thị trên website.</p>
    </div>

    @if (model == null)
    {
        <div class="bn-loading">
            <div class="bn-spinner"></div>
            <span>Đang tải dữ liệu...</span>
        </div>
    }
    else
    {
        <div class="bn-layout">
            <!-- Cột trái: Form -->
            <div class="bn-main-col">
                <div class="bn-card">
                    <div class="bn-card-header">
                        <div class="bn-card-header-icon">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /></svg>
                        </div>
                        <h2>Thông tin banner</h2>
                    </div>
                    <div class="bn-card-body">
                        <div class="bn-form-grid">
                            <div class="bn-field">
                                <label class="bn-label">Tiêu đề</label>
                                <input class="bn-input" @bind="model.Title" placeholder="Nhập tiêu đề banner..." />
                            </div>
                            <div class="bn-field">
                                <label class="bn-label">Vị trí hiển thị</label>
                                <select class="bn-input" @bind="model.Position">
                                    <option value="HomeTop">HomeTop</option>
                                    <option value="HomeMiddle">HomeMiddle</option>
                                    <option value="HomeBottom">HomeBottom</option>
                                    <option value="Sidebar">Sidebar</option>
                                </select>
                            </div>
                            <div class="bn-field">
                                <label class="bn-label">Link</label>
                                <input class="bn-input" @bind="model.LinkUrl" placeholder="Nhập URL khi click..." />
                            </div>
                            <div class="bn-field">
                                <label class="bn-label">Thứ tự</label>
                                <input class="bn-input" type="number" @bind="model.SortOrder" min="0" />
                            </div>
                            <div class="bn-field">
                                <label class="bn-label">Ngày bắt đầu</label>
                                <input class="bn-input" type="date" value="@StartDateText" @onchange="OnStartDateChanged" />
                            </div>
                            <div class="bn-field">
                                <label class="bn-label">Ngày kết thúc</label>
                                <input class="bn-input" type="date" value="@EndDateText" @onchange="OnEndDateChanged" />
                            </div>
                            <div class="bn-field">
                                <label class="bn-label">Trạng thái</label>
                                <select class="bn-input" @bind="IsActiveText">
                                    <option value="true">Đang bật</option>
                                    <option value="false">Tắt</option>
                                </select>
                            </div>
                            <div class="bn-field" style="grid-column:1/-1;">
                                <label class="bn-label">Ảnh banner</label>
                                <label class="bn-file-zone">
                                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="17 8 12 3 7 8" /><line x1="12" y1="3" x2="12" y2="15" /></svg>
                                    <p><strong>Nhấn để chọn ảnh</strong></p>
                                    <InputFile OnChange="OnImageSelected" accept="image/*" />
                                </label>
                            </div>
                        </div>

                        <div class="bn-action-bar">
                            <button type="button" class="bn-btn bn-btn-primary" @onclick="SaveAsync">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z" /><polyline points="17 21 17 13 7 13" /><polyline points="7 3 7 8 15 8" /></svg>
                                Lưu
                            </button>
                            <button type="button" class="bn-btn bn-btn-ghost" @onclick="GoBackAsync">Hủy</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Cột phải: Preview ảnh -->
            <div class="bn-side-col">
                <div class="bn-preview-card">
                    <h3>Xem trước</h3>
                    <div class="bn-preview-image">
                        @if (!string.IsNullOrWhiteSpace(model.ImageUrl))
                        {
                            <img src="@model.ImageUrl" alt="Banner preview" />
                        }
                        else
                        {
                            <span>Chưa có ảnh</span>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public string? Id { get; set; }
    private AdminBannerDetail? model;
    private string? StartDateText;
    private string? EndDateText;
    private string IsActiveText = "true";

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(Id))
        {
            model = await AdminBannerService.GetBannerByIdAsync(Id);
        }

        model ??= new AdminBannerDetail
            {
                MaTruongBo = PN_PublicVariables.MaTruong,
                Position = "HomeTop",
                IsActive = true,
                SortOrder = 0
            };

        StartDateText = model.StartDate?.ToString("yyyy-MM-dd");
        EndDateText = model.EndDate?.ToString("yyyy-MM-dd");
        IsActiveText = model.IsActive.ToString().ToLowerInvariant();
    }

    private Task OnStartDateChanged(ChangeEventArgs e)
    {
        StartDateText = e.Value?.ToString();
        return Task.CompletedTask;
    }

    private Task OnEndDateChanged(ChangeEventArgs e)
    {
        EndDateText = e.Value?.ToString();
        return Task.CompletedTask;
    }

    private async Task OnImageSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;
        model!.ImageUrl = await FileStorage.SaveImageAsync(file, "banners") ?? model.ImageUrl;
    }

    private Task GoBackAsync()
    {
        Nav.NavigateTo("/admin/banners");
        return Task.CompletedTask;
    }

    private async Task SaveAsync()
    {
        model!.StartDate = DateTime.TryParse(StartDateText, out var s) ? s : null;
        model.EndDate = DateTime.TryParse(EndDateText, out var en) ? en : null;
        model.IsActive = bool.TryParse(IsActiveText, out var active) && active;

        if (string.IsNullOrWhiteSpace(model.Id))
            await AdminBannerService.CreateBannerAsync(model);
        else
            await AdminBannerService.UpdateBannerAsync(model);

        Nav.NavigateTo("/admin/banners");
    }
}