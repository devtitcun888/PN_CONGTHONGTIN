@page "/admin/pages"
@attribute [Authorize(Roles = "Administrator")]
@using PN_HDSWeb_Admin.Services.Admin
@inject IAdminStaticPageService AdminStaticPageService
@inject NavigationManager Nav
@inject IJSRuntime JS

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700&family=Instrument+Serif:ital@0;1&display=swap');

    :root {
        --ps-bg: #f4f6fb;
        --ps-surface: #ffffff;
        --ps-surface-2: #f8fafd;
        --ps-border: #e4e9f2;
        --ps-border-focus: #3b6ef6;
        --ps-primary: #3b6ef6;
        --ps-primary-hover: #2554e0;
        --ps-primary-soft: #eef2fe;
        --ps-text: #0f1b35;
        --ps-text-2: #5a6a8a;
        --ps-text-3: #a0aec0;
        --ps-danger: #e53e3e;
        --ps-danger-soft: #fff5f5;
        --ps-success: #22c55e;
        --ps-success-soft: #f0fdf4;
        --ps-warning: #f59e0b;
        --ps-warning-soft: #fffbeb;
        --ps-radius: 14px;
        --ps-radius-sm: 9px;
        --ps-shadow: 0 4px 24px rgba(15,27,53,.07);
        --ps-transition: .2s cubic-bezier(.4,0,.2,1);
    }

    .ps-root * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    .ps-root {
        font-family: 'Be Vietnam Pro', sans-serif;
        background: var(--ps-bg);
        min-height: 100vh;
        color: var(--ps-text);
    }

    /* Breadcrumb */
    .ps-topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 20px 32px 0;
        gap: 12px;
    }

    .ps-breadcrumb {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 13px;
        color: var(--ps-text-2);
    }

        .ps-breadcrumb a {
            color: var(--ps-primary);
            text-decoration: none;
            font-weight: 500;
        }

            .ps-breadcrumb a:hover {
                text-decoration: underline;
            }

    .ps-breadcrumb-sep {
        color: var(--ps-text-3);
    }

    .ps-breadcrumb-current {
        color: var(--ps-text);
        font-weight: 600;
    }

    /* Hero */
    .ps-hero {
        padding: 20px 32px 0;
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
    }

    .ps-hero-text h1 {
        font-family: 'Instrument Serif', serif;
        font-size: 28px;
        font-weight: 400;
        letter-spacing: -.3px;
        line-height: 1.2;
    }

    .ps-hero-text p {
        margin-top: 4px;
        font-size: 13.5px;
        color: var(--ps-text-2);
    }

    /* Buttons */
    .ps-btn {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 9px 18px;
        border-radius: var(--ps-radius-sm);
        font-family: inherit;
        font-size: 13.5px;
        font-weight: 600;
        cursor: pointer;
        border: 1.5px solid transparent;
        transition: all var(--ps-transition);
        white-space: nowrap;
    }

        .ps-btn:disabled {
            opacity: .5;
            cursor: not-allowed;
        }

    .ps-btn-primary {
        background: var(--ps-primary);
        color: white;
        border-color: var(--ps-primary);
        box-shadow: 0 2px 12px rgba(59,110,246,.25);
    }

        .ps-btn-primary:hover:not(:disabled) {
            background: var(--ps-primary-hover);
            border-color: var(--ps-primary-hover);
            box-shadow: 0 4px 18px rgba(59,110,246,.35);
            transform: translateY(-1px);
        }

    .ps-btn-ghost {
        background: transparent;
        color: var(--ps-text-2);
        border-color: var(--ps-border);
        padding: 6px 12px;
    }

        .ps-btn-ghost:hover:not(:disabled) {
            border-color: var(--ps-text-2);
            color: var(--ps-text);
            background: var(--ps-surface-2);
        }

    .ps-btn-danger-ghost {
        background: none;
        color: var(--ps-danger);
        border: none;
        padding: 5px 8px;
        border-radius: 6px;
        cursor: pointer;
        font-family: inherit;
        font-size: 13px;
        transition: background var(--ps-transition);
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }

        .ps-btn-danger-ghost:hover {
            background: var(--ps-danger-soft);
        }

    /* Main content */
    .ps-content {
        padding: 20px 32px 40px;
    }

    /* Card */
    .ps-card {
        background: var(--ps-surface);
        border: 1px solid var(--ps-border);
        border-radius: var(--ps-radius);
        box-shadow: var(--ps-shadow);
        overflow: hidden;
        animation: ps-fadeup .35s ease both;
    }

    @@keyframes ps-fadeup {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Table */
    .ps-table {
        width: 100%;
        border-collapse: collapse;
    }

        .ps-table thead tr {
            background: var(--ps-surface-2);
            border-bottom: 1px solid var(--ps-border);
        }

        .ps-table th {
            padding: 11px 16px;
            font-size: 11.5px;
            font-weight: 700;
            color: var(--ps-text-3);
            text-transform: uppercase;
            letter-spacing: .5px;
            text-align: left;
            white-space: nowrap;
        }

            .ps-table th:last-child {
                text-align: right;
            }

        .ps-table tbody tr {
            border-bottom: 1px solid var(--ps-border);
            transition: background var(--ps-transition);
        }

            .ps-table tbody tr:last-child {
                border-bottom: none;
            }

            .ps-table tbody tr:hover {
                background: var(--ps-surface-2);
            }

        .ps-table td {
            padding: 14px 16px;
            font-size: 13.5px;
            color: var(--ps-text);
            vertical-align: middle;
        }

            .ps-table td:last-child {
                text-align: right;
            }

    .ps-title-cell {
        max-width: 240px;
    }

    .ps-title-main {
        font-weight: 600;
        font-size: 14px;
        line-height: 1.4;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    /* Badge */
    .ps-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
    }

        .ps-badge .dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
        }

    .badge-draft {
        background: #f1f5f9;
        color: #64748b;
    }

        .badge-draft .dot {
            background: #94a3b8;
        }

    .badge-published {
        background: var(--ps-success-soft);
        color: #166534;
    }

        .badge-published .dot {
            background: var(--ps-success);
        }

    .badge-archived {
        background: var(--ps-danger-soft);
        color: var(--ps-danger);
    }

        .badge-archived .dot {
            background: var(--ps-danger);
        }

    /* Actions */
    .ps-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 2px;
    }

    /* Loading / Empty */
    .ps-loading {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 14px;
        min-height: 40vh;
        color: var(--ps-text-2);
        font-size: 14px;
    }

    .ps-spinner {
        width: 26px;
        height: 26px;
        border: 3px solid var(--ps-border);
        border-top-color: var(--ps-primary);
        border-radius: 50%;
        animation: ps-spin .75s linear infinite;
    }

    @@keyframes ps-spin {
        to {
            transform: rotate(360deg);
        }
    }

    .ps-empty {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 60px 24px;
        text-align: center;
        color: var(--ps-text-3);
    }

    .ps-empty-icon {
        width: 56px;
        height: 56px;
        background: var(--ps-surface-2);
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 16px;
        color: var(--ps-text-3);
    }

    .ps-empty h3 {
        font-size: 15px;
        color: var(--ps-text-2);
        font-weight: 600;
        margin-bottom: 6px;
    }

    .ps-empty p {
        font-size: 13px;
    }

    @@media (max-width: 768px) {
        .ps-topbar, .ps-hero, .ps-content {
            padding-left: 16px;
            padding-right: 16px;
        }

        .ps-hero {
            flex-direction: column;
            align-items: flex-start;
        }
    }
</style>

<div class="ps-root">
    <!-- Breadcrumb -->
    <div class="ps-topbar">
        <nav class="ps-breadcrumb">
            <a href="/admin">Trang quản trị</a>
            <span class="ps-breadcrumb-sep">›</span>
            <span class="ps-breadcrumb-current">Trang tĩnh</span>
        </nav>
    </div>

    <!-- Hero -->
    <div class="ps-hero">
        <div class="ps-hero-text">
            <h1>Quản lý trang tĩnh</h1>
            <p>CRUD các trang nội dung tĩnh hiển thị ngoài public site.</p>
        </div>
        <button class="ps-btn ps-btn-primary" @onclick="GoCreate">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
            Thêm mới
        </button>
    </div>

    <!-- Nội dung -->
    <div class="ps-content">
        @if (items == null)
        {
            <div class="ps-loading">
                <div class="ps-spinner"></div>
                <span>Đang tải dữ liệu...</span>
            </div>
        }
        else if (items.Count == 0)
        {
            <div class="ps-card">
                <div class="ps-empty">
                    <div class="ps-empty-icon">
                        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /></svg>
                    </div>
                    <h3>Chưa có trang tĩnh nào</h3>
                    <p>Nhấn "Thêm mới" để tạo trang đầu tiên.</p>
                </div>
            </div>
        }
        else
        {
            <div class="ps-card">
                <table class="ps-table">
                    <thead>
                        <tr>
                            <th style="width:30%">Tiêu đề</th>
                            <th>Slug</th>
                            <th>Mã trang</th>
                            <th>Trạng thái</th>
                            <th>Thứ tự</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in items)
                        {
                            <tr>
                                <td class="ps-title-cell">
                                    <div class="ps-title-main">@item.Title</div>
                                </td>
                                <td style="font-family:monospace;font-size:13px;color:var(--ps-text-2)">@item.Slug</td>
                                <td style="font-family:monospace;font-size:13px;color:var(--ps-text-2)">@item.PageCode</td>
                                <td>
                                    <span class="ps-badge @GetBadgeClass(item.Status)">
                                        <span class="dot"></span>
                                        @GetStatusLabel(item.Status)
                                    </span>
                                </td>
                                <td>@item.SortOrder</td>
                                <td>
                                    <div class="ps-actions">
                                        <button type="button" class="ps-btn-ghost" @onclick="() => Edit(item)" title="Sửa">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" /><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" /></svg>
                                            Sửa
                                        </button>
                                        <button type="button" class="ps-btn-ghost" @onclick="() => ToggleAsync(item)" title="@(item.Status == "Published" ? "Ẩn" : "Hiện")">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                                @if (item.Status == "Published")
                                                {
                                                    <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24" />
                                                    <line x1="1" y1="1" x2="23" y2="23" />
                                                }
                                                else
                                                {
                                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                                                    <circle cx="12" cy="12" r="3" />
                                                }
                                            </svg>
                                            @(item.Status == "Published" ? "Ẩn" : "Hiện")
                                        </button>
                                        <button type="button" class="ps-btn-danger-ghost" @onclick="() => DeleteAsync(item)" title="Xóa">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="3 6 5 6 21 6" /><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" /><path d="M10 11v6M14 11v6" /><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2" /></svg>
                                            Xóa
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    private List<AdminStaticPageItem>? items;

    protected override async Task OnInitializedAsync()
    {
        items = await AdminStaticPageService.GetPagesAsync(PN_PublicVariables.MaTruong);
    }

    private void GoCreate() => Nav.NavigateTo("/admin/pages/edit");
    private void Edit(AdminStaticPageItem item) => Nav.NavigateTo($"/admin/pages/edit/{item.Id}");

    private async Task DeleteAsync(AdminStaticPageItem item)
    {
        if (await JS.InvokeAsync<bool>("confirm", $"Xóa trang '{item.Title}'?"))
        {
            await AdminStaticPageService.DeletePageAsync(item.Id ?? string.Empty);
            items = await AdminStaticPageService.GetPagesAsync(PN_PublicVariables.MaTruong);
        }
    }

    private async Task ToggleAsync(AdminStaticPageItem item)
    {
        if (await JS.InvokeAsync<bool>("confirm", $"Đổi trạng thái trang '{item.Title}'?"))
        {
            await AdminStaticPageService.SetActiveAsync(item.Id ?? string.Empty, item.Status != "Published");
            items = await AdminStaticPageService.GetPagesAsync(PN_PublicVariables.MaTruong);
        }
    }

    private static string GetBadgeClass(string? s) => s switch
    {
        "Published" => "badge-published",
        "Draft" => "badge-draft",
        "Archived" => "badge-archived",
        _ => "badge-draft"
    };

    private static string GetStatusLabel(string? s) => s switch
    {
        "Published" => "Xuất bản",
        "Draft" => "Nháp",
        "Archived" => "Lưu trữ",
        _ => s ?? "—"
    };
}