@page "/admin/menus/edit/{Id?}"
@using PN_HDSWeb_Admin.Services.Admin
@inject IAdminMenuService AdminMenuService
@inject NavigationManager Nav
<div class="admin-form-shell">
    <div class="admin-form-card">
        <div class="admin-form-header">
            <h1>Menu</h1>
            <p>Thêm mới hoặc chỉnh sửa menu của website.</p>
        </div>

        @if (model == null)
        {
            <p>Đang tải...</p>
        }
        else
        {
            <div class="admin-form-grid">
                <label>
                    Tên menu
                    <input class="admin-input" @bind="model.MenuName" />
                </label>
                <label>
                    Menu cha
                    <input class="admin-input" @bind="model.ParentId" />
                </label>
                <label>
                    URL
                    <input class="admin-input" @bind="model.Url" />
                </label>
                <label>
                    Target
                    <select class="admin-input" @bind="model.Target">
                        <option value="_self">_self</option>
                        <option value="_blank">_blank</option>
                    </select>
                </label>
                <label>
                    Thứ tự
                    <input class="admin-input" type="number" @bind="model.SortOrder" />
                </label>
                <label>
                    Trạng thái
                    <select class="admin-input" @bind="IsActiveText">
                        <option value="true">Đang bật</option>
                        <option value="false">Tắt</option>
                    </select>
                </label>
            </div>

            <div class="admin-form-actions">
                <button class="btn btn-primary" @onclick="SaveAsync">Lưu</button>
                <button class="btn btn-secondary" @onclick="GoBack">Quay lại</button>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public string? Id { get; set; }
    private AdminMenuDetail? model;
    private string IsActiveText = "true";

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(Id))
        {
            model = await AdminMenuService.GetMenuByIdAsync(Id);
        }

        model ??= new AdminMenuDetail
        {
            MaTruongBo = PN_PublicVariables.MaTruong,
            Target = "_self",
            IsActive = true,
            SortOrder = 0
        };

        IsActiveText = model.IsActive.ToString().ToLowerInvariant();
    }

    private async Task SaveAsync()
    {
        model!.IsActive = bool.TryParse(IsActiveText, out var active) && active;

        if (string.IsNullOrWhiteSpace(model.Id))
            await AdminMenuService.CreateMenuAsync(model);
        else
            await AdminMenuService.UpdateMenuAsync(model);

        Nav.NavigateTo("/admin/menus");
    }

    private void GoBack()
    {
        Nav.NavigateTo("/admin/menus");
    }
}
