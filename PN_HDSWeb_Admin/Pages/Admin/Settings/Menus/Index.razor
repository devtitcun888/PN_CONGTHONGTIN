@page "/admin/menus"
@attribute [Authorize(Roles = "Administrator")]
@using PN_HDSWeb_Admin.Services.Admin
@inject IAdminMenuService AdminMenuService
@inject NavigationManager Nav
@inject IJSRuntime JS


<div class="mn-root">

    <!-- Topbar -->
    <div class="mn-topbar">
        <nav class="mn-breadcrumb">
            <a href="/admin">Trang quản trị</a>
            <span class="mn-breadcrumb-sep">›</span>
            <span class="mn-breadcrumb-current">Menu</span>
        </nav>
    </div>

    <!-- Hero -->
    <div class="mn-hero">

        <div class="mn-hero-text">
            <h1>Quản lý menu</h1>
            <p>Quản lý menu website công khai.</p>
        </div>

    </div>

    <!-- Toolbar -->
    <div class="mn-toolbar">

        <button class="mn-btn mn-btn-primary"
                @onclick='@(() => Nav.NavigateTo("/admin/menus/edit"))'>

            <svg width="15"
                 height="15"
                 viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="2.5">

                <line x1="12" y1="5" x2="12" y2="19" />
                <line x1="5" y1="12" x2="19" y2="12" />

            </svg>

            Thêm mới

        </button>

    </div>

    <!-- Content -->
    <div class="mn-content">

        @if (items == null)
        {
            <div class="mn-loading">
                Đang tải dữ liệu...
            </div>
        }
        else if (!items.Any())
        {
            <div class="mn-card">
                <div class="mn-empty">
                    <h3>Chưa có menu</h3>
                    <p>Bắt đầu bằng cách tạo menu đầu tiên.</p>
                </div>
            </div>
        }
        else
        {
            <div class="mn-card">

                <table class="mn-table">

                    <thead>
                        <tr>
                            <th>Tên menu</th>
                            <th>URL</th>
                            <th>Thứ tự</th>
                            <th>Trạng thái</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in items)
                        {
                            <tr>

                                <td>
                                    <div class="mn-name">
                                        @item.MenuName
                                    </div>
                                </td>

                                <td>
                                    <span class="mn-url">
                                        @item.Url
                                    </span>
                                </td>

                                <td>
                                    <span class="mn-sort">
                                        #@item.SortOrder
                                    </span>
                                </td>

                                <td>

                                    @if (item.IsActive)
                                    {
                                        <span class="mn-badge mn-badge-active">
                                            <span class="dot"></span>
                                            Đang bật
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="mn-badge mn-badge-inactive">
                                            <span class="dot"></span>
                                            Đã tắt
                                        </span>
                                    }

                                </td>

                                <td>

                                    <div class="mn-actions">

                                        <button class="mn-btn mn-btn-ghost"
                                                @onclick='@(() => Nav.NavigateTo($"/admin/menus/edit/{item.Id}"))'>

                                            Sửa

                                        </button>

                                        <button class="mn-btn-danger"
                                                @onclick="() => DeleteAsync(item)">

                                            Xóa

                                        </button>

                                        <button class="mn-btn mn-btn-ghost"
                                                @onclick="() => ToggleActiveAsync(item)">

                                            @(item.IsActive ? "Tắt" : "Bật")

                                        </button>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>
@code {
    private List<AdminMenuItem>? items;

    protected override async Task OnInitializedAsync()
    {
        items = await AdminMenuService.GetMenusAsync(PN_PublicVariables.MaTruong);
    }

    private async Task DeleteAsync(AdminMenuItem item)
    {
        if (await JS.InvokeAsync<bool>("confirm", $"Xóa menu '{item.MenuName}'?"))
        {
            await AdminMenuService.DeleteMenuAsync(item.Id ?? string.Empty);
            items = await AdminMenuService.GetMenusAsync(PN_PublicVariables.MaTruong);
        }
    }

    private async Task ToggleActiveAsync(AdminMenuItem item)
    {
        if (await JS.InvokeAsync<bool>("confirm", $"Bạn có muốn {(item.IsActive ? "tắt" : "bật")} menu '{item.MenuName}'?"))
        {
            await AdminMenuService.SetActiveAsync(item.Id ?? string.Empty, !item.IsActive);
            items = await AdminMenuService.GetMenusAsync(PN_PublicVariables.MaTruong);
        }
    }
}

