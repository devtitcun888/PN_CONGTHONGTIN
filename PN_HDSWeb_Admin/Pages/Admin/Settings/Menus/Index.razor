@page "/admin/menus"
@attribute [Authorize(Roles = "Administrator")]
@using PN_HDSWeb_Admin.Services.Admin
@inject IAdminMenuService AdminMenuService
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="admin-form-shell">
    <div class="admin-form-card">
        <div class="admin-form-header">
            <h1>Quản lý menu</h1>
            <p>Quản lý menu website công khai.</p>
        </div>

        <p><button class="btn btn-primary" @onclick='@(() => Nav.NavigateTo("/admin/menus/edit"))'>Thêm mới</button></p>

        @if (items == null)
        {
            <p>Đang tải...</p>
        }
        else
        {
            <table>
                <thead>
                    <tr>
                        <th>Tên menu</th>
                        <th>URL</th>
                        <th>Thứ tự</th>
                        <th>Trạng thái</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in items)
                    {
                        <tr>
                            <td>@item.MenuName</td>
                            <td>@item.Url</td>
                            <td>@item.SortOrder</td>
                            <td>@(item.IsActive ? "Đang bật" : "Tắt")</td>
                            <td>
                                <button @onclick='@(() => Nav.NavigateTo($"/admin/menus/edit/{item.Id}"))'>Sửa</button>
                                <button @onclick="() => DeleteAsync(item)">Xóa</button>
                                <button @onclick="() => ToggleActiveAsync(item)">@(item.IsActive ? "Tắt" : "Bật")</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@code {
    private List<AdminMenuItem>? items;

    protected override async Task OnInitializedAsync()
    {
        items = await AdminMenuService.GetMenusAsync(PN_PublicVariables.MaTruong);
    }

    private async Task DeleteAsync(AdminMenuItem item)
    {
        if (await JS.InvokeAsync<bool>("confirm", $"Xóa menu '{item.MenuName}'?"))
        {
            await AdminMenuService.DeleteMenuAsync(item.Id ?? string.Empty);
            items = await AdminMenuService.GetMenusAsync(PN_PublicVariables.MaTruong);
        }
    }

    private async Task ToggleActiveAsync(AdminMenuItem item)
    {
        if (await JS.InvokeAsync<bool>("confirm", $"Bạn có muốn {(item.IsActive ? "tắt" : "bật")} menu '{item.MenuName}'?"))
        {
            await AdminMenuService.SetActiveAsync(item.Id ?? string.Empty, !item.IsActive);
            items = await AdminMenuService.GetMenusAsync(PN_PublicVariables.MaTruong);
        }
    }
}
