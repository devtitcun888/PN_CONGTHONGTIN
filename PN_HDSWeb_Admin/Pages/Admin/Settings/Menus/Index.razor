@page "/admin/menus"
@attribute [Authorize(Roles = "Administrator")]
@using PN_HDSWeb_Admin.Services.Admin
@inject IAdminMenuService AdminMenuService
@inject NavigationManager Nav
@inject IJSRuntime JS

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700&family=Instrument+Serif:ital@0;1&display=swap');

    :root {
        --mn-bg: #f4f6fb;
        --mn-surface: #ffffff;
        --mn-surface-2: #f8fafd;
        --mn-border: #e4e9f2;
        --mn-primary: #3b6ef6;
        --mn-primary-hover: #2554e0;
        --mn-primary-soft: #eef2fe;
        --mn-text: #0f1b35;
        --mn-text-2: #5a6a8a;
        --mn-text-3: #94a3b8;
        --mn-success: #22c55e;
        --mn-success-soft: #f0fdf4;
        --mn-danger: #ef4444;
        --mn-danger-soft: #fff5f5;
        --mn-radius: 16px;
        --mn-radius-sm: 10px;
        --mn-shadow: 0 4px 24px rgba(15,27,53,.07);
        --mn-transition: .2s cubic-bezier(.4,0,.2,1);
    }

    .mn-root * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    .mn-root {
        min-height: 100vh;
        background: var(--mn-bg);
        font-family: 'Be Vietnam Pro', sans-serif;
        color: var(--mn-text);
    }

    /* ── Topbar ── */
    .mn-topbar {
        padding: 20px 32px 0;
    }

    .mn-breadcrumb {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 13px;
        color: var(--mn-text-2);
    }

        .mn-breadcrumb a {
            color: var(--mn-primary);
            text-decoration: none;
            font-weight: 500;
        }

            .mn-breadcrumb a:hover {
                text-decoration: underline;
            }

    .mn-breadcrumb-sep {
        color: var(--mn-text-3);
    }

    .mn-breadcrumb-current {
        color: var(--mn-text);
        font-weight: 600;
    }

    /* ── Hero ── */
    .mn-hero {
        padding: 20px 32px 0;
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
    }

    .mn-hero-text h1 {
        font-family: 'Instrument Serif', serif;
        font-size: 30px;
        font-weight: 400;
        line-height: 1.2;
        letter-spacing: -.3px;
    }

    .mn-hero-text p {
        margin-top: 5px;
        font-size: 13.5px;
        color: var(--mn-text-2);
    }

    /* ── Toolbar ── */
    .mn-toolbar {
        padding: 20px 32px 0;
        display: flex;
        justify-content: flex-end;
    }

    /* ── Buttons ── */
    .mn-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        padding: 10px 18px;
        border-radius: var(--mn-radius-sm);
        border: 1.5px solid transparent;
        font-family: inherit;
        font-size: 13.5px;
        font-weight: 600;
        cursor: pointer;
        transition: all var(--mn-transition);
        white-space: nowrap;
    }

    .mn-btn-primary {
        background: var(--mn-primary);
        border-color: var(--mn-primary);
        color: white;
        box-shadow: 0 2px 12px rgba(59,110,246,.25);
    }

        .mn-btn-primary:hover {
            background: var(--mn-primary-hover);
            border-color: var(--mn-primary-hover);
            transform: translateY(-1px);
            box-shadow: 0 4px 18px rgba(59,110,246,.35);
        }

    .mn-btn-ghost {
        background: var(--mn-surface);
        border-color: var(--mn-border);
        color: var(--mn-text-2);
    }

        .mn-btn-ghost:hover {
            border-color: var(--mn-primary);
            background: var(--mn-primary-soft);
            color: var(--mn-primary);
        }

    .mn-btn-danger {
        background: none;
        border: none;
        color: var(--mn-danger);
        padding: 8px 10px;
        border-radius: 8px;
        cursor: pointer;
        transition: background var(--mn-transition);
        font-family: inherit;
        font-size: 13px;
        font-weight: 600;
    }

        .mn-btn-danger:hover {
            background: var(--mn-danger-soft);
        }

    /* ── Content ── */
    .mn-content {
        padding: 20px 32px 40px;
    }

    /* ── Card ── */
    .mn-card {
        background: var(--mn-surface);
        border: 1px solid var(--mn-border);
        border-radius: var(--mn-radius);
        box-shadow: var(--mn-shadow);
        overflow: hidden;
        animation: mn-fadeup .35s ease both;
    }

    @@keyframes mn-fadeup {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* ── Table ── */
    .mn-table {
        width: 100%;
        border-collapse: collapse;
    }

        .mn-table thead tr {
            background: var(--mn-surface-2);
            border-bottom: 1px solid var(--mn-border);
        }

        .mn-table th {
            padding: 12px 16px;
            text-align: left;
            font-size: 11.5px;
            text-transform: uppercase;
            letter-spacing: .5px;
            font-weight: 700;
            color: var(--mn-text-3);
            white-space: nowrap;
        }

        .mn-table td {
            padding: 14px 16px;
            font-size: 13.5px;
            color: var(--mn-text);
            border-bottom: 1px solid var(--mn-border);
            vertical-align: middle;
        }

        .mn-table tbody tr:last-child td {
            border-bottom: none;
        }

        .mn-table tbody tr {
            transition: background var(--mn-transition);
        }

            .mn-table tbody tr:hover {
                background: var(--mn-surface-2);
            }

    /* ── Menu info ── */
    .mn-name {
        font-weight: 600;
        color: var(--mn-text);
    }

    .mn-url {
        display: inline-flex;
        align-items: center;
        max-width: 320px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        padding: 4px 8px;
        border-radius: 7px;
        background: var(--mn-primary-soft);
        color: var(--mn-primary);
        font-size: 12px;
        font-family: monospace;
        font-weight: 700;
    }

    .mn-sort {
        font-weight: 600;
        color: var(--mn-text-2);
    }

    /* ── Badge ── */
    .mn-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 10px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
    }

        .mn-badge .dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
        }

    .mn-badge-active {
        background: var(--mn-success-soft);
        color: #166534;
    }

        .mn-badge-active .dot {
            background: var(--mn-success);
        }

    .mn-badge-inactive {
        background: #f1f5f9;
        color: #64748b;
    }

        .mn-badge-inactive .dot {
            background: #94a3b8;
        }

    /* ── Actions ── */
    .mn-actions {
        display: flex;
        align-items: center;
        gap: 6px;
        flex-wrap: wrap;
    }

    /* ── Loading / Empty ── */
    .mn-loading,
    .mn-empty {
        padding: 60px 24px;
        text-align: center;
        color: var(--mn-text-3);
        font-size: 14px;
    }

        .mn-empty h3 {
            font-size: 15px;
            color: var(--mn-text-2);
            margin-bottom: 6px;
        }

    /* ── Responsive ── */
    @@media (max-width: 768px) {

        .mn-topbar,
        .mn-hero,
        .mn-toolbar,
        .mn-content {
            padding-left: 16px;
            padding-right: 16px;
        }

        .mn-hero {
            flex-direction: column;
            align-items: flex-start;
        }

        .mn-card {
            overflow-x: auto;
        }

        .mn-table {
            min-width: 720px;
        }
    }
</style>

<div class="mn-root">

    <!-- Topbar -->
    <div class="mn-topbar">
        <nav class="mn-breadcrumb">
            <a href="/admin">Trang quản trị</a>
            <span class="mn-breadcrumb-sep">›</span>
            <span class="mn-breadcrumb-current">Menu</span>
        </nav>
    </div>

    <!-- Hero -->
    <div class="mn-hero">

        <div class="mn-hero-text">
            <h1>Quản lý menu</h1>
            <p>Quản lý menu website công khai.</p>
        </div>

    </div>

    <!-- Toolbar -->
    <div class="mn-toolbar">

        <button class="mn-btn mn-btn-primary"
                @onclick='@(() => Nav.NavigateTo("/admin/menus/edit"))'>

            <svg width="15"
                 height="15"
                 viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="2.5">

                <line x1="12" y1="5" x2="12" y2="19" />
                <line x1="5" y1="12" x2="19" y2="12" />

            </svg>

            Thêm mới

        </button>

    </div>

    <!-- Content -->
    <div class="mn-content">

        @if (items == null)
        {
            <div class="mn-loading">
                Đang tải dữ liệu...
            </div>
        }
        else if (!items.Any())
        {
            <div class="mn-card">
                <div class="mn-empty">
                    <h3>Chưa có menu</h3>
                    <p>Bắt đầu bằng cách tạo menu đầu tiên.</p>
                </div>
            </div>
        }
        else
        {
            <div class="mn-card">

                <table class="mn-table">

                    <thead>
                        <tr>
                            <th>Tên menu</th>
                            <th>URL</th>
                            <th>Thứ tự</th>
                            <th>Trạng thái</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in items)
                        {
                            <tr>

                                <td>
                                    <div class="mn-name">
                                        @item.MenuName
                                    </div>
                                </td>

                                <td>
                                    <span class="mn-url">
                                        @item.Url
                                    </span>
                                </td>

                                <td>
                                    <span class="mn-sort">
                                        #@item.SortOrder
                                    </span>
                                </td>

                                <td>

                                    @if (item.IsActive)
                                    {
                                        <span class="mn-badge mn-badge-active">
                                            <span class="dot"></span>
                                            Đang bật
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="mn-badge mn-badge-inactive">
                                            <span class="dot"></span>
                                            Đã tắt
                                        </span>
                                    }

                                </td>

                                <td>

                                    <div class="mn-actions">

                                        <button class="mn-btn mn-btn-ghost"
                                                @onclick='@(() => Nav.NavigateTo($"/admin/menus/edit/{item.Id}"))'>

                                            Sửa

                                        </button>

                                        <button class="mn-btn-danger"
                                                @onclick="() => DeleteAsync(item)">

                                            Xóa

                                        </button>

                                        <button class="mn-btn mn-btn-ghost"
                                                @onclick="() => ToggleActiveAsync(item)">

                                            @(item.IsActive ? "Tắt" : "Bật")

                                        </button>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>
@code {
    private List<AdminMenuItem>? items;

    protected override async Task OnInitializedAsync()
    {
        items = await AdminMenuService.GetMenusAsync(PN_PublicVariables.MaTruong);
    }

    private async Task DeleteAsync(AdminMenuItem item)
    {
        if (await JS.InvokeAsync<bool>("confirm", $"Xóa menu '{item.MenuName}'?"))
        {
            await AdminMenuService.DeleteMenuAsync(item.Id ?? string.Empty);
            items = await AdminMenuService.GetMenusAsync(PN_PublicVariables.MaTruong);
        }
    }

    private async Task ToggleActiveAsync(AdminMenuItem item)
    {
        if (await JS.InvokeAsync<bool>("confirm", $"Bạn có muốn {(item.IsActive ? "tắt" : "bật")} menu '{item.MenuName}'?"))
        {
            await AdminMenuService.SetActiveAsync(item.Id ?? string.Empty, !item.IsActive);
            items = await AdminMenuService.GetMenusAsync(PN_PublicVariables.MaTruong);
        }
    }
}
