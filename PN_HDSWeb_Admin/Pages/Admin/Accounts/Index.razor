@page  "/admin/accounts"
@attribute [Authorize(Roles = "Administrator")]
@using PN_HDSWeb_Admin.Services.Admin
@using PN_HDSWeb_Admin.Data.Model
@inject IAdminAccountService AdminAccountService
@inject NavigationManager Nav

<h1>Quản lý tài khoản</h1>

<div>
    <input @bind="keyword" placeholder="Tìm kiếm" />
    <button @onclick="SearchAsync">Tìm</button>
    <button @onclick="ResetAsync">Xóa lọc</button>
    <button @onclick='@(() => Nav.NavigateTo("/admin/accounts/edit"))'>Thêm mới</button>
</div>

@if (accounts == null)
{
    <p>Đang tải...</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th>Tài khoản</th>
                <th>Họ tên</th>
                <th>Vai trò</th>
                <th>Trạng thái</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in accounts)
            {
                <tr>
                    <td>@item.UserName</td>
                    <td>@item.FullName</td>
                    <td>@item.Roles</td>
                    <td>@(item.IsLocked ? "Đã khóa" : item.IsActive ? "Hoạt động" : "Ngưng")</td>
                    <td>
                        <button @onclick="@(() => Nav.NavigateTo($"/admin/accounts/edit/{item.Id}"))">Sửa</button>
                        <button @onclick="() => ToggleLockAsync(item)">@(item.IsLocked ? "Mở khóa" : "Khóa")</button>
                        <button @onclick="() => ToggleActiveAsync(item)">@(item.IsActive ? "Tắt" : "Bật")</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div>
        <button @onclick="PrevtrangAsync" disabled="@(trang <= 1)">Trang trước</button>
        <span>Trang @trang / @totaltrangs</span>
        <button @onclick="NexttrangAsync" disabled="@(trang >= totaltrangs)">Trang sau</button>
    </div>
}

@code {
    private List<AdminAccountListItemDto>? accounts;
    private string? keyword;
    private int trang = 1;
    private int trangSize = 20;
    private int totalCount;
    private int totaltrangs => Math.Max(1, (int)Math.Ceiling(totalCount / (double)trangSize));

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        totalCount = await AdminAccountService.GetAccountsCountAsync(PN_PublicVariables.MaTruong, keyword);
        accounts = await AdminAccountService.GetAccountsAsync(PN_PublicVariables.MaTruong, keyword, null, null, trang, trangSize);
    }

    private async Task SearchAsync()
    {
        trang = 1;
        await LoadAsync();
    }

    private async Task ResetAsync()
    {
        keyword = string.Empty;
        trang = 1;
        await LoadAsync();
    }

    private async Task PrevtrangAsync()
    {
        if (trang > 1)
        {
            trang--;
            await LoadAsync();
        }
    }

    private async Task NexttrangAsync()
    {
        if (trang < totaltrangs)
        {
            trang++;
            await LoadAsync();
        }
    }

    private async Task ToggleLockAsync(AdminAccountListItemDto item)
    {
        await AdminAccountService.SetLockedAsync(item.Id ?? string.Empty, !item.IsLocked, item.LockReason);
        await LoadAsync();
    }

    private async Task ToggleActiveAsync(AdminAccountListItemDto item)
    {
        await AdminAccountService.SetActiveAsync(item.Id ?? string.Empty, !item.IsActive);
        await LoadAsync();
    }
}
