@page  "/admin/accounts"
@attribute [Authorize(Roles = "Administrator")]
@using PN_HDSWeb_Admin.Services.Admin
@using PN_HDSWeb_Admin.Data.Model
@inject IAdminAccountService AdminAccountService
@inject NavigationManager Nav

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700&family=Instrument+Serif:ital@0;1&display=swap');

    :root {
        --ac-bg: #f4f6fb;
        --ac-surface: #ffffff;
        --ac-surface-2: #f8fafd;
        --ac-border: #e4e9f2;
        --ac-primary: #3b6ef6;
        --ac-primary-hover: #2554e0;
        --ac-primary-soft: #eef2fe;
        --ac-text: #0f1b35;
        --ac-text-2: #5a6a8a;
        --ac-text-3: #94a3b8;
        --ac-success: #22c55e;
        --ac-success-soft: #f0fdf4;
        --ac-danger: #ef4444;
        --ac-danger-soft: #fff5f5;
        --ac-warning: #f59e0b;
        --ac-warning-soft: #fffbeb;
        --ac-radius: 16px;
        --ac-radius-sm: 10px;
        --ac-shadow: 0 4px 24px rgba(15,27,53,.07);
        --ac-transition: .2s cubic-bezier(.4,0,.2,1);
    }

    .ac-root * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    .ac-root {
        min-height: 100vh;
        background: var(--ac-bg);
        font-family: 'Be Vietnam Pro', sans-serif;
        color: var(--ac-text);
    }

    /* ── Hero ── */

    .ac-hero {
        padding: 28px 32px 0;
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 16px;
        flex-wrap: wrap;
    }

    .ac-hero-text h1 {
        font-family: 'Instrument Serif', serif;
        font-size: 30px;
        font-weight: 400;
        line-height: 1.2;
        letter-spacing: -.3px;
        color: var(--ac-text);
    }

    .ac-hero-text p {
        margin-top: 6px;
        font-size: 13.5px;
        color: var(--ac-text-2);
    }

    /* ── Toolbar ── */

    .ac-toolbar {
        padding: 20px 32px 0;
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }

    .ac-search-wrap {
        position: relative;
        flex: 1;
        min-width: 220px;
        max-width: 340px;
    }

    .ac-search-icon {
        position: absolute;
        left: 12px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--ac-text-3);
        pointer-events: none;
        display: flex;
        align-items: center;
    }

    .ac-input {
        width: 100%;
        padding: 10px 14px 10px 38px;
        border-radius: var(--ac-radius-sm);
        border: 1.5px solid var(--ac-border);
        background: var(--ac-surface);
        font-family: inherit;
        font-size: 13.5px;
        color: var(--ac-text);
        outline: none;
        transition: all var(--ac-transition);
    }

        .ac-input:focus {
            border-color: var(--ac-primary);
            box-shadow: 0 0 0 3px rgba(59,110,246,.12);
        }

        .ac-input::placeholder {
            color: var(--ac-text-3);
        }

    .ac-spacer {
        flex: 1;
    }

    /* ── Buttons ── */

    .ac-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        padding: 10px 18px;
        border-radius: var(--ac-radius-sm);
        border: 1.5px solid transparent;
        font-family: inherit;
        font-size: 13.5px;
        font-weight: 600;
        cursor: pointer;
        transition: all var(--ac-transition);
        white-space: nowrap;
    }

    .ac-btn-primary {
        background: var(--ac-primary);
        border-color: var(--ac-primary);
        color: white;
        box-shadow: 0 2px 12px rgba(59,110,246,.25);
    }

        .ac-btn-primary:hover {
            background: var(--ac-primary-hover);
            border-color: var(--ac-primary-hover);
            transform: translateY(-1px);
        }

    .ac-btn-ghost {
        background: var(--ac-surface);
        border-color: var(--ac-border);
        color: var(--ac-text-2);
    }

        .ac-btn-ghost:hover {
            border-color: var(--ac-primary);
            background: var(--ac-primary-soft);
            color: var(--ac-primary);
        }

    .ac-btn-danger {
        background: none;
        border: none;
        color: var(--ac-danger);
        padding: 8px 10px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        transition: background var(--ac-transition);
    }

        .ac-btn-danger:hover {
            background: var(--ac-danger-soft);
        }

    /* ── Content ── */

    .ac-content {
        padding: 20px 32px 40px;
    }

    .ac-card {
        background: var(--ac-surface);
        border: 1px solid var(--ac-border);
        border-radius: var(--ac-radius);
        box-shadow: var(--ac-shadow);
        overflow: hidden;
        animation: acFade .35s ease;
    }

    @@keyframes acFade {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* ── Table ── */

    .ac-table {
        width: 100%;
        border-collapse: collapse;
    }

        .ac-table thead tr {
            background: var(--ac-surface-2);
            border-bottom: 1px solid var(--ac-border);
        }

        .ac-table th {
            padding: 12px 16px;
            text-align: left;
            font-size: 11.5px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .5px;
            color: var(--ac-text-3);
            white-space: nowrap;
        }

        .ac-table td {
            padding: 15px 16px;
            border-bottom: 1px solid var(--ac-border);
            font-size: 13.5px;
            vertical-align: middle;
        }

        .ac-table tbody tr:last-child td {
            border-bottom: none;
        }

        .ac-table tbody tr {
            transition: background var(--ac-transition);
        }

            .ac-table tbody tr:hover {
                background: var(--ac-surface-2);
            }

    /* ── User ── */

    .ac-user {
        display: flex;
        flex-direction: column;
        gap: 3px;
    }

    .ac-username {
        font-weight: 700;
        color: var(--ac-text);
    }

    .ac-fullname {
        font-size: 12px;
        color: var(--ac-text-2);
    }

    .ac-role {
        display: inline-flex;
        align-items: center;
        padding: 5px 10px;
        border-radius: 999px;
        background: var(--ac-primary-soft);
        color: var(--ac-primary);
        font-size: 12px;
        font-weight: 600;
    }

    /* ── Status ── */

    .ac-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 10px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
    }

        .ac-badge .dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
        }

    .ac-badge-active {
        background: var(--ac-success-soft);
        color: #166534;
    }

        .ac-badge-active .dot {
            background: var(--ac-success);
        }

    .ac-badge-locked {
        background: var(--ac-danger-soft);
        color: var(--ac-danger);
    }

        .ac-badge-locked .dot {
            background: var(--ac-danger);
        }

    .ac-badge-inactive {
        background: var(--ac-warning-soft);
        color: #92400e;
    }

        .ac-badge-inactive .dot {
            background: var(--ac-warning);
        }

    /* ── Actions ── */

    .ac-actions {
        display: flex;
        align-items: center;
        gap: 6px;
        flex-wrap: wrap;
    }

    /* ── Pagination ── */

    .ac-pagination {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 14px 18px;
        border-top: 1px solid var(--ac-border);
        background: var(--ac-surface-2);
        flex-wrap: wrap;
        gap: 12px;
    }

    .ac-pagination-info {
        font-size: 13px;
        color: var(--ac-text-2);
    }

        .ac-pagination-info strong {
            color: var(--ac-text);
        }

    .ac-pages {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .ac-page-btn {
        min-width: 34px;
        height: 34px;
        border-radius: 8px;
        border: 1.5px solid var(--ac-border);
        background: var(--ac-surface);
        font-size: 13px;
        font-weight: 600;
        color: var(--ac-text-2);
        cursor: pointer;
        transition: all var(--ac-transition);
        padding: 0 12px;
    }

        .ac-page-btn:hover:not(:disabled) {
            border-color: var(--ac-primary);
            background: var(--ac-primary-soft);
            color: var(--ac-primary);
        }

        .ac-page-btn:disabled {
            opacity: .45;
            cursor: not-allowed;
        }

    /* ── Loading ── */

    .ac-loading {
        padding: 70px 24px;
        text-align: center;
        color: var(--ac-text-3);
        font-size: 14px;
    }

    /* ── Responsive ── */

    @@media (max-width: 768px) {

        .ac-hero,
        .ac-toolbar,
        .ac-content {
            padding-left: 16px;
            padding-right: 16px;
        }

        .ac-card {
            overflow-x: auto;
        }

        .ac-table {
            min-width: 760px;
        }

        .ac-hero {
            flex-direction: column;
            align-items: flex-start;
        }
    }
</style>

<div class="ac-root">

    <!-- Hero -->
    <div class="ac-hero">

        <div class="ac-hero-text">
            <h1>Quản lý tài khoản</h1>
            <p>Quản lý người dùng và quyền truy cập hệ thống quản trị.</p>
        </div>

    </div>

    <!-- Toolbar -->
    <div class="ac-toolbar">

        <div class="ac-search-wrap">

            <span class="ac-search-icon">
                <svg width="15"
                     height="15"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2.5">

                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>

                </svg>
            </span>

            <input class="ac-input"
                   @bind="keyword"
                   placeholder="Tìm tài khoản, họ tên..." />

        </div>

        <button class="ac-btn ac-btn-primary"
                @onclick="SearchAsync">

            Tìm kiếm

        </button>

        <button class="ac-btn ac-btn-ghost"
                @onclick="ResetAsync">

            Xóa lọc

        </button>

        <div class="ac-spacer"></div>

        <button class="ac-btn ac-btn-primary"
                @onclick='@(() => Nav.NavigateTo("/admin/accounts/edit"))'>

            <svg width="15"
                 height="15"
                 viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="2.5">

                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>

            </svg>

            Thêm mới

        </button>

    </div>

    <!-- Content -->
    <div class="ac-content">

        @if (accounts == null)
        {
            <div class="ac-loading">
                Đang tải dữ liệu...
            </div>
        }
        else
        {
            <div class="ac-card">

                <table class="ac-table">

                    <thead>
                        <tr>
                            <th>Tài khoản</th>
                            <th>Họ tên</th>
                            <th>Vai trò</th>
                            <th>Trạng thái</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in accounts)
                        {
                            <tr>

                                <td>

                                    <div class="ac-user">

                                        <span class="ac-username">
                                            @item.UserName
                                        </span>

                                    </div>

                                </td>

                                <td>

                                    <span class="ac-fullname">
                                        @item.FullName
                                    </span>

                                </td>

                                <td>

                                    <span class="ac-role">
                                        @item.Roles
                                    </span>

                                </td>

                                <td>

                                    @if (item.IsLocked)
                                    {
                                        <span class="ac-badge ac-badge-locked">
                                            <span class="dot"></span>
                                            Đã khóa
                                        </span>
                                    }
                                    else if (item.IsActive)
                                    {
                                        <span class="ac-badge ac-badge-active">
                                            <span class="dot"></span>
                                            Hoạt động
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="ac-badge ac-badge-inactive">
                                            <span class="dot"></span>
                                            Ngưng
                                        </span>
                                    }

                                </td>

                                <td>

                                    <div class="ac-actions">

                                        <button class="ac-btn ac-btn-ghost"
                                                @onclick="@(() => Nav.NavigateTo($"/admin/accounts/edit/{item.Id}"))">

                                            Sửa

                                        </button>

                                        <button class="ac-btn-danger"
                                                @onclick="() => ToggleLockAsync(item)">

                                            @(item.IsLocked ? "Mở khóa" : "Khóa")

                                        </button>

                                        <button class="ac-btn ac-btn-ghost"
                                                @onclick="() => ToggleActiveAsync(item)">

                                            @(item.IsActive ? "Tắt" : "Bật")

                                        </button>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

                <!-- Pagination -->
                <div class="ac-pagination">

                    <div class="ac-pagination-info">

                        Tổng cộng
                        <strong>@totalCount</strong>
                        tài khoản

                    </div>

                    <div class="ac-pages">

                        <button class="ac-page-btn"
                                @onclick="PrevtrangAsync"
                                disabled="@(trang <= 1)">

                            ← Trước

                        </button>

                        <button class="ac-page-btn" disabled>

                            Trang @trang / @totaltrangs

                        </button>

                        <button class="ac-page-btn"
                                @onclick="NexttrangAsync"
                                disabled="@(trang >= totaltrangs)">

                            Sau →

                        </button>

                    </div>

                </div>

            </div>
        }

    </div>

</div>
@code {
    private List<AdminAccountListItemDto>? accounts;
    private string? keyword;
    private int trang = 1;
    private int trangSize = 20;
    private int totalCount;
    private int totaltrangs => Math.Max(1, (int)Math.Ceiling(totalCount / (double)trangSize));

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        totalCount = await AdminAccountService.GetAccountsCountAsync(PN_PublicVariables.MaTruong, keyword);
        accounts = await AdminAccountService.GetAccountsAsync(PN_PublicVariables.MaTruong, keyword, null, null, trang, trangSize);
    }

    private async Task SearchAsync()
    {
        trang = 1;
        await LoadAsync();
    }

    private async Task ResetAsync()
    {
        keyword = string.Empty;
        trang = 1;
        await LoadAsync();
    }

    private async Task PrevtrangAsync()
    {
        if (trang > 1)
        {
            trang--;
            await LoadAsync();
        }
    }

    private async Task NexttrangAsync()
    {
        if (trang < totaltrangs)
        {
            trang++;
            await LoadAsync();
        }
    }

    private async Task ToggleLockAsync(AdminAccountListItemDto item)
    {
        await AdminAccountService.SetLockedAsync(item.Id ?? string.Empty, !item.IsLocked, item.LockReason);
        await LoadAsync();
    }

    private async Task ToggleActiveAsync(AdminAccountListItemDto item)
    {
        await AdminAccountService.SetActiveAsync(item.Id ?? string.Empty, !item.IsActive);
        await LoadAsync();
    }
}
