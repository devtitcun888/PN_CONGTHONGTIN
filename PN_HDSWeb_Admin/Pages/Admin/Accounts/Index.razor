@page  "/admin/accounts"
@attribute [Authorize(Roles = "Administrator")]
@using PN_HDSWeb_Admin.Services.Admin
@using PN_HDSWeb_Admin.Data.Model
@inject IAdminAccountService AdminAccountService
@inject NavigationManager Nav


<HeadContent>
<style>/* Accounts/Index - page specific only */</style>
</HeadContent>
<div class="ac-root">

    <!-- Hero -->
    <div class="ac-hero">

        <div class="ac-hero-text">
            <h1>Quản lý tài khoản</h1>
            <p>Quản lý người dùng và quyền truy cập hệ thống quản trị.</p>
        </div>

    </div>

    <!-- Toolbar -->
    <div class="ac-toolbar">

        <div class="ac-search-wrap">

            <span class="ac-search-icon">
                <svg width="15"
                     height="15"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2.5">

                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>

                </svg>
            </span>

            <input class="ac-input"
                   @bind="keyword"
                   placeholder="Tìm tài khoản, họ tên..." />

        </div>

        <button class="ac-btn ac-btn-primary"
                @onclick="SearchAsync">

            Tìm kiếm

        </button>

        <button class="ac-btn ac-btn-ghost"
                @onclick="ResetAsync">

            Xóa lọc

        </button>

        <div class="ac-spacer"></div>

        <button class="ac-btn ac-btn-primary"
                @onclick='@(() => Nav.NavigateTo("/admin/accounts/edit"))'>

            <svg width="15"
                 height="15"
                 viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="2.5">

                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>

            </svg>

            Thêm mới

        </button>

    </div>

    <!-- Content -->
    <div class="ac-content">

        @if (accounts == null)
        {
            <div class="ac-loading">
                Đang tải dữ liệu...
            </div>
        }
        else
        {
            <div class="ac-card">

                <table class="ac-table">

                    <thead>
                        <tr>
                            <th>Tài khoản</th>
                            <th>Họ tên</th>
                            <th>Vai trò</th>
                            <th>Trạng thái</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in accounts)
                        {
                            <tr>

                                <td>

                                    <div class="ac-user">

                                        <span class="ac-username">
                                            @item.UserName
                                        </span>

                                    </div>

                                </td>

                                <td>

                                    <span class="ac-fullname">
                                        @item.FullName
                                    </span>

                                </td>

                                <td>

                                    <span class="ac-role">
                                        @item.Roles
                                    </span>

                                </td>

                                <td>

                                    @if (item.IsLocked)
                                    {
                                        <span class="ac-badge ac-badge-locked">
                                            <span class="dot"></span>
                                            Đã khóa
                                        </span>
                                    }
                                    else if (item.IsActive)
                                    {
                                        <span class="ac-badge ac-badge-active">
                                            <span class="dot"></span>
                                            Hoạt động
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="ac-badge ac-badge-inactive">
                                            <span class="dot"></span>
                                            Ngưng
                                        </span>
                                    }

                                </td>

                                <td>

                                    <div class="ac-actions">

                                        <button class="ac-btn ac-btn-ghost"
                                                @onclick="@(() => Nav.NavigateTo($"/admin/accounts/edit/{item.Id}"))">

                                            Sửa

                                        </button>

                                        <button class="ac-btn-danger"
                                                @onclick="() => ToggleLockAsync(item)">

                                            @(item.IsLocked ? "Mở khóa" : "Khóa")

                                        </button>

                                        <button class="ac-btn ac-btn-ghost"
                                                @onclick="() => ToggleActiveAsync(item)">

                                            @(item.IsActive ? "Tắt" : "Bật")

                                        </button>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

                <!-- Pagination -->
                <div class="ac-pagination">

                    <div class="ac-pagination-info">

                        Tổng cộng
                        <strong>@totalCount</strong>
                        tài khoản

                    </div>

                    <div class="ac-pages">

                        <button class="ac-page-btn"
                                @onclick="PrevtrangAsync"
                                disabled="@(trang <= 1)">

                            ← Trước

                        </button>

                        <button class="ac-page-btn" disabled>

                            Trang @trang / @totaltrangs

                        </button>

                        <button class="ac-page-btn"
                                @onclick="NexttrangAsync"
                                disabled="@(trang >= totaltrangs)">

                            Sau →

                        </button>

                    </div>

                </div>

            </div>
        }

    </div>

</div>
@code {
    private List<AdminAccountListItemDto>? accounts;
    private string? keyword;
    private int trang = 1;
    private int trangSize = 20;
    private int totalCount;
    private int totaltrangs => Math.Max(1, (int)Math.Ceiling(totalCount / (double)trangSize));

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        totalCount = await AdminAccountService.GetAccountsCountAsync(PN_PublicVariables.MaTruong, keyword);
        accounts = await AdminAccountService.GetAccountsAsync(PN_PublicVariables.MaTruong, keyword, null, null, trang, trangSize);
    }

    private async Task SearchAsync()
    {
        trang = 1;
        await LoadAsync();
    }

    private async Task ResetAsync()
    {
        keyword = string.Empty;
        trang = 1;
        await LoadAsync();
    }

    private async Task PrevtrangAsync()
    {
        if (trang > 1)
        {
            trang--;
            await LoadAsync();
        }
    }

    private async Task NexttrangAsync()
    {
        if (trang < totaltrangs)
        {
            trang++;
            await LoadAsync();
        }
    }

    private async Task ToggleLockAsync(AdminAccountListItemDto item)
    {
        await AdminAccountService.SetLockedAsync(item.Id ?? string.Empty, !item.IsLocked, item.LockReason);
        await LoadAsync();
    }

    private async Task ToggleActiveAsync(AdminAccountListItemDto item)
    {
        await AdminAccountService.SetActiveAsync(item.Id ?? string.Empty, !item.IsActive);
        await LoadAsync();
    }
}

