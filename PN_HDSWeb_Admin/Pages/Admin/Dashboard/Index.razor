@page "/dashboard"
@using PN_HDSWeb_Admin.Services.Admin
@inject IAdminDashboardService DashboardService
@inject NavigationManager Nav

<HeadContent>
<style>/* Dashboard — page-specific only */</style>
</HeadContent>
<PageTitle>Dashboard — EV Rental Admin</PageTitle>

<div class="ev-admin-page">
    <div class="ev-admin-header">
        <h1>📊 Dashboard</h1>
        <div class="ev-admin-date">@DateTime.Now.ToString("dddd, dd/MM/yyyy", new System.Globalization.CultureInfo("vi-VN"))</div>
    </div>

    @if (loading)
    {
        <div class="ev-loading"><div class="ev-spinner"></div><span>Đang tải...</span></div>
    }
    else
    {
        <!-- KPI Cards -->
        <div class="ev-kpi-grid">
            <!-- Xe -->
            <div class="ev-kpi-card ev-kpi-card--blue">
                <div class="ev-kpi-icon">🚗</div>
                <div class="ev-kpi-body">
                    <div class="ev-kpi-label">Tổng xe</div>
                    <div class="ev-kpi-value">@summary.TotalVehicles</div>
                    <div class="ev-kpi-sub">
                        <span class="ev-dot ev-dot--green"></span> @summary.XeTrong sẵn sàng &nbsp;
                        <span class="ev-dot ev-dot--yellow"></span> @summary.XeDangThue đang thuê &nbsp;
                        <span class="ev-dot ev-dot--gray"></span> @summary.XeBaoDuong bảo dưỡng
                    </div>
                </div>
            </div>

            <!-- Đơn hôm nay -->
            <div class="ev-kpi-card ev-kpi-card--green">
                <div class="ev-kpi-icon">📋</div>
                <div class="ev-kpi-body">
                    <div class="ev-kpi-label">Đơn hôm nay</div>
                    <div class="ev-kpi-value">@summary.DonHomNay</div>
                    <div class="ev-kpi-sub">Hoàn thành: @summary.HoanThanhHomNay</div>
                </div>
            </div>

            <!-- Chờ xử lý -->
            <div class="ev-kpi-card @(summary.DonCho > 0 ? "ev-kpi-card--orange" : "ev-kpi-card--gray")">
                <div class="ev-kpi-icon">⏳</div>
                <div class="ev-kpi-body">
                    <div class="ev-kpi-label">Chờ xử lý</div>
                    <div class="ev-kpi-value">@summary.DonCho</div>
                    <div class="ev-kpi-sub">Đã xác nhận: @summary.DonDaXacNhan</div>
                </div>
                @if (summary.DonCho > 0)
                {
                    <button class="ev-kpi-action" @onclick='() => Nav.NavigateTo("/admin/rentals?trang_thai=pending")'>
                        Xử lý →
                    </button>
                }
            </div>

            <!-- Doanh thu tháng -->
            <div class="ev-kpi-card ev-kpi-card--purple">
                <div class="ev-kpi-icon">💰</div>
                <div class="ev-kpi-body">
                    <div class="ev-kpi-label">Doanh thu tháng</div>
                    <div class="ev-kpi-value">@FormatVnd(summary.DoanhThuThang)</div>
                    <div class="ev-kpi-sub">Hôm nay: @FormatVnd(summary.DoanhThuHomNay)</div>
                </div>
            </div>

            <!-- Khách hàng -->
            <div class="ev-kpi-card ev-kpi-card--teal">
                <div class="ev-kpi-icon">👥</div>
                <div class="ev-kpi-body">
                    <div class="ev-kpi-label">Khách hàng</div>
                    <div class="ev-kpi-value">@summary.TotalCustomers</div>
                    <div class="ev-kpi-sub">Đã đăng ký</div>
                </div>
            </div>

            <!-- Đang thuê -->
            <div class="ev-kpi-card ev-kpi-card--cyan">
                <div class="ev-kpi-icon">🔑</div>
                <div class="ev-kpi-body">
                    <div class="ev-kpi-label">Đang thuê</div>
                    <div class="ev-kpi-value">@summary.DonDangThue</div>
                    <div class="ev-kpi-sub">Đơn đang active</div>
                </div>
            </div>
        </div>

        <!-- Quick Actions -->
        <div class="ev-quick-actions">
            <h2>⚡ Thao tác nhanh</h2>
            <div class="ev-quick-grid">
                <button class="ev-quick-btn" @onclick='() => Nav.NavigateTo("/admin/vehicles/create")'>
                    <span>🚗</span> Thêm xe mới
                </button>
                <button class="ev-quick-btn" @onclick='() => Nav.NavigateTo("/admin/rentals?trang_thai=pending")'>
                    <span>✅</span> Duyệt đơn chờ (@summary.DonCho)
                </button>
                <button class="ev-quick-btn" @onclick='() => Nav.NavigateTo("/admin/rentals?trang_thai=active")'>
                    <span>🔑</span> Đang cho thuê (@summary.DonDangThue)
                </button>
                <button class="ev-quick-btn" @onclick='() => Nav.NavigateTo("/admin/vehicles")'>
                    <span>📋</span> Quản lý xe
                </button>
            </div>
        </div>

        <!-- Đơn gần đây -->
        <div class="ev-recent-section">
            <div class="ev-section-header">
                <h2>🕐 Đơn thuê gần nhất</h2>
                <a href="/admin/rentals" class="ev-link-more">Xem tất cả →</a>
            </div>

            @if (recentRentals.Count == 0)
            {
                <div class="ev-empty"><p>Chưa có đơn nào.</p></div>
            }
            else
            {
                <div class="ev-table-wrap">
                    <table class="ev-table">
                        <thead>
                            <tr>
                                <th>Mã đơn</th>
                                <th>Xe</th>
                                <th>Khách hàng</th>
                                <th>Tổng tiền</th>
                                <th>Trạng thái</th>
                                <th>Thời gian đặt</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in recentRentals)
                            {
                                <tr>
                                    <td><strong>@r.MaDon</strong></td>
                                    <td>@r.TenXe</td>
                                    <td>@r.KhachTen<br /><small>@r.KhachSdt</small></td>
                                    <td>@FormatVnd(r.TongTien)</td>
                                    <td><span class="ev-badge ev-badge--@r.TrangThai">@r.TrangThaiLabel</span></td>
                                    <td>@r.CreatedAt.ToString("dd/MM HH:mm")</td>
                                    <td>
                                        <a href="/admin/rentals/@r.Id" class="ev-btn ev-btn--sm ev-btn--ghost">Chi tiết</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
</div>

@code {
    private EvDashboardSummary summary = new();
    private List<EvRecentRentalItem> recentRentals = [];
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        var summaryTask = DashboardService.GetSummaryAsync();
        var recentTask = DashboardService.GetRecentRentalsAsync(10);

        await Task.WhenAll(summaryTask, recentTask);

        summary = await summaryTask;
        recentRentals = await recentTask;
        loading = false;
    }

    private static string FormatVnd(decimal val) => val.ToString("N0").Replace(",", ".") + "đ";
}
