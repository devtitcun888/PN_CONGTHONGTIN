@page "/admin/documents"
@attribute [Authorize(Roles = "Administrator")]
@using PN_HDSWeb_Admin.Services.Content
@inject IAdminDocumentService AdminDocumentService
@inject IAdminDocumentTypeService AdminDocumentTypeService
@inject NavigationManager Nav
@inject IJSRuntime JS
<div class="dl-root">
    <!-- Breadcrumb -->
    <div class="dl-topbar">
        <nav class="dl-breadcrumb">
            <a href="/admin">Trang quản trị</a>
            <span class="dl-breadcrumb-sep">›</span>
            <span class="dl-breadcrumb-current">Văn bản</span>
        </nav>
    </div>

    <!-- Hero -->
    <div class="dl-hero">
        <div class="dl-hero-text">
            <h1>Quản lý văn bản công khai</h1>
            <p>Quản lý các văn bản công khai của trường.</p>
        </div>
        <button class="dl-btn dl-btn-primary" @onclick='@(() => Nav.NavigateTo("/admin/documents/edit"))'>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
            Thêm văn bản mới
        </button>
    </div>

    <!-- Stats -->
    @if (documents != null)
    {
        <div class="dl-stats">
            <div class="dl-stat">
                <div class="dl-stat-dot status-dot-neutral"></div>
                <div class="dl-stat-info">
                    <span class="dl-stat-value">@totalCount</span>
                    <span class="dl-stat-label">Tổng văn bản</span>
                </div>
            </div>
            @foreach (var s in statusStats)
            {
                <div class="dl-stat">
                    <div class="dl-stat-dot @s.DotClass"></div>
                    <div class="dl-stat-info">
                        <span class="dl-stat-value">@s.Count</span>
                        <span class="dl-stat-label">@s.Label</span>
                    </div>
                </div>
            }
        </div>
    }

    <!-- Toolbar -->
    <div class="dl-toolbar">
        <!-- Tìm kiếm -->
        <div class="dl-search-wrap">
            <span class="dl-search-icon">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
            </span>
            <input class="dl-input" @bind="keyword" @bind:event="oninput"
                   @onkeydown="OnKeyDown"
                   placeholder="Tìm theo tiêu đề..." />
        </div>

        <!-- Lọc trạng thái -->
        <div class="dl-status-filter">
            @foreach (var tab in statusTabs)
            {
                <button class="dl-status-tab @(status == tab.Value ? "active" : "")"
                        type="button" @onclick="() => SetStatusFilter(tab.Value)">
                    @if (!string.IsNullOrEmpty(tab.DotClass))
                    {
                        <span class="dot @tab.DotClass"></span>
                    }
                    @tab.Label
                </button>
            }
        </div>

        <!-- Lọc loại văn bản -->
        <select class="dl-select" @bind="documentTypeId" @bind:event="onchange">
            <option value="">Tất cả loại</option>
            @foreach (var type in documentTypes)
            {
                <option value="@type.Id">@type.TypeName</option>
            }
        </select>

        <div class="dl-spacer"></div>

        <button class="dl-btn dl-btn-ghost" type="button" @onclick="ResetAsync">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="1 4 1 10 7 10" /><path d="M3.51 15a9 9 0 1 0 .49-3.51" /></svg>
            Đặt lại
        </button>
    </div>

    <!-- Nội dung -->
    <div class="dl-content">
        @if (documents == null)
        {
            <div class="dl-loading">
                <div class="dl-spinner"></div>
                <span>Đang tải dữ liệu...</span>
            </div>
        }
        else
        {
            <div class="dl-card">
                @if (documents.Count == 0)
                {
                    <div class="dl-empty">
                        <div class="dl-empty-icon">
                            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /></svg>
                        </div>
                        <h3>Không có văn bản nào</h3>
                        <p>@(string.IsNullOrWhiteSpace(keyword) && string.IsNullOrWhiteSpace(status) && string.IsNullOrWhiteSpace(documentTypeId) ? "Bắt đầu bằng cách thêm văn bản đầu tiên." : "Thử thay đổi bộ lọc hoặc từ khóa tìm kiếm.")</p>
                    </div>
                }
                else
                {
                    <table class="dl-table">
                        <thead>
                            <tr>
                                <th class="u-table-title-35">Tiêu đề</th>
                                <th>Số hiệu</th>
                                <th>Loại văn bản</th>
                                <th>Trạng thái</th>
                                <th>Ngày tạo</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in documents)
                            {
                                <tr>
                                    <td class="dl-title-cell">
                                        <div class="dl-title-main">@item.DocTitle</div>
                                        @if (!string.IsNullOrWhiteSpace(item.DocNumber))
                                        {
                                            <div class="dl-title-meta">@item.DocNumber</div>
                                        }
                                    </td>
                                    <td>@item.DocNumber</td>
                                    <td>@item.DocumentTypeName</td>
                                    <td>
                                        <span class="dl-badge @GetBadgeClass(item.Status)">
                                            <span class="dot"></span>
                                            @GetStatusLabel(item.Status)
                                        </span>
                                    </td>
                                    <td>
                                        <div class="dl-date">@FormatDate(item.CreatedAt)</div>
                                        <div class="dl-date-relative">@FormatRelative(item.CreatedAt)</div>
                                    </td>
                                    <td>
                                        <div class="dl-actions">
                                            <button class="dl-btn-icon"
                                                    title="Chỉnh sửa"
                                                    @onclick="@(() => Nav.NavigateTo($"/admin/documents/edit/{item.Id}"))">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" /><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" /></svg>
                                                Sửa
                                            </button>
                                            <button class="dl-btn-danger-ghost"
                                                    title="Xóa văn bản"
                                                    @onclick="@(() => DeleteAsync(item))">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="3 6 5 6 21 6" /><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" /><path d="M10 11v6M14 11v6" /><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2" /></svg>
                                                Xóa
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <!-- Phân trang -->
                    <div class="dl-pagination">
                        <div class="dl-pagination-info">
                            Hiển thị <strong>@((trang - 1) * pageSize + 1)–@Math.Min(trang * pageSize, totalCount)</strong>
                            trong tổng số <strong>@totalCount</strong> văn bản
                        </div>
                        <div class="dl-pages">
                            <button class="dl-page-btn" @onclick="PrevPageAsync" disabled="@(trang <= 1)">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6" /></svg>
                            </button>

                            @foreach (var p in GetPageNumbers())
                            {
                                @if (p == -1)
                                {
                                    <span class="dl-page-ellipsis">…</span>
                                }
                                else
                                {
                                    <button class="dl-page-btn @(p == trang ? "active" : "")"
                                            @onclick="() => GoToPage(p)">
                                        @p
                                    </button>
                                }
                            }

                            <button class="dl-page-btn" @onclick="NextPageAsync" disabled="@(trang >= totalPages)">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6" /></svg>
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    private List<AdminDocumentItem>? documents;
    private List<AdminDocumentTypeItem>? documentTypes;
    private string? keyword;
    private string? status;
    private string? documentTypeId;
    private int trang = 1;
    private int pageSize = 20;
    private int totalCount;
    private int totalPages => Math.Max(1, (int)Math.Ceiling(totalCount / (double)pageSize));

    // Định nghĩa tab trạng thái
    private record StatusTab(string Label, string Value, string DotClass);
    private readonly List<StatusTab> statusTabs = new()
    {
        new("Tất cả",    "",          ""),
        new("Nháp",      "Draft",     "status-dot-draft"),
        new("Chờ duyệt", "Pending",   "status-dot-pending"),
        new("Đã duyệt",  "Approved",  "status-dot-approved"),
        new("Đã công khai", "Published", "status-dot-published"),
        new("Từ chối",   "Rejected",  "status-dot-rejected"),
    };

    // Thống kê
    private record StatItem(string Label, string DotClass, int Count);
    private List<StatItem> statusStats = new();

    protected override async Task OnInitializedAsync()
    {
        documentTypes = await AdminDocumentTypeService.GetDocumentTypesAsync(PN_PublicVariables.MaTruong);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        totalCount = await AdminDocumentService.GetDocumentsCountAsync(PN_PublicVariables.MaTruong, keyword, status, documentTypeId);
        documents = await AdminDocumentService.GetDocumentsAsync(PN_PublicVariables.MaTruong, keyword, status, documentTypeId, trang, pageSize);
        await LoadStatsAsync();
    }

    private async Task LoadStatsAsync()
    {
        // Chỉ tải thống kê khi không có filter để hiển thị tổng quan
        if (!string.IsNullOrWhiteSpace(status) || !string.IsNullOrWhiteSpace(documentTypeId))
            return;

        var statDefs = new[] {
            ("Draft",     "Nháp",      "status-dot-draft"),
            ("Pending",   "Chờ duyệt", "status-dot-pending"),
            ("Published", "Đã công khai", "status-dot-published"),
            ("Rejected",  "Từ chối",   "status-dot-rejected"),
        };

        statusStats = new();
        foreach (var (sv, label, dotClass) in statDefs)
        {
            var count = await AdminDocumentService.GetDocumentsCountAsync(PN_PublicVariables.MaTruong, null, sv, null);
            statusStats.Add(new StatItem(label, dotClass, count));
        }
    }

    private async Task SearchAsync()
    {
        trang = 1;
        await LoadAsync();
    }

    private async Task ResetAsync()
    {
        keyword = string.Empty;
        status = string.Empty;
        documentTypeId = string.Empty;
        trang = 1;
        await LoadAsync();
    }

    private async Task SetStatusFilter(string s)
    {
        status = s;
        trang = 1;
        await LoadAsync();
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SearchAsync();
    }

    private async Task PrevPageAsync()
    {
        if (trang > 1) { trang--; await LoadAsync(); }
    }

    private async Task NextPageAsync()
    {
        if (trang < totalPages) { trang++; await LoadAsync(); }
    }

    private async Task GoToPage(int p)
    {
        trang = p;
        await LoadAsync();
    }

    private async Task DeleteAsync(AdminDocumentItem item)
    {
        if (await JS.InvokeAsync<bool>("confirm", $"Xóa văn bản '{item.DocTitle}'?"))
        {
            await AdminDocumentService.DeleteDocumentAsync(item.Id ?? string.Empty);
            if (documents?.Count == 1 && trang > 1) trang--;
            await LoadAsync();
        }
    }

    // ── Helpers ──
    private static string GetBadgeClass(string? s) => s switch
    {
        "Draft" => "badge-draft",
        "Pending" => "badge-pending",
        "Approved" => "badge-approved",
        "Published" => "badge-published",
        "Rejected" => "badge-rejected",
        _ => "badge-draft"
    };

    private static string GetStatusLabel(string? s) => s switch
    {
        "Draft" => "Nháp",
        "Pending" => "Chờ duyệt",
        "Approved" => "Đã duyệt",
        "Published" => "Đã công khai",
        "Rejected" => "Từ chối",
        _ => s ?? "—"
    };

    private static string FormatDate(DateTime? dt) =>
        dt.HasValue ? dt.Value.ToString("dd/MM/yyyy") : "—";

    private static string FormatRelative(DateTime? dt)
    {
        if (!dt.HasValue) return string.Empty;
        var diff = DateTime.UtcNow - dt.Value.ToUniversalTime();
        if (diff.TotalMinutes < 1) return "Vừa xong";
        if (diff.TotalHours < 1) return $"{(int)diff.TotalMinutes} phút trước";
        if (diff.TotalDays < 1) return $"{(int)diff.TotalHours} giờ trước";
        if (diff.TotalDays < 30) return $"{(int)diff.TotalDays} ngày trước";
        if (diff.TotalDays < 365) return $"{(int)(diff.TotalDays / 30)} tháng trước";
        return $"{(int)(diff.TotalDays / 365)} năm trước";
    }

    private List<int> GetPageNumbers()
    {
        var pages = new List<int>();
        if (totalPages <= 7)
        {
            for (int i = 1; i <= totalPages; i++) pages.Add(i);
            return pages;
        }
        pages.Add(1);
        if (trang > 3) pages.Add(-1); // ellipsis
        for (int i = Math.Max(2, trang - 1); i <= Math.Min(totalPages - 1, trang + 1); i++)
            pages.Add(i);
        if (trang < totalPages - 2) pages.Add(-1); // ellipsis
        pages.Add(totalPages);
        return pages;
    }
}
