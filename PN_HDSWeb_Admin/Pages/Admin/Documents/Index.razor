@page "/admin/documents"
@attribute [Authorize(Roles = "Administrator")]
@using PN_HDSWeb_Admin.Services.Content
@inject IAdminDocumentService AdminDocumentService
@inject IAdminDocumentTypeService AdminDocumentTypeService
@inject NavigationManager Nav
@inject IJSRuntime JS

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700&family=Instrument+Serif:ital@0;1&display=swap');

    :root {
        --dl-bg: #f4f6fb;
        --dl-surface: #ffffff;
        --dl-surface-2: #f8fafd;
        --dl-border: #e4e9f2;
        --dl-border-focus: #3b6ef6;
        --dl-primary: #3b6ef6;
        --dl-primary-hover: #2554e0;
        --dl-primary-soft: #eef2fe;
        --dl-text: #0f1b35;
        --dl-text-2: #5a6a8a;
        --dl-text-3: #a0aec0;
        --dl-danger: #e53e3e;
        --dl-danger-soft: #fff5f5;
        --dl-success: #22c55e;
        --dl-success-soft: #f0fdf4;
        --dl-warning: #f59e0b;
        --dl-warning-soft: #fffbeb;
        --dl-radius: 14px;
        --dl-radius-sm: 9px;
        --dl-shadow: 0 4px 24px rgba(15,27,53,.07);
        --dl-shadow-lg: 0 8px 40px rgba(15,27,53,.12);
        --dl-transition: .2s cubic-bezier(.4,0,.2,1);
    }

    .dl-root * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    .dl-root {
        font-family: 'Be Vietnam Pro', sans-serif;
        background: var(--dl-bg);
        min-height: 100vh;
        color: var(--dl-text);
    }

    /* ── Topbar / Breadcrumb ── */
    .dl-topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 20px 32px 0;
        flex-wrap: wrap;
        gap: 12px;
    }

    .dl-breadcrumb {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 13px;
        color: var(--dl-text-2);
    }

        .dl-breadcrumb a {
            color: var(--dl-primary);
            text-decoration: none;
            font-weight: 500;
        }

            .dl-breadcrumb a:hover {
                text-decoration: underline;
            }

    .dl-breadcrumb-sep {
        color: var(--dl-text-3);
    }

    .dl-breadcrumb-current {
        color: var(--dl-text);
        font-weight: 600;
    }

    /* ── Hero ── */
    .dl-hero {
        padding: 20px 32px 0;
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
    }

    .dl-hero-text h1 {
        font-family: 'Instrument Serif', serif;
        font-size: 28px;
        font-weight: 400;
        color: var(--dl-text);
        letter-spacing: -.3px;
        line-height: 1.2;
    }

    .dl-hero-text p {
        margin-top: 4px;
        font-size: 13.5px;
        color: var(--dl-text-2);
    }

    /* ── Stats row ── */
    .dl-stats {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        padding: 20px 32px 0;
    }

    .dl-stat {
        background: var(--dl-surface);
        border: 1px solid var(--dl-border);
        border-radius: var(--dl-radius-sm);
        padding: 12px 18px;
        display: flex;
        align-items: center;
        gap: 12px;
        box-shadow: var(--dl-shadow);
        animation: dl-fadeup .3s ease both;
        min-width: 130px;
    }

        .dl-stat:nth-child(2) {
            animation-delay: .04s;
        }

        .dl-stat:nth-child(3) {
            animation-delay: .08s;
        }

        .dl-stat:nth-child(4) {
            animation-delay: .12s;
        }

        .dl-stat:nth-child(5) {
            animation-delay: .16s;
        }

        .dl-stat:nth-child(6) {
            animation-delay: .20s;
        }

    .dl-stat-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        flex-shrink: 0;
    }

    .dl-stat-info {
        display: flex;
        flex-direction: column;
    }

    .dl-stat-value {
        font-size: 20px;
        font-weight: 700;
        color: var(--dl-text);
        line-height: 1;
    }

    .dl-stat-label {
        font-size: 11.5px;
        color: var(--dl-text-3);
        margin-top: 3px;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: .4px;
    }

    /* ── Toolbar ── */
    .dl-toolbar {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 20px 32px 0;
        flex-wrap: wrap;
    }

    .dl-search-wrap {
        position: relative;
        flex: 1;
        min-width: 200px;
        max-width: 340px;
    }

    .dl-search-icon {
        position: absolute;
        left: 12px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--dl-text-3);
        pointer-events: none;
        display: flex;
        align-items: center;
    }

    .dl-input {
        width: 100%;
        padding: 9px 14px 9px 38px;
        border: 1.5px solid var(--dl-border);
        border-radius: var(--dl-radius-sm);
        font-family: inherit;
        font-size: 13.5px;
        color: var(--dl-text);
        background: var(--dl-surface);
        outline: none;
        transition: border-color var(--dl-transition), box-shadow var(--dl-transition);
    }

        .dl-input:focus {
            border-color: var(--dl-border-focus);
            box-shadow: 0 0 0 3px rgba(59,110,246,.12);
        }

        .dl-input::placeholder {
            color: var(--dl-text-3);
        }

    .dl-input-plain {
        padding-left: 14px;
    }

    .dl-select {
        padding: 9px 14px;
        border: 1.5px solid var(--dl-border);
        border-radius: var(--dl-radius-sm);
        font-size: 13.5px;
        background: var(--dl-surface);
        color: var(--dl-text);
        cursor: pointer;
        outline: none;
        transition: border-color var(--dl-transition), box-shadow var(--dl-transition);
        min-width: 160px;
    }

        .dl-select:focus {
            border-color: var(--dl-border-focus);
            box-shadow: 0 0 0 3px rgba(59,110,246,.12);
        }

    .dl-status-filter {
        display: flex;
        gap: 4px;
        flex-wrap: wrap;
        background: var(--dl-surface);
        border: 1px solid var(--dl-border);
        border-radius: var(--dl-radius-sm);
        padding: 4px;
        box-shadow: var(--dl-shadow);
    }

    .dl-status-tab {
        padding: 5px 12px;
        border-radius: 6px;
        font-size: 12.5px;
        font-weight: 600;
        cursor: pointer;
        border: none;
        background: none;
        color: var(--dl-text-2);
        transition: all var(--dl-transition);
        white-space: nowrap;
        display: flex;
        align-items: center;
        gap: 5px;
    }

        .dl-status-tab:hover {
            background: var(--dl-surface-2);
            color: var(--dl-text);
        }

        .dl-status-tab.active {
            background: var(--dl-primary-soft);
            color: var(--dl-primary);
        }

        .dl-status-tab .dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
        }

    .dl-spacer {
        flex: 1;
    }

    /* ── Buttons ── */
    .dl-btn {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 9px 18px;
        border-radius: var(--dl-radius-sm);
        font-family: inherit;
        font-size: 13.5px;
        font-weight: 600;
        cursor: pointer;
        border: 1.5px solid transparent;
        transition: all var(--dl-transition);
        white-space: nowrap;
    }

        .dl-btn:disabled {
            opacity: .5;
            cursor: not-allowed;
        }

    .dl-btn-primary {
        background: var(--dl-primary);
        color: white;
        border-color: var(--dl-primary);
        box-shadow: 0 2px 12px rgba(59,110,246,.25);
    }

        .dl-btn-primary:hover:not(:disabled) {
            background: var(--dl-primary-hover);
            border-color: var(--dl-primary-hover);
            box-shadow: 0 4px 18px rgba(59,110,246,.35);
            transform: translateY(-1px);
        }

    .dl-btn-ghost {
        background: var(--dl-surface);
        color: var(--dl-text-2);
        border-color: var(--dl-border);
    }

        .dl-btn-ghost:hover:not(:disabled) {
            border-color: var(--dl-text-2);
            color: var(--dl-text);
            background: var(--dl-surface-2);
        }

    .dl-btn-danger-ghost {
        background: none;
        color: var(--dl-danger);
        border: none;
        padding: 5px 8px;
        border-radius: 6px;
        cursor: pointer;
        font-family: inherit;
        font-size: 13px;
        transition: background var(--dl-transition);
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }

        .dl-btn-danger-ghost:hover {
            background: var(--dl-danger-soft);
        }

    .dl-btn-icon {
        background: none;
        color: var(--dl-text-2);
        border: none;
        padding: 5px 8px;
        border-radius: 6px;
        cursor: pointer;
        font-family: inherit;
        font-size: 13px;
        transition: all var(--dl-transition);
        display: inline-flex;
        align-items: center;
        gap: 4px;
        font-weight: 600;
    }

        .dl-btn-icon:hover {
            background: var(--dl-primary-soft);
            color: var(--dl-primary);
        }

    /* ── Main content ── */
    .dl-content {
        padding: 20px 32px 40px;
    }

    /* ── Card ── */
    .dl-card {
        background: var(--dl-surface);
        border: 1px solid var(--dl-border);
        border-radius: var(--dl-radius);
        box-shadow: var(--dl-shadow);
        overflow: hidden;
        animation: dl-fadeup .35s ease both;
        animation-delay: .1s;
    }

    @@keyframes dl-fadeup {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* ── Table ── */
    .dl-table {
        width: 100%;
        border-collapse: collapse;
    }

        .dl-table thead tr {
            background: var(--dl-surface-2);
            border-bottom: 1px solid var(--dl-border);
        }

        .dl-table th {
            padding: 11px 16px;
            font-size: 11.5px;
            font-weight: 700;
            color: var(--dl-text-3);
            text-transform: uppercase;
            letter-spacing: .5px;
            text-align: left;
            white-space: nowrap;
        }

            .dl-table th:last-child {
                text-align: right;
            }

        .dl-table tbody tr {
            border-bottom: 1px solid var(--dl-border);
            transition: background var(--dl-transition);
        }

            .dl-table tbody tr:last-child {
                border-bottom: none;
            }

            .dl-table tbody tr:hover {
                background: var(--dl-surface-2);
            }

        .dl-table td {
            padding: 14px 16px;
            font-size: 13.5px;
            color: var(--dl-text);
            vertical-align: middle;
        }

            .dl-table td:last-child {
                text-align: right;
            }

    /* Title cell */
    .dl-title-cell {
        max-width: 300px;
    }

    .dl-title-main {
        font-weight: 600;
        font-size: 14px;
        color: var(--dl-text);
        line-height: 1.4;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .dl-title-meta {
        margin-top: 3px;
        font-size: 12px;
        color: var(--dl-text-3);
        display: flex;
        align-items: center;
        gap: 6px;
    }

    /* Status badge */
    .dl-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
    }

        .dl-badge .dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
        }

    .badge-draft {
        background: #f1f5f9;
        color: #64748b;
    }

        .badge-draft .dot {
            background: #94a3b8;
        }

    .badge-pending {
        background: var(--dl-warning-soft);
        color: #92400e;
    }

        .badge-pending .dot {
            background: var(--dl-warning);
        }

    .badge-approved {
        background: #eff6ff;
        color: #1d4ed8;
    }

        .badge-approved .dot {
            background: #38bdf8;
        }

    .badge-published {
        background: var(--dl-success-soft);
        color: #166534;
    }

        .badge-published .dot {
            background: var(--dl-success);
        }

    .badge-rejected {
        background: var(--dl-danger-soft);
        color: var(--dl-danger);
    }

        .badge-rejected .dot {
            background: var(--dl-danger);
        }

    /* Date cell */
    .dl-date {
        font-size: 13px;
        color: var(--dl-text-2);
        white-space: nowrap;
    }

    .dl-date-relative {
        font-size: 11.5px;
        color: var(--dl-text-3);
        margin-top: 2px;
    }

    /* Actions cell */
    .dl-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 2px;
    }

    /* ── Empty state ── */
    .dl-empty {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 60px 24px;
        text-align: center;
        color: var(--dl-text-3);
    }

    .dl-empty-icon {
        width: 56px;
        height: 56px;
        background: var(--dl-surface-2);
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 16px;
        color: var(--dl-text-3);
    }

    .dl-empty h3 {
        font-size: 15px;
        color: var(--dl-text-2);
        font-weight: 600;
        margin-bottom: 6px;
    }

    .dl-empty p {
        font-size: 13px;
    }

    /* ── Loading ── */
    .dl-loading {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 14px;
        min-height: 40vh;
        color: var(--dl-text-2);
        font-size: 14px;
    }

    .dl-spinner {
        width: 26px;
        height: 26px;
        border: 3px solid var(--dl-border);
        border-top-color: var(--dl-primary);
        border-radius: 50%;
        animation: dl-spin .75s linear infinite;
    }

    @@keyframes dl-spin {
        to {
            transform: rotate(360deg);
        }
    }

    /* ── Pagination ── */
    .dl-pagination {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 14px 18px;
        border-top: 1px solid var(--dl-border);
        background: var(--dl-surface-2);
        flex-wrap: wrap;
        gap: 10px;
    }

    .dl-pagination-info {
        font-size: 13px;
        color: var(--dl-text-2);
    }

        .dl-pagination-info strong {
            color: var(--dl-text);
        }

    .dl-pages {
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .dl-page-btn {
        min-width: 32px;
        height: 32px;
        border: 1.5px solid var(--dl-border);
        border-radius: 7px;
        background: var(--dl-surface);
        font-family: inherit;
        font-size: 13px;
        font-weight: 600;
        color: var(--dl-text-2);
        cursor: pointer;
        transition: all var(--dl-transition);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0 8px;
    }

        .dl-page-btn:hover:not(:disabled) {
            border-color: var(--dl-primary);
            color: var(--dl-primary);
            background: var(--dl-primary-soft);
        }

        .dl-page-btn.active {
            background: var(--dl-primary);
            border-color: var(--dl-primary);
            color: white;
            box-shadow: 0 2px 8px rgba(59,110,246,.3);
        }

        .dl-page-btn:disabled {
            opacity: .4;
            cursor: not-allowed;
        }

    .dl-page-ellipsis {
        padding: 0 4px;
        color: var(--dl-text-3);
        font-size: 13px;
    }

    @@media (max-width: 768px) {
        .dl-topbar, .dl-hero, .dl-stats, .dl-toolbar, .dl-content {
            padding-left: 16px;
            padding-right: 16px;
        }

        .dl-stats {
            gap: 8px;
        }

        .dl-stat {
            min-width: 100px;
            padding: 10px 12px;
        }

        .dl-title-cell {
            max-width: 200px;
        }

        .dl-table td, .dl-table th {
            padding: 12px 10px;
        }

        .dl-hero {
            flex-direction: column;
            align-items: flex-start;
        }
    }
</style>

<div class="dl-root">
    <!-- Breadcrumb -->
    <div class="dl-topbar">
        <nav class="dl-breadcrumb">
            <a href="/admin">Trang quản trị</a>
            <span class="dl-breadcrumb-sep">›</span>
            <span class="dl-breadcrumb-current">Văn bản</span>
        </nav>
    </div>

    <!-- Hero -->
    <div class="dl-hero">
        <div class="dl-hero-text">
            <h1>Quản lý văn bản công khai</h1>
            <p>Quản lý các văn bản công khai của trường.</p>
        </div>
        <button class="dl-btn dl-btn-primary" @onclick='@(() => Nav.NavigateTo("/admin/documents/edit"))'>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
            Thêm văn bản mới
        </button>
    </div>

    <!-- Stats -->
    @if (documents != null)
    {
        <div class="dl-stats">
            <div class="dl-stat" style="animation-delay:.04s">
                <div class="dl-stat-dot" style="background:#94a3b8;"></div>
                <div class="dl-stat-info">
                    <span class="dl-stat-value">@totalCount</span>
                    <span class="dl-stat-label">Tổng văn bản</span>
                </div>
            </div>
            @foreach (var s in statusStats)
            {
                <div class="dl-stat" style="animation-delay:@(s.Delay)s">
                    <div class="dl-stat-dot" style="background:@s.Color;"></div>
                    <div class="dl-stat-info">
                        <span class="dl-stat-value">@s.Count</span>
                        <span class="dl-stat-label">@s.Label</span>
                    </div>
                </div>
            }
        </div>
    }

    <!-- Toolbar -->
    <div class="dl-toolbar">
        <!-- Tìm kiếm -->
        <div class="dl-search-wrap">
            <span class="dl-search-icon">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
            </span>
            <input class="dl-input" @bind="keyword" @bind:event="oninput"
                   @onkeydown="OnKeyDown"
                   placeholder="Tìm theo tiêu đề..." />
        </div>

        <!-- Lọc trạng thái -->
        <div class="dl-status-filter">
            @foreach (var tab in statusTabs)
            {
                <button class="dl-status-tab @(status == tab.Value ? "active" : "")"
                        type="button" @onclick="() => SetStatusFilter(tab.Value)">
                    @if (!string.IsNullOrEmpty(tab.Color))
                    {
                        <span class="dot" style="background:@tab.Color;"></span>
                    }
                    @tab.Label
                </button>
            }
        </div>

        <!-- Lọc loại văn bản -->
        <select class="dl-select" @bind="documentTypeId" @bind:event="onchange">
            <option value="">Tất cả loại</option>
            @foreach (var type in documentTypes)
            {
                <option value="@type.Id">@type.TypeName</option>
            }
        </select>

        <div class="dl-spacer"></div>

        <button class="dl-btn dl-btn-ghost" type="button" @onclick="ResetAsync">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="1 4 1 10 7 10" /><path d="M3.51 15a9 9 0 1 0 .49-3.51" /></svg>
            Đặt lại
        </button>
    </div>

    <!-- Nội dung -->
    <div class="dl-content">
        @if (documents == null)
        {
            <div class="dl-loading">
                <div class="dl-spinner"></div>
                <span>Đang tải dữ liệu...</span>
            </div>
        }
        else
        {
            <div class="dl-card">
                @if (documents.Count == 0)
                {
                    <div class="dl-empty">
                        <div class="dl-empty-icon">
                            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /></svg>
                        </div>
                        <h3>Không có văn bản nào</h3>
                        <p>@(string.IsNullOrWhiteSpace(keyword) && string.IsNullOrWhiteSpace(status) && string.IsNullOrWhiteSpace(documentTypeId) ? "Bắt đầu bằng cách thêm văn bản đầu tiên." : "Thử thay đổi bộ lọc hoặc từ khóa tìm kiếm.")</p>
                    </div>
                }
                else
                {
                    <table class="dl-table">
                        <thead>
                            <tr>
                                <th style="width:35%">Tiêu đề</th>
                                <th>Số hiệu</th>
                                <th>Loại văn bản</th>
                                <th>Trạng thái</th>
                                <th>Ngày tạo</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in documents)
                            {
                                <tr>
                                    <td class="dl-title-cell">
                                        <div class="dl-title-main">@item.DocTitle</div>
                                        @if (!string.IsNullOrWhiteSpace(item.DocNumber))
                                        {
                                            <div class="dl-title-meta">@item.DocNumber</div>
                                        }
                                    </td>
                                    <td>@item.DocNumber</td>
                                    <td>@item.DocumentTypeName</td>
                                    <td>
                                        <span class="dl-badge @GetBadgeClass(item.Status)">
                                            <span class="dot"></span>
                                            @GetStatusLabel(item.Status)
                                        </span>
                                    </td>
                                    <td>
                                        <div class="dl-date">@FormatDate(item.CreatedAt)</div>
                                        <div class="dl-date-relative">@FormatRelative(item.CreatedAt)</div>
                                    </td>
                                    <td>
                                        <div class="dl-actions">
                                            <button class="dl-btn-icon"
                                                    title="Chỉnh sửa"
                                                    @onclick="@(() => Nav.NavigateTo($"/admin/documents/edit/{item.Id}"))">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" /><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" /></svg>
                                                Sửa
                                            </button>
                                            <button class="dl-btn-danger-ghost"
                                                    title="Xóa văn bản"
                                                    @onclick="@(() => DeleteAsync(item))">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="3 6 5 6 21 6" /><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" /><path d="M10 11v6M14 11v6" /><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2" /></svg>
                                                Xóa
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <!-- Phân trang -->
                    <div class="dl-pagination">
                        <div class="dl-pagination-info">
                            Hiển thị <strong>@((trang - 1) * pageSize + 1)–@Math.Min(trang * pageSize, totalCount)</strong>
                            trong tổng số <strong>@totalCount</strong> văn bản
                        </div>
                        <div class="dl-pages">
                            <button class="dl-page-btn" @onclick="PrevPageAsync" disabled="@(trang <= 1)">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6" /></svg>
                            </button>

                            @foreach (var p in GetPageNumbers())
                            {
                                @if (p == -1)
                                {
                                    <span class="dl-page-ellipsis">…</span>
                                }
                                else
                                {
                                    <button class="dl-page-btn @(p == trang ? "active" : "")"
                                            @onclick="() => GoToPage(p)">
                                        @p
                                    </button>
                                }
                            }

                            <button class="dl-page-btn" @onclick="NextPageAsync" disabled="@(trang >= totalPages)">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6" /></svg>
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    private List<AdminDocumentItem>? documents;
    private List<AdminDocumentTypeItem>? documentTypes;
    private string? keyword;
    private string? status;
    private string? documentTypeId;
    private int trang = 1;
    private int pageSize = 20;
    private int totalCount;
    private int totalPages => Math.Max(1, (int)Math.Ceiling(totalCount / (double)pageSize));

    // Định nghĩa tab trạng thái
    private record StatusTab(string Label, string Value, string Color);
    private readonly List<StatusTab> statusTabs = new()
    {
        new("Tất cả",    "",          ""),
        new("Nháp",      "Draft",     "#94a3b8"),
        new("Chờ duyệt", "Pending",   "#f59e0b"),
        new("Đã duyệt",  "Approved",  "#38bdf8"),
        new("Đã công khai", "Published", "#22c55e"),
        new("Từ chối",   "Rejected",  "#e53e3e"),
    };

    // Thống kê
    private record StatItem(string Label, string Color, int Count, double Delay);
    private List<StatItem> statusStats = new();

    protected override async Task OnInitializedAsync()
    {
        documentTypes = await AdminDocumentTypeService.GetDocumentTypesAsync(PN_PublicVariables.MaTruong);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        totalCount = await AdminDocumentService.GetDocumentsCountAsync(PN_PublicVariables.MaTruong, keyword, status, documentTypeId);
        documents = await AdminDocumentService.GetDocumentsAsync(PN_PublicVariables.MaTruong, keyword, status, documentTypeId, trang, pageSize);
        await LoadStatsAsync();
    }

    private async Task LoadStatsAsync()
    {
        // Chỉ tải thống kê khi không có filter để hiển thị tổng quan
        if (!string.IsNullOrWhiteSpace(status) || !string.IsNullOrWhiteSpace(documentTypeId))
            return;

        var statDefs = new[] {
            ("Draft",     "Nháp",      "#94a3b8", .08),
            ("Pending",   "Chờ duyệt", "#f59e0b", .12),
            ("Published", "Đã công khai", "#22c55e", .16),
            ("Rejected",  "Từ chối",   "#e53e3e", .20),
        };

        statusStats = new();
        foreach (var (sv, label, color, delay) in statDefs)
        {
            var count = await AdminDocumentService.GetDocumentsCountAsync(PN_PublicVariables.MaTruong, null, sv, null);
            statusStats.Add(new StatItem(label, color, count, delay));
        }
    }

    private async Task SearchAsync()
    {
        trang = 1;
        await LoadAsync();
    }

    private async Task ResetAsync()
    {
        keyword = string.Empty;
        status = string.Empty;
        documentTypeId = string.Empty;
        trang = 1;
        await LoadAsync();
    }

    private async Task SetStatusFilter(string s)
    {
        status = s;
        trang = 1;
        await LoadAsync();
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SearchAsync();
    }

    private async Task PrevPageAsync()
    {
        if (trang > 1) { trang--; await LoadAsync(); }
    }

    private async Task NextPageAsync()
    {
        if (trang < totalPages) { trang++; await LoadAsync(); }
    }

    private async Task GoToPage(int p)
    {
        trang = p;
        await LoadAsync();
    }

    private async Task DeleteAsync(AdminDocumentItem item)
    {
        if (await JS.InvokeAsync<bool>("confirm", $"Xóa văn bản '{item.DocTitle}'?"))
        {
            await AdminDocumentService.DeleteDocumentAsync(item.Id ?? string.Empty);
            if (documents?.Count == 1 && trang > 1) trang--;
            await LoadAsync();
        }
    }

    // ── Helpers ──
    private static string GetBadgeClass(string? s) => s switch
    {
        "Draft" => "badge-draft",
        "Pending" => "badge-pending",
        "Approved" => "badge-approved",
        "Published" => "badge-published",
        "Rejected" => "badge-rejected",
        _ => "badge-draft"
    };

    private static string GetStatusLabel(string? s) => s switch
    {
        "Draft" => "Nháp",
        "Pending" => "Chờ duyệt",
        "Approved" => "Đã duyệt",
        "Published" => "Đã công khai",
        "Rejected" => "Từ chối",
        _ => s ?? "—"
    };

    private static string FormatDate(DateTime? dt) =>
        dt.HasValue ? dt.Value.ToString("dd/MM/yyyy") : "—";

    private static string FormatRelative(DateTime? dt)
    {
        if (!dt.HasValue) return string.Empty;
        var diff = DateTime.UtcNow - dt.Value.ToUniversalTime();
        if (diff.TotalMinutes < 1) return "Vừa xong";
        if (diff.TotalHours < 1) return $"{(int)diff.TotalMinutes} phút trước";
        if (diff.TotalDays < 1) return $"{(int)diff.TotalHours} giờ trước";
        if (diff.TotalDays < 30) return $"{(int)diff.TotalDays} ngày trước";
        if (diff.TotalDays < 365) return $"{(int)(diff.TotalDays / 30)} tháng trước";
        return $"{(int)(diff.TotalDays / 365)} năm trước";
    }

    private List<int> GetPageNumbers()
    {
        var pages = new List<int>();
        if (totalPages <= 7)
        {
            for (int i = 1; i <= totalPages; i++) pages.Add(i);
            return pages;
        }
        pages.Add(1);
        if (trang > 3) pages.Add(-1); // ellipsis
        for (int i = Math.Max(2, trang - 1); i <= Math.Min(totalPages - 1, trang + 1); i++)
            pages.Add(i);
        if (trang < totalPages - 2) pages.Add(-1); // ellipsis
        pages.Add(totalPages);
        return pages;
    }
}