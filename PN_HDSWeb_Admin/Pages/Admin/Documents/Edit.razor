@page "/admin/documents/edit/{Id?}"
@attribute [Authorize(Roles = "Administrator")]
@using Microsoft.AspNetCore.Components.Forms
@using PN_HDSWeb_Admin.Services.Content
@inject IAdminDocumentService AdminDocumentService
@inject IAdminDocumentTypeService AdminDocumentTypeService
@inject PN_HDSWeb_Admin.Services.Admin.IAdminFileStorageService FileStorage
@inject NavigationManager Nav

<style>
    /* ── Design Tokens ── */
    .de-root {
        --de-bg: #f4f6fb;
        --de-surface: #ffffff;
        --de-surface-2: #f8fafd;
        --de-border: #e4e9f2;
        --de-border-focus: #3b6ef6;
        --de-primary: #3b6ef6;
        --de-primary-hover: #2554e0;
        --de-primary-soft: #eef2fe;
        --de-text: #0f1b35;
        --de-text-2: #5a6a8a;
        --de-text-3: #a0aec0;
        --de-danger: #e53e3e;
        --de-danger-soft: #fff5f5;
        --de-success: #22c55e;
        --de-success-soft: #f0fdf4;
        --de-warning: #f59e0b;
        --de-warning-soft: #fffbeb;
        --de-radius: 14px;
        --de-radius-sm: 9px;
        --de-shadow: 0 4px 24px rgba(15,27,53,.07);
        --de-shadow-lg: 0 8px 40px rgba(15,27,53,.12);
        --de-transition: .2s cubic-bezier(.4,0,.2,1);
        font-family: 'Be Vietnam Pro', sans-serif;
        background: var(--de-bg);
        min-height: 100vh;
        color: var(--de-text);
    }

        .de-root * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

    /* ── Breadcrumb / Topbar ── */
    .de-topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 20px 32px 0;
        gap: 12px;
    }

    .de-breadcrumb {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 13px;
        color: var(--de-text-2);
    }

        .de-breadcrumb a {
            color: var(--de-primary);
            text-decoration: none;
            font-weight: 500;
        }

            .de-breadcrumb a:hover {
                text-decoration: underline;
            }

    .de-breadcrumb-sep {
        color: var(--de-text-3);
    }

    .de-breadcrumb-current {
        color: var(--de-text);
        font-weight: 600;
    }

    /* ── Hero ── */
    .de-page-hero {
        padding: 24px 32px 0;
    }

        .de-page-hero h1 {
            font-family: 'Instrument Serif', serif;
            font-size: 28px;
            font-weight: 400;
            letter-spacing: -.3px;
            line-height: 1.2;
        }

        .de-page-hero p {
            margin-top: 4px;
            font-size: 13.5px;
            color: var(--de-text-2);
        }

    /* ── Layout ── */
    .de-layout {
        display: grid;
        grid-template-columns: 1fr 340px;
        gap: 24px;
        padding: 24px 32px 40px;
        max-width: 1400px;
    }

    @@media (max-width: 1100px) {
        .de-layout {
            grid-template-columns: 1fr;
        }

        .de-topbar, .de-page-hero {
            padding-left: 20px;
            padding-right: 20px;
        }

        .de-layout {
            padding: 20px;
        }
    }

    /* ── Card ── */
    .de-card {
        background: var(--de-surface);
        border: 1px solid var(--de-border);
        border-radius: var(--de-radius);
        box-shadow: var(--de-shadow);
        overflow: hidden;
        animation: de-fadeup .3s ease both;
    }

        .de-card:nth-child(2) {
            animation-delay: .05s;
        }

        .de-card:nth-child(3) {
            animation-delay: .1s;
        }

    .de-card-header {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 18px 22px 16px;
        border-bottom: 1px solid var(--de-border);
        background: var(--de-surface-2);
    }

    .de-card-header-icon {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        background: var(--de-primary-soft);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--de-primary);
        flex-shrink: 0;
    }

    .de-card-header h2 {
        font-size: 14px;
        font-weight: 600;
        color: var(--de-text);
        letter-spacing: -.1px;
    }

    .de-card-body {
        padding: 22px;
    }

    /* ── Form Fields ── */
    .de-field {
        margin-bottom: 18px;
    }

        .de-field:last-child {
            margin-bottom: 0;
        }

    .de-label {
        display: block;
        font-size: 12.5px;
        font-weight: 600;
        color: var(--de-text-2);
        letter-spacing: .4px;
        text-transform: uppercase;
        margin-bottom: 7px;
    }

    .de-label-hint {
        display: block;
        font-size: 11.5px;
        font-weight: 400;
        color: var(--de-text-3);
        text-transform: none;
        letter-spacing: 0;
        margin-top: 2px;
    }

    .de-input {
        width: 100%;
        padding: 10px 14px;
        border: 1.5px solid var(--de-border);
        border-radius: var(--de-radius-sm);
        font-family: inherit;
        font-size: 14px;
        color: var(--de-text);
        background: var(--de-surface);
        transition: border-color var(--de-transition), box-shadow var(--de-transition);
        outline: none;
        appearance: none;
    }

        .de-input:focus {
            border-color: var(--de-border-focus);
            box-shadow: 0 0 0 3px rgba(59,110,246,.12);
        }

        .de-input::placeholder {
            color: var(--de-text-3);
        }

    textarea.de-input {
        resize: vertical;
        min-height: 80px;
        line-height: 1.6;
    }

    select.de-input {
        cursor: pointer;
    }

    /* ── File Upload Zone ── */
    .de-file-zone {
        border: 2px dashed var(--de-border);
        border-radius: var(--de-radius-sm);
        padding: 20px;
        text-align: center;
        cursor: pointer;
        transition: all var(--de-transition);
        background: var(--de-surface-2);
    }

        .de-file-zone:hover {
            border-color: var(--de-primary);
            background: var(--de-primary-soft);
        }

        .de-file-zone input[type=file] {
            display: none;
        }

    .de-file-zone-icon {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        background: var(--de-primary-soft);
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 10px;
        color: var(--de-primary);
    }

    .de-file-zone p {
        font-size: 13px;
        color: var(--de-text-2);
        line-height: 1.5;
    }

    .de-file-zone strong {
        color: var(--de-primary);
    }

    .de-file-preview {
        margin-top: 12px;
        padding: 10px 14px;
        background: var(--de-success-soft);
        border: 1px solid #bbf7d0;
        border-radius: var(--de-radius-sm);
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 13px;
        color: #166534;
    }

        .de-file-preview svg {
            flex-shrink: 0;
        }

    /* ── Buttons ── */
    .de-btn {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 10px 20px;
        border-radius: var(--de-radius-sm);
        font-family: inherit;
        font-size: 13.5px;
        font-weight: 600;
        cursor: pointer;
        border: 1.5px solid transparent;
        transition: all var(--de-transition);
        text-decoration: none;
        white-space: nowrap;
    }

        .de-btn:disabled {
            opacity: .5;
            cursor: not-allowed;
        }

    .de-btn-primary {
        background: var(--de-primary);
        color: white;
        border-color: var(--de-primary);
        box-shadow: 0 2px 12px rgba(59,110,246,.25);
    }

        .de-btn-primary:hover:not(:disabled) {
            background: var(--de-primary-hover);
            border-color: var(--de-primary-hover);
            box-shadow: 0 4px 18px rgba(59,110,246,.35);
            transform: translateY(-1px);
        }

    .de-btn-ghost {
        background: transparent;
        color: var(--de-text-2);
        border-color: var(--de-border);
    }

        .de-btn-ghost:hover:not(:disabled) {
            border-color: var(--de-text-2);
            color: var(--de-text);
            background: var(--de-surface-2);
        }

    .de-btn-sm {
        padding: 7px 14px;
        font-size: 12.5px;
    }

    /* ── Loading ── */
    .de-loading {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 14px;
        min-height: 50vh;
        color: var(--de-text-2);
        font-size: 14px;
    }

    .de-spinner {
        width: 28px;
        height: 28px;
        border: 3px solid var(--de-border);
        border-top-color: var(--de-primary);
        border-radius: 50%;
        animation: de-spin .75s linear infinite;
    }

    @@keyframes de-spin {
        to {
            transform: rotate(360deg);
        }
    }

    @@keyframes de-fadeup {
        from {
            opacity: 0;
            transform: translateY(12px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* ── Responsive sidebar ── */
    .de-side {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

        .de-side > .de-card:nth-child(1) {
            animation-delay: .1s;
        }

        .de-side > .de-card:nth-child(2) {
            animation-delay: .15s;
        }

        .de-side > .de-card:nth-child(3) {
            animation-delay: .2s;
        }
</style>

<div class="de-root">
    <!-- Breadcrumb -->
    <div class="de-topbar">
        <nav class="de-breadcrumb">
            <a href="/admin">Trang quản trị</a>
            <span class="de-breadcrumb-sep">›</span>
            <a href="/admin/documents">Văn bản</a>
            <span class="de-breadcrumb-sep">›</span>
            <span class="de-breadcrumb-current">@(IsEditMode ? "Chỉnh sửa" : "Tạo mới")</span>
        </nav>
        <button class="de-btn de-btn-ghost de-btn-sm" type="button" @onclick='@(() => Nav.NavigateTo("/admin/documents"))'>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 12H5M12 5l-7 7 7 7" /></svg>
            Quay lại
        </button>
    </div>

    <!-- Hero -->
    <div class="de-page-hero">
        <h1>@(IsEditMode ? "Sửa văn bản" : "Thêm văn bản")</h1>
        <p>Quản lý văn bản công khai, file đính kèm và lịch sử phiên bản.</p>
    </div>

    @if (model == null || documentTypes == null)
    {
        <div class="de-loading">
            <div class="de-spinner"></div>
            <span>Đang tải dữ liệu...</span>
        </div>
    }
    else
    {
        <div class="de-layout">
            <!-- Cột chính -->
            <div style="display:flex;flex-direction:column;gap:20px;">
                <!-- Thông tin văn bản -->
                <div class="de-card">
                    <div class="de-card-header">
                        <div class="de-card-header-icon">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /></svg>
                        </div>
                        <h2>Thông tin văn bản</h2>
                    </div>
                    <div class="de-card-body">
                        <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
                            <div class="de-field">
                                <label class="de-label">Số hiệu</label>
                                <input class="de-input" @bind="model.DocNumber" placeholder="VD: 123/QĐ-UBND" />
                            </div>
                            <div class="de-field">
                                <label class="de-label">Tiêu đề</label>
                                <input class="de-input" @bind="model.DocTitle" placeholder="Nhập tiêu đề văn bản" />
                            </div>
                            <div class="de-field">
                                <label class="de-label">Loại văn bản</label>
                                <select class="de-input" @bind="SelectedDocumentTypeId">
                                    <option value="">-- Chọn loại văn bản --</option>
                                    @foreach (var type in documentTypes)
                                    {
                                        <option value="@type.Id">@type.TypeName</option>
                                    }
                                </select>
                            </div>
                            <div class="de-field">
                                <label class="de-label">Mã loại hiển thị</label>
                                <input class="de-input" @bind="model.DocType" placeholder="Ví dụ: Quyết định" />
                            </div>
                            <div class="de-field">
                                <label class="de-label">Cơ quan ban hành</label>
                                <input class="de-input" @bind="model.Issuer" placeholder="Ví dụ: Sở GD&ĐT" />
                            </div>
                            <div class="de-field">
                                <label class="de-label">Trạng thái</label>
                                <select class="de-input" @bind="model.Status">
                                    <option value="Draft">Nháp</option>
                                    <option value="Pending">Chờ duyệt</option>
                                    <option value="Approved">Đã duyệt</option>
                                    <option value="Published">Đã công khai</option>
                                    <option value="Rejected">Từ chối</option>
                                </select>
                            </div>
                            <div class="de-field" style="grid-column:1/-1;">
                                <label class="de-label">Tóm tắt</label>
                                <textarea class="de-input" rows="3" @bind="model.Summary" placeholder="Mô tả ngắn cho văn bản..."></textarea>
                            </div>
                            <div class="de-field" style="grid-column:1/-1;">
                                <label class="de-label">Nội dung</label>
                                <textarea class="de-input" rows="8" @bind="model.Content" placeholder="Nhập nội dung văn bản..."></textarea>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- File đính kèm -->
                <div class="de-card">
                    <div class="de-card-header">
                        <div class="de-card-header-icon">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48" /></svg>
                        </div>
                        <h2>File đính kèm</h2>
                    </div>
                    <div class="de-card-body">
                        <div class="de-field">
                            <label class="de-label">Chọn file mới</label>
                            <label class="de-file-zone">
                                <div class="de-file-zone-icon">
                                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="17 8 12 3 7 8" /><line x1="12" y1="3" x2="12" y2="15" /></svg>
                                </div>
                                <p>
                                    <strong>Nhấn để chọn file</strong> hoặc kéo thả vào đây<br />
                                    <span style="font-size:12px;color:var(--de-text-3);">PDF, DOCX, XLSX, hình ảnh…</span>
                                </p>
                                <InputFile OnChange="OnFileSelected" />
                            </label>
                            @if (selectedFile != null)
                            {
                                <div class="de-file-preview">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12" /></svg>
                                    <span><strong>@selectedFile.Name</strong> · @FormatFileSize(selectedFile.Size)</span>
                                </div>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(model.FileUrl))
                        {
                            <div style="margin-top:14px;padding:14px;border:1px solid var(--de-border);border-radius:var(--de-radius-sm);background:var(--de-surface-2);">
                                <div style="font-size:12px;font-weight:600;color:var(--de-text-2);text-transform:uppercase;margin-bottom:6px;">File hiện tại</div>
                                <a href="@model.FileUrl" target="_blank" rel="noopener noreferrer" style="font-size:13px;word-break:break-all;">@model.FileUrl</a>
                            </div>
                        }
                        else
                        {
                            <div style="margin-top:14px;padding:14px;border:1px solid var(--de-border);border-radius:var(--de-radius-sm);background:var(--de-surface-2);text-align:center;color:var(--de-text-3);font-size:13px;">Chưa có file đính kèm.</div>
                        }
                    </div>
                </div>
            </div>

            <!-- Sidebar -->
            <div class="de-side">
                <!-- Xuất bản -->
                <div class="de-card">
                    <div class="de-card-header">
                        <div class="de-card-header-icon">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
                        </div>
                        <h2>Xuất bản</h2>
                    </div>
                    <div class="de-card-body">
                        <div style="display:flex;flex-direction:column;gap:10px;">
                            <button class="de-btn de-btn-primary" type="button" @onclick="SaveAsync" style="width:100%;justify-content:center;">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z" /><polyline points="17 21 17 13 7 13" /><polyline points="7 3 7 8 15 8" /></svg>
                                Lưu văn bản
                            </button>
                            <button class="de-btn de-btn-ghost de-btn-sm" type="button" @onclick='@(() => Nav.NavigateTo("/admin/documents"))' style="width:100%;justify-content:center;">Hủy</button>
                        </div>
                    </div>
                </div>

                <!-- Thông tin ngày -->
                <div class="de-card">
                    <div class="de-card-header">
                        <div class="de-card-header-icon">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="4" width="18" height="18" rx="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg>
                        </div>
                        <h2>Ngày tháng</h2>
                    </div>
                    <div class="de-card-body">
                        <div class="de-field">
                            <label class="de-label">Ngày ban hành</label>
                            <input class="de-input" type="date" value="@IssuedDateText" @onchange="OnIssuedDateChanged" />
                        </div>
                        <div class="de-field" style="margin-top:18px;">
                            <label class="de-label">Ngày hiệu lực</label>
                            <input class="de-input" type="date" value="@EffectiveDateText" @onchange="OnEffectiveDateChanged" />
                        </div>
                        <div class="de-field" style="margin-top:18px;">
                            <label class="de-label">Hết hiệu lực</label>
                            <input class="de-input" type="date" value="@ExpireDateText" @onchange="OnExpireDateChanged" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public string? Id { get; set; }
    private AdminDocumentDetail? model;
    private List<AdminDocumentTypeItem>? documentTypes;
    private string? SelectedDocumentTypeId;
    private string? IssuedDateText;
    private string? EffectiveDateText;
    private string? ExpireDateText;
    private IBrowserFile? selectedFile;
    private string? currentFileUrl;
    private bool IsEditMode => !string.IsNullOrWhiteSpace(Id);

    protected override async Task OnInitializedAsync()
    {
        documentTypes = await AdminDocumentTypeService.GetDocumentTypesAsync(PN_PublicVariables.MaTruong);

        if (IsEditMode)
        {
            model = await AdminDocumentService.GetDocumentByIdAsync(Id!);
        }

        model ??= new AdminDocumentDetail
        {
            MaTruongBo = PN_PublicVariables.MaTruong,
            Status = "Draft",
            VersionNo = 1
        };

        currentFileUrl = model.FileUrl;
        SelectedDocumentTypeId = model.DocumentTypeId ?? string.Empty;
        IssuedDateText = model.IssuedDate?.ToString("yyyy-MM-dd");
        EffectiveDateText = model.EffectiveDate?.ToString("yyyy-MM-dd");
        ExpireDateText = model.ExpireDate?.ToString("yyyy-MM-dd");
    }

    private Task OnIssuedDateChanged(ChangeEventArgs e)
    {
        IssuedDateText = e.Value?.ToString();
        return Task.CompletedTask;
    }

    private Task OnEffectiveDateChanged(ChangeEventArgs e)
    {
        EffectiveDateText = e.Value?.ToString();
        return Task.CompletedTask;
    }

    private Task OnExpireDateChanged(ChangeEventArgs e)
    {
        ExpireDateText = e.Value?.ToString();
        return Task.CompletedTask;
    }

    private Task OnFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        return Task.CompletedTask;
    }

    private async Task SaveAsync()
    {
        if (model == null) return;

        model.IssuedDate = DateTime.TryParse(IssuedDateText, out var issued) ? issued : null;
        model.EffectiveDate = DateTime.TryParse(EffectiveDateText, out var eff) ? eff : null;
        model.ExpireDate = DateTime.TryParse(ExpireDateText, out var exp) ? exp : null;
        model.DocumentTypeId = SelectedDocumentTypeId;

        var selectedType = documentTypes?.FirstOrDefault(x => x.Id == SelectedDocumentTypeId);
        if (selectedType != null && string.IsNullOrWhiteSpace(model.DocType))
            model.DocType = selectedType.TypeName;

        if (string.IsNullOrWhiteSpace(model.Id))
        {
            if (selectedFile != null)
            {
                var savedUrl = await FileStorage.SaveFileAsync(selectedFile, "documents");
                if (!string.IsNullOrWhiteSpace(savedUrl))
                {
                    model.FileUrl = savedUrl;
                    model.FileName = selectedFile.Name;
                    model.MimeType = selectedFile.ContentType;
                    currentFileUrl = savedUrl;
                }
            }

            await AdminDocumentService.CreateDocumentAsync(model);
        }
        else
        {
            if (selectedFile != null)
            {
                var oldUrl = currentFileUrl;
                var newUrl = await FileStorage.SaveFileAsync(selectedFile, "documents");
                if (!string.IsNullOrWhiteSpace(newUrl))
                {
                    model.FileUrl = newUrl;
                    model.FileName = selectedFile.Name;
                    model.MimeType = selectedFile.ContentType;
                    await FileStorage.DeleteFileAsync(oldUrl);
                    currentFileUrl = newUrl;
                }
            }
            else
            {
                model.FileUrl = currentFileUrl;
            }

            await AdminDocumentService.UpdateDocumentAsync(model);
        }

        Nav.NavigateTo("/admin/documents");
    }

    private static string FormatFileSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / (1024.0 * 1024):F1} MB";
    }
}