@page "/admin/document-versions/{DocumentId}"
@attribute [Authorize(Roles = "Administrator")]
@using Microsoft.AspNetCore.Components.Forms
@using PN_HDSWeb_Admin.Services.Content
@using PN_HDSWeb_Admin.Services.Admin
@inject IAdminDocumentVersionService AdminDocumentVersionService
@inject IAdminFileStorageService FileStorage
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="admin-form-shell">
    <div class="admin-form-card">
        <div class="admin-form-header">
            <h1>Lịch sử phiên bản văn bản</h1>
            <p>Quản lý các file version theo từng văn bản.</p>
        </div>

        <div class="admin-form-actions">
            <button type="button" class="btn btn-primary" @onclick="GoBack">Quay lại văn bản</button>
        </div>

        @if (versions == null)
        {
            <p>Đang tải...</p>
        }
        else
        {
            <div class="admin-form-grid u-mb-16">
                <label>
                    File version mới
                    <InputFile OnChange="OnFileSelected" />
                </label>
                <label>
                    Ghi chú thay đổi
                    <textarea class="admin-input" rows="3" @bind="changeSummary"></textarea>
                </label>
            </div>

            <div class="admin-form-actions">
                <button type="button" class="btn btn-primary" @onclick="SaveVersionAsync">Thêm version</button>
            </div>

            @if (!versions.Any())
            {
                <p>Chưa có version nào.</p>
            }
            else
            {
                <table>
                    <thead>
                        <tr>
                            <th>Version</th>
                            <th>File</th>
                            <th>Ghi chú</th>
                            <th>Ngày tạo</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in versions)
                        {
                            <tr>
                                <td>@item.VersionNo</td>
                                <td><a href="@item.FileUrl" target="_blank">@item.FileName</a></td>
                                <td>@item.ChangeSummary</td>
                                <td>@item.CreatedAt</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        }
    </div>
</div>

@code {
    [Parameter] public string? DocumentId { get; set; }
    private List<AdminDocumentVersionItem>? versions;
    private string? changeSummary;
    private IBrowserFile? selectedFile;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        versions = await AdminDocumentVersionService.GetVersionsAsync(PN_PublicVariables.MaTruong, DocumentId ?? string.Empty);
    }

    private Task OnFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        return Task.CompletedTask;
    }

    private async Task SaveVersionAsync()
    {
        if (selectedFile == null || string.IsNullOrWhiteSpace(DocumentId))
            return;

        var saved = await FileStorage.SaveFileAsync(selectedFile, "documents");
        if (string.IsNullOrWhiteSpace(saved))
            return;

        var nextNo = await AdminDocumentVersionService.GetNextVersionNoAsync(DocumentId);
        var fileName = Path.GetFileName(saved);

        await AdminDocumentVersionService.CreateVersionAsync(new AdminDocumentVersionDetail
        {
            DocumentId = DocumentId,
            MaTruongBo = PN_PublicVariables.MaTruong,
            VersionNo = nextNo,
            FileUrl = saved,
            FileName = fileName,
            ChangeSummary = changeSummary,
            CreatedBy = "system"
        });

        selectedFile = null;
        changeSummary = string.Empty;
        await LoadAsync();
    }

    private void GoBack() => Nav.NavigateTo("/admin/documents");
}
