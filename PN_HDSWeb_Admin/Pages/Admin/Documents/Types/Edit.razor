@page "/admin/document-types/edit/{Id?}"
@attribute [Authorize(Roles = "Administrator")]
@using PN_HDSWeb_Admin.Services.Content
@inject IAdminDocumentTypeService AdminDocumentTypeService
@inject NavigationManager Nav
<div class="dt-root">
    <!-- Breadcrumb -->
    <div class="dt-topbar">
        <nav class="dt-breadcrumb">
            <a href="/admin">Trang quản trị</a>
            <span class="dt-breadcrumb-sep">›</span>
            <a href="/admin/document-types">Loại văn bản</a>
            <span class="dt-breadcrumb-sep">›</span>
            <span class="dt-breadcrumb-current">@(IsEditMode ? "Chỉnh sửa" : "Tạo mới")</span>
        </nav>
        <button class="dt-btn dt-btn-ghost dt-btn-sm" type="button" @onclick="GoBack">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 12H5M12 5l-7 7 7 7" /></svg>
            Quay lại
        </button>
    </div>

    <!-- Hero -->
    <div class="dt-hero">
        <h1>@(IsEditMode ? "Sửa loại văn bản" : "Thêm loại văn bản")</h1>
        <p>Thiết lập loại văn bản chuẩn để dùng ở màn hình tạo văn bản.</p>
    </div>

    @if (model == null)
    {
        <div class="dt-loading">
            <div class="dt-spinner"></div>
            <span>Đang tải dữ liệu...</span>
        </div>
    }
    else
    {
        <div class="dt-layout">
            <!-- Cột chính: Form -->
            <div class="dt-main-col">
                <div class="dt-card">
                    <div class="dt-card-header">
                        <div class="dt-card-header-icon">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /></svg>
                        </div>
                        <h2>Thông tin loại văn bản</h2>
                    </div>
                    <div class="dt-card-body">
                        <div class="u-grid-2">
                            <div class="dt-field">
                                <label class="dt-label">Mã loại (Tự động sinh)</label>
                                <input class="dt-input" value="@model.TypeCode" disabled placeholder="Ví dụ: QD" />
                            </div>
                            <div class="dt-field">
                                <label class="dt-label">Tên loại</label>
                                <input class="dt-input" value="@model.TypeName" @oninput="OnTypeNameInput" placeholder="Ví dụ: Quyết định" />
                            </div>
                            <div class="dt-field">
                                <label class="dt-label">Slug (Tự động sinh)</label>
                                <input class="dt-input" value="@model.Slug" disabled placeholder="quyet-dinh" />
                            </div>
                            <div class="dt-field">
                                <label class="dt-label">Thứ tự</label>
                                <input class="dt-input" type="number" @bind="model.SortOrder" min="0" />
                            </div>
                            <div class="dt-field u-span-full">
                                <label class="dt-label">Mô tả</label>
                                <textarea class="dt-input" rows="3" @bind="model.Description" placeholder="Mô tả ngắn về loại văn bản..."></textarea>
                            </div>
                            <div class="dt-field">
                                <label class="dt-label">Trạng thái</label>
                                <select class="dt-input" @bind="IsActiveText">
                                    <option value="true">Đang bật</option>
                                    <option value="false">Tắt</option>
                                </select>
                            </div>
                        </div>

                        <div class="dt-action-bar">
                            <button type="button" class="dt-btn dt-btn-primary" @onclick="SaveAsync">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z" /><polyline points="17 21 17 13 7 13" /><polyline points="7 3 7 8 15 8" /></svg>
                                Lưu
                            </button>
                            <button type="button" class="dt-btn dt-btn-ghost" @onclick="GoBack">Hủy</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Cột phụ: Preview -->
            <div class="dt-side-col">
                <div class="dt-preview-box">
                    <h3>Xem trước</h3>
                    <p><strong>Mã:</strong> @model.TypeCode</p>
                    <p><strong>Tên:</strong> @model.TypeName</p>
                    <p><strong>Slug:</strong> @model.Slug</p>
                    <div class="u-mt-16">
                        <strong class="u-block u-mb-6">Ví dụ thường dùng</strong>
                        <ul>
                            <li>QD — Quyết định</li>
                            <li>TB — Thông báo</li>
                            <li>KH — Kế hoạch</li>
                            <li>CV — Công văn</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public string? Id { get; set; }
    private AdminDocumentTypeDetail? model;
    private string IsActiveText = "true";
    private bool IsEditMode => !string.IsNullOrWhiteSpace(Id);

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(Id))
            model = await AdminDocumentTypeService.GetDocumentTypeByIdAsync(Id);

        model ??= new AdminDocumentTypeDetail
        {
            MaTruongBo = PN_PublicVariables.MaTruong,
            SortOrder = 0,
            IsActive = true
        };

        IsActiveText = model.IsActive.ToString().ToLowerInvariant();
        UpdateAutoSlug();
    }

    private void OnTypeNameInput(ChangeEventArgs e)
    {
        model!.TypeName = e.Value?.ToString();
        UpdateAutoSlug();
    }

    private void UpdateAutoSlug()
    {
        if (model != null)
        {
            model.Slug = PN_HDSWeb_Admin.Services.Admin.AdminMenuService.ToSlug(model.TypeName);
            model.TypeCode = PN_HDSWeb_Admin.Services.Admin.AdminMenuService.GenerateTypeCode(model.TypeName);
        }
    }

    private async Task SaveAsync()
    {
        model!.IsActive = bool.TryParse(IsActiveText, out var active) && active;
        UpdateAutoSlug();

        if (string.IsNullOrWhiteSpace(model.Id))
            await AdminDocumentTypeService.CreateDocumentTypeAsync(model);
        else
            await AdminDocumentTypeService.UpdateDocumentTypeAsync(model);

        Nav.NavigateTo("/admin/document-types");
    }

    private void GoBack() => Nav.NavigateTo("/admin/document-types");
}