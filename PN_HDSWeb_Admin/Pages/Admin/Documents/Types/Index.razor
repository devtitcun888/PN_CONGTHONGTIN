@page "/admin/document-types"
@attribute [Authorize(Roles = "Administrator")]
@using PN_HDSWeb_Admin.Services.Content
@inject IAdminDocumentTypeService AdminDocumentTypeService
@inject NavigationManager Nav
@inject IJSRuntime JS

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700&family=Instrument+Serif:ital@0;1&display=swap');

    :root {
        --dt-bg: #f4f6fb;
        --dt-surface: #ffffff;
        --dt-surface-2: #f8fafd;
        --dt-border: #e4e9f2;
        --dt-border-focus: #3b6ef6;
        --dt-primary: #3b6ef6;
        --dt-primary-hover: #2554e0;
        --dt-primary-soft: #eef2fe;
        --dt-text: #0f1b35;
        --dt-text-2: #5a6a8a;
        --dt-text-3: #94a3b8;
        --dt-success: #22c55e;
        --dt-success-soft: #f0fdf4;
        --dt-danger: #ef4444;
        --dt-danger-soft: #fff5f5;
        --dt-radius: 16px;
        --dt-radius-sm: 10px;
        --dt-shadow: 0 4px 24px rgba(15,27,53,.07);
        --dt-transition: .2s cubic-bezier(.4,0,.2,1);
    }

    .dt-root * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    .dt-root {
        min-height: 100vh;
        background: var(--dt-bg);
        font-family: 'Be Vietnam Pro', sans-serif;
        color: var(--dt-text);
    }

    /* ── Topbar ── */
    .dt-topbar {
        padding: 20px 32px 0;
    }

    .dt-breadcrumb {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 13px;
        color: var(--dt-text-2);
    }

        .dt-breadcrumb a {
            text-decoration: none;
            color: var(--dt-primary);
            font-weight: 500;
        }

            .dt-breadcrumb a:hover {
                text-decoration: underline;
            }

    .dt-breadcrumb-sep {
        color: var(--dt-text-3);
    }

    .dt-breadcrumb-current {
        font-weight: 600;
        color: var(--dt-text);
    }

    /* ── Hero ── */
    .dt-hero {
        padding: 20px 32px 0;
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
    }

    .dt-hero-text h1 {
        font-family: 'Instrument Serif', serif;
        font-size: 30px;
        font-weight: 400;
        line-height: 1.2;
        letter-spacing: -.3px;
        color: var(--dt-text);
    }

    .dt-hero-text p {
        margin-top: 6px;
        font-size: 13.5px;
        color: var(--dt-text-2);
    }

    /* ── Actions ── */
    .dt-toolbar {
        padding: 20px 32px 0;
        display: flex;
        justify-content: flex-end;
    }

    /* ── Buttons ── */
    .dt-btn {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 10px 18px;
        border-radius: var(--dt-radius-sm);
        border: 1.5px solid transparent;
        font-family: inherit;
        font-size: 13.5px;
        font-weight: 600;
        cursor: pointer;
        transition: all var(--dt-transition);
        white-space: nowrap;
    }

    .dt-btn-primary {
        background: var(--dt-primary);
        border-color: var(--dt-primary);
        color: white;
        box-shadow: 0 2px 12px rgba(59,110,246,.25);
    }

        .dt-btn-primary:hover {
            background: var(--dt-primary-hover);
            border-color: var(--dt-primary-hover);
            transform: translateY(-1px);
            box-shadow: 0 4px 18px rgba(59,110,246,.35);
        }

    .dt-btn-ghost {
        background: var(--dt-surface);
        border-color: var(--dt-border);
        color: var(--dt-text-2);
    }

        .dt-btn-ghost:hover {
            border-color: var(--dt-primary);
            background: var(--dt-primary-soft);
            color: var(--dt-primary);
        }

    .dt-btn-danger {
        background: none;
        border: none;
        color: var(--dt-danger);
        padding: 8px 10px;
        border-radius: 8px;
    }

        .dt-btn-danger:hover {
            background: var(--dt-danger-soft);
        }

    /* ── Content ── */
    .dt-content {
        padding: 20px 32px 40px;
    }

    /* ── Card ── */
    .dt-card {
        background: var(--dt-surface);
        border: 1px solid var(--dt-border);
        border-radius: var(--dt-radius);
        box-shadow: var(--dt-shadow);
        overflow: hidden;
        animation: dt-fadeup .35s ease both;
    }

    @@keyframes dt-fadeup {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* ── Table ── */
    .dt-table {
        width: 100%;
        border-collapse: collapse;
    }

        .dt-table thead tr {
            background: var(--dt-surface-2);
            border-bottom: 1px solid var(--dt-border);
        }

        .dt-table th {
            padding: 12px 16px;
            text-align: left;
            font-size: 11.5px;
            text-transform: uppercase;
            letter-spacing: .5px;
            font-weight: 700;
            color: var(--dt-text-3);
            white-space: nowrap;
        }

        .dt-table td {
            padding: 14px 16px;
            font-size: 13.5px;
            color: var(--dt-text);
            vertical-align: middle;
            border-bottom: 1px solid var(--dt-border);
        }

        .dt-table tbody tr:last-child td {
            border-bottom: none;
        }

        .dt-table tbody tr {
            transition: background var(--dt-transition);
        }

            .dt-table tbody tr:hover {
                background: var(--dt-surface-2);
            }

    /* ── Type info ── */
    .dt-type-code {
        display: inline-flex;
        align-items: center;
        padding: 4px 8px;
        border-radius: 7px;
        background: var(--dt-primary-soft);
        color: var(--dt-primary);
        font-size: 12px;
        font-weight: 700;
        font-family: monospace;
    }

    .dt-type-name {
        font-weight: 600;
        color: var(--dt-text);
    }

    .dt-slug {
        font-family: monospace;
        font-size: 12px;
        color: var(--dt-text-2);
    }

    /* ── Status ── */
    .dt-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 10px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
    }

        .dt-badge .dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
        }

    .dt-badge-active {
        background: var(--dt-success-soft);
        color: #166534;
    }

        .dt-badge-active .dot {
            background: var(--dt-success);
        }

    .dt-badge-inactive {
        background: #f1f5f9;
        color: #64748b;
    }

        .dt-badge-inactive .dot {
            background: #94a3b8;
        }

    /* ── Actions ── */
    .dt-actions {
        display: flex;
        align-items: center;
        gap: 4px;
    }

    /* ── Empty / Loading ── */
    .dt-empty,
    .dt-loading {
        padding: 60px 24px;
        text-align: center;
        color: var(--dt-text-3);
        font-size: 14px;
    }

        .dt-empty h3 {
            font-size: 15px;
            color: var(--dt-text-2);
            margin-bottom: 6px;
        }

    /* ── Responsive ── */
    @@media (max-width: 768px) {
        .dt-topbar,
        .dt-hero,
        .dt-toolbar,
        .dt-content {
            padding-left: 16px;
            padding-right: 16px;
        }

        .dt-hero {
            flex-direction: column;
            align-items: flex-start;
        }

        .dt-table {
            min-width: 760px;
        }

        .dt-card {
            overflow-x: auto;
        }
    }
</style>

<div class="dt-root">

    <!-- Topbar -->
    <div class="dt-topbar">
        <nav class="dt-breadcrumb">
            <a href="/admin">Trang quản trị</a>
            <span class="dt-breadcrumb-sep">›</span>
            <span class="dt-breadcrumb-current">Loại văn bản</span>
        </nav>
    </div>

    <!-- Hero -->
    <div class="dt-hero">
        <div class="dt-hero-text">
            <h1>Loại văn bản</h1>
            <p>Quản lý danh mục loại văn bản chuẩn cho team nhập liệu.</p>
        </div>
    </div>

    <!-- Toolbar -->
    <div class="dt-toolbar">
        <button type="button"
                class="dt-btn dt-btn-primary"
                @onclick="GoCreate">
            <svg width="15" height="15" viewBox="0 0 24 24"
                 fill="none" stroke="currentColor" stroke-width="2.5">
                <line x1="12" y1="5" x2="12" y2="19" />
                <line x1="5" y1="12" x2="19" y2="12" />
            </svg>
            Thêm mới
        </button>
    </div>

    <!-- Content -->
    <div class="dt-content">

        @if (items == null)
        {
            <div class="dt-loading">
                Đang tải dữ liệu...
            </div>
        }
        else if (items.Count == 0)
        {
            <div class="dt-card">
                <div class="dt-empty">
                    <h3>Chưa có loại văn bản</h3>
                    <p>Bắt đầu bằng cách tạo loại văn bản đầu tiên.</p>
                </div>
            </div>
        }
        else
        {
            <div class="dt-card">
                <table class="dt-table">
                    <thead>
                        <tr>
                            <th>Mã</th>
                            <th>Tên loại</th>
                            <th>Slug</th>
                            <th>Thứ tự</th>
                            <th>Trạng thái</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in items)
                        {
                            <tr>
                                <td>
                                    <span class="dt-type-code">
                                        @item.TypeCode
                                    </span>
                                </td>

                                <td>
                                    <div class="dt-type-name">
                                        @item.TypeName
                                    </div>
                                </td>

                                <td>
                                    <span class="dt-slug">
                                        /@item.Slug
                                    </span>
                                </td>

                                <td>
                                    @item.SortOrder
                                </td>

                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="dt-badge dt-badge-active">
                                            <span class="dot"></span>
                                            Đang bật
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="dt-badge dt-badge-inactive">
                                            <span class="dot"></span>
                                            Đã tắt
                                        </span>
                                    }
                                </td>

                                <td>
                                    <div class="dt-actions">

                                        <button type="button"
                                                class="dt-btn dt-btn-ghost"
                                                @onclick="() => Edit(item)">
                                            Sửa
                                        </button>

                                        <button type="button"
                                                class="dt-btn dt-btn-ghost"
                                                @onclick="() => ToggleAsync(item)">
                                            @(item.IsActive ? "Tắt" : "Bật")
                                        </button>

                                        <button type="button"
                                                class="dt-btn-danger"
                                                @onclick="() => DeleteAsync(item)">
                                            Xóa
                                        </button>

                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

    </div>
</div>

@code {
    private List<AdminDocumentTypeItem>? items;

    protected override async Task OnInitializedAsync()
    {
        items = await AdminDocumentTypeService.GetDocumentTypesAsync(PN_PublicVariables.MaTruong);
    }

    private void GoCreate() => Nav.NavigateTo("/admin/document-types/edit");
    private void Edit(AdminDocumentTypeItem item) => Nav.NavigateTo($"/admin/document-types/edit/{item.Id}");

    private async Task ToggleAsync(AdminDocumentTypeItem item)
    {
        if (await JS.InvokeAsync<bool>("confirm", $"Đổi trạng thái loại văn bản '{item.TypeName}'?"))
        {
            await AdminDocumentTypeService.SetActiveAsync(item.Id ?? string.Empty, !item.IsActive);
            items = await AdminDocumentTypeService.GetDocumentTypesAsync(PN_PublicVariables.MaTruong);
        }
    }

    private async Task DeleteAsync(AdminDocumentTypeItem item)
    {
        if (await JS.InvokeAsync<bool>("confirm", $"Xóa loại văn bản '{item.TypeName}'?"))
        {
            await AdminDocumentTypeService.DeleteDocumentTypeAsync(item.Id ?? string.Empty);
            items = await AdminDocumentTypeService.GetDocumentTypesAsync(PN_PublicVariables.MaTruong);
        }
    }
}
