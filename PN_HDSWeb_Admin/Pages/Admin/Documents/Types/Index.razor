@page "/admin/document-types"
@attribute [Authorize(Roles = "Administrator")]
@using PN_HDSWeb_Admin.Services.Content
@inject IAdminDocumentTypeService AdminDocumentTypeService
@inject NavigationManager Nav
@inject IJSRuntime JS


<div class="dt-root">

    <!-- Topbar -->
    <div class="dt-topbar">
        <nav class="dt-breadcrumb">
            <a href="/admin">Trang quản trị</a>
            <span class="dt-breadcrumb-sep">›</span>
            <span class="dt-breadcrumb-current">Loại văn bản</span>
        </nav>
    </div>

    <!-- Hero -->
    <div class="dt-hero">
        <div class="dt-hero-text">
            <h1>Loại văn bản</h1>
            <p>Quản lý danh mục loại văn bản chuẩn cho team nhập liệu.</p>
        </div>
    </div>

    <!-- Toolbar -->
    <div class="dt-toolbar">
        <button type="button"
                class="dt-btn dt-btn-primary"
                @onclick="GoCreate">
            <svg width="15" height="15" viewBox="0 0 24 24"
                 fill="none" stroke="currentColor" stroke-width="2.5">
                <line x1="12" y1="5" x2="12" y2="19" />
                <line x1="5" y1="12" x2="19" y2="12" />
            </svg>
            Thêm mới
        </button>
    </div>

    <!-- Content -->
    <div class="dt-content">

        @if (items == null)
        {
            <div class="dt-loading">
                Đang tải dữ liệu...
            </div>
        }
        else if (items.Count == 0)
        {
            <div class="dt-card">
                <div class="dt-empty">
                    <h3>Chưa có loại văn bản</h3>
                    <p>Bắt đầu bằng cách tạo loại văn bản đầu tiên.</p>
                </div>
            </div>
        }
        else
        {
            <div class="dt-card">
                <table class="dt-table">
                    <thead>
                        <tr>
                            <th>Mã</th>
                            <th>Tên loại</th>
                            <th>Slug</th>
                            <th>Thứ tự</th>
                            <th>Trạng thái</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in items)
                        {
                            <tr>
                                <td>
                                    <span class="dt-type-code">
                                        @item.TypeCode
                                    </span>
                                </td>

                                <td>
                                    <div class="dt-type-name">
                                        @item.TypeName
                                    </div>
                                </td>

                                <td>
                                    <span class="dt-slug">
                                        /@item.Slug
                                    </span>
                                </td>

                                <td>
                                    @item.SortOrder
                                </td>

                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="dt-badge dt-badge-active">
                                            <span class="dot"></span>
                                            Đang bật
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="dt-badge dt-badge-inactive">
                                            <span class="dot"></span>
                                            Đã tắt
                                        </span>
                                    }
                                </td>

                                <td>
                                    <div class="dt-actions">

                                        <button type="button"
                                                class="dt-btn dt-btn-ghost"
                                                @onclick="() => Edit(item)">
                                            Sửa
                                        </button>

                                        <button type="button"
                                                class="dt-btn dt-btn-ghost"
                                                @onclick="() => ToggleAsync(item)">
                                            @(item.IsActive ? "Tắt" : "Bật")
                                        </button>

                                        <button type="button"
                                                class="dt-btn-danger"
                                                @onclick="() => DeleteAsync(item)">
                                            Xóa
                                        </button>

                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

    </div>
</div>

@code {
    private List<AdminDocumentTypeItem>? items;

    protected override async Task OnInitializedAsync()
    {
        items = await AdminDocumentTypeService.GetDocumentTypesAsync(PN_PublicVariables.MaTruong);
    }

    private void GoCreate() => Nav.NavigateTo("/admin/document-types/edit");
    private void Edit(AdminDocumentTypeItem item) => Nav.NavigateTo($"/admin/document-types/edit/{item.Id}");

    private async Task ToggleAsync(AdminDocumentTypeItem item)
    {
        if (await JS.InvokeAsync<bool>("confirm", $"Đổi trạng thái loại văn bản '{item.TypeName}'?"))
        {
            await AdminDocumentTypeService.SetActiveAsync(item.Id ?? string.Empty, !item.IsActive);
            items = await AdminDocumentTypeService.GetDocumentTypesAsync(PN_PublicVariables.MaTruong);
        }
    }

    private async Task DeleteAsync(AdminDocumentTypeItem item)
    {
        if (await JS.InvokeAsync<bool>("confirm", $"Xóa loại văn bản '{item.TypeName}'?"))
        {
            await AdminDocumentTypeService.DeleteDocumentTypeAsync(item.Id ?? string.Empty);
            items = await AdminDocumentTypeService.GetDocumentTypesAsync(PN_PublicVariables.MaTruong);
        }
    }
}

