@page "/admin/post-tags/edit/{Id?}"
@attribute [Authorize(Roles = "Administrator")]
@using PN_HDSWeb_Admin.Services.Content
@inject IAdminPostTagService AdminPostTagService
@inject NavigationManager Nav

<div class="admin-form-shell">
    <div class="admin-form-card">
        <div class="admin-form-header">
            <h1>@(IsEditMode ? "Sửa tag" : "Thêm tag")</h1>
            <p>Quản lý tag bài viết tại một nơi riêng.</p>
        </div>

        @if (model == null)
        {
            <p>Đang tải...</p>
        }
        else
        {
            <div class="admin-form-grid">
                <label>
                    Tên tag
                    <input class="admin-input" value="@model.TagName" @oninput="OnTagNameInput" placeholder="VD: Tuyển sinh" />
                </label>
                <label>
                    Slug (Tự động sinh)
                    <input class="admin-input" value="@model.Slug" disabled placeholder="Tự động sinh từ tên tag..." />
                </label>
                <label>
                    Trạng thái
                    <select class="admin-input" @bind="IsActiveText">
                        <option value="true">Đang bật</option>
                        <option value="false">Tắt</option>
                    </select>
                </label>
            </div>

            <div class="admin-form-actions">
                <button class="btn btn-primary" type="button" @onclick="SaveAsync">Lưu</button>
                <button class="btn btn-secondary" type="button" @onclick="GoBack">Quay lại</button>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public string? Id { get; set; }
    private AdminPostTagDetail? model;
    private string IsActiveText = "true";
    private bool IsEditMode => !string.IsNullOrWhiteSpace(Id);

    protected override async Task OnInitializedAsync()
    {
        if (IsEditMode)
            model = await AdminPostTagService.GetTagByIdAsync(Id!);

        model ??= new AdminPostTagDetail
        {
            MaTruongBo = PN_PublicVariables.MaTruong,
            IsActive = true
        };

        model.MaTruongBo ??= PN_PublicVariables.MaTruong;
        IsActiveText = model.IsActive.ToString().ToLowerInvariant();
        UpdateAutoSlug();
    }

    private void OnTagNameInput(ChangeEventArgs e)
    {
        model!.TagName = e.Value?.ToString();
        UpdateAutoSlug();
    }

    private void UpdateAutoSlug()
    {
        if (model != null)
        {
            model.Slug = GenerateSlug(model.TagName ?? string.Empty);
        }
    }

    private async Task SaveAsync()
    {
        model!.IsActive = bool.TryParse(IsActiveText, out var active) && active;
        model.MaTruongBo ??= PN_PublicVariables.MaTruong;
        UpdateAutoSlug();

        if (!await IsDuplicateAsync())
        {
            if (string.IsNullOrWhiteSpace(model.Id))
                await AdminPostTagService.CreateTagAsync(model);
            else
                await AdminPostTagService.UpdateTagAsync(model);

            Nav.NavigateTo("/admin/post-tags");
        }
    }

    private async Task<bool> IsDuplicateAsync()
    {
        var tags = await AdminPostTagService.GetTagsAsync(PN_PublicVariables.MaTruong);
        return tags.Any(x =>
            x.Id != model!.Id &&
            (string.Equals(x.Slug, model!.Slug, StringComparison.OrdinalIgnoreCase) ||
             string.Equals(x.TagName, model.TagName, StringComparison.OrdinalIgnoreCase)));
    }

    private void GoBack() => Nav.NavigateTo("/admin/post-tags");

    private static string GenerateSlug(string input)
    {
        if (string.IsNullOrWhiteSpace(input)) return string.Empty;
        var text = input.ToLowerInvariant();
        var map = new Dictionary<string, string>
        {
            {"à","a"},{"á","a"},{"ả","a"},{"ã","a"},{"ạ","a"},
            {"ă","a"},{"ắ","a"},{"ằ","a"},{"ẵ","a"},{"ặ","a"},{"ẳ","a"},
            {"â","a"},{"ấ","a"},{"ầ","a"},{"ẫ","a"},{"ậ","a"},{"ẩ","a"},
            {"è","e"},{"é","e"},{"ẻ","e"},{"ẽ","e"},{"ẹ","e"},
            {"ê","e"},{"ế","e"},{"ề","e"},{"ể","e"},{"ễ","e"},{"ệ","e"},
            {"ì","i"},{"í","i"},{"ỉ","i"},{"ĩ","i"},{"ị","i"},
            {"ò","o"},{"ó","o"},{"ỏ","o"},{"õ","o"},{"ọ","o"},
            {"ô","o"},{"ố","o"},{"ồ","o"},{"ổ","o"},{"ỗ","o"},{"ộ","o"},
            {"ơ","o"},{"ớ","o"},{"ờ","o"},{"ở","o"},{"ỡ","o"},{"ợ","o"},
            {"ù","u"},{"ú","u"},{"ủ","u"},{"ũ","u"},{"ụ","u"},
            {"ư","u"},{"ứ","u"},{"ừ","u"},{"ử","u"},{"ữ","u"},{"ự","u"},
            {"ỳ","y"},{"ý","y"},{"ỷ","y"},{"ỹ","y"},{"ỵ","y"},
            {"đ","d"}
        };
        foreach (var kv in map) text = text.Replace(kv.Key, kv.Value);
        var sb = new System.Text.StringBuilder();
        bool prevDash = false;
        foreach (var c in text)
        {
            if (char.IsLetterOrDigit(c)) { sb.Append(c); prevDash = false; }
            else if (!prevDash && sb.Length > 0) { sb.Append('-'); prevDash = true; }
        }
        return sb.ToString().TrimEnd('-');
    }
}
