@page "/admin/posts/edit/{Id?}"
@attribute [Authorize(Roles = "Administrator")]
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using PN_HDSWeb_Admin.Services.Content
@using PN_HDSWeb_Admin.Services.Admin
@inject IAdminPostService AdminPostService
@inject IAdminPostCategoryService AdminPostCategoryService
@inject IAdminPostTagService AdminPostTagService
@inject IAdminPostTagMapService AdminPostTagMapService
@inject IAdminPostMediaService AdminPostMediaService
@inject IAdminFileStorageService FileStorage
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="admin-form-shell">
    <div class="admin-form-card">
        <div class="admin-form-header">
            <h1>Bài viết</h1>
            <p>Thêm mới hoặc chỉnh sửa bài viết của trường.</p>
        </div>

        @if (model == null || categories == null || tags == null)
        {
            <p>Đang tải...</p>
        }
        else
        {
            <div class="admin-form-grid">
                <label>
                    Chuyên mục
                    <select class="admin-input" @bind="model.CategoryId">
                        <option value="">-- Chọn chuyên mục --</option>
                        @foreach (var cat in categories)
                        {
                            <option value="@cat.Id">@cat.CategoryName</option>
                        }
                    </select>
                </label>
                <label>
                    Tiêu đề
                    <input class="admin-input" @bind="model.Title" />
                </label>
                <label>
                    Slug
                    <input class="admin-input" @bind="model.Slug" />
                </label>
                <label>
                    Mã loại bài
                    <input class="admin-input" @bind="model.PostType" placeholder="news, announcement..." />
                </label>
                <label>
                    Tóm tắt
                    <textarea class="admin-input" rows="3" @bind="model.Summary"></textarea>
                </label>
                <div class="admin-editor-field">
                    <span class="admin-field-label-row">
                        <span>Nội dung</span>
                        <span class="admin-field-hint">Soạn thảo bài viết với định dạng phong phú</span>
                    </span>
                    <div class="admin-rich-editor-shell">
                        <div id="post-content-editor" class="admin-rich-editor"></div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(editorLoadError))
                    {
                        <div class="admin-editor-error">
                            Không thể tải CKEditor: @editorLoadError
                        </div>
                    }
                </div>
                <label>
                    Ảnh đại diện
                    <input class="admin-input" @bind="model.CoverImageUrl" />
                </label>
                <label>
                    Trạng thái
                    <select class="admin-input" @bind="model.Status">
                        <option value="Draft">Nháp</option>
                        <option value="Pending">Chờ duyệt</option>
                        <option value="Approved">Đã duyệt</option>
                        <option value="Published">Đã xuất bản</option>
                        <option value="Rejected">Từ chối</option>
                    </select>
                </label>
                <label>
                    Nổi bật
                    <input type="checkbox" @bind="model.IsFeatured" />
                </label>
                <label>
                    Thứ tự
                    <input class="admin-input" type="number" @bind="model.SortOrder" />
                </label>
            </div>

            <div class="admin-section">
                <h3>Tags</h3>
                <div style="display:flex; flex-wrap:wrap; gap:12px;">
                    @foreach (var tag in tags)
                    {
                        <label style="display:flex; gap:8px; align-items:center;">
                            <input type="checkbox" checked="@(selectedTagIds.Contains(tag.Id ?? string.Empty))" @onchange="(e) => ToggleTag(tag.Id, e)" />
                            <span>@tag.TagName</span>
                        </label>
                    }
                </div>
            </div>

            <div class="admin-section">
                <h3>Media</h3>
                <div class="admin-form-grid">
                    <label>
                        Loại media
                        <select class="admin-input" @bind="mediaModel.MediaType">
                            <option value="image">image</option>
                            <option value="video">video</option>
                            <option value="file">file</option>
                        </select>
                    </label>
                    <label>
                        Caption
                        <input class="admin-input" @bind="mediaModel.Caption" />
                    </label>
                    <label>
                        Upload file
                        <InputFile OnChange="OnMediaSelected" />
                    </label>
                </div>
                <div class="admin-form-actions">
                    <button class="btn btn-secondary" type="button" @onclick="AddMediaAsync">Thêm media</button>
                </div>
            </div>

            <div class="admin-form-actions">
                <button class="btn btn-primary" @onclick="SaveAsync">Lưu</button>
                <button class="btn btn-secondary" type="button" @onclick="GoBack">Quay lại</button>
                @if (!string.IsNullOrWhiteSpace(model.Id))
                {
                    <button class="btn btn-secondary" type="button" @onclick="GoMedia">Quản lý media</button>
                }
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public string? Id { get; set; }
    private AdminPostDetail? model;
    private List<AdminPostCategoryItem>? categories;
    private List<AdminPostTagItem>? tags;
    private List<string> selectedTagIds = new();
    private IBrowserFile? selectedMediaFile;
    private AdminPostMediaDetail mediaModel = new() { MediaType = "image", SortOrder = 0 };
    private IJSObjectReference? editorModule;
    private IJSObjectReference? editorInstance;
    private bool editorReady;
    private string? editorLoadError;
    private const string EditorId = "post-content-editor";

    protected override async Task OnInitializedAsync()
    {
        categories = await AdminPostCategoryService.GetActiveCategoriesAsync(PN_PublicVariables.MaTruong);
        tags = await AdminPostTagService.GetActiveTagsAsync(PN_PublicVariables.MaTruong);

        if (!string.IsNullOrWhiteSpace(Id))
        {
            model = await AdminPostService.GetPostByIdAsync(Id);
            selectedTagIds = await AdminPostTagMapService.GetTagIdsByPostIdAsync(Id);
            mediaModel.PostId = Id;
        }

        model ??= new AdminPostDetail
        {
            MaTruongBo = PN_PublicVariables.MaTruong,
            Status = "Draft"
        };

        mediaModel.MaTruongBo = PN_PublicVariables.MaTruong;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || model == null || editorReady || editorLoadError != null)
            return;

        try
        {
            editorModule = await JS.InvokeAsync<IJSObjectReference>("import", "/js/ckeditor-interop.js");
            editorInstance = await editorModule.InvokeAsync<IJSObjectReference>("initializeEditor", EditorId, "Nhập nội dung bài viết...");
            await editorModule.InvokeVoidAsync("setEditorData", EditorId, model.Content ?? string.Empty);
            editorReady = true;
        }
        catch (Exception ex)
        {
            editorLoadError = ex.Message;
        }

        StateHasChanged();
    }

    private void ToggleTag(string? tagId, ChangeEventArgs e)
    {
        if (string.IsNullOrWhiteSpace(tagId)) return;
        var checkedValue = e.Value?.ToString();
        if (checkedValue == "true" || checkedValue == "on")
        {
            if (!selectedTagIds.Contains(tagId)) selectedTagIds.Add(tagId);
        }
        else
        {
            selectedTagIds.Remove(tagId);
        }
    }

    private Task OnMediaSelected(InputFileChangeEventArgs e)
    {
        selectedMediaFile = e.File;
        return Task.CompletedTask;
    }

    private async Task AddMediaAsync()
    {
        if (string.IsNullOrWhiteSpace(model?.Id) || selectedMediaFile == null)
            return;

        var saved = await FileStorage.SaveFileAsync(selectedMediaFile, "posts");
        if (string.IsNullOrWhiteSpace(saved)) return;

        mediaModel.PostId = model.Id;
        mediaModel.FileUrl = saved;
        mediaModel.FileName = selectedMediaFile.Name;
        mediaModel.FileSize = selectedMediaFile.Size;
        mediaModel.MimeType = selectedMediaFile.ContentType;
        mediaModel.CreatedBy = "system";

        await AdminPostMediaService.CreateMediaAsync(mediaModel);
        selectedMediaFile = null;
    }

    private async Task SaveAsync()
    {
        if (editorModule != null)
        {
            model!.Content = await editorModule.InvokeAsync<string>("getEditorData", EditorId);
        }

        if (string.IsNullOrWhiteSpace(model!.Id))
        {
            await AdminPostService.CreatePostAsync(model);
            var saved = await AdminPostService.GetPostsAsync(PN_PublicVariables.MaTruong, model.Title, model.Status, 1, 1);
            model.Id = saved.FirstOrDefault()?.Id;
        }
        else
        {
            await AdminPostService.UpdatePostAsync(model);
        }

        if (!string.IsNullOrWhiteSpace(model.Id))
        {
            await AdminPostTagMapService.ReplaceTagsAsync(model.Id, selectedTagIds);
        }

        Nav.NavigateTo("/admin/posts");
    }

    public async ValueTask DisposeAsync()
    {
        if (editorModule != null)
        {
            if (editorReady)
            {
                await editorModule.InvokeVoidAsync("destroyEditor", editorInstance);
            }

            await editorModule.DisposeAsync();
        }
    }

    private void GoBack() => Nav.NavigateTo("/admin/posts");
    private void GoMedia() => Nav.NavigateTo($"/admin/posts/{model?.Id}/media");
}
