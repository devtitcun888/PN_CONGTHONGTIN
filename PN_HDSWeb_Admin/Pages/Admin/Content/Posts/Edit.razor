@page "/admin/posts/edit/{Id?}"
@attribute [Authorize(Roles = "Administrator")]
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using PN_HDSWeb_Admin.Services.Content
@using PN_HDSWeb_Admin.Services.Admin
@inject IAdminPostService AdminPostService
@inject IAdminPostCategoryService AdminPostCategoryService
@inject IAdminPostTagService AdminPostTagService
@inject IAdminPostTagMapService AdminPostTagMapService
@inject IAdminPostMediaService AdminPostMediaService
@inject IAdminFileStorageService FileStorage
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IAsyncDisposable
@implements IDisposable

<div class="admin-form-shell">
    <div class="admin-form-card">
        <div class="admin-form-header">
            <h1>Bài viết</h1>
            <p>Thêm mới hoặc chỉnh sửa bài viết của trường.</p>
        </div>

        @if (model == null || categories == null || tags == null)
        {
            <p>Đang tải...</p>
        }
        else
        {
            <div class="admin-form-grid">
                <label>
                    Chuyên mục
                    <select class="admin-input" @bind="model.CategoryId">
                        <option value="">-- Chọn chuyên mục --</option>
                        @foreach (var cat in categories)
                        {
                            <option value="@cat.Id">@cat.CategoryName</option>
                        }
                    </select>
                </label>
                <label>
                    Tiêu đề
                    <input class="admin-input" @bind="model.Title" />
                </label>
                <label>
                    Slug
                    <input class="admin-input" @bind="model.Slug" />
                </label>
                <label>
                    Mã loại bài
                    <input class="admin-input" @bind="model.PostType" placeholder="news, announcement..." />
                </label>
                <label>
                    Tóm tắt
                    <textarea class="admin-input" rows="3" @bind="model.Summary"></textarea>
                </label>
                <div class="admin-editor-field">
                    <span class="admin-field-label-row">
                        <span>Nội dung</span>
                        <span class="admin-field-hint">Soạn thảo bài viết với đầy đủ định dạng, bảng, media và liên kết</span>
                    </span>

                    <!-- CKEditor 5 Premium Container -->
                    <div class="admin-rich-editor-shell">
                        <div class="admin-rich-editor">
                            <div id="@EditorId"></div>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(editorLoadError))
                    {
                        <div class="admin-editor-error">
                            Không thể tải CKEditor: @editorLoadError
                        </div>
                    }
                </div>
                <label>
                    Ảnh đại diện
                    <input class="admin-input" @bind="model.CoverImageUrl" />
                </label>
                <label>
                    Trạng thái
                    <select class="admin-input" @bind="model.Status">
                        <option value="Draft">Nháp</option>
                        <option value="Pending">Chờ duyệt</option>
                        <option value="Approved">Đã duyệt</option>
                        <option value="Published">Đã xuất bản</option>
                        <option value="Rejected">Từ chối</option>
                    </select>
                </label>
                <label>
                    Nổi bật
                    <input type="checkbox" @bind="model.IsFeatured" />
                </label>
                <label>
                    Thứ tự
                    <input class="admin-input" type="number" @bind="model.SortOrder" />
                </label>
            </div>

            <div class="admin-section">
                <h3>Tags</h3>
                <div style="display:flex; flex-wrap:wrap; gap:12px;">
                    @foreach (var tag in tags)
                    {
                        <label style="display:flex; gap:8px; align-items:center;">
                            <input type="checkbox" checked="@(selectedTagIds.Contains(tag.Id ?? string.Empty))" @onchange="(e) => ToggleTag(tag.Id, e)" />
                            <span>@tag.TagName</span>
                        </label>
                    }
                </div>
            </div>

            <div class="admin-section">
                <h3>Media</h3>
                <div class="admin-form-grid">
                    <label>
                        Loại media
                        <select class="admin-input" @bind="mediaModel.MediaType">
                            <option value="image">image</option>
                            <option value="video">video</option>
                            <option value="file">file</option>
                        </select>
                    </label>
                    <label>
                        Caption
                        <input class="admin-input" @bind="mediaModel.Caption" />
                    </label>
                    <label>
                        Upload file
                        <InputFile OnChange="OnMediaSelected" />
                    </label>
                </div>
                <div class="admin-form-actions">
                    <button class="btn btn-secondary" type="button" @onclick="AddMediaAsync" disabled="@(model == null || selectedMediaFile == null)">Thêm media</button>
                </div>
            </div>

            <div class="admin-form-actions">
                <button class="btn btn-primary" type="button" @onclick="SaveAsync">Lưu</button>
                <button class="btn btn-secondary" type="button" @onclick="GoBack">Quay lại</button>
                <button class="btn btn-secondary" type="button" @onclick="GoMedia" disabled="@string.IsNullOrWhiteSpace(model.Id)">Quản lý media</button>
            </div>
        }
    </div>
</div>

<!-- CKEditor 5 Premium Styles & Scripts -->
<style>
    @@import url('https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,400;0,700;1,400;1,700&display=swap');
    @@media print { body { margin: 0!important; } }
    :root { --ck-content-font-family: Lato; --ck-sidebar-width: 270px; }
    .admin-rich-editor-shell { border: 1px solid var(--public-border); border-radius: 18px; background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%); box-shadow: 0 10px 24px rgba(15, 23, 42, 0.04); padding: 12px; transition: border-color .2s ease, box-shadow .2s ease, transform .2s ease; }
    .admin-rich-editor-shell:focus-within { border-color: rgba(37, 99, 235, 0.45); box-shadow: 0 16px 30px rgba(37, 99, 235, 0.12); transform: translateY(-1px); }
    .admin-rich-editor { min-height: 520px; }
    .admin-rich-editor .ck.ck-editor { width: 100%; }
    .admin-rich-editor .ck.ck-editor__top { position: sticky; top: 0; z-index: 3; }
    .admin-rich-editor .ck.ck-toolbar { border: 0 !important; border-radius: 16px 16px 0 0; background: #f8fbff; border-bottom: 1px solid var(--public-border) !important; }
    .admin-rich-editor .ck.ck-toolbar .ck-button { border-radius: 10px; }
    .admin-rich-editor .ck.ck-toolbar .ck-dropdown__panel,
    .admin-rich-editor .ck.ck-toolbar .ck-list__panel { z-index: 9999; }
    .admin-rich-editor .ck.ck-toolbar .ck-button.ck-on { background: rgba(37, 99, 235, 0.12); color: var(--public-primary-dark); }
    .admin-rich-editor .ck.ck-editor__main > .ck-editor__editable { min-height: 440px; border: 0 !important; border-radius: 0 0 16px 16px; padding: 18px 20px; background: white; box-shadow: inset 0 1px 0 rgba(15, 23, 42, 0.04); }
    .admin-rich-editor .ck.ck-editor__main > .ck-editor__editable.ck-focused { box-shadow: inset 0 0 0 2px rgba(37, 99, 235, 0.12); }
    .editor-container__sidebar, .revision-history, .editor_container__word-count, .main-container { display: none; }
</style>

