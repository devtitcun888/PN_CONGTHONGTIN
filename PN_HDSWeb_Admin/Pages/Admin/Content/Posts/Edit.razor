            RealTimeCollaborativeEditing,
            RealTimeCollaborativeRevisionHistory,
            RealTimeCollaborativeTrackChanges,
            RevisionHistory,
            SlashCommand,
            TableOfContents,
            Template,
            TrackChanges,
            TrackChangesData,
            TrackChangesPreview
        } = window.CKEDITOR_PREMIUM_FEATURES;

        class BlazorUploadAdapter {
            constructor(loader, dotNetRef) {
                this.loader = loader;
                this.dotNetRef = dotNetRef;
            }

            upload() {
                return this.loader.file.then(file => new Promise((resolve, reject) => {
                    const reader = new FileReader();
                    reader.onload = () => {
                        const arrayBuffer = reader.result;
                        const uint8Array = new Uint8Array(arrayBuffer);
                        this.dotNetRef.invokeMethodAsync('UploadEditorImageAsync', Array.from(uint8Array), file.name, file.type)
                            .then(url => {
                                if (url) {
                                    resolve({ default: url });
                                } else {
                                    reject('Upload failed');
                                }
                            })
                            .catch(error => reject(error));
                    };
                    reader.readAsArrayBuffer(file);
                }));
            }

            abort() {}
        }

        function createUploadAdapterPlugin(dotNetRef) {
            return function(editor) {
                editor.plugins.get('FileRepository').createUploadAdapter = (loader) => {
                    return new BlazorUploadAdapter(loader, dotNetRef);
                };
            };
        }

        const editorConfig = {
