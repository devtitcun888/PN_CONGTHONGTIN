                    'emoji', 'specialCharacters', 'horizontalLine', 'pageBreak',
                    'link', 'insertFootnote', 'bookmark', 'insertImage', 'insertImageViaUrl', 'ckbox', 'mediaEmbed',
                    'insertTable', 'insertTableLayout', 'tableOfContents', 'insertTemplate',
                    'highlight', 'blockQuote', 'codeBlock', 'htmlEmbed', '|',
