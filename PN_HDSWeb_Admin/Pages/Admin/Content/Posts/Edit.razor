@page "/admin/posts/edit/{Id?}"
@attribute [Authorize(Roles = "Administrator")]
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using PN_HDSWeb_Admin.Services.Content
@using PN_HDSWeb_Admin.Services.Admin
@inject IAdminPostService AdminPostService
@inject IAdminPostCategoryService AdminPostCategoryService
@inject IAdminPostTagService AdminPostTagService
@inject IAdminPostTagMapService AdminPostTagMapService
@inject IAdminPostMediaService AdminPostMediaService
@inject IAdminFileStorageService FileStorage
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IAsyncDisposable
@implements IDisposable

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700&family=Instrument+Serif:ital@0;1&display=swap');

    :root {
        --ep-bg: #f4f6fb;
        --ep-surface: #ffffff;
        --ep-surface-2: #f8fafd;
        --ep-border: #e4e9f2;
        --ep-border-focus: #3b6ef6;
        --ep-primary: #3b6ef6;
        --ep-primary-hover: #2554e0;
        --ep-primary-soft: #eef2fe;
        --ep-text: #0f1b35;
        --ep-text-2: #5a6a8a;
        --ep-text-3: #a0aec0;
        --ep-danger: #e53e3e;
        --ep-danger-soft: #fff5f5;
        --ep-success: #22c55e;
        --ep-success-soft: #f0fdf4;
        --ep-warning: #f59e0b;
        --ep-warning-soft: #fffbeb;
        --ep-radius: 14px;
        --ep-radius-sm: 9px;
        --ep-shadow: 0 4px 24px rgba(15,27,53,.07);
        --ep-shadow-lg: 0 8px 40px rgba(15,27,53,.12);
        --ep-transition: .2s cubic-bezier(.4,0,.2,1);
    }

    .ep-root * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    .ep-root {
        font-family: 'Be Vietnam Pro', sans-serif;
        background: var(--ep-bg);
        min-height: 100vh;
        color: var(--ep-text);
    }

    /* ── Header breadcrumb ── */
    .ep-topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 20px 32px 0;
        gap: 12px;
    }

    .ep-breadcrumb {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 13px;
        color: var(--ep-text-2);
    }

        .ep-breadcrumb a {
            color: var(--ep-primary);
            text-decoration: none;
            font-weight: 500;
        }

            .ep-breadcrumb a:hover {
                text-decoration: underline;
            }

    .ep-breadcrumb-sep {
        color: var(--ep-text-3);
    }

    .ep-breadcrumb-current {
        color: var(--ep-text);
        font-weight: 600;
    }

    .ep-topbar-actions {
        display: flex;
        gap: 10px;
    }

    /* ── Page title ── */
    .ep-page-hero {
        padding: 24px 32px 0;
    }

        .ep-page-hero h1 {
            font-family: 'Instrument Serif', serif;
            font-size: 28px;
            font-weight: 400;
            color: var(--ep-text);
            letter-spacing: -.3px;
            line-height: 1.2;
        }

        .ep-page-hero p {
            margin-top: 4px;
            font-size: 13.5px;
            color: var(--ep-text-2);
        }

    /* ── Layout ── */
    .ep-layout {
        display: grid;
        grid-template-columns: 1fr 340px;
        gap: 24px;
        padding: 24px 32px 40px;
        max-width: 1400px;
    }

    @@media (max-width: 1100px) {
        .ep-layout {
            grid-template-columns: 1fr;
        }

        .ep-topbar, .ep-page-hero {
            padding-left: 20px;
            padding-right: 20px;
        }

        .ep-layout {
            padding: 20px;
        }
    }

    /* ── Card ── */
    .ep-card {
        background: var(--ep-surface);
        border: 1px solid var(--ep-border);
        border-radius: var(--ep-radius);
        box-shadow: var(--ep-shadow);
        overflow: hidden;
    }

    .ep-card-header {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 18px 22px 16px;
        border-bottom: 1px solid var(--ep-border);
        background: var(--ep-surface-2);
    }

    .ep-card-header-icon {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        background: var(--ep-primary-soft);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--ep-primary);
        flex-shrink: 0;
    }

    .ep-card-header h2 {
        font-size: 14px;
        font-weight: 600;
        color: var(--ep-text);
        letter-spacing: -.1px;
    }

    .ep-card-body {
        padding: 22px;
    }

    /* ── Form Fields ── */
    .ep-field {
        margin-bottom: 18px;
    }

        .ep-field:last-child {
            margin-bottom: 0;
        }

    .ep-label {
        display: block;
        font-size: 12.5px;
        font-weight: 600;
        color: var(--ep-text-2);
        letter-spacing: .4px;
        text-transform: uppercase;
        margin-bottom: 7px;
    }

    .ep-label-hint {
        display: block;
        font-size: 11.5px;
        font-weight: 400;
        color: var(--ep-text-3);
        text-transform: none;
        letter-spacing: 0;
        margin-top: 2px;
    }

    .ep-input {
        width: 100%;
        padding: 10px 14px;
        border: 1.5px solid var(--ep-border);
        border-radius: var(--ep-radius-sm);
        font-family: inherit;
        font-size: 14px;
        color: var(--ep-text);
        background: var(--ep-surface);
        transition: border-color var(--ep-transition), box-shadow var(--ep-transition);
        outline: none;
        appearance: none;
    }

        .ep-input:focus {
            border-color: var(--ep-border-focus);
            box-shadow: 0 0 0 3px rgba(59,110,246,.12);
        }

        .ep-input::placeholder {
            color: var(--ep-text-3);
        }

    textarea.ep-input {
        resize: vertical;
        min-height: 80px;
        line-height: 1.6;
    }

    select.ep-input {
        cursor: pointer;
    }

    /* Slug row */
    .ep-slug-row {
        position: relative;
        display: flex;
        align-items: center;
    }

    .ep-slug-prefix {
        position: absolute;
        left: 14px;
        font-size: 13px;
        color: var(--ep-text-3);
        pointer-events: none;
        white-space: nowrap;
        z-index: 1;
    }

    .ep-input-slug {
        padding-left: calc(14px + 5ch);
        font-family: 'Courier New', monospace;
        font-size: 13px;
        background: var(--ep-surface-2);
    }

    .ep-slug-copy {
        position: absolute;
        right: 10px;
        background: none;
        border: none;
        cursor: pointer;
        color: var(--ep-text-3);
        padding: 4px;
        border-radius: 4px;
        transition: color var(--ep-transition);
        display: flex;
        align-items: center;
    }

        .ep-slug-copy:hover {
            color: var(--ep-primary);
        }

    /* Title input - larger */
    .ep-input-title {
        font-size: 16px;
        font-weight: 500;
        padding: 12px 14px;
    }

    /* ── Rich Editor ── */
    .ep-editor-wrap {
        border: 1.5px solid var(--ep-border);
        border-radius: var(--ep-radius-sm);
        overflow: hidden;
        transition: border-color var(--ep-transition), box-shadow var(--ep-transition);
        background: white;
    }

        .ep-editor-wrap:focus-within {
            border-color: var(--ep-border-focus);
            box-shadow: 0 0 0 3px rgba(59,110,246,.12);
        }

        .ep-editor-wrap .ck.ck-toolbar {
            border: none !important;
            border-bottom: 1px solid var(--ep-border) !important;
            background: var(--ep-surface-2) !important;
            border-radius: 0 !important;
        }

        .ep-editor-wrap .ck.ck-editor__main > .ck-editor__editable {
            min-height: 420px;
            border: none !important;
            padding: 18px 20px;
            font-family: 'Be Vietnam Pro', sans-serif;
            font-size: 15px;
            line-height: 1.75;
        }

            .ep-editor-wrap .ck.ck-editor__main > .ck-editor__editable.ck-focused {
                box-shadow: none !important;
            }

    .ep-editor-error {
        margin-top: 8px;
        padding: 10px 14px;
        background: var(--ep-danger-soft);
        border: 1px solid #fed7d7;
        border-radius: var(--ep-radius-sm);
        font-size: 13px;
        color: var(--ep-danger);
    }

    /* ── Tags ── */
    .ep-tags-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .ep-tag-chip {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 6px 12px;
        border: 1.5px solid var(--ep-border);
        border-radius: 20px;
        cursor: pointer;
        font-size: 13px;
        font-weight: 500;
        color: var(--ep-text-2);
        transition: all var(--ep-transition);
        user-select: none;
        background: var(--ep-surface);
    }

        .ep-tag-chip:hover {
            border-color: var(--ep-primary);
            color: var(--ep-primary);
            background: var(--ep-primary-soft);
        }

        .ep-tag-chip.active {
            border-color: var(--ep-primary);
            background: var(--ep-primary-soft);
            color: var(--ep-primary);
        }

        .ep-tag-chip input {
            display: none;
        }

    .ep-tag-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--ep-border);
        transition: background var(--ep-transition);
        flex-shrink: 0;
    }

    .ep-tag-chip.active .ep-tag-dot {
        background: var(--ep-primary);
    }

    /* ── Attachment upload ── */
    .ep-attachment-zone {
        border: 2px dashed var(--ep-border);
        border-radius: var(--ep-radius-sm);
        padding: 20px;
        text-align: center;
        cursor: pointer;
        transition: all var(--ep-transition);
        background: var(--ep-surface-2);
    }

        .ep-attachment-zone:hover, .ep-attachment-zone.drag-over {
            border-color: var(--ep-primary);
            background: var(--ep-primary-soft);
        }

    .ep-attachment-icon {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        background: var(--ep-primary-soft);
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 10px;
        color: var(--ep-primary);
    }

    .ep-attachment-zone p {
        font-size: 13px;
        color: var(--ep-text-2);
        line-height: 1.5;
    }

    .ep-attachment-zone strong {
        color: var(--ep-primary);
    }

    .ep-attachment-zone input[type=file] {
        display: none;
    }

    .ep-attachment-preview {
        margin-top: 12px;
        padding: 10px 14px;
        background: var(--ep-success-soft);
        border: 1px solid #bbf7d0;
        border-radius: var(--ep-radius-sm);
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 13px;
        color: #166534;
    }

        .ep-attachment-preview svg {
            flex-shrink: 0;
        }

    /* ── Type badges ── */
    .ep-type-select-row {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 8px;
    }

    .ep-type-btn {
        border: 1.5px solid var(--ep-border);
        border-radius: var(--ep-radius-sm);
        padding: 8px 6px;
        text-align: center;
        cursor: pointer;
        font-size: 12px;
        font-weight: 600;
        color: var(--ep-text-2);
        background: var(--ep-surface);
        transition: all var(--ep-transition);
    }

        .ep-type-btn:hover {
            border-color: var(--ep-primary);
            color: var(--ep-primary);
            background: var(--ep-primary-soft);
        }

        .ep-type-btn.active {
            border-color: var(--ep-primary);
            background: var(--ep-primary-soft);
            color: var(--ep-primary);
        }

    /* ── Status badge select ── */
    .ep-status-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px;
    }

    .ep-status-opt {
        position: relative;
        display: flex;
        align-items: center;
        gap: 8px;
        border: 1.5px solid var(--ep-border);
        border-radius: var(--ep-radius-sm);
        padding: 9px 12px;
        cursor: pointer;
        font-size: 12.5px;
        font-weight: 600;
        color: var(--ep-text-2);
        transition: all var(--ep-transition);
    }

        .ep-status-opt input {
            display: none;
        }

        .ep-status-opt:hover {
            border-color: var(--ep-primary);
        }

        .ep-status-opt.active {
            border-color: var(--ep-border-focus);
            background: var(--ep-primary-soft);
            color: var(--ep-primary);
        }

    .ep-status-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        flex-shrink: 0;
    }

    .dot-draft {
        background: #94a3b8;
    }

    .dot-pending {
        background: var(--ep-warning);
    }

    .dot-approved {
        background: #38bdf8;
    }

    .dot-published {
        background: var(--ep-success);
    }

    .dot-rejected {
        background: var(--ep-danger);
    }

    /* ── Featured toggle ── */
    .ep-toggle-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 16px;
        border: 1.5px solid var(--ep-border);
        border-radius: var(--ep-radius-sm);
        background: var(--ep-surface-2);
    }

    .ep-toggle-label {
        font-size: 13.5px;
        font-weight: 500;
        color: var(--ep-text);
    }

    .ep-toggle-sub {
        font-size: 12px;
        color: var(--ep-text-3);
        margin-top: 2px;
    }

    .ep-toggle {
        position: relative;
        width: 42px;
        height: 24px;
        flex-shrink: 0;
    }

        .ep-toggle input {
            display: none;
        }

    .ep-toggle-track {
        position: absolute;
        inset: 0;
        background: var(--ep-border);
        border-radius: 12px;
        cursor: pointer;
        transition: background var(--ep-transition);
    }

    .ep-toggle input:checked ~ .ep-toggle-track {
        background: var(--ep-primary);
    }

    .ep-toggle-thumb {
        position: absolute;
        top: 3px;
        left: 3px;
        width: 18px;
        height: 18px;
        background: white;
        border-radius: 50%;
        box-shadow: 0 1px 4px rgba(0,0,0,.2);
        transition: transform var(--ep-transition);
    }

    .ep-toggle input:checked ~ .ep-toggle-track .ep-toggle-thumb {
        transform: translateX(18px);
    }

    /* ── Cover image preview ── */
    .ep-cover-preview {
        width: 100%;
        height: 140px;
        border-radius: var(--ep-radius-sm);
        object-fit: cover;
        border: 1px solid var(--ep-border);
        background: var(--ep-surface-2);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--ep-text-3);
        font-size: 13px;
        margin-bottom: 10px;
        overflow: hidden;
    }

        .ep-cover-preview img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .ep-cover-placeholder {
        text-align: center;
        padding: 16px;
    }

        .ep-cover-placeholder svg {
            opacity: .4;
            margin-bottom: 6px;
        }

    /* ── Sort order ── */
    .ep-number-input-wrap {
        position: relative;
    }

        .ep-number-input-wrap .ep-input {
            padding-right: 40px;
        }

    .ep-number-arrows {
        position: absolute;
        right: 0;
        top: 0;
        bottom: 0;
        display: flex;
        flex-direction: column;
        border-left: 1.5px solid var(--ep-border);
    }

        .ep-number-arrows button {
            flex: 1;
            border: none;
            background: none;
            cursor: pointer;
            color: var(--ep-text-3);
            font-size: 11px;
            line-height: 1;
            padding: 0 8px;
            transition: color var(--ep-transition), background var(--ep-transition);
            border-radius: 0;
        }

            .ep-number-arrows button:first-child {
                border-bottom: 1px solid var(--ep-border);
                border-radius: 0 var(--ep-radius-sm) 0 0;
            }

            .ep-number-arrows button:last-child {
                border-radius: 0 0 var(--ep-radius-sm) 0;
            }

            .ep-number-arrows button:hover {
                background: var(--ep-primary-soft);
                color: var(--ep-primary);
            }

    /* ── Buttons ── */
    .ep-btn {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 10px 20px;
        border-radius: var(--ep-radius-sm);
        font-family: inherit;
        font-size: 13.5px;
        font-weight: 600;
        cursor: pointer;
        border: 1.5px solid transparent;
        transition: all var(--ep-transition);
        text-decoration: none;
        white-space: nowrap;
    }

        .ep-btn:disabled {
            opacity: .5;
            cursor: not-allowed;
        }

    .ep-btn-primary {
        background: var(--ep-primary);
        color: white;
        border-color: var(--ep-primary);
        box-shadow: 0 2px 12px rgba(59,110,246,.25);
    }

        .ep-btn-primary:hover:not(:disabled) {
            background: var(--ep-primary-hover);
            border-color: var(--ep-primary-hover);
            box-shadow: 0 4px 18px rgba(59,110,246,.35);
            transform: translateY(-1px);
        }

    .ep-btn-ghost {
        background: transparent;
        color: var(--ep-text-2);
        border-color: var(--ep-border);
    }

        .ep-btn-ghost:hover:not(:disabled) {
            border-color: var(--ep-text-2);
            color: var(--ep-text);
            background: var(--ep-surface-2);
        }

    .ep-btn-danger {
        background: transparent;
        color: var(--ep-danger);
        border-color: #fed7d7;
    }

        .ep-btn-danger:hover:not(:disabled) {
            background: var(--ep-danger-soft);
        }

    .ep-btn-sm {
        padding: 7px 14px;
        font-size: 12.5px;
    }

    .ep-action-bar {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        padding-top: 4px;
    }

    /* ── Loading ── */
    .ep-loading {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 14px;
        min-height: 50vh;
        color: var(--ep-text-2);
        font-size: 14px;
    }

    .ep-spinner {
        width: 28px;
        height: 28px;
        border: 3px solid var(--ep-border);
        border-top-color: var(--ep-primary);
        border-radius: 50%;
        animation: ep-spin .75s linear infinite;
    }

    @@keyframes ep-spin {
        to {
            transform: rotate(360deg);
        }
    }

    /* ── Divider ── */
    .ep-divider {
        height: 1px;
        background: var(--ep-border);
        margin: 4px 0 18px;
    }

    /* ── Sticky sidebar save bar (mobile) ── */
    .ep-sticky-save {
        display: none;
    }

    /* ── Animations ── */
    .ep-card {
        animation: ep-fadeup .3s ease both;
    }

        .ep-card:nth-child(2) {
            animation-delay: .05s;
        }

        .ep-card:nth-child(3) {
            animation-delay: .1s;
        }

    @@keyframes ep-fadeup {
        from {
            opacity: 0;
            transform: translateY(12px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .ep-main-col > .ep-card {
        animation-delay: .06s;
    }

    .ep-side-col > .ep-card:nth-child(1) {
        animation-delay: .1s;
    }

    .ep-side-col > .ep-card:nth-child(2) {
        animation-delay: .15s;
    }

    .ep-side-col > .ep-card:nth-child(3) {
        animation-delay: .2s;
    }

    /* Fix CKEditor inside custom container */
    .ep-editor-wrap .ck-editor {
        width: 100% !important;
    }

    .ck.ck-toolbar .ck-dropdown__panel,
    .ck.ck-toolbar .ck-list__panel {
        z-index: 9999 !important;
    }
</style>

<div class="ep-root">
    <!-- Topbar -->
    <div class="ep-topbar">
        <nav class="ep-breadcrumb">
            <a href="/admin">Trang quản trị</a>
            <span class="ep-breadcrumb-sep">›</span>
            <a href="/admin/posts">Bài viết</a>
            <span class="ep-breadcrumb-sep">›</span>
            <span class="ep-breadcrumb-current">@(string.IsNullOrWhiteSpace(Id) ? "Tạo mới" : "Chỉnh sửa")</span>
        </nav>
        <div class="ep-topbar-actions">
            <button class="ep-btn ep-btn-ghost ep-btn-sm" type="button" @onclick="GoBack">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 12H5M12 5l-7 7 7 7" /></svg>
                Quay lại
            </button>
        </div>
    </div>

    <!-- Hero -->
    <div class="ep-page-hero">
        <h1>@(string.IsNullOrWhiteSpace(Id) ? "Tạo bài viết mới" : "Chỉnh sửa bài viết")</h1>
        <p>@(string.IsNullOrWhiteSpace(Id) ? "Soạn thảo và xuất bản bài viết cho website trường." : $"Đang chỉnh sửa · ID: {Id}")</p>
    </div>

    @if (model == null || categories == null || tags == null)
    {
        <div class="ep-loading">
            <div class="ep-spinner"></div>
            <span>Đang tải dữ liệu...</span>
        </div>
    }
    else
    {
        <div class="ep-layout">
            <!-- ── Main Column ── -->
            <div class="ep-main-col" style="display:flex;flex-direction:column;gap:20px;">

                <!-- Basic info card -->
                <div class="ep-card">
                    <div class="ep-card-header">
                        <div class="ep-card-header-icon">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /><line x1="16" y1="13" x2="8" y2="13" /><line x1="16" y1="17" x2="8" y2="17" /><polyline points="10 9 9 9 8 9" /></svg>
                        </div>
                        <h2>Thông tin cơ bản</h2>
                    </div>
                    <div class="ep-card-body">
                        <!-- Tiêu đề -->
                        <div class="ep-field">
                            <label class="ep-label">Tiêu đề bài viết</label>
                            <input class="ep-input ep-input-title"
                                   placeholder="Nhập tiêu đề hấp dẫn..."
                                   value="@model.Title"
                                   @oninput="OnTitleInput" />
                        </div>

                        <!-- Slug -->
                        <div class="ep-field">
                            <label class="ep-label">
                                Slug (đường dẫn)
                                <span class="ep-label-hint">Tự động tạo từ tiêu đề · có thể chỉnh sửa</span>
                            </label>
                            <div class="ep-slug-row">
                                <span class="ep-slug-prefix">/tin/</span>
                                <input class="ep-input ep-input-slug"
                                       @bind="model.Slug"
                                       @bind:event="oninput"
                                       placeholder="duong-dan-bai-viet" />
                                <button class="ep-slug-copy" type="button" title="Sao chép URL" @onclick="CopySlug">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" /><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" /></svg>
                                </button>
                            </div>
                        </div>

                        <!-- Tóm tắt -->
                        <div class="ep-field">
                            <label class="ep-label">Tóm tắt</label>
                            <textarea class="ep-input" rows="3" @bind="model.Summary"
                                      placeholder="Mô tả ngắn gọn về nội dung bài viết (hiển thị ở trang danh sách)..."></textarea>
                        </div>
                    </div>
                </div>

                <!-- Editor card -->
                <div class="ep-card">
                    <div class="ep-card-header">
                        <div class="ep-card-header-icon">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" /><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" /></svg>
                        </div>
                        <h2>Nội dung bài viết</h2>
                    </div>
                    <div class="ep-card-body" style="padding:16px;">
                        <div class="ep-editor-wrap">
                            <div id="@EditorId"></div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(editorLoadError))
                        {
                            <div class="ep-editor-error">
                                <strong>Lỗi tải trình soạn thảo:</strong> @editorLoadError
                            </div>
                        }
                    </div>
                </div>

                <!-- Tags card -->
                <div class="ep-card">
                    <div class="ep-card-header">
                        <div class="ep-card-header-icon">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z" /><line x1="7" y1="7" x2="7.01" y2="7" /></svg>
                        </div>
                        <h2>Tags</h2>
                    </div>
                    <div class="ep-card-body">
                        <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:12px;">
                            <div>
                                <div style="font-size:13px;font-weight:600;color:var(--ep-text);">Chọn tag cho bài viết</div>
                                <div class="ep-label-hint" style="margin-top:4px;">Quản lý tag tại mục riêng trong danh mục bài viết.</div>
                            </div>
                            <a href="/admin/post-tags" class="ep-btn ep-btn-ghost ep-btn-sm" style="text-decoration:none;">Quản lý tag</a>
                        </div>

                        @if (tags?.Any() == true)
                        {
                            <div class="ep-tags-grid">
                                @foreach (var tag in tags)
                                {
                                    var isActive = selectedTagIds.Contains(tag.Id ?? string.Empty);
                                    <button type="button"
                                            class="ep-tag-chip @(isActive ? "active" : "")"
                                            @onclick="() => ToggleTag(tag.Id)">
                                        <span class="ep-tag-dot"></span>
                                        @tag.TagName
                                    </button>
                                }
                            </div>
                        }
                        else
                        {
                            <p style="font-size:13px;color:var(--ep-text-3);text-align:center;padding:12px 0;">Chưa có tag nào. Hãy tạo tag ở trang quản lý tag.</p>
                        }
                    </div>
                </div>

                <!-- Attachment card -->
                <div class="ep-card">
                    <div class="ep-card-header">
                        <div class="ep-card-header-icon">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48" /></svg>
                        </div>
                        <h2>Tệp đính kèm</h2>
                    </div>
                    <div class="ep-card-body">
                        <div class="ep-field">
                            <label class="ep-label">Loại tệp</label>
                            <select class="ep-input" @bind="mediaModel.MediaType">
                                <option value="image">🖼️ Hình ảnh</option>
                                <option value="video">🎬 Video</option>
                                <option value="file">📄 Tài liệu / File</option>
                            </select>
                        </div>
                        <div class="ep-field">
                            <label class="ep-label">Mô tả tệp</label>
                            <input class="ep-input" @bind="mediaModel.Caption" placeholder="Nhập mô tả cho tệp đính kèm..." />
                        </div>
                        <div class="ep-field">
                            <label class="ep-label">Chọn tệp</label>
                            <label class="ep-attachment-zone" id="attachment-zone">
                                <div class="ep-attachment-icon">
                                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="17 8 12 3 7 8" /><line x1="12" y1="3" x2="12" y2="15" /></svg>
                                </div>
                                <p>
                                    <strong>Nhấn để chọn tệp</strong> hoặc kéo thả vào đây<br />
                                    <span style="font-size:12px;color:var(--ep-text-3);">PNG, JPG, GIF, PDF, DOC, MP4…</span>
                                </p>
                                <InputFile OnChange="OnMediaSelected" multiple />
                            </label>
                            @if (selectedMediaFiles.Any())
                            {
                                <div style="margin-top:10px;display:flex;flex-direction:column;gap:8px;">
                                    @foreach (var file in selectedMediaFiles)
                                    {
                                        <div class="ep-attachment-preview">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12" /></svg>
                                            <span><strong>@file.Name</strong> · @FormatFileSize(file.Size)</span>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                        @if (mediaItems.Any())
                        {
                            <div style="margin-top:10px;display:flex;flex-direction:column;gap:10px;">
                                @foreach (var media in mediaItems)
                                {
                                    <div class="ep-card" style="box-shadow:none;border-style:solid;border-width:1px;">
                                        <div class="ep-card-body" style="padding:14px;">
                                            <div style="display:flex;justify-content:space-between;gap:12px;align-items:flex-start;">
                                                <div style="flex:1;min-width:0;">
                                                    <div style="font-weight:600;font-size:13px;word-break:break-word;">@media.FileName</div>
                                                    <a href="@media.FileUrl" target="_blank" rel="noopener noreferrer" style="font-size:12px;word-break:break-word;">@media.FileUrl</a>
                                                </div>
                                                <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;justify-content:flex-end;">
@*                                                     <label class="ep-btn ep-btn-ghost ep-btn-sm" style="position:relative;overflow:hidden;">
                                                        <InputFile OnChange="(e) => OnReplaceMediaSelected(media.Id, e)" accept="image/*,.pdf,.doc,.docx,.mp4,.mov,.avi" style="position:absolute;inset:0;opacity:0;cursor:pointer;" />
                                                        Đổi file
                                                    </label> *@
                                                    <select class="ep-input" style="min-width:130px;" @bind="media.MediaType">
                                                        <option value="image">Hình ảnh</option>
                                                        <option value="video">Video</option>
                                                        <option value="file">File</option>
                                                    </select>
                                                    <button type="button" class="ep-btn ep-btn-danger ep-btn-sm" @onclick="() => DeleteMediaAsync(media)">Xóa</button>
                                                </div>
                                            </div>
                                            <div class="ep-field" style="margin-top:12px;margin-bottom:0;">
                                                <label class="ep-label">Mô tả</label>
                                                <input class="ep-input" @bind="media.Caption" placeholder="Nhập mô tả tệp..." />
                                            </div>
                                            @if (replacementMediaFiles.ContainsKey(media.Id ?? string.Empty))
                                            {
                                                <div class="ep-label-hint" style="margin-top:8px;">Đã chọn file mới, sẽ thay thế khi bấm lưu bài viết.</div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        <div class="ep-label-hint" style="margin-top:8px;">Tệp đính kèm sẽ được lưu khi bấm lưu bài viết.</div>
                    </div>
                </div>
            </div>

            <!-- ── Side Column ── -->
            <div class="ep-side-col" style="display:flex;flex-direction:column;gap:20px;">

                <!-- Publish actions card -->
                <div class="ep-card">
                    <div class="ep-card-header">
                        <div class="ep-card-header-icon">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
                        </div>
                        <h2>Xuất bản</h2>
                    </div>
                    <div class="ep-card-body">
                        <div class="ep-action-bar" style="flex-direction:column;gap:10px;">
                            <button class="ep-btn ep-btn-primary" type="button" @onclick="SaveAsync" style="width:100%;justify-content:center;">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z" /><polyline points="17 21 17 13 7 13" /><polyline points="7 3 7 8 15 8" /></svg>
                                Lưu bài viết
                            </button>
                            <div style="display:flex;gap:8px;">
                                <button class="ep-btn ep-btn-ghost ep-btn-sm" type="button" @onclick="GoBack" style="flex:1;justify-content:center;">Hủy</button>
                                <button class="ep-btn ep-btn-ghost ep-btn-sm" type="button" @onclick="GoMedia"
                                        disabled="@string.IsNullOrWhiteSpace(model.Id)"
                                        style="flex:1;justify-content:center;">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="3" width="18" height="18" rx="2" /><circle cx="8.5" cy="8.5" r="1.5" /><polyline points="21 15 16 10 5 21" /></svg>
                                    Media
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Status card -->
                <div class="ep-card">
                    <div class="ep-card-header">
                        <div class="ep-card-header-icon">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10" /><path d="M12 8v4l3 3" /></svg>
                        </div>
                        <h2>Trạng thái</h2>
                    </div>
                    <div class="ep-card-body">
                        <div class="ep-status-row">
                            @foreach (var s in new[] {
                                ("Draft","Nháp","dot-draft"),
                                ("Pending","Chờ duyệt","dot-pending"),
                                ("Approved","Đã duyệt","dot-approved"),
                                ("Published","Xuất bản","dot-published"),
                                ("Rejected","Từ chối","dot-rejected")
                            })
                            {
                                <label class="ep-status-opt @(model.Status == s.Item1 ? "active" : "")">
                                    <input type="radio" name="ep-status" value="@s.Item1"
                                           checked="@(model.Status == s.Item1)"
                                           @onchange="() => model.Status = s.Item1" />
                                    <span class="ep-status-dot @s.Item3"></span>
                                    @s.Item2
                                </label>
                            }
                        </div>
                    </div>
                </div>

                <!-- Settings card -->
                <div class="ep-card">
                    <div class="ep-card-header">
                        <div class="ep-card-header-icon">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="3" /><path d="M19.07 4.93a10 10 0 0 1 0 14.14M12 2a10 10 0 0 1 7.07 2.93" /><path d="M4.93 4.93a10 10 0 0 0 0 14.14M12 2a10 10 0 0 0-7.07 2.93" /></svg>
                        </div>
                        <h2>Cài đặt</h2>
                    </div>
                    <div class="ep-card-body">
                        <!-- Category -->
                        <div class="ep-field">
                            <label class="ep-label">Chuyên mục</label>
                            <select class="ep-input" @bind="model.CategoryId">
                                <option value="">-- Chọn chuyên mục --</option>
                                @foreach (var cat in categories)
                                {
                                    <option value="@cat.Id">@cat.CategoryName</option>
                                }
                            </select>
                        </div>

                        <!-- Post type -->
                        <div class="ep-field">
                            <label class="ep-label">Mã loại bài</label>
                            <div class="ep-type-select-row">
                                @foreach (var pt in new[] { "news", "announcement", "event", "gallery", "general" })
                                {
                                    <button type="button"
                                            class="ep-type-btn @(model.PostType == pt ? "active" : "")"
                                            @onclick="() => model.PostType = pt">
                                        @pt
                                    </button>
                                }
                            </div>
                            <input class="ep-input" style="margin-top:8px;" @bind="model.PostType" placeholder="Hoặc nhập tùy chỉnh..." />
                        </div>

                        <!-- Sort order -->
                        <div class="ep-field">
                            <label class="ep-label">Thứ tự hiển thị</label>
                            <div class="ep-number-input-wrap">
                                <input class="ep-input" type="number" @bind="model.SortOrder" min="0" />
                                <div class="ep-number-arrows">
                                    <button type="button" @onclick="() => model.SortOrder++">▲</button>
                                    <button type="button" @onclick="() => { if (model.SortOrder > 0) model.SortOrder--; }">▼</button>
                                </div>
                            </div>
                        </div>

                        <!-- Featured -->
                        <div class="ep-field">
                            <div class="ep-toggle-row">
                                <div>
                                    <div class="ep-toggle-label">Bài viết nổi bật</div>
                                    <div class="ep-toggle-sub">Hiển thị ở vị trí nổi bật trang chủ</div>
                                </div>
                                <label class="ep-toggle">
                                    <input type="checkbox" @bind="model.IsFeatured" />
                                    <div class="ep-toggle-track">
                                        <div class="ep-toggle-thumb"></div>
                                    </div>
                                </label>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Cover image card -->
                <div class="ep-card">
                    <div class="ep-card-header">
                        <div class="ep-card-header-icon">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="3" width="18" height="18" rx="2" /><circle cx="8.5" cy="8.5" r="1.5" /><polyline points="21 15 16 10 5 21" /></svg>
                        </div>
                        <h2>Ảnh đại diện</h2>
                    </div>
                    <div class="ep-card-body">
                        <div class="ep-cover-preview">
                            @if (!string.IsNullOrWhiteSpace(model.CoverImageUrl))
                            {
                                <img src="@model.CoverImageUrl" alt="Cover" />
                            }
                            else
                            {
                                <div class="ep-cover-placeholder">
                                    <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2" /><circle cx="8.5" cy="8.5" r="1.5" /><polyline points="21 15 16 10 5 21" /></svg>
                                    <div style="font-size:12px;margin-top:4px;">Chưa có ảnh đại diện</div>
                                </div>
                            }
                        </div>
                        <div class="ep-field" style="margin-top:12px;">
                            <label class="ep-label">Chọn ảnh đại diện</label>
                            <InputFile OnChange="OnCoverSelected" accept="image/*" />
                            @if (selectedCoverFile != null)
                            {
                                <div class="ep-label-hint" style="margin-top:6px;">Ảnh sẽ được tải lên khi lưu bài viết.</div>
                            }
                        </div>
                        <input class="ep-input" @bind="model.CoverImageUrl" @bind:event="oninput"
                               placeholder="/uploads/posts/covers/..." />
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- CKEditor Scripts (giữ nguyên từ file gốc) -->
<link rel="stylesheet" href="https://cdn.ckeditor.com/ckeditor5/47.6.1/ckeditor5.css" crossorigin />
<link rel="stylesheet" href="https://cdn.ckeditor.com/ckeditor5-premium-features/47.6.1/ckeditor5-premium-features.css" crossorigin />
<script src="https://cdn.ckeditor.com/ckeditor5/47.6.1/ckeditor5.umd.js" crossorigin></script>
<script src="https://cdn.ckeditor.com/ckeditor5-premium-features/47.6.1/ckeditor5-premium-features.umd.js" crossorigin></script>
<script src="https://cdn.ckbox.io/ckbox/2.9.2/ckbox.js" crossorigin></script>

@code {
    [Parameter] public string? Id { get; set; }
    private AdminPostDetail? model;
    private List<AdminPostCategoryItem>? categories;
    private List<AdminPostTagItem>? tags;
    private List<AdminPostMediaItem> mediaItems = new();
    private List<string> selectedTagIds = new();
    private List<IBrowserFile> selectedMediaFiles = new();
    private Dictionary<string, IBrowserFile> replacementMediaFiles = new();
    private IBrowserFile? selectedCoverFile;
    private AdminPostMediaDetail mediaModel = new() { MediaType = "image", SortOrder = 0 };
    private DotNetObjectReference<Edit>? dotNetRef;
    private IJSObjectReference? ckEditorModule;
    private bool editorReady;
    private string? editorLoadError;
    private string? editorContent;
    private const string EditorId = "post-content-editor";

    protected override async Task OnInitializedAsync()
    {
        categories = await AdminPostCategoryService.GetActiveCategoriesAsync(PN_PublicVariables.MaTruong);
        tags = await AdminPostTagService.GetActiveTagsAsync(PN_PublicVariables.MaTruong);

        if (!string.IsNullOrWhiteSpace(Id))
        {
            model = await AdminPostService.GetPostByIdAsync(Id);
            selectedTagIds = await AdminPostTagMapService.GetTagIdsByPostIdAsync(Id);
            mediaItems = await AdminPostMediaService.GetMediaAsync(PN_PublicVariables.MaTruong, Id);
            mediaModel.PostId = Id;
        }

        model ??= new AdminPostDetail
        {
            MaTruongBo = PN_PublicVariables.MaTruong,
            Status = "Draft"
        };

        editorContent = model.Content ?? string.Empty;
        mediaModel.MaTruongBo = PN_PublicVariables.MaTruong;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || model == null || editorReady || editorLoadError != null)
            return;

        try
        {
            dotNetRef ??= DotNetObjectReference.Create(this);
            ckEditorModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/ckeditor-interop.js");

            await ckEditorModule.InvokeVoidAsync(
                "initializeEditor",
                EditorId,
                "Soạn thảo bài viết...",
                editorContent ?? string.Empty,
                dotNetRef,
                PN_PublicVariables.LicenceEditor,
                null
            );

            editorReady = true;
        }
        catch (Exception ex)
        {
            editorLoadError = ex.Message;
        }

        StateHasChanged();
    }

    // ── Auto-slug từ tiêu đề ──
    private void OnTitleInput(ChangeEventArgs e)
    {
        model!.Title = e.Value?.ToString() ?? string.Empty;
        // Chỉ tự động tạo slug nếu slug chưa được chỉnh tay
        if (string.IsNullOrWhiteSpace(model.Slug) || _slugAutoGenerated)
        {
            model.Slug = GenerateSlug(model.Title);
            _slugAutoGenerated = true;
        }
    }

    private bool _slugAutoGenerated = false;

    private static string GenerateSlug(string input)
    {
        if (string.IsNullOrWhiteSpace(input)) return string.Empty;

        var text = input.ToLowerInvariant();

        // Bảng chuyển đổi ký tự tiếng Việt
        var map = new Dictionary<string, string>
        {
            {"à","a"},{"á","a"},{"ả","a"},{"ã","a"},{"ạ","a"},
            {"ă","a"},{"ắ","a"},{"ằ","a"},{"ẵ","a"},{"ặ","a"},{"ẳ","a"},
            {"â","a"},{"ấ","a"},{"ầ","a"},{"ẫ","a"},{"ậ","a"},{"ẩ","a"},
            {"è","e"},{"é","e"},{"ẻ","e"},{"ẽ","e"},{"ẹ","e"},
            {"ê","e"},{"ế","e"},{"ề","e"},{"ể","e"},{"ễ","e"},{"ệ","e"},
            {"ì","i"},{"í","i"},{"ỉ","i"},{"ĩ","i"},{"ị","i"},
            {"ò","o"},{"ó","o"},{"ỏ","o"},{"õ","o"},{"ọ","o"},
            {"ô","o"},{"ố","o"},{"ồ","o"},{"ổ","o"},{"ỗ","o"},{"ộ","o"},
            {"ơ","o"},{"ớ","o"},{"ờ","o"},{"ở","o"},{"ỡ","o"},{"ợ","o"},
            {"ù","u"},{"ú","u"},{"ủ","u"},{"ũ","u"},{"ụ","u"},
            {"ư","u"},{"ứ","u"},{"ừ","u"},{"ử","u"},{"ữ","u"},{"ự","u"},
            {"ỳ","y"},{"ý","y"},{"ỷ","y"},{"ỹ","y"},{"ỵ","y"},
            {"đ","d"}
        };

        foreach (var kv in map)
            text = text.Replace(kv.Key, kv.Value);

        // Chỉ giữ chữ, số, dấu gạch ngang
        var sb = new System.Text.StringBuilder();
        bool prevDash = false;
        foreach (var c in text)
        {
            if (char.IsLetterOrDigit(c))
            {
                sb.Append(c);
                prevDash = false;
            }
            else if (!prevDash && sb.Length > 0)
            {
                sb.Append('-');
                prevDash = true;
            }
        }

        return sb.ToString().TrimEnd('-');
    }

    private async Task CopySlug()
    {
        var url = $"/tin/{model?.Slug}";
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", url);
    }

    private void ToggleTag(string? tagId)
    {
        if (string.IsNullOrWhiteSpace(tagId)) return;

        if (selectedTagIds.Contains(tagId))
            selectedTagIds.Remove(tagId);
        else
            selectedTagIds.Add(tagId);
    }

    private Task OnCoverSelected(InputFileChangeEventArgs e)
    {
        selectedCoverFile = e.File;
        return Task.CompletedTask;
    }

    private Task OnMediaSelected(InputFileChangeEventArgs e)
    {
        selectedMediaFiles = e.GetMultipleFiles().ToList();
        return Task.CompletedTask;
    }

    private void OnReplaceMediaSelected(string? mediaId, InputFileChangeEventArgs e)
    {
        if (string.IsNullOrWhiteSpace(mediaId)) return;
        var file = e.File;
        if (file != null)
            replacementMediaFiles[mediaId] = file;
    }

    private async Task DeleteMediaAsync(AdminPostMediaItem media)
    {
        if (model == null || string.IsNullOrWhiteSpace(media.Id)) return;

        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Xóa tệp đính kèm '{media.FileName}'?");
        if (!confirmed) return;

        await AdminPostMediaService.DeleteMediaAsync(media.Id);
        mediaItems = await AdminPostMediaService.GetMediaAsync(PN_PublicVariables.MaTruong, model.Id!);
        replacementMediaFiles.Remove(media.Id);
    }

    private async Task SaveAsync()
    {
        if (model == null) return;

        if (editorReady && ckEditorModule != null)
        {
            model.Content = await ckEditorModule.InvokeAsync<string>("waitForUploadsAndGetData", EditorId);
        }

        if (string.IsNullOrWhiteSpace(model.Id))
        {
            await AdminPostService.CreatePostAsync(model);
            var saved = await AdminPostService.GetPostsAsync(PN_PublicVariables.MaTruong, model.Title, model.Status, 1, 1);
            model.Id = saved.FirstOrDefault()?.Id;
        }
        else
        {
            await AdminPostService.UpdatePostAsync(model);
        }

        if (string.IsNullOrWhiteSpace(model.Id))
            return;

        if (selectedCoverFile != null)
        {
            var savedCover = await FileStorage.SaveImageAsync(selectedCoverFile, "posts/covers");
            if (!string.IsNullOrWhiteSpace(savedCover))
                model.CoverImageUrl = savedCover;
            selectedCoverFile = null;
        }

        if (selectedMediaFiles.Any())
        {
            foreach (var file in selectedMediaFiles)
            {
                var detail = new AdminPostMediaDetail
                {
                    PostId = model.Id,
                    MaTruongBo = PN_PublicVariables.MaTruong,
                    MediaType = mediaModel.MediaType,
                    Caption = mediaModel.Caption,
                    SortOrder = mediaModel.SortOrder,
                    CreatedBy = "system",
                    FileName = file.Name,
                    FileSize = file.Size,
                    MimeType = file.ContentType
                };

                await AdminPostMediaService.CreateMediaFromFileAsync(detail, file, "posts/media");
            }

            selectedMediaFiles.Clear();
        }

        foreach (var media in mediaItems.ToList())
        {
            if (replacementMediaFiles.TryGetValue(media.Id ?? string.Empty, out var newFile))
            {
                var replaceDetail = new AdminPostMediaDetail
                {
                    Id = media.Id,
                    PostId = model.Id,
                    MaTruongBo = PN_PublicVariables.MaTruong,
                    MediaType = media.MediaType,
                    Caption = media.Caption,
                    SortOrder = media.SortOrder,
                    CreatedBy = "system",
                    FileName = media.FileName,
                    FileSize = media.FileSize,
                    MimeType = media.MimeType
                };

                await AdminPostMediaService.ReplaceMediaFileAsync(replaceDetail, newFile, "posts/media");
            }
        }

        replacementMediaFiles.Clear();
        mediaItems = await AdminPostMediaService.GetMediaAsync(PN_PublicVariables.MaTruong, model.Id);

        await AdminPostTagMapService.ReplaceTagsAsync(model.Id, selectedTagIds);

        Nav.NavigateTo("/admin/posts");
    }


    private static string FormatFileSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / (1024.0 * 1024):F1} MB";
    }

    public async ValueTask DisposeAsync()
    {
        if (ckEditorModule != null)
        {
            try { await ckEditorModule.InvokeVoidAsync("destroyEditor", EditorId); } catch { }
            try { await ckEditorModule.DisposeAsync(); } catch { }
        }
        dotNetRef?.Dispose();
    }

    void IDisposable.Dispose() => dotNetRef?.Dispose();

    [JSInvokable]
    public async Task<string?> UploadEditorImageAsync(string base64Data, string fileName, string contentType)
    {
        var fileBytes = Convert.FromBase64String(base64Data);
        var file = new BrowserFileUpload(fileBytes, fileName, contentType);
        return await FileStorage.SaveImageAsync(file, "posts/covers");
    }

    private sealed class BrowserFileUpload : IBrowserFile
    {
        private readonly byte[] _bytes;
        public BrowserFileUpload(byte[] bytes, string name, string contentType)
        {
            _bytes = bytes; Name = name; ContentType = contentType;
            LastModified = DateTimeOffset.UtcNow;
        }
        public string Name { get; }
        public string ContentType { get; }
        public DateTimeOffset LastModified { get; }
        public long Size => _bytes.LongLength;
        public Stream OpenReadStream(long maxAllowedSize = 512000, CancellationToken cancellationToken = default)
            => new MemoryStream(_bytes, writable: false);
    }

    private void GoBack() => Nav.NavigateTo("/admin/posts");
    private void GoMedia()
    {
        if (!string.IsNullOrWhiteSpace(model?.Id))
            Nav.NavigateTo($"/admin/posts/{model.Id}/media");
    }
