@page "/admin/posts/edit/{Id?}"
@attribute [Authorize(Roles = "Administrator")]
@using PN_HDSWeb_Admin.Services.Content
@inject IAdminPostService AdminPostService
@inject NavigationManager Nav

<div class="admin-form-shell">
    <div class="admin-form-card">
        <div class="admin-form-header">
            <h1>Bài viết</h1>
            <p>Thêm mới hoặc chỉnh sửa bài viết của trường.</p>
        </div>

        @if (model == null)
        {
            <p>Đang tải...</p>
        }
        else
        {
            <div class="admin-form-grid">
                <label>
                    Tiêu đề
                    <input class="admin-input" @bind="model.Title" />
                </label>
                <label>
                    Slug
                    <input class="admin-input" @bind="model.Slug" />
                </label>
                <label>
                    Tóm tắt
                    <textarea class="admin-input" rows="3" @bind="model.Summary"></textarea>
                </label>
                <label>
                    Nội dung
                    <textarea class="admin-input" rows="8" @bind="model.Content"></textarea>
                </label>
                <label>
                    Trạng thái
                    <select class="admin-input" @bind="model.Status">
                        <option value="Draft">Nháp</option>
                        <option value="Pending">Chờ duyệt</option>
                        <option value="Approved">Đã duyệt</option>
                        <option value="Published">Đã xuất bản</option>
                        <option value="Rejected">Từ chối</option>
                    </select>
                </label>
            </div>

            <div class="admin-form-actions">
                <button class="btn btn-primary" @onclick="SaveAsync">Lưu</button>
                <button class="btn btn-secondary" @onclick="@(() => Nav.NavigateTo("/admin/posts"))">Quay lại</button>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public string? Id { get; set; }
    private AdminPostDetail? model;

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(Id))
        {
            model = await AdminPostService.GetPostByIdAsync(Id);
        }

        model ??= new AdminPostDetail
        {
            MaTruongBo = PN_PublicVariables.MaTruong,
            Status = "Draft"
        };
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(model!.Id))
            await AdminPostService.CreatePostAsync(model);
        else
            await AdminPostService.UpdatePostAsync(model);

        Nav.NavigateTo("/admin/posts");
    }
}
