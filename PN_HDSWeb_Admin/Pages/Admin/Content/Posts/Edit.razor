        const {
            getEmailInlineStylesTransformations,
            AIChat,
            AIEditorIntegration,
            AIQuickActions,
            AIReviewMode,
            CaseChange,
            Comments,
            ExportPdf,
            ExportWord,
            ExportInlineStyles,
            Footnotes,
            FormatPainter,
            ImportWord,
            LineHeight,
            MergeFields,
            MultiLevelList,
            PasteFromOfficeEnhanced,
            PresenceList,
