@page "/admin/posts/edit/{Id?}"
@attribute [Authorize(Roles = "Administrator")]
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using PN_HDSWeb_Admin.Services.Content
@using PN_HDSWeb_Admin.Services.Admin
@inject IAdminPostService AdminPostService
@inject IAdminPostCategoryService AdminPostCategoryService
@inject IAdminPostTagService AdminPostTagService
@inject IAdminPostTagMapService AdminPostTagMapService
@inject IAdminPostMediaService AdminPostMediaService
@inject IAdminFileStorageService FileStorage
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IAsyncDisposable
@implements IDisposable
<div class="ep-root">
    <!-- Topbar -->
    <div class="ep-topbar">
        <nav class="ep-breadcrumb">
            <a href="/admin">Trang quản trị</a>
            <span class="ep-breadcrumb-sep">›</span>
            <a href="/admin/posts">Bài viết</a>
            <span class="ep-breadcrumb-sep">›</span>
            <span class="ep-breadcrumb-current">@(string.IsNullOrWhiteSpace(Id) ? "Tạo mới" : "Chỉnh sửa")</span>
        </nav>
        <div class="ep-topbar-actions">
            <button class="ep-btn ep-btn-ghost ep-btn-sm" type="button" @onclick="GoBack">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 12H5M12 5l-7 7 7 7" /></svg>
                Quay lại
            </button>
        </div>
    </div>

    <!-- Hero -->
    <div class="ep-page-hero">
        <h1>@(string.IsNullOrWhiteSpace(Id) ? "Tạo bài viết mới" : "Chỉnh sửa bài viết")</h1>
        <p>@(string.IsNullOrWhiteSpace(Id) ? "Soạn thảo và xuất bản bài viết cho website trường." : $"Đang chỉnh sửa · ID: {Id}")</p>
    </div>

    @if (model == null || categories == null || tags == null)
    {
        <div class="ep-loading">
            <div class="ep-spinner"></div>
            <span>Đang tải dữ liệu...</span>
        </div>
    }
    else
    {
        <div class="ep-layout">
            <!-- ── Main Column ── -->
            <div class="ep-main-col u-flex-column u-gap-20">

                <!-- Basic info card -->
                <div class="ep-card">
                    <div class="ep-card-header">
                        <div class="ep-card-header-icon">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /><line x1="16" y1="13" x2="8" y2="13" /><line x1="16" y1="17" x2="8" y2="17" /><polyline points="10 9 9 9 8 9" /></svg>
                        </div>
                        <h2>Thông tin cơ bản</h2>
                    </div>
                    <div class="ep-card-body">
                        <!-- Tiêu đề -->
                        <div class="ep-field">
                            <label class="ep-label">Tiêu đề bài viết</label>
                            <input class="ep-input ep-input-title"
                                   placeholder="Nhập tiêu đề hấp dẫn..."
                                   value="@model.Title"
                                   @oninput="OnTitleInput" />
                        </div>

                        <!-- Slug -->
                        <div class="ep-field">
                            <label class="ep-label">
                                Slug (đường dẫn)
                                <span class="ep-label-hint">Tự động tạo từ tiêu đề</span>
                            </label>
                            <div class="ep-slug-row">
                                <span class="ep-slug-prefix">/tin/</span>
                                <input class="ep-input ep-input-slug"
                                       value="@model.Slug"
                                       disabled
                                       placeholder="duong-dan-bai-viet" />
                                <button class="ep-slug-copy" type="button" title="Sao chép URL" @onclick="CopySlug">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" /><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" /></svg>
                                </button>
                            </div>
                        </div>

                        <!-- Tóm tắt -->
                        <div class="ep-field">
                            <label class="ep-label">Tóm tắt</label>
                            <textarea class="ep-input" rows="3" @bind="model.Summary"
                                      placeholder="Mô tả ngắn gọn về nội dung bài viết (hiển thị ở trang danh sách)..."></textarea>
                        </div>
                    </div>
                </div>

                <!-- Editor card -->
                <div class="ep-card">
                    <div class="ep-card-header">
                        <div class="ep-card-header-icon">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" /><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" /></svg>
                        </div>
                        <h2>Nội dung bài viết</h2>
                    </div>
                    <div class="ep-card-body u-card-pad-md">
                        <div class="ep-editor-wrap">
                            <div id="@EditorId"></div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(editorLoadError))
                        {
                            <div class="ep-editor-error">
                                <strong>Lỗi tải trình soạn thảo:</strong> @editorLoadError
                            </div>
                        }
                    </div>
                </div>

                <!-- Tags card -->
                <div class="ep-card">
                    <div class="ep-card-header">
                        <div class="ep-card-header-icon">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z" /><line x1="7" y1="7" x2="7.01" y2="7" /></svg>
                        </div>
                        <h2>Tags</h2>
                    </div>
                    <div class="ep-card-body">
                        <div class="u-flex-between u-mb-12">
                            <div>
                                <div class="ep-tag-title">Chọn tag cho bài viết</div>
                                <div class="ep-label-hint u-mt-4">Quản lý tag tại mục riêng trong danh mục bài viết.</div>
                            </div>
                            <a href="/admin/post-tags" class="ep-btn ep-btn-ghost ep-btn-sm u-link-reset">Quản lý tag</a>
                        </div>

                        @if (tags?.Any() == true)
                        {
                            <div class="ep-tags-grid">
                                @foreach (var tag in tags)
                                {
                                    var isActive = selectedTagIds.Contains(tag.Id ?? string.Empty);
                                    <button type="button"
                                            class="ep-tag-chip @(isActive ? "active" : "")"
                                            @onclick="() => ToggleTag(tag.Id)">
                                        <span class="ep-tag-dot"></span>
                                        @tag.TagName
                                    </button>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="ep-empty-note">Chưa có tag nào. Hãy tạo tag ở trang quản lý tag.</p>
                        }
                    </div>
                </div>

                <!-- Attachment card -->
                <div class="ep-card">
                    <div class="ep-card-header">
                        <div class="ep-card-header-icon">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48" /></svg>
                        </div>
                        <h2>Tệp đính kèm</h2>
                    </div>
                    <div class="ep-card-body">
                        <div class="ep-field">
                            <label class="ep-label">Loại tệp</label>
                            <select class="ep-input" @bind="mediaModel.MediaType">
                                <option value="image">🖼️ Hình ảnh</option>
                                <option value="video">🎬 Video</option>
                                <option value="file">📄 Tài liệu / File</option>
                            </select>
                        </div>
                        <div class="ep-field">
                            <label class="ep-label">Mô tả tệp</label>
                            <input class="ep-input" @bind="mediaModel.Caption" placeholder="Nhập mô tả cho tệp đính kèm..." />
                        </div>
                        <div class="ep-field">
                            <label class="ep-label">Chọn tệp</label>
                            <label class="ep-attachment-zone" id="attachment-zone">
                                <div class="ep-attachment-icon">
                                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="17 8 12 3 7 8" /><line x1="12" y1="3" x2="12" y2="15" /></svg>
                                </div>
                                <p>
                                    <strong>Nhấn để chọn tệp</strong> hoặc kéo thả vào đây<br />
                                    <span class="u-file-hint">PNG, JPG, GIF, PDF, DOC, MP4…</span>
                                </p>
                                <InputFile OnChange="OnMediaSelected" multiple />
                            </label>
                            @if (selectedMediaFiles.Any())
                            {
                                <div class="u-flex-column u-gap-8 u-mt-10">
                                    @foreach (var file in selectedMediaFiles)
                                    {
                                        <div class="ep-attachment-preview">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12" /></svg>
                                            <span><strong>@file.Name</strong> · @FormatFileSize(file.Size)</span>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                        @if (mediaItems.Any())
                        {
                            <div class="u-flex-column u-gap-10 u-mt-10">
                                @foreach (var media in mediaItems)
                                {
                                    <div class="ep-card u-card-flat">
                                        <div class="ep-card-body u-card-pad-sm">
                                            <div class="u-flex-between">
                                                <div class="u-flex-1">
                                                    <div class="ep-media-file-name">@media.FileName</div>
                                                    <a class="ep-media-file-url" href="@media.FileUrl" target="_blank" rel="noopener noreferrer">@media.FileUrl</a>
                                                </div>
                                                <div class="u-flex-wrap-end">
@*                                                     <label class="ep-btn ep-btn-ghost ep-btn-sm ep-file-replace-label">
                                                        <InputFile class="u-hidden-file" OnChange="(e) => OnReplaceMediaSelected(media.Id, e)" accept="image/*,.pdf,.doc,.docx,.mp4,.mov,.avi" />
                                                        Đổi file
                                                    </label> *@
                                                    <select class="ep-input u-select-sm" @bind="media.MediaType">
                                                        <option value="image">Hình ảnh</option>
                                                        <option value="video">Video</option>
                                                        <option value="file">File</option>
                                                    </select>
                                                    <button type="button" class="ep-btn ep-btn-danger ep-btn-sm" @onclick="() => DeleteMediaAsync(media)">Xóa</button>
                                                </div>
                                            </div>
                                            <div class="ep-field u-mt-12 u-mb-0">
                                                <label class="ep-label">Mô tả</label>
                                                <input class="ep-input" @bind="media.Caption" placeholder="Nhập mô tả tệp..." />
                                            </div>
                                            @if (replacementMediaFiles.ContainsKey(media.Id ?? string.Empty))
                                            {
                                                <div class="ep-label-hint u-mt-8">Đã chọn file mới, sẽ thay thế khi bấm lưu bài viết.</div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        <div class="ep-label-hint u-mt-8">Tệp đính kèm sẽ được lưu khi bấm lưu bài viết.</div>
                    </div>
                </div>
            </div>

            <!-- ── Side Column ── -->
            <div class="ep-side-col u-flex-column u-gap-20">

                <!-- Publish actions card -->
                <div class="ep-card">
                    <div class="ep-card-header">
                        <div class="ep-card-header-icon">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
                        </div>
                        <h2>Xuất bản</h2>
                    </div>
                    <div class="ep-card-body">
                        <div class="ep-action-bar u-flex-column u-gap-10">
                            <button class="ep-btn ep-btn-primary u-w-full u-justify-center" type="button" @onclick="SaveAsync">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z" /><polyline points="17 21 17 13 7 13" /><polyline points="7 3 7 8 15 8" /></svg>
                                Lưu bài viết
                            </button>
                            <div class="u-actions-row">
                                <button class="ep-btn ep-btn-ghost ep-btn-sm u-flex-1 u-justify-center" type="button" @onclick="GoBack">Hủy</button>
                                <button class="ep-btn ep-btn-ghost ep-btn-sm u-flex-1 u-justify-center" type="button" @onclick="GoMedia"
                                        disabled="@string.IsNullOrWhiteSpace(model.Id)"
                                       >
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="3" width="18" height="18" rx="2" /><circle cx="8.5" cy="8.5" r="1.5" /><polyline points="21 15 16 10 5 21" /></svg>
                                    Media
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Status card -->
                <div class="ep-card">
                    <div class="ep-card-header">
                        <div class="ep-card-header-icon">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10" /><path d="M12 8v4l3 3" /></svg>
                        </div>
                        <h2>Trạng thái</h2>
                    </div>
                    <div class="ep-card-body">
                        <div class="ep-status-row">
                            @foreach (var s in new[] {
                                ("Draft","Nháp","dot-draft"),
                                ("Pending","Chờ duyệt","dot-pending"),
                                ("Approved","Đã duyệt","dot-approved"),
                                ("Published","Xuất bản","dot-published"),
                                ("Rejected","Từ chối","dot-rejected")
                            })
                            {
                                <label class="ep-status-opt @(model.Status == s.Item1 ? "active" : "")">
                                    <input type="radio" name="ep-status" value="@s.Item1"
                                           checked="@(model.Status == s.Item1)"
                                           @onchange="() => model.Status = s.Item1" />
                                    <span class="ep-status-dot @s.Item3"></span>
                                    @s.Item2
                                </label>
                            }
                        </div>
                    </div>
                </div>

                <!-- Settings card -->
                <div class="ep-card">
                    <div class="ep-card-header">
                        <div class="ep-card-header-icon">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="3" /><path d="M19.07 4.93a10 10 0 0 1 0 14.14M12 2a10 10 0 0 1 7.07 2.93" /><path d="M4.93 4.93a10 10 0 0 0 0 14.14M12 2a10 10 0 0 0-7.07 2.93" /></svg>
                        </div>
                        <h2>Cài đặt</h2>
                    </div>
                    <div class="ep-card-body">
                        <!-- Category -->
                        <div class="ep-field">
                            <label class="ep-label">Chuyên mục</label>
                            <select class="ep-input" @bind="model.CategoryId">
                                <option value="">-- Chọn chuyên mục --</option>
                                @foreach (var cat in categories)
                                {
                                    <option value="@cat.Id">@cat.CategoryName</option>
                                }
                            </select>
                        </div>

                        <!-- Post type -->
                        <div class="ep-field">
                            <label class="ep-label">Mã loại bài</label>
                            <div class="ep-type-select-row">
                                @foreach (var pt in new[] { "news", "announcement", "event", "gallery", "general" })
                                {
                                    <button type="button"
                                            class="ep-type-btn @(model.PostType == pt ? "active" : "")"
                                            @onclick="() => model.PostType = pt">
                                        @pt
                                    </button>
                                }
                            </div>
                            <input class="ep-input u-mt-8" @bind="model.PostType" placeholder="Hoặc nhập tùy chỉnh..." />
                        </div>

                        <!-- Sort order -->
                        <div class="ep-field">
                            <label class="ep-label">Thứ tự hiển thị</label>
                            <div class="ep-number-input-wrap">
                                <input class="ep-input" type="number" @bind="model.SortOrder" min="0" />
                                <div class="ep-number-arrows">
                                    <button type="button" @onclick="() => model.SortOrder++">▲</button>
                                    <button type="button" @onclick="() => { if (model.SortOrder > 0) model.SortOrder--; }">▼</button>
                                </div>
                            </div>
                        </div>

                        <!-- Featured -->
                        <div class="ep-field">
                            <div class="ep-toggle-row">
                                <div>
                                    <div class="ep-toggle-label">Bài viết nổi bật</div>
                                    <div class="ep-toggle-sub">Hiển thị ở vị trí nổi bật trang chủ</div>
                                </div>
                                <label class="ep-toggle">
                                    <input type="checkbox" @bind="model.IsFeatured" />
                                    <div class="ep-toggle-track">
                                        <div class="ep-toggle-thumb"></div>
                                    </div>
                                </label>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Cover image card -->
                <div class="ep-card">
                    <div class="ep-card-header">
                        <div class="ep-card-header-icon">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="3" width="18" height="18" rx="2" /><circle cx="8.5" cy="8.5" r="1.5" /><polyline points="21 15 16 10 5 21" /></svg>
                        </div>
                        <h2>Ảnh đại diện</h2>
                    </div>
                    <div class="ep-card-body">
                        <div class="ep-cover-preview">
                            @if (!string.IsNullOrWhiteSpace(model.CoverImageUrl))
                            {
                                <img src="@model.CoverImageUrl" alt="Cover" />
                            }
                            else
                            {
                                <div class="ep-cover-placeholder">
                                    <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2" /><circle cx="8.5" cy="8.5" r="1.5" /><polyline points="21 15 16 10 5 21" /></svg>
                                    <div class="ep-cover-empty-text">Chưa có ảnh đại diện</div>
                                </div>
                            }
                        </div>
                        <div class="ep-field u-mt-12">
                            <label class="ep-label">Chọn ảnh đại diện</label>
                            <InputFile OnChange="OnCoverSelected" accept="image/*" />
                            @if (selectedCoverFile != null)
                            {
                                <div class="ep-label-hint u-mt-6">Ảnh sẽ được tải lên khi lưu bài viết.</div>
                            }
                        </div>
                        <input class="ep-input" @bind="model.CoverImageUrl" @bind:event="oninput"
                               placeholder="/uploads/posts/covers/..." />
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- CKEditor Scripts (giữ nguyên từ file gốc) -->
<link rel="stylesheet" href="https://cdn.ckeditor.com/ckeditor5/47.6.1/ckeditor5.css" crossorigin />
<link rel="stylesheet" href="https://cdn.ckeditor.com/ckeditor5-premium-features/47.6.1/ckeditor5-premium-features.css" crossorigin />
<script src="https://cdn.ckeditor.com/ckeditor5/47.6.1/ckeditor5.umd.js" crossorigin></script>
<script src="https://cdn.ckeditor.com/ckeditor5-premium-features/47.6.1/ckeditor5-premium-features.umd.js" crossorigin></script>
<script src="https://cdn.ckbox.io/ckbox/2.9.2/ckbox.js" crossorigin></script>

@code {
    [Parameter] public string? Id { get; set; }
    private AdminPostDetail? model;
    private List<AdminPostCategoryItem>? categories;
    private List<AdminPostTagItem>? tags;
    private List<AdminPostMediaItem> mediaItems = new();
    private List<string> selectedTagIds = new();
    private List<IBrowserFile> selectedMediaFiles = new();
    private Dictionary<string, IBrowserFile> replacementMediaFiles = new();
    private IBrowserFile? selectedCoverFile;
    private AdminPostMediaDetail mediaModel = new() { MediaType = "image", SortOrder = 0 };
    private DotNetObjectReference<Edit>? dotNetRef;
    private IJSObjectReference? ckEditorModule;
    private bool editorReady;
    private string? editorLoadError;
    private string? editorContent;
    private const string EditorId = "post-content-editor";

    protected override async Task OnInitializedAsync()
    {
        categories = await AdminPostCategoryService.GetActiveCategoriesAsync(PN_PublicVariables.MaTruong);
        tags = await AdminPostTagService.GetActiveTagsAsync(PN_PublicVariables.MaTruong);

        if (!string.IsNullOrWhiteSpace(Id))
        {
            model = await AdminPostService.GetPostByIdAsync(Id);
            selectedTagIds = await AdminPostTagMapService.GetTagIdsByPostIdAsync(Id);
            mediaItems = await AdminPostMediaService.GetMediaAsync(PN_PublicVariables.MaTruong, Id);
            mediaModel.PostId = Id;
        }

        model ??= new AdminPostDetail
        {
            MaTruongBo = PN_PublicVariables.MaTruong,
            Status = "Draft"
        };

        editorContent = model.Content ?? string.Empty;
        mediaModel.MaTruongBo = PN_PublicVariables.MaTruong;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || model == null || editorReady || editorLoadError != null)
            return;

        try
        {
            dotNetRef ??= DotNetObjectReference.Create(this);
            ckEditorModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/ckeditor-interop.js");

            await ckEditorModule.InvokeVoidAsync(
                "initializeEditor",
                EditorId,
                "Soạn thảo bài viết...",
                editorContent ?? string.Empty,
                dotNetRef,
                PN_PublicVariables.LicenceEditor,
                null
            );

            editorReady = true;
        }
        catch (Exception ex)
        {
            editorLoadError = ex.Message;
        }

        StateHasChanged();
    }

    // ── Auto-slug từ tiêu đề ──
    private void OnTitleInput(ChangeEventArgs e)
    {
        model!.Title = e.Value?.ToString() ?? string.Empty;
        model.Slug = GenerateSlug(model.Title);
    }

    private bool _slugAutoGenerated = false;

    private static string GenerateSlug(string input)
    {
        if (string.IsNullOrWhiteSpace(input)) return string.Empty;

        var text = input.ToLowerInvariant();

        // Bảng chuyển đổi ký tự tiếng Việt
        var map = new Dictionary<string, string>
        {
            {"à","a"},{"á","a"},{"ả","a"},{"ã","a"},{"ạ","a"},
            {"ă","a"},{"ắ","a"},{"ằ","a"},{"ẵ","a"},{"ặ","a"},{"ẳ","a"},
            {"â","a"},{"ấ","a"},{"ầ","a"},{"ẫ","a"},{"ậ","a"},{"ẩ","a"},
            {"è","e"},{"é","e"},{"ẻ","e"},{"ẽ","e"},{"ẹ","e"},
            {"ê","e"},{"ế","e"},{"ề","e"},{"ể","e"},{"ễ","e"},{"ệ","e"},
            {"ì","i"},{"í","i"},{"ỉ","i"},{"ĩ","i"},{"ị","i"},
            {"ò","o"},{"ó","o"},{"ỏ","o"},{"õ","o"},{"ọ","o"},
            {"ô","o"},{"ố","o"},{"ồ","o"},{"ổ","o"},{"ỗ","o"},{"ộ","o"},
            {"ơ","o"},{"ớ","o"},{"ờ","o"},{"ở","o"},{"ỡ","o"},{"ợ","o"},
            {"ù","u"},{"ú","u"},{"ủ","u"},{"ũ","u"},{"ụ","u"},
            {"ư","u"},{"ứ","u"},{"ừ","u"},{"ử","u"},{"ữ","u"},{"ự","u"},
            {"ỳ","y"},{"ý","y"},{"ỷ","y"},{"ỹ","y"},{"ỵ","y"},
            {"đ","d"}
        };

        foreach (var kv in map)
            text = text.Replace(kv.Key, kv.Value);

        // Chỉ giữ chữ, số, dấu gạch ngang
        var sb = new System.Text.StringBuilder();
        bool prevDash = false;
        foreach (var c in text)
        {
            if (char.IsLetterOrDigit(c))
            {
                sb.Append(c);
                prevDash = false;
            }
            else if (!prevDash && sb.Length > 0)
            {
                sb.Append('-');
                prevDash = true;
            }
        }

        return sb.ToString().TrimEnd('-');
    }

    private async Task CopySlug()
    {
        var url = $"/tin/{model?.Slug}";
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", url);
    }

    private void ToggleTag(string? tagId)
    {
        if (string.IsNullOrWhiteSpace(tagId)) return;

        if (selectedTagIds.Contains(tagId))
            selectedTagIds.Remove(tagId);
        else
            selectedTagIds.Add(tagId);
    }

    private Task OnCoverSelected(InputFileChangeEventArgs e)
    {
        selectedCoverFile = e.File;
        return Task.CompletedTask;
    }

    private Task OnMediaSelected(InputFileChangeEventArgs e)
    {
        selectedMediaFiles = e.GetMultipleFiles().ToList();
        return Task.CompletedTask;
    }

    private void OnReplaceMediaSelected(string? mediaId, InputFileChangeEventArgs e)
    {
        if (string.IsNullOrWhiteSpace(mediaId)) return;
        var file = e.File;
        if (file != null)
            replacementMediaFiles[mediaId] = file;
    }

    private async Task DeleteMediaAsync(AdminPostMediaItem media)
    {
        if (model == null || string.IsNullOrWhiteSpace(media.Id)) return;

        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Xóa tệp đính kèm '{media.FileName}'?");
        if (!confirmed) return;

        await AdminPostMediaService.DeleteMediaAsync(media.Id);
        mediaItems = await AdminPostMediaService.GetMediaAsync(PN_PublicVariables.MaTruong, model.Id!);
        replacementMediaFiles.Remove(media.Id);
    }

    private async Task SaveAsync()
    {
        if (model == null) return;

        if (editorReady && ckEditorModule != null)
        {
            model.Content = await ckEditorModule.InvokeAsync<string>("waitForUploadsAndGetData", EditorId);
        }

        if (string.IsNullOrWhiteSpace(model.Id))
        {
            await AdminPostService.CreatePostAsync(model);
            var saved = await AdminPostService.GetPostsAsync(PN_PublicVariables.MaTruong, model.Title, model.Status, 1, 1);
            model.Id = saved.FirstOrDefault()?.Id;
        }
        else
        {
            await AdminPostService.UpdatePostAsync(model);
        }

        if (string.IsNullOrWhiteSpace(model.Id))
            return;

        if (selectedCoverFile != null)
        {
            var savedCover = await FileStorage.SaveImageAsync(selectedCoverFile, "posts/covers");
            if (!string.IsNullOrWhiteSpace(savedCover))
                model.CoverImageUrl = savedCover;
            selectedCoverFile = null;
        }

        if (selectedMediaFiles.Any())
        {
            foreach (var file in selectedMediaFiles)
            {
                var detail = new AdminPostMediaDetail
                {
                    PostId = model.Id,
                    MaTruongBo = PN_PublicVariables.MaTruong,
                    MediaType = mediaModel.MediaType,
                    Caption = mediaModel.Caption,
                    SortOrder = mediaModel.SortOrder,
                    CreatedBy = "system",
                    FileName = file.Name,
                    FileSize = file.Size,
                    MimeType = file.ContentType
                };

                await AdminPostMediaService.CreateMediaFromFileAsync(detail, file, "posts/media");
            }

            selectedMediaFiles.Clear();
        }

        foreach (var media in mediaItems.ToList())
        {
            if (replacementMediaFiles.TryGetValue(media.Id ?? string.Empty, out var newFile))
            {
                var replaceDetail = new AdminPostMediaDetail
                {
                    Id = media.Id,
                    PostId = model.Id,
                    MaTruongBo = PN_PublicVariables.MaTruong,
                    MediaType = media.MediaType,
                    Caption = media.Caption,
                    SortOrder = media.SortOrder,
                    CreatedBy = "system",
                    FileName = media.FileName,
                    FileSize = media.FileSize,
                    MimeType = media.MimeType
                };

                await AdminPostMediaService.ReplaceMediaFileAsync(replaceDetail, newFile, "posts/media");
            }
        }

        replacementMediaFiles.Clear();
        mediaItems = await AdminPostMediaService.GetMediaAsync(PN_PublicVariables.MaTruong, model.Id);

        await AdminPostTagMapService.ReplaceTagsAsync(model.Id, selectedTagIds);

        Nav.NavigateTo("/admin/posts");
    }


    private static string FormatFileSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / (1024.0 * 1024):F1} MB";
    }

    public async ValueTask DisposeAsync()
    {
        if (ckEditorModule != null)
        {
            try { await ckEditorModule.InvokeVoidAsync("destroyEditor", EditorId); } catch { }
            try { await ckEditorModule.DisposeAsync(); } catch { }
        }
        dotNetRef?.Dispose();
    }

    void IDisposable.Dispose() => dotNetRef?.Dispose();

    [JSInvokable]
    public async Task<string?> UploadEditorImageAsync(string base64Data, string fileName, string contentType)
    {
        var fileBytes = Convert.FromBase64String(base64Data);
        var file = new BrowserFileUpload(fileBytes, fileName, contentType);
        return await FileStorage.SaveImageAsync(file, "posts/covers");
    }

    private sealed class BrowserFileUpload : IBrowserFile
    {
        private readonly byte[] _bytes;
        public BrowserFileUpload(byte[] bytes, string name, string contentType)
        {
            _bytes = bytes; Name = name; ContentType = contentType;
            LastModified = DateTimeOffset.UtcNow;
        }
        public string Name { get; }
        public string ContentType { get; }
        public DateTimeOffset LastModified { get; }
        public long Size => _bytes.LongLength;
        public Stream OpenReadStream(long maxAllowedSize = 512000, CancellationToken cancellationToken = default)
            => new MemoryStream(_bytes, writable: false);
    }

    private void GoBack() => Nav.NavigateTo("/admin/posts");
    private void GoMedia()
    {
        if (!string.IsNullOrWhiteSpace(model?.Id))
            Nav.NavigateTo($"/admin/posts/{model.Id}/media");
    }
