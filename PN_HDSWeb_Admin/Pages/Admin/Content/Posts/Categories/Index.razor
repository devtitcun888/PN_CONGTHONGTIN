@page "/admin/post-categories"
@attribute [Authorize(Roles = "Administrator")]
@using PN_HDSWeb_Admin.Services.Content
@inject IAdminPostCategoryService AdminPostCategoryService
@inject NavigationManager Nav
@inject IJSRuntime JS



<div class="apc-root">

    <!-- Breadcrumb -->
    <nav class="apc-breadcrumb" aria-label="breadcrumb">
        <a href="/admin">Trang quản trị</a>
        <span class="apc-breadcrumb-sep">›</span>
        <span>Chuyên mục bài viết</span>
    </nav>

    <!-- Hero -->
    <div class="apc-hero">
        <h1>Chuyên mục bài viết</h1>
        <p>Quản lý cấu trúc chuyên mục cho module bài viết.</p>
    </div>

    <!-- Stats (chỉ hiển thị khi có dữ liệu) -->
    @if (items != null && items.Any())
    {
        <div class="apc-stats">
            <div class="apc-stat">
                <div class="apc-stat-num">@items.Count</div>
                <div class="apc-stat-label">Tổng chuyên mục</div>
            </div>
            <div class="apc-stat">
                <div class="apc-stat-num">@items.Count(x => x.IsActive)</div>
                <div class="apc-stat-label">Đang hoạt động</div>
            </div>
            <div class="apc-stat">
                <div class="apc-stat-num">@items.Count(x => string.IsNullOrWhiteSpace(x.ParentId))</div>
                <div class="apc-stat-label">Chuyên mục gốc</div>
            </div>
        </div>
    }

    <!-- Toolbar -->
    <div class="apc-toolbar">
        <div class="apc-toolbar-left">
            <div class="apc-search-wrap">
                <span class="material-symbols-outlined apc-search-icon" aria-hidden="true">search</span>
                <input class="apc-search-input"
                       type="text"
                       placeholder="Tìm chuyên mục..."
                       @bind="searchKeyword"
                       @bind:event="oninput" />
            </div>
            <select class="apc-filter-select" @bind="filterStatus">
                <option value="">Tất cả trạng thái</option>
                <option value="active">Đang bật</option>
                <option value="inactive">Đã tắt</option>
            </select>
        </div>
        <button class="apc-btn apc-btn-primary" @onclick="GoCreate">
            <span class="material-symbols-outlined">add</span>
            Thêm mới
        </button>
    </div>

    <!-- Content -->
    @if (items == null)
    {
        <div class="apc-loading">
            <div class="spinner"></div>
            <p>Đang tải dữ liệu...</p>
        </div>
    }
    else if (!FilteredItems.Any())
    {
        @if (!items.Any())
        {
            <div class="apc-empty">
                <span class="material-symbols-outlined">folder_off</span>
                <h3>Chưa có chuyên mục nào</h3>
                <p>Bắt đầu bằng cách tạo chuyên mục đầu tiên.</p>
                <button class="apc-btn apc-btn-primary" style="margin-top:8px" @onclick="GoCreate">
                    <span class="material-symbols-outlined">add</span>
                    Thêm chuyên mục
                </button>
            </div>
        }
        else
        {
            <div class="apc-empty">
                <span class="material-symbols-outlined">search_off</span>
                <h3>Không tìm thấy kết quả</h3>
                <p>Thử thay đổi từ khóa hoặc bộ lọc.</p>
            </div>
        }
    }
    else
    {
        <div class="apc-card">
            <div class="apc-table-wrap">
                <table class="apc-table">
                    <thead>
                        <tr>
                            <th class="apc-col-name">Tên chuyên mục</th>
                            <th class="apc-col-slug">Slug</th>
                            <th class="apc-col-order">Thứ tự</th>
                            <th class="apc-col-status">Trạng thái</th>
                            <th class="apc-col-action">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var tuple in FilteredItems)
                        {
                            var item = tuple.Item;
                            var level = tuple.Level;
                            var isRoot = level == 0;
                            var menuId = GetMenuId(item);

                            <tr>
                                <!-- Tên chuyên mục -->
                                <td>
                                    <div class="apc-name-cell">
                                        @if (level > 0)
                                        {
                                            <div class="apc-indent" style="margin-left: @((level - 1) * 20)px;">
                                                <span class="apc-indent-line"></span>
                                                <span class="apc-indent-dot"></span>
                                            </div>
                                            <span class="material-symbols-outlined apc-cat-icon">folder_open</span>
                                        }
                                        else
                                        {
                                            <span class="material-symbols-outlined apc-cat-icon">folder</span>
                                        }

                                        <span class="apc-cat-name @(isRoot ? string.Empty : "child")">
                                            @item.CategoryName
                                        </span>

                                        @if (isRoot)
                                        {
                                            <span class="apc-badge apc-badge-root">Gốc (Menu)</span>
                                        }
                                        else
                                        {
                                            <span class="apc-badge apc-badge-sub">Cấp @(level + 1)</span>
                                        }
                                    </div>
                                </td>

                                <!-- Slug -->
                                <td>
                                    <span class="apc-slug">/@item.Slug</span>
                                </td>

                                <!-- Thứ tự -->
                                <td>
                                    <span class="apc-order">@item.SortOrder</span>
                                </td>

                                <!-- Trạng thái -->
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="apc-status apc-status-active">
                                            <span class="dot"></span>
                                            Đang bật
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="apc-status apc-status-inactive">
                                            <span class="dot"></span>
                                            Đã tắt
                                        </span>
                                    }
                                </td>

                                <!-- Thao tác -->
                                <td>
                                    <div class="apc-actions">
                                        @if (isRoot)
                                        {
                                            <!-- Chuyên mục gốc: chỉ cho phép đi đến trang Menu -->
                                            @if (!string.IsNullOrWhiteSpace(menuId))
                                            {
                                                <button class="apc-action-btn apc-action-menu"
                                                        title="Chỉnh sửa tại trang Quản lý Menu"
                                                        @onclick="() => Edit(item)">
                                                    <span class="material-symbols-outlined">open_in_new</span>
                                                    Quản lý Menu
                                                </button>
                                            }
                                            <button class="apc-action-btn apc-action-delete"
                                                    title="Xóa tại trang Quản lý Menu"
                                                    @onclick="() => DeleteAsync(item)">
                                                <span class="material-symbols-outlined">delete</span>
                                                Xóa
                                            </button>
                                        }
                                        else
                                        {
                                            <!-- Danh mục con: đầy đủ thao tác -->
                                            <button class="apc-action-btn apc-action-edit"
                                                    @onclick="() => Edit(item)">
                                                <span class="material-symbols-outlined">edit</span>
                                                Sửa
                                            </button>

                                            @if (item.IsActive)
                                            {
                                                <button class="apc-action-btn apc-action-deactivate"
                                                        @onclick="() => ToggleAsync(item)">
                                                    <span class="material-symbols-outlined">visibility_off</span>
                                                    Tắt
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="apc-action-btn apc-action-activate"
                                                        @onclick="() => ToggleAsync(item)">
                                                    <span class="material-symbols-outlined">visibility</span>
                                                    Bật
                                                </button>
                                            }

                                            <button class="apc-action-btn apc-action-delete"
                                                    @onclick="() => DeleteAsync(item)">
                                                <span class="material-symbols-outlined">delete</span>
                                                Xóa
                                            </button>
                                        }
                                    </div>
                                </td>

                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Footer đếm số kết quả -->
            <div class="apc-table-footer">
                <span class="apc-table-footer-count">
                    Hiển thị @FilteredItems.Count() / @items.Count chuyên mục
                </span>
            </div>
        </div>
    }

</div>

@code {
    private List<AdminPostCategoryItem>? items;
    private string searchKeyword = string.Empty;
    private string filterStatus = string.Empty;

    /* ── Lọc theo từ khoá + trạng thái ── */
    private IEnumerable<(AdminPostCategoryItem Item, int Level)> FilteredItems
    {
        get
        {
            if (items == null) return Enumerable.Empty<(AdminPostCategoryItem Item, int Level)>();

            var hierarchical = BuildHierarchy(items);
            return hierarchical.Where(x =>
                (string.IsNullOrWhiteSpace(searchKeyword) ||
                 (x.Item.CategoryName ?? string.Empty)
                     .Contains(searchKeyword, StringComparison.OrdinalIgnoreCase)) &&
                filterStatus switch
                {
                    "active" => x.Item.IsActive,
                    "inactive" => !x.Item.IsActive,
                    _ => true
                }
            );
        }
    }

    private List<(AdminPostCategoryItem Item, int Level)> BuildHierarchy(IEnumerable<AdminPostCategoryItem> allItems)
    {
        var result = new List<(AdminPostCategoryItem Item, int Level)>();
        var allItemsList = allItems.ToList();
        var idSet = new HashSet<string>(allItemsList.Select(x => x.Id).Where(id => id != null)!);

        // Roots are items that have no parent, or their parent is not in the list of all items
        var roots = allItemsList
            .Where(x => string.IsNullOrWhiteSpace(x.ParentId) || !idSet.Contains(x.ParentId))
            .OrderBy(x => x.SortOrder)
            .ToList();

        foreach (var root in roots)
        {
            AddChildren(root, 0, allItemsList, result);
        }

        // In case there is a circular dependency (which shouldn't happen, but just in case),
        // we can add any items that were not visited.
        var visitedIds = new HashSet<string>(result.Select(x => x.Item.Id).Where(id => id != null)!);
        var unvisited = allItemsList.Where(x => x.Id != null && !visitedIds.Contains(x.Id)).ToList();
        if (unvisited.Any())
        {
            foreach (var item in unvisited.OrderBy(x => x.SortOrder))
            {
                result.Add((item, 0));
            }
        }

        return result;
    }

    private void AddChildren(AdminPostCategoryItem parent, int level, IEnumerable<AdminPostCategoryItem> allItems, List<(AdminPostCategoryItem Item, int Level)> result)
    {
        result.Add((parent, level));
        var children = allItems.Where(x => x.ParentId == parent.Id).OrderBy(x => x.SortOrder).ToList();
        foreach (var child in children)
        {
            AddChildren(child, level + 1, allItems, result);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        items = await AdminPostCategoryService.GetCategoriesAsync(PN_PublicVariables.MaTruong);
    }

    /* ── Điều hướng ── */
    private void GoCreate() => Nav.NavigateTo("/admin/post-categories/edit");

    private string? GetMenuId(AdminPostCategoryItem item)
    {
        if (item.CategoryCode != null && item.CategoryCode.StartsWith("MENU_"))
            return item.CategoryCode.Substring("MENU_".Length);
        return null;
    }

    private void Edit(AdminPostCategoryItem item)
    {
        if (string.IsNullOrWhiteSpace(item.ParentId))
        {
            var menuId = GetMenuId(item);
            if (!string.IsNullOrWhiteSpace(menuId))
            {
                Nav.NavigateTo($"/admin/menus/edit/{menuId}");
                return;
            }
        }
        Nav.NavigateTo($"/admin/post-categories/edit/{item.Id}");
    }

    /* ── Bật / Tắt ── */
    private async Task ToggleAsync(AdminPostCategoryItem item)
    {
        if (string.IsNullOrWhiteSpace(item.ParentId))
        {
            await JS.InvokeVoidAsync("alert",
                "Không thể trực tiếp bật/tắt chuyên mục gốc. " +
                "Vui lòng bật/tắt Menu tương ứng tại trang Quản lý Menu.");
            return;
        }

        if (await JS.InvokeAsync<bool>("confirm",
            $"Đổi trạng thái chuyên mục '{item.CategoryName}'?"))
        {
            await AdminPostCategoryService.SetActiveAsync(
                item.Id ?? string.Empty, !item.IsActive);
            items = await AdminPostCategoryService.GetCategoriesAsync(
                PN_PublicVariables.MaTruong);
        }
    }

    /* ── Xóa ── */
    private async Task DeleteAsync(AdminPostCategoryItem item)
    {
        if (string.IsNullOrWhiteSpace(item.ParentId))
        {
            await JS.InvokeVoidAsync("alert",
                "Không thể trực tiếp xóa chuyên mục gốc. " +
                "Vui lòng xóa Menu tương ứng tại trang Quản lý Menu để đồng bộ xóa chuyên mục.");
            return;
        }

        if (await JS.InvokeAsync<bool>("confirm",
            $"Xóa chuyên mục '{item.CategoryName}'?"))
        {
            await AdminPostCategoryService.DeleteCategoryAsync(item.Id ?? string.Empty);
            items = await AdminPostCategoryService.GetCategoriesAsync(
                PN_PublicVariables.MaTruong);
        }
    }
}
