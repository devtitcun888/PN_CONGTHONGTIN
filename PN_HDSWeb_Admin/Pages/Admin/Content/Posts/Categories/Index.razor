@page "/admin/post-categories"
@attribute [Authorize(Roles = "Administrator")]
@using PN_HDSWeb_Admin.Services.Content
@inject IAdminPostCategoryService AdminPostCategoryService
@inject NavigationManager Nav
@inject IJSRuntime JS


<div class="pc-root">

    <!-- Topbar -->
    <div class="pc-topbar">
        <nav class="pc-breadcrumb">
            <a href="/admin">Trang quản trị</a>
            <span class="pc-breadcrumb-sep">›</span>
            <span class="pc-breadcrumb-current">Chuyên mục bài viết</span>
        </nav>
    </div>

    <!-- Hero -->
    <div class="pc-hero">
        <div class="pc-hero-text">
            <h1>Chuyên mục bài viết</h1>
            <p>Quản lý chuyên mục cho module bài viết.</p>
        </div>
    </div>

    <!-- Toolbar -->
    <div class="pc-toolbar">
        <button class="pc-btn pc-btn-primary" @onclick="GoCreate">
            <svg width="15" height="15" viewBox="0 0 24 24"
                 fill="none" stroke="currentColor" stroke-width="2.5">
                <line x1="12" y1="5" x2="12" y2="19" />
                <line x1="5" y1="12" x2="19" y2="12" />
            </svg>
            Thêm mới
        </button>
    </div>

    <!-- Content -->
    <div class="pc-content">

        @if (items == null)
        {
            <div class="pc-loading">
                Đang tải dữ liệu...
            </div>
        }
        else if (!items.Any())
        {
            <div class="pc-card">
                <div class="pc-empty">
                    <h3>Chưa có chuyên mục</h3>
                    <p>Bắt đầu bằng cách tạo chuyên mục đầu tiên.</p>
                </div>
            </div>
        }
        else
        {
            <div class="pc-card">

                <table class="pc-table">

                    <thead>
                        <tr>
                            <th>Tên chuyên mục</th>
                            <th>Slug</th>
                            <th>Thứ tự</th>
                            <th>Trạng thái</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in items)
                        {
                            <tr>

                                <td>
                                    <div class="pc-category-name" style="display: flex; align-items: center;">
                                        @item.CategoryName
                                        @if (string.IsNullOrWhiteSpace(item.ParentId))
                                        {
                                            <span style="margin-left: 8px; font-size: 0.75rem; background: #e0f2fe; color: #0369a1; padding: 2px 6px; border-radius: 4px; font-weight: normal; border: 1px solid #bae6fd;">
                                                Gốc (Menu)
                                            </span>
                                        }
                                    </div>
                                </td>

                                <td>
                                    <span class="pc-slug">
                                        /@item.Slug
                                    </span>
                                </td>

                                <td>
                                    @item.SortOrder
                                </td>

                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="pc-badge pc-badge-active">
                                            <span class="dot"></span>
                                            Đang bật
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="pc-badge pc-badge-inactive">
                                            <span class="dot"></span>
                                            Đã tắt
                                        </span>
                                    }
                                </td>

                                <td>
                                    <div class="pc-actions">

                                        <button class="pc-btn pc-btn-ghost"
                                                @onclick="() => Edit(item)">
                                            Sửa
                                        </button>

                                        <button class="pc-btn pc-btn-ghost"
                                                @onclick="() => ToggleAsync(item)">
                                            @(item.IsActive ? "Tắt" : "Bật")
                                        </button>

                                        <button class="pc-btn-danger"
                                                @onclick="() => DeleteAsync(item)">
                                            Xóa
                                        </button>

                                    </div>
                                </td>

                            </tr>
                        }
                    </tbody>

                </table>

            </div>
        }

    </div>

</div>

@code {
    private List<AdminPostCategoryItem>? items;

    protected override async Task OnInitializedAsync()
    {
        items = await AdminPostCategoryService.GetCategoriesAsync(PN_PublicVariables.MaTruong);
    }

    private void GoCreate() => Nav.NavigateTo("/admin/post-categories/edit");
    
    private string? GetMenuId(AdminPostCategoryItem item)
    {
        if (item.CategoryCode != null && item.CategoryCode.StartsWith("MENU_"))
        {
            return item.CategoryCode.Substring("MENU_".Length);
        }
        return null;
    }

    private void Edit(AdminPostCategoryItem item)
    {
        if (string.IsNullOrWhiteSpace(item.ParentId))
        {
            var menuId = GetMenuId(item);
            if (!string.IsNullOrWhiteSpace(menuId))
            {
                Nav.NavigateTo($"/admin/menus/edit/{menuId}");
                return;
            }
        }
        Nav.NavigateTo($"/admin/post-categories/edit/{item.Id}");
    }

    private async Task ToggleAsync(AdminPostCategoryItem item)
    {
        if (string.IsNullOrWhiteSpace(item.ParentId))
        {
            await JS.InvokeVoidAsync("alert", "Không thể trực tiếp bật/tắt chuyên mục gốc. Vui lòng bật/tắt Menu tương ứng tại trang Quản lý Menu.");
            return;
        }
        if (await JS.InvokeAsync<bool>("confirm", $"Đổi trạng thái chuyên mục '{item.CategoryName}'?"))
        {
            await AdminPostCategoryService.SetActiveAsync(item.Id ?? string.Empty, !item.IsActive);
            items = await AdminPostCategoryService.GetCategoriesAsync(PN_PublicVariables.MaTruong);
        }
    }

    private async Task DeleteAsync(AdminPostCategoryItem item)
    {
        if (string.IsNullOrWhiteSpace(item.ParentId))
        {
            await JS.InvokeVoidAsync("alert", "Không thể trực tiếp xóa chuyên mục gốc. Vui lòng xóa Menu tương ứng tại trang Quản lý Menu để đồng bộ xóa chuyên mục.");
            return;
        }
        if (await JS.InvokeAsync<bool>("confirm", $"Xóa chuyên mục '{item.CategoryName}'?"))
        {
            await AdminPostCategoryService.DeleteCategoryAsync(item.Id ?? string.Empty);
            items = await AdminPostCategoryService.GetCategoriesAsync(PN_PublicVariables.MaTruong);
        }
    }
}

