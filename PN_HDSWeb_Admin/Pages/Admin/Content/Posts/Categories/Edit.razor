@page "/admin/post-categories/edit/{Id?}"
@attribute [Authorize(Roles = "Administrator")]
@using PN_HDSWeb_Admin.Services.Content
@inject IAdminPostCategoryService AdminPostCategoryService
@inject NavigationManager Nav
@inject IJSRuntime JS
<div class="pc-root">
    <!-- Breadcrumb -->
    <div class="pc-topbar">
        <nav class="pc-breadcrumb">
            <a href="/admin">Trang quản trị</a>
            <span class="pc-breadcrumb-sep">›</span>
            <a href="/admin/post-categories">Chuyên mục bài viết</a>
            <span class="pc-breadcrumb-sep">›</span>
            <span class="pc-breadcrumb-current">@(IsEditMode ? "Chỉnh sửa" : "Tạo mới")</span>
        </nav>
        <button class="pc-btn pc-btn-ghost pc-btn-sm" type="button" @onclick="GoBack">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 12H5M12 5l-7 7 7 7" /></svg>
            Quay lại
        </button>
    </div>

    <!-- Hero -->
    <div class="pc-hero">
        <h1>@(IsEditMode ? "Sửa chuyên mục" : "Thêm chuyên mục")</h1>
        <p>Quản lý chuyên mục bài viết theo cấu trúc cha/con.</p>
    </div>

    @if (model == null || allCategories == null)
    {
        <div class="pc-loading">
            <div class="pc-spinner"></div>
            <span>Đang tải dữ liệu...</span>
        </div>
    }
    else
    {
        <div class="pc-layout">
            <!-- Form cột trái -->
            <div class="pc-main-col">
                <div class="pc-card">
                    <div class="pc-card-header">
                        <div class="pc-card-header-icon">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /></svg>
                        </div>
                        <h2>Thông tin chuyên mục</h2>
                    </div>
                    <div class="pc-card-body">
                        @if (IsRootCategory)
                        {
                            <div class="alert alert-warning" style="margin-bottom: 20px; padding: 15px; border-radius: 6px; background-color: #fff3cd; border: 1px solid #ffeeba; color: #856404;">
                                Chuyên mục này là chuyên mục cha (gốc) được liên kết với Menu. 
                                Vui lòng thực hiện chỉnh sửa hoặc quản lý tại trang <a href="/admin/menus" style="font-weight: bold; color: #533f03; text-decoration: underline;">Quản lý Menu</a>.
                            </div>
                        }

                        <div class="u-grid-2">
                            <div class="pc-field">
                                <label class="pc-label">Mã chuyên mục (Tự động sinh)</label>
                                <input class="pc-input" value="@model.CategoryCode" disabled placeholder="VD: TIN" />
                            </div>
                            <div class="pc-field">
                                <label class="pc-label">Tên chuyên mục</label>
                                <input class="pc-input" value="@model.CategoryName" @oninput="OnCategoryNameInput" placeholder="VD: Chi bộ" disabled="@IsRootCategory" />
                            </div>
                            <div class="pc-field">
                                <label class="pc-label">Slug (Tự động sinh)</label>
                                <input class="pc-input" value="@model.Slug" placeholder="chi-bo" disabled />
                            </div>
                            <div class="pc-field">
                                <label class="pc-label">Chuyên mục cha</label>
                                @if (IsRootCategory)
                                {
                                    <select class="pc-input" value="" disabled>
                                        <option value="">-- Danh mục gốc --</option>
                                    </select>
                                }
                                else
                                {
                                    <select class="pc-input" @bind="model.ParentId">
                                        @foreach (var option in ParentOptions)
                                        {
                                            <option value="@option.Item1">@option.Item2</option>
                                        }
                                    </select>
                                }
                            </div>
                            <div class="pc-field">
                                <label class="pc-label">Thứ tự</label>
                                <input class="pc-input" type="number" @bind="model.SortOrder" min="0" disabled="@IsRootCategory" />
                            </div>
                            <div class="pc-field">
                                <label class="pc-label">Trạng thái</label>
                                <select class="pc-input" @bind="IsActiveText" disabled="@IsRootCategory">
                                    <option value="true">Đang bật</option>
                                    <option value="false">Tắt</option>
                                </select>
                            </div>
                            <div class="pc-field u-span-full">
                                <label class="pc-label">Mô tả</label>
                                <textarea class="pc-input" rows="4" @bind="model.Description" placeholder="Mô tả về chuyên mục..." disabled="@IsRootCategory"></textarea>
                            </div>
                        </div>

                        <div class="pc-action-bar">
                            @if (!IsRootCategory)
                            {
                                <button type="button" class="pc-btn pc-btn-primary" @onclick="SaveAsync">
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z" /><polyline points="17 21 17 13 7 13" /><polyline points="7 3 7 8 15 8" /></svg>
                                    Lưu
                                </button>
                            }
                            <button type="button" class="pc-btn pc-btn-ghost" @onclick="GoBack">@(IsRootCategory ? "Quay lại" : "Hủy")</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Cây danh mục cột phải -->
            <div class="pc-side-col">
                <div class="pc-tree-card">
                    <h3>Cây danh mục hiện có</h3>
                    @foreach (var line in GetTreeLines(allCategories.Where(x => string.IsNullOrWhiteSpace(x.ParentId)).OrderBy(x => x.SortOrder), 0))
                    {
                        <div class="pc-tree-item">@((MarkupString)line)</div>
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public string? Id { get; set; }
    private AdminPostCategoryDetail? model;
    private List<AdminPostCategoryItem>? allCategories;
    private string IsActiveText = "true";
    private bool IsEditMode => !string.IsNullOrWhiteSpace(Id);
    private bool IsRootCategory => IsEditMode && string.IsNullOrWhiteSpace(model?.ParentId);

    private IEnumerable<(string Item1, string Item2)> ParentOptions =>
        allCategories == null || model == null
            ? Enumerable.Empty<(string Item1, string Item2)>()
            : allCategories
                .Where(x => x.Id != model.Id)
                .Select(x => (x.Id ?? string.Empty, FormatLabel(x)))
                .Where(x => !string.IsNullOrWhiteSpace(x.Item1));

    protected override async Task OnInitializedAsync()
    {
        allCategories = await AdminPostCategoryService.GetCategoriesAsync(PN_PublicVariables.MaTruong);

        if (!string.IsNullOrWhiteSpace(Id))
        {
            model = await AdminPostCategoryService.GetCategoryByIdAsync(Id);
        }

        model ??= new AdminPostCategoryDetail
        {
            MaTruongBo = PN_PublicVariables.MaTruong,
            IsActive = true,
            SortOrder = 0
        };

        model.MaTruongBo ??= PN_PublicVariables.MaTruong;
        IsActiveText = model.IsActive.ToString().ToLowerInvariant();

        if (!IsEditMode && string.IsNullOrWhiteSpace(model.ParentId) && ParentOptions.Any())
        {
            model.ParentId = ParentOptions.First().Item1;
        }

        UpdateAutoSlug();
    }

    private void OnCategoryNameInput(ChangeEventArgs e)
    {
        model!.CategoryName = e.Value?.ToString();
        UpdateAutoSlug();
    }

    private void UpdateAutoSlug()
    {
        if (model != null)
        {
            model.Slug = PN_HDSWeb_Admin.Services.Admin.AdminMenuService.ToSlug(model.CategoryName);
            model.CategoryCode = PN_HDSWeb_Admin.Services.Admin.AdminMenuService.GenerateCategoryCode(model.CategoryName);
        }
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(model!.ParentId))
        {
            await JS.InvokeVoidAsync("alert", "Vui lòng chọn chuyên mục cha. Trang này chỉ cho phép tạo chuyên mục con!");
            return;
        }

        model!.IsActive = bool.TryParse(IsActiveText, out var active) && active;
        UpdateAutoSlug();

        if (string.IsNullOrWhiteSpace(model.Id))
            await AdminPostCategoryService.CreateCategoryAsync(model);
        else
            await AdminPostCategoryService.UpdateCategoryAsync(model);

        Nav.NavigateTo("/admin/post-categories");
    }

    private void GoBack() => Nav.NavigateTo("/admin/post-categories");

    private static string FormatLabel(AdminPostCategoryItem item)
        => string.IsNullOrWhiteSpace(item.ParentId) ? item.CategoryName ?? string.Empty : $"├─ {item.CategoryName}";

    private IEnumerable<string> GetTreeLines(IEnumerable<AdminPostCategoryItem> roots, int level)
    {
        foreach (var root in roots)
        {
            var indent = new string('·', level * 2);
            yield return $"{indent}{root.CategoryName} <span class=\"slug\">({root.Slug})</span>";
            var children = allCategories?.Where(x => x.ParentId == root.Id).OrderBy(x => x.SortOrder) ?? Enumerable.Empty<AdminPostCategoryItem>();
            foreach (var child in GetTreeLines(children, level + 1))
            {
                yield return child;
            }
        }
    }
}