@page "/admin/posts/{PostId}/media"
@attribute [Authorize(Roles = "Administrator")]
@using Microsoft.AspNetCore.Components.Forms
@using PN_HDSWeb_Admin.Services.Content
@using PN_HDSWeb_Admin.Services.Admin
@inject IAdminPostMediaService AdminPostMediaService
@inject IAdminFileStorageService FileStorage
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="admin-form-shell">
    <div class="admin-form-card">
        <div class="admin-form-header">
            <h1>Media bài viết</h1>
            <p>Quản lý file media, thứ tự hiển thị và xóa media của bài viết.</p>
        </div>

        <div class="admin-form-actions">
            <button type="button" class="btn btn-secondary" @onclick="GoBack">Quay lại bài viết</button>
        </div>

        @if (items == null)
        {
            <p>Đang tải...</p>
        }
        else
        {
            <div class="admin-form-grid">
                <label>
                    Loại media
                    <select class="admin-input" @bind="newMedia.MediaType">
                        <option value="image">image</option>
                        <option value="video">video</option>
                        <option value="file">file</option>
                    </select>
                </label>
                <label>
                    Caption
                    <input class="admin-input" @bind="newMedia.Caption" />
                </label>
                <label>
                    Upload file
                    <InputFile OnChange="OnFileSelected" />
                </label>
            </div>

            <div class="admin-form-actions">
                <button class="btn btn-primary" type="button" @onclick="AddAsync">Thêm media</button>
            </div>

            @if (!items.Any())
            {
                <p>Chưa có media nào.</p>
            }
            else
            {
                <table>
                    <thead>
                        <tr>
                            <th>Thứ tự</th>
                            <th>Loại</th>
                            <th>File</th>
                            <th>Caption</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in items)
                        {
                            <tr>
                                <td>
                                    <input class="u-sort-input" type="number" value="@item.SortOrder" @onchange="(e) => UpdateSortOrder(item, e)" />
                                </td>
                                <td>@item.MediaType</td>
                                <td><a href="@item.FileUrl" target="_blank">@item.FileName</a></td>
                                <td>@item.Caption</td>
                                <td>
                                    <button @onclick="() => DeleteAsync(item)">Xóa</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        }
    </div>
</div>

@code {
    [Parameter] public string? PostId { get; set; }
    private List<AdminPostMediaItem>? items;
    private AdminPostMediaDetail newMedia = new() { MediaType = "image", SortOrder = 0 };
    private IBrowserFile? selectedFile;

    protected override async Task OnInitializedAsync()
    {
        newMedia.MaTruongBo = PN_PublicVariables.MaTruong;
        newMedia.PostId = PostId;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        items = await AdminPostMediaService.GetMediaAsync(PN_PublicVariables.MaTruong, PostId ?? string.Empty);
    }

    private Task OnFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        return Task.CompletedTask;
    }

    private async Task AddAsync()
    {
        if (selectedFile == null || string.IsNullOrWhiteSpace(PostId)) return;

        var saved = await FileStorage.SaveFileAsync(selectedFile, "posts");
        if (string.IsNullOrWhiteSpace(saved)) return;

        newMedia.PostId = PostId;
        newMedia.FileUrl = saved;
        newMedia.FileName = selectedFile.Name;
        newMedia.FileSize = selectedFile.Size;
        newMedia.MimeType = selectedFile.ContentType;
        newMedia.CreatedBy = "system";

        await AdminPostMediaService.CreateMediaAsync(newMedia);
        selectedFile = null;
        newMedia.Caption = string.Empty;
        await LoadAsync();
    }

    private async Task UpdateSortOrder(AdminPostMediaItem item, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var sortOrder) && !string.IsNullOrWhiteSpace(item.Id))
        {
            await AdminPostMediaService.MoveMediaAsync(item.Id, sortOrder);
            await LoadAsync();
        }
    }

    private async Task DeleteAsync(AdminPostMediaItem item)
    {
        if (await JS.InvokeAsync<bool>("confirm", $"Xóa media '{item.FileName}'?"))
        {
            await AdminPostMediaService.DeleteMediaAsync(item.Id ?? string.Empty);
            await LoadAsync();
        }
    }

    private void GoBack() => Nav.NavigateTo($"/admin/posts/edit/{PostId}");
}
