@page "/admin/staff-profiles/edit/{Id?}"
@attribute [Authorize(Roles = "Administrator")]
@using Microsoft.AspNetCore.Components.Forms
@using PN_HDSWeb_Admin.Services.Admin
@using PN_HDSWeb_Admin.Services.Content
@inject IAdminStaffProfileService StaffProfileService
@inject IAdminFileStorageService FileStorage
@inject NavigationManager Nav
<div class="sp-root">
    <!-- Breadcrumb -->
    <div class="sp-topbar">
        <nav class="sp-breadcrumb">
            <a href="/admin">Trang quản trị</a>
            <span class="sp-breadcrumb-sep">›</span>
            <a href="/admin/staff-profiles">Hồ sơ nhân sự</a>
            <span class="sp-breadcrumb-sep">›</span>
            <span class="sp-breadcrumb-current">@(IsEditMode ? "Chỉnh sửa" : "Tạo mới")</span>
        </nav>
        <button class="sp-btn sp-btn-ghost sp-btn-sm" type="button" @onclick="GoBack">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 12H5M12 5l-7 7 7 7" /></svg>
            Quay lại
        </button>
    </div>

    <!-- Hero -->
    <div class="sp-hero">
        <h1>@(IsEditMode ? "Sửa hồ sơ nhân sự" : "Thêm hồ sơ nhân sự")</h1>
        <p>Quản lý hồ sơ dùng cho trang cơ cấu tổ chức công khai.</p>
    </div>

    @if (model == null)
    {
        <div class="sp-loading">
            <div class="sp-spinner"></div>
            <span>Đang tải dữ liệu...</span>
        </div>
    }
    else
    {
        <div class="sp-layout">
            <!-- Cột trái: Form -->
            <div class="sp-main-col">
                <div class="sp-card">
                    <div class="sp-card-header">
                        <div class="sp-card-header-icon">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /></svg>
                        </div>
                        <h2>Thông tin hồ sơ</h2>
                    </div>
                    <div class="sp-card-body">
                        <div class="sp-form-grid">
                            <div class="sp-field">
                                <label class="sp-label">Nhóm</label>
                                <select class="sp-input" @bind="model.GroupName">
                                    @foreach (var group in GroupOptions)
                                    {
                                        <option value="@group">@group</option>
                                    }
                                </select>
                            </div>
                            <div class="sp-field">
                                <label class="sp-label">Họ tên</label>
                                <input class="sp-input" @bind="model.FullName" placeholder="Nhập họ tên..." />
                            </div>
                            <div class="sp-field">
                                <label class="sp-label">Vị trí / Chức vụ</label>
                                <input class="sp-input" @bind="model.PositionName" placeholder="Hiệu trưởng, Phó hiệu trưởng..." />
                            </div>
                            <div class="sp-field">
                                <label class="sp-label">Trình độ</label>
                                <input class="sp-input" @bind="model.Qualification" placeholder="Thạc sĩ, Cử nhân..." />
                            </div>
                            <div class="sp-field">
                                <label class="sp-label">Chứng chỉ</label>
                                <input class="sp-input" @bind="model.CertificateInfo" placeholder="Thông tin chứng chỉ..." />
                            </div>
                            <div class="sp-field">
                                <label class="sp-label">Email</label>
                                <input class="sp-input" @bind="model.Email" placeholder="email@truong.edu.vn" />
                            </div>
                            <div class="sp-field">
                                <label class="sp-label">Số điện thoại</label>
                                <input class="sp-input" @bind="model.Phone" placeholder="Số điện thoại..." />
                            </div>
                            <div class="sp-field">
                                <label class="sp-label">Avatar URL</label>
                                <input class="sp-input" @bind="model.AvatarUrl" placeholder="https://..." />
                            </div>
                            <div class="sp-field">
                                <label class="sp-label">Upload avatar</label>
                                <label class="sp-file-zone">
                                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="17 8 12 3 7 8" /><line x1="12" y1="3" x2="12" y2="15" /></svg>
                                    <p><strong>Nhấn để chọn ảnh</strong></p>
                                    <InputFile OnChange="OnAvatarSelected" accept="image/*" />
                                </label>
                            </div>
                            <div class="sp-field">
                                <label class="sp-label">Thứ tự</label>
                                <input class="sp-input" type="number" @bind="model.SortOrder" min="0" />
                            </div>
                            <div class="sp-field">
                                <label class="sp-label">Công khai</label>
                                <select class="sp-input" @bind="IsPublicText">
                                    <option value="true">Có</option>
                                    <option value="false">Không</option>
                                </select>
                            </div>
                            <div class="sp-field">
                                <label class="sp-label">Trạng thái</label>
                                <select class="sp-input" @bind="IsActiveText">
                                    <option value="true">Đang bật</option>
                                    <option value="false">Tắt</option>
                                </select>
                            </div>
                            <div class="sp-field u-span-full">
                                <label class="sp-label">Mô tả / tiểu sử</label>
                                <textarea class="sp-input" rows="7" @bind="model.Bio" placeholder="Tiểu sử, quá trình công tác..."></textarea>
                            </div>
                        </div>

                        <div class="sp-action-bar">
                            <button type="button" class="sp-btn sp-btn-primary" @onclick="SaveAsync">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z" /><polyline points="17 21 17 13 7 13" /><polyline points="7 3 7 8 15 8" /></svg>
                                Lưu
                            </button>
                            <button type="button" class="sp-btn sp-btn-ghost" @onclick="GoBack">Hủy</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Cột phải: Avatar preview -->
            <div class="sp-side-col">
                <div class="sp-avatar-card">
                    <h3 class="sp-avatar-title">Ảnh đại diện</h3>
                    <div class="sp-avatar-image">
                        @if (!string.IsNullOrWhiteSpace(model.AvatarUrl))
                        {
                            <img src="@model.AvatarUrl" alt="Avatar" />
                        }
                        else
                        {
                            <span>Chưa có ảnh</span>
                        }
                    </div>
                    <p class="sp-help-text">
                        @(string.IsNullOrWhiteSpace(model.FullName) ? "Họ tên" : model.FullName)
                    </p>
                    <p class="sp-help-muted">
                        @(string.IsNullOrWhiteSpace(model.PositionName) ? "Chức vụ" : model.PositionName)
                    </p>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public string? Id { get; set; }
    private AdminStaffProfileDetail? model;
    private string IsPublicText = "true";
    private string IsActiveText = "true";
    private IBrowserFile? avatarFile;
    private bool IsEditMode => !string.IsNullOrWhiteSpace(Id);
    private static readonly string[] GroupOptions = ["Ban giám hiệu", "Tổ / Phòng ban", "Giáo viên", "Văn phòng", "Khác"];

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(Id))
        {
            model = await StaffProfileService.GetStaffProfileByIdAsync(Id);
        }

        model ??= new AdminStaffProfileDetail
        {
            MaTruongBo = PN_PublicVariables.MaTruong,
            IsPublic = true,
            IsActive = true,
            SortOrder = 0
        };

        model.MaTruongBo ??= PN_PublicVariables.MaTruong;
        IsPublicText = model.IsPublic.ToString().ToLowerInvariant();
        IsActiveText = model.IsActive.ToString().ToLowerInvariant();
    }

    private Task OnAvatarSelected(InputFileChangeEventArgs e)
    {
        avatarFile = e.File;
        return Task.CompletedTask;
    }

    private async Task SaveAsync()
    {
        model!.IsPublic = bool.TryParse(IsPublicText, out var isPublic) && isPublic;
        model.IsActive = bool.TryParse(IsActiveText, out var isActive) && isActive;

        if (avatarFile != null)
        {
            var saved = await FileStorage.SaveFileAsync(avatarFile, "staff-profiles");
            if (!string.IsNullOrWhiteSpace(saved))
            {
                model.AvatarUrl = saved;
            }
        }

        if (string.IsNullOrWhiteSpace(model.Id))
            await StaffProfileService.CreateStaffProfileAsync(model);
        else
            await StaffProfileService.UpdateStaffProfileAsync(model);

        Nav.NavigateTo("/admin/staff-profiles");
    }

    private void GoBack() => Nav.NavigateTo("/admin/staff-profiles");
}