@page "/admin/staff-profiles/edit/{Id?}"
@attribute [Authorize(Roles = "Administrator")]
@using Microsoft.AspNetCore.Components.Forms
@using PN_HDSWeb_Admin.Services.Admin
@using PN_HDSWeb_Admin.Services.Content
@inject IAdminStaffProfileService StaffProfileService
@inject IAdminFileStorageService FileStorage
@inject NavigationManager Nav

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700&family=Instrument+Serif:ital@0;1&display=swap');

    :root {
        --sp-bg: #f4f6fb;
        --sp-surface: #ffffff;
        --sp-surface-2: #f8fafd;
        --sp-border: #e4e9f2;
        --sp-border-focus: #3b6ef6;
        --sp-primary: #3b6ef6;
        --sp-primary-hover: #2554e0;
        --sp-primary-soft: #eef2fe;
        --sp-text: #0f1b35;
        --sp-text-2: #5a6a8a;
        --sp-text-3: #a0aec0;
        --sp-radius: 14px;
        --sp-radius-sm: 9px;
        --sp-shadow: 0 4px 24px rgba(15,27,53,.07);
        --sp-shadow-lg: 0 8px 40px rgba(15,27,53,.12);
        --sp-transition: .2s cubic-bezier(.4,0,.2,1);
    }

    .sp-root * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    .sp-root {
        font-family: 'Be Vietnam Pro', sans-serif;
        background: var(--sp-bg);
        min-height: 100vh;
        color: var(--sp-text);
    }

    /* Breadcrumb */
    .sp-topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 20px 32px 0;
        gap: 12px;
    }

    .sp-breadcrumb {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 13px;
        color: var(--sp-text-2);
    }

        .sp-breadcrumb a {
            color: var(--sp-primary);
            text-decoration: none;
            font-weight: 500;
        }

            .sp-breadcrumb a:hover {
                text-decoration: underline;
            }

    .sp-breadcrumb-sep {
        color: var(--sp-text-3);
    }

    .sp-breadcrumb-current {
        color: var(--sp-text);
        font-weight: 600;
    }

    /* Hero */
    .sp-hero {
        padding: 24px 32px 0;
    }

        .sp-hero h1 {
            font-family: 'Instrument Serif', serif;
            font-size: 28px;
            font-weight: 400;
            letter-spacing: -.3px;
            line-height: 1.2;
        }

        .sp-hero p {
            margin-top: 4px;
            font-size: 13.5px;
            color: var(--sp-text-2);
        }

    /* Layout */
    .sp-layout {
        display: grid;
        grid-template-columns: 1fr 340px;
        gap: 24px;
        padding: 24px 32px 40px;
        max-width: 1400px;
    }

    @@media (max-width: 1100px) {
        .sp-layout {
            grid-template-columns: 1fr;
        }

        .sp-topbar, .sp-hero {
            padding-left: 20px;
            padding-right: 20px;
        }

        .sp-layout {
            padding: 20px;
        }
    }

    /* Card */
    .sp-card {
        background: var(--sp-surface);
        border: 1px solid var(--sp-border);
        border-radius: var(--sp-radius);
        box-shadow: var(--sp-shadow);
        overflow: hidden;
        animation: sp-fadeup .3s ease both;
    }

    .sp-card-header {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 18px 22px 16px;
        border-bottom: 1px solid var(--sp-border);
        background: var(--sp-surface-2);
    }

    .sp-card-header-icon {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        background: var(--sp-primary-soft);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--sp-primary);
        flex-shrink: 0;
    }

    .sp-card-header h2 {
        font-size: 14px;
        font-weight: 600;
        color: var(--sp-text);
    }

    .sp-card-body {
        padding: 22px;
    }

    /* Form */
    .sp-form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }

    .sp-field {
        margin-bottom: 18px;
    }

        .sp-field:last-child {
            margin-bottom: 0;
        }

    .sp-label {
        display: block;
        font-size: 12.5px;
        font-weight: 600;
        color: var(--sp-text-2);
        text-transform: uppercase;
        letter-spacing: .4px;
        margin-bottom: 7px;
    }

    .sp-input {
        width: 100%;
        padding: 10px 14px;
        border: 1.5px solid var(--sp-border);
        border-radius: var(--sp-radius-sm);
        font-family: inherit;
        font-size: 14px;
        color: var(--sp-text);
        background: var(--sp-surface);
        transition: border-color var(--sp-transition), box-shadow var(--sp-transition);
        outline: none;
    }

        .sp-input:focus {
            border-color: var(--sp-border-focus);
            box-shadow: 0 0 0 3px rgba(59,110,246,.12);
        }

    textarea.sp-input {
        resize: vertical;
        min-height: 80px;
        line-height: 1.6;
    }

    select.sp-input {
        cursor: pointer;
    }

    /* File upload */
    .sp-file-zone {
        border: 2px dashed var(--sp-border);
        border-radius: var(--sp-radius-sm);
        padding: 16px;
        text-align: center;
        cursor: pointer;
        transition: all var(--sp-transition);
        background: var(--sp-surface-2);
    }

        .sp-file-zone:hover {
            border-color: var(--sp-primary);
            background: var(--sp-primary-soft);
        }

        .sp-file-zone p {
            font-size: 13px;
            color: var(--sp-text-2);
            margin-top: 8px;
        }

        .sp-file-zone strong {
            color: var(--sp-primary);
        }

        .sp-file-zone input[type=file] {
            display: none;
        }

    /* Avatar preview */
    .sp-avatar-card {
        background: var(--sp-surface);
        border: 1px solid var(--sp-border);
        border-radius: var(--sp-radius);
        padding: 22px;
        box-shadow: var(--sp-shadow);
        text-align: center;
    }

    .sp-avatar-image {
        width: 140px;
        height: 140px;
        border-radius: 50%;
        object-fit: cover;
        border: 3px solid var(--sp-border);
        background: var(--sp-surface-2);
        margin: 0 auto 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--sp-text-3);
        font-size: 13px;
    }

        .sp-avatar-image img {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            object-fit: cover;
        }

    /* Buttons */
    .sp-btn {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 10px 20px;
        border-radius: var(--sp-radius-sm);
        font-family: inherit;
        font-size: 13.5px;
        font-weight: 600;
        cursor: pointer;
        border: 1.5px solid transparent;
        transition: all var(--sp-transition);
        white-space: nowrap;
    }

        .sp-btn:disabled {
            opacity: .5;
            cursor: not-allowed;
        }

    .sp-btn-primary {
        background: var(--sp-primary);
        color: white;
        border-color: var(--sp-primary);
        box-shadow: 0 2px 12px rgba(59,110,246,.25);
    }

        .sp-btn-primary:hover:not(:disabled) {
            background: var(--sp-primary-hover);
            border-color: var(--sp-primary-hover);
            box-shadow: 0 4px 18px rgba(59,110,246,.35);
            transform: translateY(-1px);
        }

    .sp-btn-ghost {
        background: transparent;
        color: var(--sp-text-2);
        border-color: var(--sp-border);
    }

        .sp-btn-ghost:hover:not(:disabled) {
            border-color: var(--sp-text-2);
            color: var(--sp-text);
            background: var(--sp-surface-2);
        }

    .sp-btn-sm {
        padding: 7px 14px;
        font-size: 12.5px;
    }

    .sp-action-bar {
        display: flex;
        gap: 10px;
        margin-top: 24px;
    }

    /* Loading */
    .sp-loading {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 14px;
        min-height: 50vh;
        color: var(--sp-text-2);
        font-size: 14px;
    }

    .sp-spinner {
        width: 28px;
        height: 28px;
        border: 3px solid var(--sp-border);
        border-top-color: var(--sp-primary);
        border-radius: 50%;
        animation: sp-spin .75s linear infinite;
    }

    @@keyframes sp-spin {
        to {
            transform: rotate(360deg);
        }
    }

    @@keyframes sp-fadeup {
        from {
            opacity: 0;
            transform: translateY(12px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .sp-main-col > .sp-card {
        animation-delay: .06s;
    }

    .sp-side-col > .sp-card {
        animation-delay: .1s;
    }
</style>

<div class="sp-root">
    <!-- Breadcrumb -->
    <div class="sp-topbar">
        <nav class="sp-breadcrumb">
            <a href="/admin">Trang quản trị</a>
            <span class="sp-breadcrumb-sep">›</span>
            <a href="/admin/staff-profiles">Hồ sơ nhân sự</a>
            <span class="sp-breadcrumb-sep">›</span>
            <span class="sp-breadcrumb-current">@(IsEditMode ? "Chỉnh sửa" : "Tạo mới")</span>
        </nav>
        <button class="sp-btn sp-btn-ghost sp-btn-sm" type="button" @onclick="GoBack">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 12H5M12 5l-7 7 7 7" /></svg>
            Quay lại
        </button>
    </div>

    <!-- Hero -->
    <div class="sp-hero">
        <h1>@(IsEditMode ? "Sửa hồ sơ nhân sự" : "Thêm hồ sơ nhân sự")</h1>
        <p>Quản lý hồ sơ dùng cho trang cơ cấu tổ chức công khai.</p>
    </div>

    @if (model == null)
    {
        <div class="sp-loading">
            <div class="sp-spinner"></div>
            <span>Đang tải dữ liệu...</span>
        </div>
    }
    else
    {
        <div class="sp-layout">
            <!-- Cột trái: Form -->
            <div class="sp-main-col">
                <div class="sp-card">
                    <div class="sp-card-header">
                        <div class="sp-card-header-icon">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /></svg>
                        </div>
                        <h2>Thông tin hồ sơ</h2>
                    </div>
                    <div class="sp-card-body">
                        <div class="sp-form-grid">
                            <div class="sp-field">
                                <label class="sp-label">Nhóm</label>
                                <select class="sp-input" @bind="model.GroupName">
                                    @foreach (var group in GroupOptions)
                                    {
                                        <option value="@group">@group</option>
                                    }
                                </select>
                            </div>
                            <div class="sp-field">
                                <label class="sp-label">Họ tên</label>
                                <input class="sp-input" @bind="model.FullName" placeholder="Nhập họ tên..." />
                            </div>
                            <div class="sp-field">
                                <label class="sp-label">Vị trí / Chức vụ</label>
                                <input class="sp-input" @bind="model.PositionName" placeholder="Hiệu trưởng, Phó hiệu trưởng..." />
                            </div>
                            <div class="sp-field">
                                <label class="sp-label">Trình độ</label>
                                <input class="sp-input" @bind="model.Qualification" placeholder="Thạc sĩ, Cử nhân..." />
                            </div>
                            <div class="sp-field">
                                <label class="sp-label">Chứng chỉ</label>
                                <input class="sp-input" @bind="model.CertificateInfo" placeholder="Thông tin chứng chỉ..." />
                            </div>
                            <div class="sp-field">
                                <label class="sp-label">Email</label>
                                <input class="sp-input" @bind="model.Email" placeholder="email@truong.edu.vn" />
                            </div>
                            <div class="sp-field">
                                <label class="sp-label">Số điện thoại</label>
                                <input class="sp-input" @bind="model.Phone" placeholder="Số điện thoại..." />
                            </div>
                            <div class="sp-field">
                                <label class="sp-label">Avatar URL</label>
                                <input class="sp-input" @bind="model.AvatarUrl" placeholder="https://..." />
                            </div>
                            <div class="sp-field">
                                <label class="sp-label">Upload avatar</label>
                                <label class="sp-file-zone">
                                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="17 8 12 3 7 8" /><line x1="12" y1="3" x2="12" y2="15" /></svg>
                                    <p><strong>Nhấn để chọn ảnh</strong></p>
                                    <InputFile OnChange="OnAvatarSelected" accept="image/*" />
                                </label>
                            </div>
                            <div class="sp-field">
                                <label class="sp-label">Thứ tự</label>
                                <input class="sp-input" type="number" @bind="model.SortOrder" min="0" />
                            </div>
                            <div class="sp-field">
                                <label class="sp-label">Công khai</label>
                                <select class="sp-input" @bind="IsPublicText">
                                    <option value="true">Có</option>
                                    <option value="false">Không</option>
                                </select>
                            </div>
                            <div class="sp-field">
                                <label class="sp-label">Trạng thái</label>
                                <select class="sp-input" @bind="IsActiveText">
                                    <option value="true">Đang bật</option>
                                    <option value="false">Tắt</option>
                                </select>
                            </div>
                            <div class="sp-field" style="grid-column:1/-1;">
                                <label class="sp-label">Mô tả / tiểu sử</label>
                                <textarea class="sp-input" rows="7" @bind="model.Bio" placeholder="Tiểu sử, quá trình công tác..."></textarea>
                            </div>
                        </div>

                        <div class="sp-action-bar">
                            <button type="button" class="sp-btn sp-btn-primary" @onclick="SaveAsync">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z" /><polyline points="17 21 17 13 7 13" /><polyline points="7 3 7 8 15 8" /></svg>
                                Lưu
                            </button>
                            <button type="button" class="sp-btn sp-btn-ghost" @onclick="GoBack">Hủy</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Cột phải: Avatar preview -->
            <div class="sp-side-col">
                <div class="sp-avatar-card">
                    <h3 style="font-size:14px;font-weight:600;margin-bottom:16px;">Ảnh đại diện</h3>
                    <div class="sp-avatar-image">
                        @if (!string.IsNullOrWhiteSpace(model.AvatarUrl))
                        {
                            <img src="@model.AvatarUrl" alt="Avatar" />
                        }
                        else
                        {
                            <span>Chưa có ảnh</span>
                        }
                    </div>
                    <p style="font-size:13px;color:var(--sp-text-2);">
                        @(string.IsNullOrWhiteSpace(model.FullName) ? "Họ tên" : model.FullName)
                    </p>
                    <p style="font-size:13px;color:var(--sp-text-3);">
                        @(string.IsNullOrWhiteSpace(model.PositionName) ? "Chức vụ" : model.PositionName)
                    </p>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public string? Id { get; set; }
    private AdminStaffProfileDetail? model;
    private string IsPublicText = "true";
    private string IsActiveText = "true";
    private IBrowserFile? avatarFile;
    private bool IsEditMode => !string.IsNullOrWhiteSpace(Id);
    private static readonly string[] GroupOptions = ["Ban giám hiệu", "Tổ / Phòng ban", "Giáo viên", "Văn phòng", "Khác"];

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(Id))
        {
            model = await StaffProfileService.GetStaffProfileByIdAsync(Id);
        }

        model ??= new AdminStaffProfileDetail
        {
            MaTruongBo = PN_PublicVariables.MaTruong,
            IsPublic = true,
            IsActive = true,
            SortOrder = 0
        };

        model.MaTruongBo ??= PN_PublicVariables.MaTruong;
        IsPublicText = model.IsPublic.ToString().ToLowerInvariant();
        IsActiveText = model.IsActive.ToString().ToLowerInvariant();
    }

    private Task OnAvatarSelected(InputFileChangeEventArgs e)
    {
        avatarFile = e.File;
        return Task.CompletedTask;
    }

    private async Task SaveAsync()
    {
        model!.IsPublic = bool.TryParse(IsPublicText, out var isPublic) && isPublic;
        model.IsActive = bool.TryParse(IsActiveText, out var isActive) && isActive;

        if (avatarFile != null)
        {
            var saved = await FileStorage.SaveFileAsync(avatarFile, "staff-profiles");
            if (!string.IsNullOrWhiteSpace(saved))
            {
                model.AvatarUrl = saved;
            }
        }

        if (string.IsNullOrWhiteSpace(model.Id))
            await StaffProfileService.CreateStaffProfileAsync(model);
        else
            await StaffProfileService.UpdateStaffProfileAsync(model);

        Nav.NavigateTo("/admin/staff-profiles");
    }

    private void GoBack() => Nav.NavigateTo("/admin/staff-profiles");
}