@page "/login-admin"
@namespace LoginComponent
@using Microsoft.AspNetCore.WebUtilities
@using PN_HDSWeb_Admin.Services.Auth
@using PN_HDSWeb_Admin.Data
@inject IAdminLoginService AdminLoginService
@inject HttpContentService HttpContentService
@inject NavigationManager navManager

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700&family=Instrument+Serif:ital@0;1&display=swap');

    :root {
        --lg-bg: #f4f6fb;
        --lg-surface: #ffffff;
        --lg-border: #e4e9f2;
        --lg-border-focus: #3b6ef6;
        --lg-primary: #3b6ef6;
        --lg-primary-hover: #2554e0;
        --lg-primary-soft: #eef2fe;
        --lg-text: #0f1b35;
        --lg-text-2: #5a6a8a;
        --lg-text-3: #a0aec0;
        --lg-danger: #e53e3e;
        --lg-danger-soft: #fff5f5;
        --lg-radius: 14px;
        --lg-radius-sm: 9px;
        --lg-shadow: 0 8px 32px rgba(15,27,53,.12);
        --lg-transition: .2s cubic-bezier(.4,0,.2,1);
    }

    .lg-root {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        background: var(--lg-bg);
        font-family: 'Be Vietnam Pro', sans-serif;
        color: var(--lg-text);
        padding: 20px;
        box-sizing: border-box;
    }

    .lg-card {
        width: 100%;
        max-width: 420px;
        background: var(--lg-surface);
        border-radius: var(--lg-radius);
        box-shadow: var(--lg-shadow);
        padding: 36px 32px 32px;
        animation: lg-fadeup .4s ease;
    }

        .lg-card h1 {
            font-family: 'Instrument Serif', serif;
            font-size: 26px;
            font-weight: 400;
            text-align: center;
            margin: 0 0 8px;
            color: var(--lg-text);
        }

        .lg-card .lg-sub {
            text-align: center;
            font-size: 13.5px;
            color: var(--lg-text-2);
            margin-bottom: 28px;
        }

    .lg-divider {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 20px 0;
        color: var(--lg-text-3);
        font-size: 12px;
        font-weight: 500;
        text-transform: uppercase;
    }

        .lg-divider::before,
        .lg-divider::after {
            content: '';
            flex: 1;
            height: 1px;
            background: var(--lg-border);
        }

    .lg-field {
        margin-bottom: 16px;
    }

    .lg-label {
        display: block;
        font-size: 12.5px;
        font-weight: 600;
        color: var(--lg-text-2);
        text-transform: uppercase;
        letter-spacing: .4px;
        margin-bottom: 6px;
    }

    .lg-input {
        width: 100%;
        padding: 10px 14px;
        border: 1.5px solid var(--lg-border);
        border-radius: var(--lg-radius-sm);
        font-family: inherit;
        font-size: 14px;
        color: var(--lg-text);
        background: var(--lg-surface);
        transition: border-color var(--lg-transition), box-shadow var(--lg-transition);
        outline: none;
    }

        .lg-input:focus {
            border-color: var(--lg-border-focus);
            box-shadow: 0 0 0 3px rgba(59,110,246,.12);
        }

    .lg-error {
        margin-top: 12px;
        padding: 10px 14px;
        background: var(--lg-danger-soft);
        border: 1px solid #fed7d7;
        border-radius: var(--lg-radius-sm);
        font-size: 13px;
        color: var(--lg-danger);
        text-align: center;
    }

    .lg-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        width: 100%;
        padding: 11px 18px;
        border-radius: var(--lg-radius-sm);
        font-family: inherit;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        border: 1.5px solid transparent;
        transition: all var(--lg-transition);
        white-space: nowrap;
        text-decoration: none;
        background: none;
    }

    .lg-btn-primary {
        background: var(--lg-primary);
        color: white;
        border-color: var(--lg-primary);
        box-shadow: 0 2px 12px rgba(59,110,246,.25);
    }

        .lg-btn-primary:hover {
            background: var(--lg-primary-hover);
            border-color: var(--lg-primary-hover);
            box-shadow: 0 4px 18px rgba(59,110,246,.35);
            transform: translateY(-1px);
        }

    .lg-btn-ghost {
        background: transparent;
        color: var(--lg-text-2);
        border-color: var(--lg-border);
    }

        .lg-btn-ghost:hover {
            border-color: var(--lg-text-2);
            color: var(--lg-text);
            background: #f8fafd;
        }

    @@keyframes lg-fadeup {
        from {
            opacity: 0;
            transform: translateY(16px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@media (max-width: 480px) {
        .lg-card {
            padding: 28px 20px 24px;
        }
    }
</style>

<div class="lg-root">
    <div class="lg-card">
        <h1>Đăng nhập quản trị</h1>
        <p class="lg-sub">Truy cập hệ thống quản lý trường học</p>

        <!-- SSO -->
        <button class="lg-btn lg-btn-ghost" @onclick="LoginSSO">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>
            Đăng nhập SSO
        </button>

        <div class="lg-divider">hoặc</div>

        <!-- Local account -->
        <div class="lg-field">
            <label class="lg-label">Tên đăng nhập</label>
            <input class="lg-input" @bind="username" placeholder="Nhập tên đăng nhập" />
        </div>
        <div class="lg-field">
            <label class="lg-label">Mật khẩu</label>
            <input class="lg-input" @bind="password" type="password" placeholder="Nhập mật khẩu" />
        </div>

        <button class="lg-btn lg-btn-primary" @onclick="LoginLocal">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4" /><polyline points="10 17 15 12 10 7" /><line x1="15" y1="12" x2="3" y2="12" /></svg>
            Đăng nhập tài khoản
        </button>

        @if (!string.IsNullOrEmpty(message))
        {
            <div class="lg-error">@message</div>
        }
    </div>
</div>

@code {
    private string username = string.Empty;
    private string password = string.Empty;
    private string message = string.Empty;
    private bool _handledToken;

    protected override async Task OnInitializedAsync()
    {
        await TryLoginByTokenFromQueryAsync();
    }

    private async Task TryLoginByTokenFromQueryAsync()
    {
        if (_handledToken)
            return;

        _handledToken = true;

        var uri = navManager.ToAbsoluteUri(navManager.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);
        if (!query.TryGetValue("token", out var tokenValues) || string.IsNullOrWhiteSpace(tokenValues.FirstOrDefault()))
            return;

        var token = tokenValues.First();
        var result = await AdminLoginService.LoginBySsoAsync(token, navManager.Uri);
        if (!result.IsSuccess)
        {
            message = result.Message;
            return;
        }

        await AdminLoginService.UpdateSessionAsync(result.Session!);
        navManager.NavigateTo("/dashboard", true);
    }

    private async Task LoginSSO()
    {
        message = string.Empty;
        var ssoUrl = await HttpContentService.HandleDirectToSSO(0, navManager.Uri, PN_PublicVariables.MaTruong);
        if (ssoUrl == null || string.IsNullOrWhiteSpace(ssoUrl.Result))
        {
            message = "Không lấy được URL đăng nhập SSO.";
            return;
        }

        navManager.NavigateTo(ssoUrl.Result, true);
    }

    private async Task LoginLocal()
    {
        var result = await AdminLoginService.LoginByLocalAccountAsync(username, password, PN_PublicVariables.MaTruong);
        if (!result.IsSuccess)
        {
            message = result.Message;
            return;
        }

        await AdminLoginService.UpdateSessionAsync(result.Session!);
        navManager.NavigateTo("/dashboard", true);
    }
}