@page "/posts/tag/{Slug}"
@using PN_HDSWeb_Admin.Services.Public
@inject IPublicPostTagService PublicPostTagService
@inject IPublicPostService PublicPostService

<div class="public-article">
    <nav class="breadcrumb">
        <a href="/">Trang chủ</a>
        <span>/</span>
        <a href="/posts">Bài viết</a>
        <span>/</span>
        <span>@(tag?.TagName ?? Slug)</span>
    </nav>

    <section class="content-card">
        @if (tag == null)
        {
            <p>Đang tải hoặc không tìm thấy tag.</p>
        }
        else
        {
            <h1>@tag.TagName</h1>
        }
    </section>

    <section class="content-card">
        @if (posts == null)
        {
            <p>Đang tải...</p>
        }
        else if (!posts.Any())
        {
            <p>Không có bài viết nào có tag này.</p>
        }
        else
        {
            <div class="search-result-list">
                @foreach (var item in posts)
                {
                    <article class="search-result-item">
                        <h3><a href="@PostHref(item)">@item.Title</a></h3>
                        <p>@item.Summary</p>
                    </article>
                }
            </div>
        }
    </section>
</div>

@code {
    [Parameter] public string? Slug { get; set; }
    private PublicPostTagItem? tag;
    private List<PublicPostListItem>? posts;

    protected override async Task OnParametersSetAsync()
    {
        tag = null;
        posts = null;
        tag = (await PublicPostTagService.GetTagsByPostIdAsync(""))?.FirstOrDefault(x => x.Slug == Slug);
        if (tag != null)
        {
            posts = await PublicPostService.GetPostsByTagIdAsync(PN_PublicVariables.MaTruong, tag.Id ?? string.Empty, 1, 30);
        }
        else
        {
            posts = new();
        }
    }

    private static string PostHref(PublicPostListItem item)
        => string.IsNullOrWhiteSpace(item.Slug) ? "/posts" : $"/posts/{item.Slug}";
}
