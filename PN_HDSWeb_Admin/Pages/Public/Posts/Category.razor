@page "/posts/category/{Slug}"
@using PN_HDSWeb_Admin.Services.Public
@inject IPublicPostCategoryService PublicPostCategoryService
@inject IPublicPostService PublicPostService

<div class="public-page public-category-page">
    <nav class="public-breadcrumb" aria-label="breadcrumb">
        <a href="/">Trang chủ</a>
        <span>/</span>
        <a href="/posts">Bài viết</a>
        @foreach (var node in breadcrumbNodes)
        {
            <span>/</span>
            <a href="@CategoryHref(node)">@node.CategoryName</a>
        }
    </nav>

    <section class="public-page-head">
        @if (category == null)
        {
            <div>
                <div class="public-kicker">Chuyên mục</div>
                <h1>Không tìm thấy chuyên mục</h1>
                <p>Đường dẫn này không khớp với chuyên mục đang được công khai.</p>
            </div>
            <a class="public-button public-button-soft" href="/posts">Tất cả bài viết</a>
        }
        else
        {
            <div>
                <div class="public-kicker">Chuyên mục</div>
                <h1>@category.CategoryName</h1>
                @if (!string.IsNullOrWhiteSpace(category.Description))
                {
                    <p>@category.Description</p>
                }
            </div>
            <a class="public-button public-button-soft" href="/posts">Tất cả bài viết</a>
        }
    </section>

    @if (childCategories.Any())
    {
        <section class="public-card">
            <div class="public-card-head">
                <h2>Chuyên mục con</h2>
                <span>@childCategories.Count</span>
            </div>
            <div class="public-chip-grid">
                @foreach (var child in childCategories)
                {
                    <a class="public-chip-card" href="@CategoryHref(child)">
                        <strong>@child.CategoryName</strong>
                        @if (!string.IsNullOrWhiteSpace(child.Description))
                        {
                            <span>@child.Description</span>
                        }
                    </a>
                }
            </div>
        </section>
    }

    @if (isLoading)
    {
        <div class="public-state-card">
            <div class="spinner"></div>
            <p>Đang tải bài viết...</p>
        </div>
    }
    else if (childCategoryGroups.Any())
    {
        @foreach (var group in childCategoryGroups)
        {
            <section class="public-card public-category-group">
                <div class="public-card-head">
                    <div>
                        <h2>@group.Category.CategoryName</h2>
                        @if (!string.IsNullOrWhiteSpace(group.Category.Description))
                        {
                            <p>@group.Category.Description</p>
                        }
                    </div>
                    <a class="public-button public-button-ghost" href="@CategoryHref(group.Category)">Xem chuyên mục</a>
                </div>

                @if (group.Posts.Any())
                {
                    <div class="public-article-grid public-article-grid-compact">
                        @foreach (var item in group.Posts.Take(6))
                        {
                            <article class="public-article-card">
                                <a class="public-article-media" href="@PostHref(item)" aria-label="@item.Title">
                                    @if (!string.IsNullOrWhiteSpace(item.CoverImageUrl))
                                    {
                                        <img src="@item.CoverImageUrl" alt="@item.Title" loading="lazy" />
                                    }
                                    else
                                    {
                                        <span class="material-symbols-outlined">image</span>
                                    }
                                </a>
                                <div class="public-article-body">
                                    <div class="public-article-meta">
                                        <span>@(item.PublishAt?.ToString("dd/MM/yyyy") ?? "Chưa có ngày")</span>
                                        <span class="post-card-view-count">
                                            <span class="material-symbols-outlined">visibility</span>
                                            @FormatViews(item.ViewCount)
                                        </span>
                                    </div>
                                    <h2><a href="@PostHref(item)">@item.Title</a></h2>
                                    @if (!string.IsNullOrWhiteSpace(item.Summary))
                                    {
                                        <p>@item.Summary</p>
                                    }
                                </div>
                            </article>
                        }
                    </div>
                }
                else
                {
                    <p class="public-empty-text">Chưa có bài viết trong chuyên mục này.</p>
                }
            </section>
        }
    }
    else if (posts == null || !posts.Any())
    {
        <div class="public-state-card">
            <span class="material-symbols-outlined">article</span>
            <h2>Chưa có bài viết</h2>
            <p>Chuyên mục này chưa có bài viết được công khai.</p>
            <a class="public-button public-button-primary" href="/posts">Quay về danh sách</a>
        </div>
    }
    else
    {
        <section class="public-article-grid">
            @foreach (var item in posts)
            {
                <article class="public-article-card">
                    <a class="public-article-media" href="@PostHref(item)" aria-label="@item.Title">
                        @if (!string.IsNullOrWhiteSpace(item.CoverImageUrl))
                        {
                            <img src="@item.CoverImageUrl" alt="@item.Title" loading="lazy" />
                        }
                        else
                        {
                            <span class="material-symbols-outlined">image</span>
                        }
                    </a>
                    <div class="public-article-body">
                        <div class="public-article-meta">
                            <span>@(item.PublishAt?.ToString("dd/MM/yyyy") ?? "Chưa có ngày")</span>
                            <span class="post-card-view-count">
                                <span class="material-symbols-outlined">visibility</span>
                                @FormatViews(item.ViewCount)
                            </span>
                        </div>
                        <h2><a href="@PostHref(item)">@item.Title</a></h2>
                        @if (!string.IsNullOrWhiteSpace(item.Summary))
                        {
                            <p>@item.Summary</p>
                        }
                    </div>
                </article>
            }
        </section>
    }
</div>

@code {
    [Parameter] public string? Slug { get; set; }
    private PublicPostCategoryDetail? category;
    private List<PublicPostListItem>? posts;
    private List<PublicPostCategoryItem>? allCategories;
    private List<PublicPostCategoryItem> breadcrumbNodes = [];
    private List<PublicPostCategoryItem> childCategories = [];
    private List<(PublicPostCategoryItem Category, List<PublicPostListItem> Posts)> childCategoryGroups = [];
    private bool isLoading = true;

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        posts = null;
        breadcrumbNodes = [];
        childCategories = [];
        childCategoryGroups = [];

        allCategories = await PublicPostCategoryService.GetCategoriesAsync(PN_PublicVariables.MaTruong);
        category = await PublicPostCategoryService.GetCategoryBySlugAsync(PN_PublicVariables.MaTruong, Slug ?? string.Empty);

        if (category != null && allCategories != null)
        {
            breadcrumbNodes = BuildBreadcrumb(category, allCategories);
            childCategories = allCategories.Where(x => x.ParentId == category.Id).OrderBy(x => x.SortOrder).ToList();

            if (childCategories.Any())
            {
                foreach (var child in childCategories)
                {
                    var childPosts = await PublicPostService.GetPostsAsync(PN_PublicVariables.MaTruong, null, child.Id, 1, 6);
                    childCategoryGroups.Add((child, childPosts));
                }
            }
            else
            {
                posts = await PublicPostService.GetPostsAsync(PN_PublicVariables.MaTruong, null, category.Id, 1, 30);
            }
        }

        isLoading = false;
    }

    private static List<PublicPostCategoryItem> BuildBreadcrumb(PublicPostCategoryDetail current, List<PublicPostCategoryItem> all)
    {
        var result = new List<PublicPostCategoryItem>();
        var node = all.FirstOrDefault(x => x.Id == current.Id);
        while (node != null)
        {
            result.Insert(0, node);
            node = all.FirstOrDefault(x => x.Id == node.ParentId);
        }
        return result;
    }

    private static string PostHref(PublicPostListItem item)
        => string.IsNullOrWhiteSpace(item.Slug) ? "/posts" : $"/posts/{item.Slug}";

    private static string CategoryHref(PublicPostCategoryItem item)
        => string.IsNullOrWhiteSpace(item.Slug) ? "/posts" : $"/posts/category/{item.Slug}";

    private static string FormatViews(long views)
        => views < 1_000 ? $"{views:N0}" : $"{views / 1_000d:0.#}K";
}
