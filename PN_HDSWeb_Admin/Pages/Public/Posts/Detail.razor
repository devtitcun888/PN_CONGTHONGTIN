@page "/posts/{Slug}"
@using PN_HDSWeb_Admin.Services.Public
@implements IDisposable
@inject IPublicPostService PublicPostService
@inject IPublicPostMediaService PublicPostMediaService
@inject IPublicPostTagService PublicPostTagService
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>@(post?.Title ?? "Bài viết")</PageTitle>

@if (isLoading)
{
    <div class="post-loading">
        <div class="spinner"></div>
        <span>Đang tải bài viết...</span>
    </div>
}
else if (post == null)
{
    <section class="public-state-card">
        <span class="material-symbols-outlined">article</span>
        <h1>Không tìm thấy bài viết</h1>
        <p>Nội dung bạn đang mở chưa tồn tại hoặc đã được gỡ khỏi cổng thông tin.</p>
        <a class="public-button public-button-primary" href="/posts">Về danh sách bài viết</a>
    </section>
}
else
{
    <div class="post-page">
        <div class="post-page-inner">

            <main class="post-main">

                <nav class="post-breadcrumb" aria-label="breadcrumb">
                    <a href="/">Trang chủ</a>
                    <span class="post-breadcrumb-sep">/</span>
                    <a href="/posts">Bài viết</a>
                    @if (!string.IsNullOrWhiteSpace(post.CategoryName))
                    {
                        <span class="post-breadcrumb-sep">/</span>
                        <a href="@CategoryHref(post.CategorySlug)">@post.CategoryName</a>
                    }
                </nav>

                <header class="post-header">
                    @if (!string.IsNullOrWhiteSpace(post.CategoryName))
                    {
                        <a class="post-category-badge" href="@CategoryHref(post.CategorySlug)">@post.CategoryName</a>
                    }

                    <div class="post-title-row">
                        <h1 class="post-title">@post.Title</h1>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(post.Summary))
                    {
                        <p class="post-lead">@post.Summary</p>
                    }

                    <div class="post-meta-row">
                        <span class="post-author">
                            <span class="post-author-dot">●</span>
                            Ban biên tập
                        </span>
                        <span class="post-view-pill" title="Lượt xem">
                            <span class="material-symbols-outlined">visibility</span>
                            @FormatViews(post.ViewCount)
                        </span>
                        @if (post.PublishAt.HasValue)
                        {
                            <time class="post-time" datetime="@post.PublishAt.Value.ToString("yyyy-MM-ddTHH:mm")">
                                @FormatDate(post.PublishAt)
                            </time>
                        }
                    </div>
                </header>

                @if (!string.IsNullOrWhiteSpace(post.CoverImageUrl))
                {
                    <figure class="post-cover">
                        <img src="@post.CoverImageUrl" alt="@post.Title" data-fallback-src="/image/banner-holder.png" />
                        @if (!string.IsNullOrWhiteSpace(post.Title))
                        {
                            <figcaption>@post.Title</figcaption>
                        }
                    </figure>
                }

                <div class="post-body article-content">
                    @((MarkupString)(post.Content ?? string.Empty))
                </div>

                @if (media?.Any() == true)
                {
                    <section class="post-attachments">
                        <h3 class="post-attachments-heading">
                            <span class="material-symbols-outlined">attach_file</span>
                            Tài liệu đính kèm
                        </h3>
                        <div class="post-attachment-list">
                            @foreach (var item in media)
                            {
                                var fileType = GetFileType(GetExtension(item.FileUrl ?? item.FileName ?? string.Empty));
                                <div class="post-attachment-card">
                                    <span class="material-symbols-outlined @GetFileIconClass(fileType)">@GetFileIconName(fileType)</span>
                                    <div class="post-attachment-info">
                                        <strong>@(item.FileName ?? "Tệp đính kèm")</strong>
                                        @if (!string.IsNullOrWhiteSpace(item.Caption))
                                        {
                                            <p>@item.Caption</p>
                                        }
                                    </div>
                                    <div class="post-attachment-actions">
                                        @if (!string.IsNullOrWhiteSpace(item.FileUrl))
                                        {
                                            @if (CanPreviewInOverlay(fileType))
                                            {
                                                <button type="button" class="post-att-open" @onclick="() => OpenAttachmentPreview(item)">
                                                    <span class="material-symbols-outlined">open_in_new</span>
                                                    Mở
                                                </button>
                                            }
                                            else
                                            {
                                                <a class="post-att-open" href="@item.FileUrl" target="_blank" rel="noopener noreferrer">
                                                    <span class="material-symbols-outlined">open_in_new</span>
                                                    Mở
                                                </a>
                                            }
                                            <a class="post-att-dl" href="@item.FileUrl" download>
                                                <span class="material-symbols-outlined">download</span>
                                                Tải
                                            </a>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </section>
                }

                @if (postTags?.Any() == true)
                {
                    <div class="post-tags">
                        <span class="post-tags-label">Từ khóa:</span>
                        @foreach (var tag in postTags.Where(x => !string.IsNullOrWhiteSpace(x.Slug)))
                        {
                            <a class="post-tag" href="@TagHref(tag)">#@tag.TagName</a>
                        }
                    </div>
                }

                <div class="post-share-bar post-share-bar-bottom">
                    <span class="post-share-label-text">Chia sẻ bài viết:</span>
                    <button class="post-share-btn psb-fb" type="button" @onclick="ShareFacebookAsync">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
                        Facebook
                    </button>
                    <button class="post-share-btn psb-zalo" type="button" @onclick="ShareZaloAsync">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><text x="1" y="18" font-size="17" font-weight="900" font-family="Arial,sans-serif">Z</text></svg>
                        Zalo
                    </button>
                    <button class="post-share-btn psb-copy" type="button" @onclick="CopyLinkAsync">
                        <span class="material-symbols-outlined">link</span>
                        Sao chép link
                    </button>
                    <button class="post-share-btn psb-print" type="button" @onclick="PrintPageAsync">
                        <span class="material-symbols-outlined">print</span>
                        In
                    </button>
                </div>

                @if (relatedPosts?.Any() == true)
                {
                    <section class="post-related">
                        <h2 class="post-section-title">
                            <span class="post-section-title-bar"></span>
                            Bài viết liên quan
                        </h2>
                        <div class="post-related-grid">
                            @foreach (var item in relatedPosts.Take(4))
                            {
                                <a class="post-related-card" href="@PostHref(item)">
                                    <div class="post-related-thumb">
                                        @if (!string.IsNullOrWhiteSpace(item.CoverImageUrl))
                                        {
                                            <img src="@item.CoverImageUrl" alt="@item.Title" loading="lazy" data-fallback-src="/image/banner-holder.png" />
                                        }
                                        else
                                        {
                                            <span class="material-symbols-outlined">article</span>
                                        }
                                    </div>
                                    <div class="post-related-body">
                                        @if (!string.IsNullOrWhiteSpace(item.CategoryName))
                                        {
                                            <span class="post-related-cat">@item.CategoryName</span>
                                        }
                                        <p class="post-related-title">@item.Title</p>
                                    </div>
                                </a>
                            }
                        </div>
                    </section>
                }

            </main>

            <aside class="post-sidebar">
                @if (latestPosts?.Any() == true)
                {
                    <section class="post-sidebar-panel">
                        <h2 class="post-sidebar-heading">
                            <span class="post-section-title-bar"></span>
                            Đọc nhiều nhất
                        </h2>
                        <ol class="post-most-read">
                            @foreach (var item in latestPosts.Take(7).Select((val, idx) => new { val, idx }))
                            {
                                <li class="post-most-read-item">
                                    <span class="post-most-read-num @(item.idx < 3 ? "top3" : string.Empty)">@((item.idx + 1).ToString("00"))</span>
                                    <a href="@PostHref(item.val)">@item.val.Title</a>
                                </li>
                            }
                        </ol>
                    </section>
                }
            </aside>

        </div>
    </div>

    @if (previewAttachment != null && !string.IsNullOrWhiteSpace(previewAttachment.FileUrl))
    {
        var previewType = GetFileType(GetExtension(previewAttachment.FileUrl ?? previewAttachment.FileName ?? string.Empty));
        <div class="article-file-preview-overlay" role="dialog" aria-modal="true" aria-label="Xem tài liệu đính kèm" @onclick="CloseAttachmentPreview">
            <section class="article-file-preview-modal" @onclick:stopPropagation>
                <header>
                    <div>
                        <span class="material-symbols-outlined @GetFileIconClass(previewType)">@GetFileIconName(previewType)</span>
                        <div>
                            <strong>@(previewAttachment.FileName ?? "Tệp đính kèm")</strong>
                            <small>@GetPreviewHint(previewType)</small>
                        </div>
                    </div>
                    <button type="button" @onclick="CloseAttachmentPreview" aria-label="Đóng xem trước">
                        <span class="material-symbols-outlined">close</span>
                    </button>
                </header>
                <div class="article-file-preview-body">
                    @if (previewType == "pdf")
                    {
                        <iframe src="@GetPdfPreviewUrl(previewAttachment.FileUrl)" title="@previewAttachment.FileName"></iframe>
                    }
                    else if (previewType == "image")
                    {
                        <img src="@previewAttachment.FileUrl" alt="@previewAttachment.FileName" />
                    }
                    else if (previewType == "word")
                    {
                        <iframe src="@GetOfficePreviewUrl(previewAttachment.FileUrl)" title="@previewAttachment.FileName"></iframe>
                    }
                    else
                    {
                        <div class="article-file-preview-empty">
                            <span class="material-symbols-outlined">draft</span>
                            <p>Định dạng này chưa hỗ trợ xem trực tiếp.</p>
                        </div>
                    }
                </div>
                <footer>
                    <a href="@previewAttachment.FileUrl" target="_blank" rel="noopener noreferrer">Mở tab mới</a>
                    <a href="@previewAttachment.FileUrl" download>Tải xuống</a>
                </footer>
            </section>
        </div>
    }
}

@code {
    [Parameter] public string? Slug { get; set; }

    private PublicPostDetail? post;
    private List<PublicPostMediaItem>? media;
    private List<PublicPostTagItem>? postTags;
    private List<PublicPostListItem>? relatedPosts;
    private List<PublicPostListItem>? latestPosts;
    private PublicPostMediaItem? previewAttachment;
    private string? shareMessage;
    private bool isLoading = true;
    private bool imageFallbacksApplied;
    private bool viewCounterScheduled;
    private CancellationTokenSource? viewCounterCts;

    protected override async Task OnParametersSetAsync()
    {
        CancelViewCounter();
        isLoading = true;
        imageFallbacksApplied = false;
        viewCounterScheduled = false;
        post = null;
        media = null;
        postTags = null;
        relatedPosts = null;
        latestPosts = null;
        previewAttachment = null;
        shareMessage = null;

        post = await PublicPostService.GetPostBySlugAsync(PN_PublicVariables.MaTruong, Slug ?? string.Empty);

        if (post != null)
        {
            var mediaTask = PublicPostMediaService.GetMediaAsync(PN_PublicVariables.MaTruong, post.Id ?? string.Empty);
            var postTagsTask = PublicPostTagService.GetTagsByPostIdAsync(post.Id ?? string.Empty);
            var relatedPostsTask = PublicPostService.GetRelatedPostsAsync(PN_PublicVariables.MaTruong, post.CategoryId, post.Id ?? string.Empty, 4);
            var latestPostsTask = PublicPostService.GetMostViewedPostsAsync(PN_PublicVariables.MaTruong, 8, post.Id);

            await Task.WhenAll(mediaTask, postTagsTask, relatedPostsTask, latestPostsTask);

            media = await mediaTask;
            postTags = await postTagsTask;
            relatedPosts = await relatedPostsTask;
            latestPosts = await latestPostsTask;
        }

        isLoading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!isLoading && post != null && !imageFallbacksApplied)
        {
            imageFallbacksApplied = true;
            await JS.InvokeVoidAsync("AppUtils.applyImageFallbacks", ".post-body");
        }

        if (!isLoading && post != null && !viewCounterScheduled && !string.IsNullOrWhiteSpace(post.Id))
        {
            viewCounterScheduled = true;
            viewCounterCts = new CancellationTokenSource();
            _ = CountViewAfterDelayAsync(post.Id, viewCounterCts.Token);
        }
    }

    private async Task CountViewAfterDelayAsync(string postId, CancellationToken token)
    {
        try
        {
            await Task.Delay(TimeSpan.FromSeconds(3), token);
            if (token.IsCancellationRequested)
                return;

            var counted = await PublicPostService.IncrementPostViewAsync(PN_PublicVariables.MaTruong, postId);
            if (!counted)
                return;

            await InvokeAsync(() =>
            {
                if (post?.Id == postId)
                {
                    post.ViewCount++;
                    StateHasChanged();
                }
            });
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task CopyLinkAsync()
    {
        shareMessage = await JS.InvokeAsync<string>("AppUtils.copyToClipboard", GetShareUrl());
    }

    private async Task ShareFacebookAsync()
    {
        await JS.InvokeVoidAsync("AppUtils.shareFacebook", GetShareUrl());
        shareMessage = "Đã mở Facebook";
    }

    private async Task ShareZaloAsync()
    {
        await JS.InvokeVoidAsync("AppUtils.shareZalo", GetShareUrl());
        shareMessage = "Đã mở Zalo";
    }

    private async Task PrintPageAsync()
    {
        await JS.InvokeVoidAsync("window.print");
    }

    private string GetShareUrl() => Nav.ToAbsoluteUri($"/posts/{Slug}").ToString();

    private static string CategoryHref(string? slug)
        => string.IsNullOrWhiteSpace(slug) ? "/posts" : $"/posts/category/{slug}";

    private static string TagHref(PublicPostTagItem item)
        => string.IsNullOrWhiteSpace(item.Slug) ? "/posts" : $"/posts/tag/{item.Slug}";

    private static string PostHref(PublicPostListItem item)
        => string.IsNullOrWhiteSpace(item.Slug) ? "/posts" : $"/posts/{item.Slug}";

    private static string FormatDate(DateTime? date)
        => date.HasValue ? date.Value.ToString("dd/MM/yyyy HH:mm") : string.Empty;

    private static string FormatViews(long views)
        => views < 1_000 ? $"{views:N0} lượt xem" : $"{views / 1_000d:0.#}K lượt xem";

    private static string GetExtension(string url)
    {
        try
        {
            var path = new Uri(url, UriKind.RelativeOrAbsolute).IsAbsoluteUri
                ? new Uri(url).AbsolutePath
                : url;
            return System.IO.Path.GetExtension(path).ToLowerInvariant().TrimStart('.');
        }
        catch { return string.Empty; }
    }

    private static string GetFileType(string ext) => ext switch
    {
        "pdf" => "pdf",
        "jpg" or "jpeg" or "png" or "gif" or "webp" or "svg" or "bmp" => "image",
        "mp4" or "webm" or "ogg" or "mov" or "avi" => "video",
        "mp3" or "wav" or "aac" or "flac" => "audio",
        "doc" or "docx" => "word",
        "xls" or "xlsx" => "excel",
        _ => "file"
    };

    private static string GetFileIconName(string fileType) => fileType switch
    {
        "pdf" => "picture_as_pdf",
        "image" => "image",
        "video" => "movie",
        "audio" => "graphic_eq",
        "word" => "description",
        "excel" => "table_chart",
        _ => "draft"
    };

    private static string GetFileIconClass(string fileType) => $"article-file-icon-{fileType}";

    private void OpenAttachmentPreview(PublicPostMediaItem item) => previewAttachment = item;
    private void CloseAttachmentPreview() => previewAttachment = null;

    private static bool CanPreviewInOverlay(string fileType) => fileType is "pdf" or "image" or "word";

    private static string GetPdfPreviewUrl(string? fileUrl)
    {
        if (string.IsNullOrWhiteSpace(fileUrl)) return string.Empty;
        return fileUrl.Contains('#') ? fileUrl : $"{fileUrl}#toolbar=1&navpanes=1&scrollbar=1&view=FitH";
    }

    private string GetOfficePreviewUrl(string? fileUrl)
    {
        if (string.IsNullOrWhiteSpace(fileUrl)) return string.Empty;
        try { return $"https://view.officeapps.live.com/op/embed.aspx?src={Uri.EscapeDataString(Nav.ToAbsoluteUri(fileUrl).ToString())}"; }
        catch { return string.Empty; }
    }

    private static string GetPreviewHint(string fileType) => fileType switch
    {
        "pdf" => "Xem PDF trực tiếp trong trang",
        "image" => "Xem ảnh trực tiếp trong trang",
        "word" => "Xem Word qua khung Office viewer",
        _ => "Xem tài liệu đính kèm"
    };

    private void CancelViewCounter()
    {
        viewCounterCts?.Cancel();
        viewCounterCts?.Dispose();
        viewCounterCts = null;
    }

    public void Dispose()
    {
        CancelViewCounter();
    }
}
