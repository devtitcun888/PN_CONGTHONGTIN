@page "/posts/{Slug}"
@using PN_HDSWeb_Admin.Services.Public
@inject IPublicPostService PublicPostService
@inject IPublicPostMediaService PublicPostMediaService
@inject IPublicPostTagService PublicPostTagService
@inject IJSRuntime JS
@inject NavigationManager Nav

@if (isLoading)
{
    <div class="article-detail-loading">
        <div class="spinner"></div>
        <span>Đang tải bài viết...</span>
    </div>
}
else if (post == null)
{
    <section class="public-state-card">
        <span class="material-symbols-outlined">article</span>
        <h1>Không tìm thấy bài viết</h1>
        <p>Nội dung bạn đang mở chưa tồn tại hoặc đã được gỡ khỏi cổng thông tin.</p>
        <a class="public-button public-button-primary" href="/posts">Về danh sách bài viết</a>
    </section>
}
else
{
    <div class="article-detail-shell">
        <aside class="article-share-rail" aria-label="Chia sẻ bài viết">
            <span>Chia sẻ</span>
            <button type="button" title="Chia sẻ" @onclick="ShareNativeAsync">
                <span class="material-symbols-outlined">ios_share</span>
            </button>
            <button type="button" title="Sao chép liên kết" @onclick="CopyLinkAsync">
                <span class="material-symbols-outlined">link</span>
            </button>
            @if (!string.IsNullOrWhiteSpace(shareMessage))
            {
                <small>@shareMessage</small>
            }
        </aside>

        <article class="article-detail-main">
            <nav class="article-breadcrumb" aria-label="Điều hướng bài viết">
                <a href="/">Trang chủ</a>
                <span>/</span>
                <a href="/posts">Bài viết</a>
                @if (!string.IsNullOrWhiteSpace(post.CategoryName))
                {
                    <span>/</span>
                    <a href="@CategoryHref(post.CategorySlug)">@post.CategoryName</a>
                }
            </nav>

            <header class="article-detail-head">
                <h1>@post.Title</h1>

                <div class="article-meta-bar">
                    <div class="article-author">
                        <div>
                            <strong>Ban biên tập</strong>
                            <span>Cổng thông tin điện tử</span>
                        </div>
                    </div>

                    <div class="article-meta-list">
                        @if (post.PublishAt.HasValue)
                        {
                            <span>
                                <span class="material-symbols-outlined">schedule</span>
                                @FormatDate(post.PublishAt)
                            </span>
                        }
                        @if (!string.IsNullOrWhiteSpace(post.CategoryName))
                        {
                            <a href="@CategoryHref(post.CategorySlug)">@post.CategoryName</a>
                        }
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(post.Summary))
                {
                    <p class="article-lead">@post.Summary</p>
                }
            </header>

            @if (!string.IsNullOrWhiteSpace(post.CoverImageUrl))
            {
                <figure class="article-cover">
                    <img src="@post.CoverImageUrl" alt="@post.Title" />
                    <figcaption>@post.Title</figcaption>
                </figure>
            }

            <div class="article-content">
                @((MarkupString)(post.Content ?? string.Empty))
            </div>

            @if (media?.Any() == true)
            {
                <section class="article-attachments">
                    <h2>Tài liệu đính kèm</h2>
                    <div class="article-attachment-list">
                        @foreach (var item in media)
                        {
                            var fileType = GetFileType(GetExtension(item.FileUrl ?? item.FileName ?? string.Empty));
                            <article class="article-attachment-card">
                                <span class="material-symbols-outlined @GetFileIconClass(fileType)">@GetFileIconName(fileType)</span>
                                <div>
                                    <strong>@(item.FileName ?? "Tệp đính kèm")</strong>
                                    @if (!string.IsNullOrWhiteSpace(item.Caption))
                                    {
                                        <p>@item.Caption</p>
                                    }
                                </div>
                                <div class="article-attachment-actions">
                                    @if (!string.IsNullOrWhiteSpace(item.FileUrl))
                                    {
                                        @if (CanPreviewInOverlay(fileType))
                                        {
                                            <button type="button" @onclick="() => OpenAttachmentPreview(item)">Mở</button>
                                        }
                                        else
                                        {
                                            <a href="@item.FileUrl" target="_blank" rel="noopener noreferrer">Mở</a>
                                        }
                                        <a href="@item.FileUrl" download>Tải</a>
                                    }
                                </div>
                            </article>
                        }
                    </div>
                </section>
            }

            @if (postTags?.Any() == true)
            {
                <div class="article-tags">
                    <span>Từ khóa:</span>
                    @foreach (var tag in postTags.Where(x => !string.IsNullOrWhiteSpace(x.Slug)))
                    {
                        <a href="@TagHref(tag)"># @tag.TagName</a>
                    }
                </div>
            }
        </article>

        <aside class="article-detail-sidebar">
            @if (relatedPosts?.Any() == true)
            {
                <section class="article-side-panel">
                    <h2>Bài viết liên quan</h2>
                    <div class="article-related-list">
                        @foreach (var item in relatedPosts.Take(3))
                        {
                            <a class="article-related-card" href="@PostHref(item)">
                                @if (!string.IsNullOrWhiteSpace(item.CoverImageUrl))
                                {
                                    <img src="@item.CoverImageUrl" alt="@item.Title" loading="lazy" />
                                }
                                else
                                {
                                    <span class="article-related-fallback material-symbols-outlined">article</span>
                                }
                                <span>
                                    <strong>@item.Title</strong>
                                    @if (!string.IsNullOrWhiteSpace(item.CategoryName))
                                    {
                                        <small>@item.CategoryName</small>
                                    }
                                </span>
                            </a>
                        }
                    </div>
                </section>
            }

            @if (latestPosts?.Any() == true)
            {
                <section class="article-side-panel">
                    <h2>Đọc nhiều nhất</h2>
                    <ol class="article-most-read">
                        @foreach (var item in latestPosts.Take(5).Select((value, index) => new { value, index }))
                        {
                            <li>
                                <span>@((item.index + 1).ToString("00"))</span>
                                <a href="@PostHref(item.value)">@item.value.Title</a>
                            </li>
                        }
                    </ol>
                </section>
            }

        </aside>
    </div>

    @if (previewAttachment != null && !string.IsNullOrWhiteSpace(previewAttachment.FileUrl))
    {
        var previewType = GetFileType(GetExtension(previewAttachment.FileUrl ?? previewAttachment.FileName ?? string.Empty));
        <div class="article-file-preview-overlay" role="dialog" aria-modal="true" aria-label="Xem tài liệu đính kèm" @onclick="CloseAttachmentPreview">
            <section class="article-file-preview-modal" @onclick:stopPropagation>
                <header>
                    <div>
                        <span class="material-symbols-outlined @GetFileIconClass(previewType)">@GetFileIconName(previewType)</span>
                        <div>
                            <strong>@(previewAttachment.FileName ?? "Tệp đính kèm")</strong>
                            <small>@GetPreviewHint(previewType)</small>
                        </div>
                    </div>
                    <button type="button" @onclick="CloseAttachmentPreview" aria-label="Đóng xem trước">
                        <span class="material-symbols-outlined">close</span>
                    </button>
                </header>

                <div class="article-file-preview-body">
                    @if (previewType == "pdf")
                    {
                        <iframe src="@GetPdfPreviewUrl(previewAttachment.FileUrl)" title="@previewAttachment.FileName"></iframe>
                    }
                    else if (previewType == "image")
                    {
                        <img src="@previewAttachment.FileUrl" alt="@previewAttachment.FileName" />
                    }
                    else if (previewType == "word")
                    {
                        <iframe src="@GetOfficePreviewUrl(previewAttachment.FileUrl)" title="@previewAttachment.FileName"></iframe>
                    }
                    else
                    {
                        <div class="article-file-preview-empty">
                            <span class="material-symbols-outlined">draft</span>
                            <p>Định dạng này chưa hỗ trợ xem trực tiếp.</p>
                        </div>
                    }
                </div>

                <footer>
                    <a href="@previewAttachment.FileUrl" target="_blank" rel="noopener noreferrer">Mở tab mới</a>
                    <a href="@previewAttachment.FileUrl" download>Tải xuống</a>
                </footer>
            </section>
        </div>
    }
}

@code {
    [Parameter] public string? Slug { get; set; }

    private PublicPostDetail? post;
    private List<PublicPostMediaItem>? media;
    private List<PublicPostTagItem>? postTags;
    private List<PublicPostListItem>? relatedPosts;
    private List<PublicPostListItem>? latestPosts;
    private PublicPostMediaItem? previewAttachment;
    private string? shareMessage;
    private bool isLoading = true;

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        post = null;
        media = null;
        postTags = null;
        relatedPosts = null;
        latestPosts = null;
        previewAttachment = null;

        post = await PublicPostService.GetPostBySlugAsync(PN_PublicVariables.MaTruong, Slug ?? string.Empty);
        latestPosts = await PublicPostService.GetPostsAsync(PN_PublicVariables.MaTruong, pageSize: 6);

        if (post != null)
        {
            media = await PublicPostMediaService.GetMediaAsync(PN_PublicVariables.MaTruong, post.Id ?? string.Empty);
            postTags = await PublicPostTagService.GetTagsByPostIdAsync(post.Id ?? string.Empty);
            relatedPosts = await PublicPostService.GetRelatedPostsAsync(PN_PublicVariables.MaTruong, post.CategoryId, post.Id ?? string.Empty, 5);
            latestPosts = latestPosts
                .Where(item => !string.Equals(item.Id, post.Id, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }

        isLoading = false;
    }

    private async Task ShareNativeAsync()
    {
        shareMessage = await JS.InvokeAsync<string>("AppUtils.shareArticle", GetShareTitle(), GetShareText(), GetShareUrl());
    }

    private async Task CopyLinkAsync()
    {
        shareMessage = await JS.InvokeAsync<string>("AppUtils.copyToClipboard", GetShareUrl());
    }

    private async Task ShareFacebookAsync()
    {
        await JS.InvokeVoidAsync("AppUtils.shareFacebook", GetShareUrl());
        shareMessage = "Đã mở Facebook";
    }

    private async Task ShareZaloAsync()
    {
        await JS.InvokeVoidAsync("AppUtils.shareZalo", GetShareUrl());
        shareMessage = "Đã mở Zalo";
    }

    private string GetShareUrl() => Nav.ToAbsoluteUri($"/posts/{Slug}").ToString();

    private string GetShareTitle() => post?.Title ?? "Bài viết";

    private string GetShareText() => post?.Summary ?? "Mời bạn xem bài viết này.";

    private static string CategoryHref(string? slug)
        => string.IsNullOrWhiteSpace(slug) ? "/posts" : $"/posts/category/{slug}";

    private static string TagHref(PublicPostTagItem item)
        => string.IsNullOrWhiteSpace(item.Slug) ? "/posts" : $"/posts/tag/{item.Slug}";

    private static string PostHref(PublicPostListItem item)
        => string.IsNullOrWhiteSpace(item.Slug) ? "/posts" : $"/posts/{item.Slug}";

    private static string FormatDate(DateTime? date)
        => date.HasValue ? date.Value.ToString("dd/MM/yyyy HH:mm") : string.Empty;

    private static string GetExtension(string url)
    {
        try
        {
            var path = new Uri(url, UriKind.RelativeOrAbsolute).IsAbsoluteUri
                ? new Uri(url).AbsolutePath
                : url;
            return System.IO.Path.GetExtension(path).ToLowerInvariant().TrimStart('.');
        }
        catch
        {
            return string.Empty;
        }
    }

    private static string GetFileType(string ext) => ext switch
    {
        "pdf" => "pdf",
        "jpg" or "jpeg" or "png" or "gif" or "webp" or "svg" or "bmp" => "image",
        "mp4" or "webm" or "ogg" or "mov" or "avi" => "video",
        "mp3" or "wav" or "aac" or "flac" => "audio",
        "doc" or "docx" => "word",
        "xls" or "xlsx" => "excel",
        _ => "file"
    };

    private static string GetFileIconName(string fileType) => fileType switch
    {
        "pdf" => "picture_as_pdf",
        "image" => "image",
        "video" => "movie",
        "audio" => "graphic_eq",
        "word" => "description",
        "excel" => "table_chart",
        _ => "draft"
    };

    private static string GetFileIconClass(string fileType)
        => $"article-file-icon-{fileType}";

    private void OpenAttachmentPreview(PublicPostMediaItem item)
    {
        previewAttachment = item;
    }

    private void CloseAttachmentPreview()
    {
        previewAttachment = null;
    }

    private static bool CanPreviewInOverlay(string fileType)
        => fileType is "pdf" or "image" or "word";

    private static string GetPdfPreviewUrl(string? fileUrl)
    {
        if (string.IsNullOrWhiteSpace(fileUrl))
            return string.Empty;

        return fileUrl.Contains('#')
            ? fileUrl
            : $"{fileUrl}#toolbar=1&navpanes=1&scrollbar=1&view=FitH";
    }

    private string GetOfficePreviewUrl(string? fileUrl)
    {
        if (string.IsNullOrWhiteSpace(fileUrl))
            return string.Empty;

        string absoluteUrl;
        try
        {
            absoluteUrl = Nav.ToAbsoluteUri(fileUrl).ToString();
        }
        catch
        {
            absoluteUrl = fileUrl;
        }

        return $"https://view.officeapps.live.com/op/embed.aspx?src={Uri.EscapeDataString(absoluteUrl)}";
    }

    private static string GetPreviewHint(string fileType) => fileType switch
    {
        "pdf" => "Xem PDF trực tiếp trong trang",
        "image" => "Xem ảnh trực tiếp trong trang",
        "word" => "Xem Word qua khung Office viewer",
        _ => "Xem tài liệu đính kèm"
    };
}
