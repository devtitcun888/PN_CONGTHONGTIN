@page "/posts"
@using Microsoft.AspNetCore.Components.Web
@using PN_HDSWeb_Admin.Services.Public
@inject IPublicPostService PublicPostService
@inject IPublicPostCategoryService PublicPostCategoryService
@inject IPublicPostTagService PublicPostTagService

<style>
    /* =============================================
       RESET & PAGE SHELL
    ============================================= */
    .posts-page {
        max-width: 1140px;
        margin: 0 auto;
    }

    /* Breadcrumb */
    .posts-breadcrumb {
        display: flex;
        align-items: center;
        gap: 5px;
        font-size: 12.5px;
        color: var(--color-text-muted);
        margin-bottom: 22px;
        flex-wrap: wrap;
    }

    .posts-breadcrumb a {
        color: var(--color-text-muted);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 3px;
    }

    .posts-breadcrumb a:hover { color: var(--color-primary); }

    .posts-breadcrumb .sep {
        opacity: 0.35;
        font-size: 11px;
    }

    .posts-breadcrumb .current {
        color: var(--color-text);
        font-weight: 600;
    }

    /* =============================================
       PAGE HERO BANNER
    ============================================= */
    .posts-hero {
        position: relative;
        overflow: hidden;
        background: var(--color-primary);
        border-radius: 16px;
        padding: 36px 40px;
        margin-bottom: 28px;
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 24px;
        min-height: 148px;
    }

    /* Geometric decoration */
    .posts-hero::before {
        content: '';
        position: absolute;
        right: -40px;
        top: -40px;
        width: 240px;
        height: 240px;
        border-radius: 50%;
        border: 1.5px solid rgba(255,255,255,0.08);
        pointer-events: none;
    }

    .posts-hero::after {
        content: '';
        position: absolute;
        right: 60px;
        top: 20px;
        width: 100px;
        height: 100px;
        border-radius: 50%;
        border: 1px solid rgba(255,255,255,0.06);
        pointer-events: none;
    }

    .posts-hero-bg-line {
        position: absolute;
        inset: 0;
        background:
            linear-gradient(135deg, transparent 55%, rgba(255,255,255,0.04) 100%),
            radial-gradient(ellipse 70% 120% at 100% 50%, rgba(255,255,255,0.05) 0%, transparent 65%);
        pointer-events: none;
    }

    .posts-hero-content {
        position: relative;
        z-index: 1;
    }

    .posts-hero-kicker {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 10.5px;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: rgba(255,255,255,0.55);
        margin-bottom: 10px;
    }

    .posts-hero-kicker .material-symbols-outlined {
        font-size: 13px;
    }

    .posts-hero h1 {
        font-size: 28px;
        font-weight: 800;
        color: #fff;
        margin: 0 0 8px;
        letter-spacing: -0.025em;
        line-height: 1.2;
    }

    .posts-hero-sub {
        font-size: 13.5px;
        color: rgba(255,255,255,0.65);
        margin: 0;
        max-width: 460px;
        line-height: 1.55;
    }

    .posts-hero-stats {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        gap: 24px;
        flex-shrink: 0;
    }

    .posts-hero-stat {
        text-align: center;
    }

    .posts-hero-stat-num {
        font-size: 30px;
        font-weight: 800;
        color: rgba(255,255,255,0.95);
        line-height: 1;
        display: block;
    }

    .posts-hero-stat-label {
        font-size: 10.5px;
        color: rgba(255,255,255,0.45);
        margin-top: 3px;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        display: block;
    }

    .posts-hero-divider {
        width: 1px;
        height: 36px;
        background: rgba(255,255,255,0.12);
    }

    /* =============================================
       TOOLBAR : SEARCH + FILTER BAR
    ============================================= */
    .posts-toolbar {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 14px;
        flex-wrap: wrap;
    }

    .posts-search-wrap {
        flex: 1;
        min-width: 200px;
        position: relative;
        display: flex;
        align-items: center;
    }

    .posts-search-icon {
        position: absolute;
        left: 13px;
        font-size: 17px;
        color: var(--color-text-muted);
        pointer-events: none;
        line-height: 1;
    }

    .posts-search-input {
        width: 100%;
        height: 40px;
        padding: 0 14px 0 40px;
        background: var(--color-surface);
        border: 1px solid var(--color-outline-soft);
        border-radius: 10px;
        font-size: 13.5px;
        color: var(--color-text);
        transition: border-color 0.15s, box-shadow 0.15s;
        outline: none;
    }

    .posts-search-input::placeholder {
        color: var(--color-text-muted);
        opacity: 0.7;
    }

    .posts-search-input:focus {
        border-color: var(--color-primary);
        box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-primary) 12%, transparent);
    }

    .posts-search-input:not(:placeholder-shown) {
        border-color: color-mix(in srgb, var(--color-primary) 40%, var(--color-outline-soft));
    }

    /* Search clear btn */
    .posts-search-clear {
        position: absolute;
        right: 10px;
        width: 22px;
        height: 22px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        background: var(--color-surface-low);
        border: none;
        color: var(--color-text-muted);
        font-size: 13px;
        transition: background 0.12s, color 0.12s;
    }

    .posts-search-clear:hover {
        background: var(--color-outline-soft);
        color: var(--color-text);
    }

    .posts-search-clear .material-symbols-outlined {
        font-size: 14px;
    }

    /* Filter btn */
    .posts-btn-filter {
        height: 40px;
        padding: 0 18px;
        background: var(--color-primary);
        color: #fff;
        border: none;
        border-radius: 10px;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: opacity 0.15s, transform 0.12s;
        flex-shrink: 0;
    }

    .posts-btn-filter:hover { opacity: 0.88; }
    .posts-btn-filter:active { transform: scale(0.97); }

    .posts-btn-filter .material-symbols-outlined {
        font-size: 16px;
    }

    /* Reset btn */
    .posts-btn-reset {
        height: 40px;
        padding: 0 14px;
        background: transparent;
        border: 1px solid var(--color-outline-soft);
        border-radius: 10px;
        font-size: 13px;
        font-weight: 600;
        color: var(--color-text-muted);
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        transition: all 0.12s;
        flex-shrink: 0;
    }

    .posts-btn-reset:hover {
        border-color: var(--color-primary);
        color: var(--color-primary);
    }

    .posts-btn-reset .material-symbols-outlined {
        font-size: 15px;
    }

    /* =============================================
       CATEGORY CHIPS
    ============================================= */
    .posts-chips {
        display: flex;
        align-items: center;
        gap: 6px;
        flex-wrap: wrap;
        margin-bottom: 20px;
        padding-bottom: 18px;
        border-bottom: 1px solid var(--color-outline-soft);
    }

    .posts-chips-label {
        font-size: 11.5px;
        font-weight: 700;
        color: var(--color-text-muted);
        letter-spacing: 0.06em;
        text-transform: uppercase;
        margin-right: 2px;
        flex-shrink: 0;
    }

    .posts-chip {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 5px 13px;
        background: var(--color-surface);
        border: 1px solid var(--color-outline-soft);
        border-radius: 20px;
        font-size: 12.5px;
        font-weight: 500;
        color: var(--color-text-muted);
        cursor: pointer;
        transition: all 0.13s;
        white-space: nowrap;
    }

    .posts-chip:hover {
        background: color-mix(in srgb, var(--color-primary) 6%, var(--color-surface));
        border-color: color-mix(in srgb, var(--color-primary) 35%, var(--color-outline-soft));
        color: var(--color-primary);
    }

    .posts-chip.active {
        background: var(--color-primary);
        border-color: var(--color-primary);
        color: #fff;
        font-weight: 600;
    }

    .posts-chip .material-symbols-outlined {
        font-size: 13px;
    }

    /* =============================================
       RESULTS SUMMARY
    ============================================= */
    .posts-summary {
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-size: 12.5px;
        color: var(--color-text-muted);
        margin-bottom: 16px;
        flex-wrap: wrap;
        gap: 6px;
    }

    .posts-summary strong {
        color: var(--color-text);
        font-weight: 700;
    }

    .posts-summary-page {
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }

    .posts-summary-page .material-symbols-outlined {
        font-size: 14px;
    }

    /* =============================================
       LOADING STATE
    ============================================= */
    .posts-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 72px 24px;
        gap: 14px;
        background: var(--color-surface);
        border: 1px solid var(--color-outline-soft);
        border-radius: 14px;
        color: var(--color-text-muted);
        font-size: 13.5px;
        text-align: center;
    }

    .posts-state .material-symbols-outlined {
        font-size: 44px;
        opacity: 0.25;
        margin-bottom: 4px;
    }

    .posts-state h2 {
        font-size: 15px;
        font-weight: 700;
        color: var(--color-text);
        margin: 0;
    }

    .posts-state p {
        font-size: 13px;
        margin: 0;
        max-width: 260px;
    }

    .posts-spinner {
        width: 34px;
        height: 34px;
        border: 2.5px solid var(--color-outline-soft);
        border-top-color: var(--color-primary);
        border-radius: 50%;
        animation: posts-spin 0.7s linear infinite;
    }

    @@keyframes posts-spin {
        to { transform: rotate(360deg); }
    }

    .posts-state-btn {
        margin-top: 6px;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 8px 18px;
        background: var(--color-primary);
        color: #fff;
        border: none;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        transition: opacity 0.15s;
    }

    .posts-state-btn:hover { opacity: 0.88; }

    /* =============================================
       ARTICLE GRID  — 3-column compact
    ============================================= */
    .posts-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
        margin-bottom: 28px;
    }

    /* =============================================
       FEATURED ROW — first 2 posts get wider treatment
       (full-width row with hero + secondary side-by-side)
    ============================================= */
    .posts-featured-row {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 16px;
        margin-bottom: 16px;
    }

    /* =============================================
       ARTICLE CARD
    ============================================= */
    .post-card {
        background: var(--color-surface);
        border: 1px solid var(--color-outline-soft);
        border-radius: 11px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        transition: box-shadow 0.16s, transform 0.16s, border-color 0.16s;
    }

    .post-card:hover {
        box-shadow: 0 6px 20px rgba(0,0,0,0.08);
        transform: translateY(-2px);
        border-color: color-mix(in srgb, var(--color-primary) 28%, var(--color-outline-soft));
    }

    /* Card thumbnail */
    .post-card-img {
        display: block;
        width: 100%;
        aspect-ratio: 16 / 9;
        overflow: hidden;
        background: var(--color-surface-low);
        flex-shrink: 0;
        position: relative;
    }

    .post-card-img img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform 0.32s ease;
    }

    .post-card:hover .post-card-img img {
        transform: scale(1.04);
    }

    .post-card-img-placeholder {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--color-outline-soft);
    }

    .post-card-img-placeholder .material-symbols-outlined {
        font-size: 30px;
    }

    /* Category badge overlaid on image */
    .post-card-category {
        position: absolute;
        bottom: 8px;
        left: 8px;
        display: inline-flex;
        align-items: center;
        padding: 3px 9px;
        background: rgba(0,0,0,0.55);
        backdrop-filter: blur(4px);
        -webkit-backdrop-filter: blur(4px);
        border-radius: 5px;
        font-size: 10.5px;
        font-weight: 700;
        color: rgba(255,255,255,0.92);
        text-decoration: none;
        letter-spacing: 0.03em;
        transition: background 0.12s;
    }

    .post-card-category:hover {
        background: color-mix(in srgb, var(--color-primary) 80%, rgba(0,0,0,0.6));
        color: #fff;
        text-decoration: none;
    }

    /* Card body */
    .post-card-body {
        padding: 13px 15px 14px;
        display: flex;
        flex-direction: column;
        gap: 7px;
        flex: 1;
    }

    /* Meta row */
    .post-card-meta {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 11px;
        color: var(--color-text-muted);
        flex-wrap: wrap;
    }

    .post-card-meta-date {
        display: flex;
        align-items: center;
        gap: 3px;
    }

    .post-card-meta-date .material-symbols-outlined {
        font-size: 12px;
    }

    .post-card-meta-views {
        display: flex;
        align-items: center;
        gap: 3px;
        margin-left: auto;
    }

    .post-card-meta-views .material-symbols-outlined {
        font-size: 12px;
    }

    /* Title */
    .post-card-title {
        font-size: 13.5px;
        font-weight: 700;
        line-height: 1.42;
        margin: 0;
        color: var(--color-text);
        display: -webkit-box;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 2;
        overflow: hidden;
    }

    .post-card-title a {
        color: inherit;
        text-decoration: none;
        transition: color 0.12s;
    }

    .post-card-title a:hover { color: var(--color-primary); }

    /* Summary */
    .post-card-summary {
        font-size: 12px;
        color: var(--color-text-muted);
        line-height: 1.5;
        margin: 0;
        display: -webkit-box;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 2;
        overflow: hidden;
    }

    /* Tags */
    .post-card-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 4px;
        margin-top: auto;
        padding-top: 4px;
    }

    .post-card-tag {
        display: inline-flex;
        align-items: center;
        padding: 2px 8px;
        background: color-mix(in srgb, var(--color-primary) 8%, transparent);
        color: var(--color-primary);
        border-radius: 4px;
        font-size: 10.5px;
        font-weight: 600;
        text-decoration: none;
        letter-spacing: 0.02em;
        transition: background 0.12s;
    }

    .post-card-tag:hover {
        background: color-mix(in srgb, var(--color-primary) 15%, transparent);
        color: var(--color-primary);
        text-decoration: none;
    }

    /* Read more footer */
    .post-card-footer {
        padding: 9px 15px 11px;
        border-top: 1px solid var(--color-outline-soft);
        margin-top: auto;
    }

    .post-card-footer a {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        font-size: 12px;
        font-weight: 700;
        color: var(--color-primary);
        text-decoration: none;
        transition: gap 0.15s;
    }

    .post-card-footer a:hover {
        gap: 7px;
        text-decoration: none;
    }

    .post-card-footer a .material-symbols-outlined {
        font-size: 14px;
        transition: transform 0.15s;
    }

    .post-card-footer a:hover .material-symbols-outlined {
        transform: translateX(2px);
    }

    /* ============================================
       FEATURED CARD (larger, landscape)
    ============================================= */
    .post-card.featured {
        flex-direction: column;
    }

    .post-card.featured .post-card-img {
        aspect-ratio: 16 / 10;
    }

    .post-card.featured .post-card-body {
        padding: 16px 18px 16px;
        gap: 8px;
    }

    .post-card.featured .post-card-title {
        font-size: 16px;
        font-weight: 800;
        -webkit-line-clamp: 3;
        letter-ratio: -0.01em;
    }

    .post-card.featured .post-card-summary {
        font-size: 13px;
        -webkit-line-clamp: 3;
    }

    /* Featured badge ribbon */
    .post-card-featured-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 3px 9px;
        background: color-mix(in srgb, var(--color-primary) 12%, transparent);
        color: var(--color-primary);
        border-radius: 5px;
        font-size: 10px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        width: fit-content;
    }

    .post-card-featured-badge .material-symbols-outlined {
        font-size: 12px;
    }

    /* =============================================
       SECONDARY CARD (tall portrait beside featured)
    ============================================= */
    .post-card.secondary {
        flex-direction: column;
    }

    .post-card.secondary .post-card-img {
        aspect-ratio: 4 / 3;
    }

    /* =============================================
       PAGINATION
    ============================================= */
    .posts-pager {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        padding: 4px 0 12px;
        flex-wrap: wrap;
    }

    .posts-pager-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 38px;
        height: 38px;
        padding: 0 10px;
        background: var(--color-surface);
        border: 1px solid var(--color-outline-soft);
        border-radius: 9px;
        font-size: 13px;
        font-weight: 600;
        color: var(--color-text-muted);
        cursor: pointer;
        transition: all 0.12s;
        text-decoration: none;
    }

    .posts-pager-btn .material-symbols-outlined {
        font-size: 17px;
    }

    .posts-pager-btn:hover:not(:disabled):not(.pager-active) {
        border-color: var(--color-primary);
        color: var(--color-primary);
        background: color-mix(in srgb, var(--color-primary) 5%, var(--color-surface));
    }

    .posts-pager-btn.pager-active {
        background: var(--color-primary);
        border-color: var(--color-primary);
        color: #fff;
        cursor: default;
    }

    .posts-pager-btn:disabled {
        opacity: 0.3;
        cursor: default;
    }

    .posts-pager-ellipsis {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 38px;
        height: 38px;
        font-size: 14px;
        color: var(--color-text-muted);
        user-select: none;
    }

    .posts-pager-info {
        text-align: center;
        font-size: 12px;
        color: var(--color-text-muted);
        margin-top: 6px;
    }

    /* =============================================
       RESPONSIVE
    ============================================= */
    @@media (max-width: 991px) {
        .posts-featured-row {
            grid-template-columns: 1fr;
        }
        .posts-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 640px) {
        .posts-hero {
            padding: 26px 22px;
            min-height: unset;
            flex-direction: column;
            align-items: flex-start;
        }
        .posts-hero h1 { font-size: 22px; }
        .posts-hero-stats {
            gap: 16px;
        }
        .posts-grid {
            grid-template-columns: 1fr;
        }
        .posts-toolbar {
            flex-wrap: nowrap;
        }
    }
</style>

<div class="public-page posts-page">

  @*   <%-- Breadcrumb --%> *@
    <nav class="posts-breadcrumb" aria-label="breadcrumb">
        <a href="/">
            <span class="material-symbols-outlined" style="font-size: 13px; vertical-align: -2px;">home</span>
            Trang chủ
        </a>
        <span class="sep">/</span>
        <span class="current">Bài viết</span>
    </nav>

@*     <%-- Hero --%> *@
    <div class="posts-hero">
        <div class="posts-hero-bg-line"></div>
        <div class="posts-hero-content">
            <div class="posts-hero-kicker">
                <span class="material-symbols-outlined">newspaper</span>
                Tin tức & Thông báo
            </div>
            <h1>Bài viết mới nhất</h1>
            <p class="posts-hero-sub">Theo dõi các hoạt động, thông báo và nội dung chuyên mục được công khai từ nhà trường.</p>
        </div>
        @if (totalCount > 0)
        {
            <div class="posts-hero-stats">
                <div class="posts-hero-stat">
                    <span class="posts-hero-stat-num">@totalCount</span>
                    <span class="posts-hero-stat-label">Bài viết</span>
                </div>
                @if (categories?.Any() == true)
                {
                    <div class="posts-hero-divider"></div>
                    <div class="posts-hero-stat">
                        <span class="posts-hero-stat-num">@categories.Count</span>
                        <span class="posts-hero-stat-label">Chuyên mục</span>
                    </div>
                }
            </div>
        }
    </div>

@*     <%-- Toolbar --%> *@
    <div class="posts-toolbar">
        <div class="posts-search-wrap">
            <span class="material-symbols-outlined posts-search-icon">search</span>
            <input class="posts-search-input"
                   type="search"
                   @bind="keyword"
                   @bind:event="oninput"
                   @onkeydown="HandleKeyDown"
                   placeholder="Tìm theo tiêu đề hoặc mô tả..."
                   autocomplete="off" />
            @if (!string.IsNullOrWhiteSpace(keyword))
            {
                <button class="posts-search-clear" type="button" @onclick="ClearKeyword" title="Xóa">
                    <span class="material-symbols-outlined">close</span>
                </button>
            }
        </div>
        <button class="posts-btn-filter" type="button" @onclick="SearchAsync">
            <span class="material-symbols-outlined">tune</span>
            Lọc
        </button>
        @if (!string.IsNullOrWhiteSpace(keyword) || !string.IsNullOrWhiteSpace(selectedCategoryId))
        {
            <button class="posts-btn-reset" type="button" @onclick="ClearAll">
                <span class="material-symbols-outlined">refresh</span>
                Đặt lại
            </button>
        }
    </div>

    @* <%-- Category Chips --%> *@
    @if (categories?.Any() == true)
    {
        <div class="posts-chips" aria-label="Lọc theo chuyên mục">
            <span class="posts-chips-label">Chuyên mục</span>
            <button type="button"
                    class="posts-chip @(string.IsNullOrWhiteSpace(selectedCategoryId) ? "active" : "")"
                    @onclick="ClearCategory">
                <span class="material-symbols-outlined">apps</span>
                Tất cả
            </button>
            @foreach (var cat in categories)
            {
                <button type="button"
                        class="posts-chip @(selectedCategoryId == cat.Id ? "active" : "")"
                        @onclick="() => SelectCategory(cat.Id)">
                    @cat.CategoryName
                </button>
            }
        </div>
    }

 @*    <%-- Content --%> *@
    @if (posts == null)
    {
        <div class="posts-state">
            <div class="posts-spinner"></div>
            <p>Đang tải bài viết...</p>
        </div>
    }
    else if (!posts.Any())
    {
        <div class="posts-state">
            <span class="material-symbols-outlined">manage_search</span>
            <h2>Không tìm thấy bài viết</h2>
            <p>Thử thay đổi từ khóa hoặc chọn chuyên mục khác.</p>
            <button class="posts-state-btn" type="button" @onclick="ClearAll">
                <span class="material-symbols-outlined">refresh</span>
                Xem tất cả
            </button>
        </div>
    }
    else
    {
@*         <%-- Results summary --%> *@
        <div class="posts-summary">
            <span>
                Hiển thị <strong>@((trang - 1) * pageSize + 1)</strong>–<strong>@Math.Min(trang * pageSize, totalCount)</strong>
                trong <strong>@totalCount</strong> bài viết
                @if (!string.IsNullOrWhiteSpace(selectedCategoryId))
                {
                    <span> · <strong>@(categories?.FirstOrDefault(c => c.Id == selectedCategoryId)?.CategoryName)</strong></span>
                }
                @if (!string.IsNullOrWhiteSpace(keyword))
                {
                    <span> · "<strong>@keyword</strong>"</span>
                }
            </span>
            <span class="posts-summary-page">
                <span class="material-symbols-outlined">pages</span>
                Trang @trang / @totalPages
            </span>
        </div>

       
            var featuredPost = posts.FirstOrDefault();
            var secondPost   = posts.Count > 1 ? posts[1] : null;
            var remainPosts  = posts.Count > 2 ? posts.Skip(2).ToList() : new List<PublicPostListItem>();
        

     @*    <%-- Featured row: first 2 posts --%> *@
        @if (featuredPost != null)
        {
            <div class="posts-featured-row">
       @*          <%-- Hero card --%> *@
                <article class="post-card featured">
                    <a class="post-card-img" href="@PostHref(featuredPost)" aria-label="@featuredPost.Title">
                        @if (!string.IsNullOrWhiteSpace(featuredPost.CoverImageUrl))
                        {
                            <img src="@featuredPost.CoverImageUrl" alt="@featuredPost.Title" loading="eager" />
                        }
                        else
                        {
                            <div class="post-card-img-placeholder"><span class="material-symbols-outlined">image</span></div>
                        }
                        @if (!string.IsNullOrWhiteSpace(featuredPost.CategoryName))
                        {
                            <a class="post-card-category" href="@CategoryHref(featuredPost)">@featuredPost.CategoryName</a>
                        }
                    </a>
                    <div class="post-card-body">
                        <div class="post-card-featured-badge">
                            <span class="material-symbols-outlined">stars</span>
                            Nổi bật
                        </div>
                        <div class="post-card-meta">
                            @if (featuredPost.PublishAt.HasValue)
                            {
                                <span class="post-card-meta-date">
                                    <span class="material-symbols-outlined">calendar_today</span>
                                    @featuredPost.PublishAt.Value.ToString("dd/MM/yyyy")
                                </span>
                            }
                            <span class="post-card-meta-views">
                                <span class="material-symbols-outlined">visibility</span>
                                @FormatViews(featuredPost.ViewCount)
                            </span>
                        </div>
                        <h2 class="post-card-title"><a href="@PostHref(featuredPost)">@featuredPost.Title</a></h2>
                        @if (!string.IsNullOrWhiteSpace(featuredPost.Summary))
                        {
                            <p class="post-card-summary">@featuredPost.Summary</p>
                        }
                        @if (featuredPost.Tags?.Any(x => !string.IsNullOrWhiteSpace(x.Slug)) == true)
                        {
                            <div class="post-card-tags">
                                @foreach (var tag in featuredPost.Tags.Where(x => !string.IsNullOrWhiteSpace(x.Slug)).Take(4))
                                {
                                    <a class="post-card-tag" href="@TagHref(tag)">@tag.TagName</a>
                                }
                            </div>
                        }
                    </div>
                    <div class="post-card-footer">
                        <a href="@PostHref(featuredPost)">
                            Đọc tiếp
                            <span class="material-symbols-outlined">arrow_forward</span>
                        </a>
                    </div>
                </article>

               @*  <%-- Secondary card --%> *@
                @if (secondPost != null)
                {
                    <article class="post-card secondary">
                        <a class="post-card-img" href="@PostHref(secondPost)" aria-label="@secondPost.Title">
                            @if (!string.IsNullOrWhiteSpace(secondPost.CoverImageUrl))
                            {
                                <img src="@secondPost.CoverImageUrl" alt="@secondPost.Title" loading="lazy" />
                            }
                            else
                            {
                                <div class="post-card-img-placeholder"><span class="material-symbols-outlined">image</span></div>
                            }
                            @if (!string.IsNullOrWhiteSpace(secondPost.CategoryName))
                            {
                                <a class="post-card-category" href="@CategoryHref(secondPost)">@secondPost.CategoryName</a>
                            }
                        </a>
                        <div class="post-card-body">
                            <div class="post-card-meta">
                                @if (secondPost.PublishAt.HasValue)
                                {
                                    <span class="post-card-meta-date">
                                        <span class="material-symbols-outlined">calendar_today</span>
                                        @secondPost.PublishAt.Value.ToString("dd/MM/yyyy")
                                    </span>
                                }
                                <span class="post-card-meta-views">
                                    <span class="material-symbols-outlined">visibility</span>
                                    @FormatViews(secondPost.ViewCount)
                                </span>
                            </div>
                            <h2 class="post-card-title"><a href="@PostHref(secondPost)">@secondPost.Title</a></h2>
                            @if (!string.IsNullOrWhiteSpace(secondPost.Summary))
                            {
                                <p class="post-card-summary">@secondPost.Summary</p>
                            }
                            @if (secondPost.Tags?.Any(x => !string.IsNullOrWhiteSpace(x.Slug)) == true)
                            {
                                <div class="post-card-tags">
                                    @foreach (var tag in secondPost.Tags.Where(x => !string.IsNullOrWhiteSpace(x.Slug)).Take(3))
                                    {
                                        <a class="post-card-tag" href="@TagHref(tag)">@tag.TagName</a>
                                    }
                                </div>
                            }
                        </div>
                        <div class="post-card-footer">
                            <a href="@PostHref(secondPost)">
                                Đọc tiếp
                                <span class="material-symbols-outlined">arrow_forward</span>
                            </a>
                        </div>
                    </article>
                }
            </div>
        }

    @*     <%-- Remaining posts grid --%> *@
        @if (remainPosts.Any())
        {
            <div class="posts-grid">
                @foreach (var item in remainPosts)
                {
                    <article class="post-card">
                        <a class="post-card-img" href="@PostHref(item)" aria-label="@item.Title">
                            @if (!string.IsNullOrWhiteSpace(item.CoverImageUrl))
                            {
                                <img src="@item.CoverImageUrl" alt="@item.Title" loading="lazy" />
                            }
                            else
                            {
                                <div class="post-card-img-placeholder"><span class="material-symbols-outlined">image</span></div>
                            }
                            @if (!string.IsNullOrWhiteSpace(item.CategoryName))
                            {
                                <a class="post-card-category" href="@CategoryHref(item)">@item.CategoryName</a>
                            }
                        </a>
                        <div class="post-card-body">
                            <div class="post-card-meta">
                                @if (item.PublishAt.HasValue)
                                {
                                    <span class="post-card-meta-date">
                                        <span class="material-symbols-outlined">calendar_today</span>
                                        @item.PublishAt.Value.ToString("dd/MM/yyyy")
                                    </span>
                                }
                                <span class="post-card-meta-views">
                                    <span class="material-symbols-outlined">visibility</span>
                                    @FormatViews(item.ViewCount)
                                </span>
                            </div>
                            <h2 class="post-card-title"><a href="@PostHref(item)">@item.Title</a></h2>
                            @if (!string.IsNullOrWhiteSpace(item.Summary))
                            {
                                <p class="post-card-summary">@item.Summary</p>
                            }
                            @if (item.Tags?.Any(x => !string.IsNullOrWhiteSpace(x.Slug)) == true)
                            {
                                <div class="post-card-tags">
                                    @foreach (var tag in item.Tags.Where(x => !string.IsNullOrWhiteSpace(x.Slug)).Take(3))
                                    {
                                        <a class="post-card-tag" href="@TagHref(tag)">@tag.TagName</a>
                                    }
                                </div>
                            }
                        </div>
                        <div class="post-card-footer">
                            <a href="@PostHref(item)">
                                Đọc tiếp
                                <span class="material-symbols-outlined">arrow_forward</span>
                            </a>
                        </div>
                    </article>
                }
            </div>
        }
@* 
        <%-- Pagination --%> *@
        @if (totalPages > 1)
        {
            <nav class="posts-pager" aria-label="Phân trang">
                <button class="posts-pager-btn" @onclick="PrevPageAsync" disabled="@(trang <= 1)" aria-label="Trang trước">
                    <span class="material-symbols-outlined">chevron_left</span>
                </button>

                @for (int p = 1; p <= totalPages; p++)
                {
                    int pCopy = p;
                    @if (p == 1 || p == totalPages || (p >= trang - 2 && p <= trang + 2))
                    {
                        <button class="posts-pager-btn @(p == trang ? "pager-active" : "")"
                                @onclick="() => GoToPage(pCopy)"
                                aria-label="Trang @p"
                                aria-current="@(p == trang ? "page" : null)">
                            @p
                        </button>
                    }
                    else if (p == trang - 3 || p == trang + 3)
                    {
                        <span class="posts-pager-ellipsis">…</span>
                    }
                }

                <button class="posts-pager-btn" @onclick="NextPageAsync" disabled="@(trang >= totalPages)" aria-label="Trang sau">
                    <span class="material-symbols-outlined">chevron_right</span>
                </button>
            </nav>
            <p class="posts-pager-info">Trang @trang / @totalPages &nbsp;·&nbsp; @totalCount bài viết</p>
        }
    }
</div>

@code {
    private List<PublicPostListItem>? posts;
    private List<PublicPostCategoryItem>? categories;
    private string? keyword;
    private string? selectedCategoryId;
    private int trang = 1;
    private int pageSize = 12;
    private int totalCount;
    private int totalPages => Math.Max(1, (int)Math.Ceiling(totalCount / (double)pageSize));

    protected override async Task OnInitializedAsync()
    {
        categories = await PublicPostCategoryService.GetCategoriesAsync(PN_PublicVariables.MaTruong);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        posts = null;
        StateHasChanged();

        totalCount = await PublicPostService.GetPostsCountAsync(PN_PublicVariables.MaTruong, keyword, selectedCategoryId);
        posts = await PublicPostService.GetPostsAsync(PN_PublicVariables.MaTruong, keyword, selectedCategoryId, trang, pageSize);

        if (posts != null && posts.Count > 0)
        {
            var postIds = posts.Select(x => x.Id).Where(id => !string.IsNullOrWhiteSpace(id)).Cast<string>().ToList();
            var tagsMap = await PublicPostTagService.GetTagsByPostIdsAsync(postIds);
            foreach (var post in posts)
            {
                post.Tags = !string.IsNullOrWhiteSpace(post.Id) && tagsMap.TryGetValue(post.Id, out var tags)
                    ? tags
                    : [];
            }
        }
    }

    private async Task SearchAsync()
    {
        trang = 1;
        await LoadAsync();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SearchAsync();
    }

    private async Task SelectCategory(string? categoryId)
    {
        selectedCategoryId = categoryId;
        trang = 1;
        await LoadAsync();
    }

    private async Task ClearCategory()
    {
        selectedCategoryId = null;
        trang = 1;
        await LoadAsync();
    }

    private void ClearKeyword() => keyword = string.Empty;

    private async Task ClearAll()
    {
        keyword = string.Empty;
        selectedCategoryId = null;
        trang = 1;
        await LoadAsync();
    }

    private async Task PrevPageAsync()
    {
        if (trang > 1) { trang--; await LoadAsync(); }
    }

    private async Task NextPageAsync()
    {
        if (trang < totalPages) { trang++; await LoadAsync(); }
    }

    private async Task GoToPage(int page)
    {
        if (page < 1 || page > totalPages || page == trang) return;
        trang = page;
        await LoadAsync();
    }

    private static string PostHref(PublicPostListItem item)
        => string.IsNullOrWhiteSpace(item.Slug) ? "/posts" : $"/posts/{item.Slug}";

    private static string CategoryHref(PublicPostListItem item)
        => string.IsNullOrWhiteSpace(item.CategorySlug) ? "/posts" : $"/posts/category/{item.CategorySlug}";

    private static string TagHref(PublicPostTagItem tag)
        => string.IsNullOrWhiteSpace(tag.Slug) ? "/posts" : $"/posts/tag/{tag.Slug}";

    private static string FormatViews(long views)
        => views >= 1_000_000
            ? $"{views / 1_000_000d:0.#}M"
            : views >= 1_000
                ? $"{views / 1_000d:0.#}K"
                : $"{views:N0}";
}
