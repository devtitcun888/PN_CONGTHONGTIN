@page "/posts"
@using Microsoft.AspNetCore.Components.Web
@using PN_HDSWeb_Admin.Services.Public
@inject IPublicPostService PublicPostService
@inject IPublicPostCategoryService PublicPostCategoryService
@inject IPublicPostTagService PublicPostTagService

<div class="public-page public-posts-page">
    <nav class="public-breadcrumb" aria-label="breadcrumb">
        <a href="/">Trang chủ</a>
        <span>/</span>
        <span>Bài viết</span>
    </nav>

    <section class="public-page-head">
        <div>
            <div class="public-kicker">Tin tức và thông báo</div>
            <h1>Bài viết mới nhất</h1>
            <p>Theo dõi các hoạt động, thông báo và nội dung chuyên mục được công khai từ nhà trường.</p>
        </div>
        <a class="public-button public-button-soft" href="/search">
            <span class="material-symbols-outlined">search</span>
            Tìm kiếm
        </a>
    </section>

    <section class="public-toolbar">
        <div class="public-search-field">
            <span class="material-symbols-outlined">search</span>
            <input class="public-input"
                   @bind="keyword"
                   @bind:event="oninput"
                   @onkeydown="HandleKeyDown"
                   placeholder="Tìm theo tiêu đề hoặc mô tả..." />
        </div>
        <button class="public-button public-button-primary" type="button" @onclick="SearchAsync">Lọc</button>
        @if (!string.IsNullOrWhiteSpace(keyword) || !string.IsNullOrWhiteSpace(selectedCategoryId))
        {
            <button class="public-button public-button-ghost" type="button" @onclick="ClearAll">Đặt lại</button>
        }
    </section>

    @if (categories?.Any() == true)
    {
        <section class="public-chip-row" aria-label="Chuyên mục bài viết">
            <button type="button"
                    class="public-chip @(string.IsNullOrWhiteSpace(selectedCategoryId) ? "active" : string.Empty)"
                    @onclick="ClearCategory">
                Tất cả
            </button>
            @foreach (var cat in categories)
            {
                <button type="button"
                        class="public-chip @(selectedCategoryId == cat.Id ? "active" : string.Empty)"
                        @onclick="() => SelectCategory(cat.Id)">
                    @cat.CategoryName
                </button>
            }
        </section>
    }

    @if (posts == null)
    {
        <div class="public-state-card">
            <div class="spinner"></div>
            <p>Đang tải bài viết...</p>
        </div>
    }
    else if (!posts.Any())
    {
        <div class="public-state-card">
            <span class="material-symbols-outlined">article</span>
            <h2>Không tìm thấy bài viết</h2>
            <p>Thử thay đổi từ khóa hoặc chọn chuyên mục khác.</p>
            <button class="public-button public-button-primary" type="button" @onclick="ClearAll">Xem tất cả</button>
        </div>
    }
    else
    {
        <div class="public-results-summary">
            <span>Hiển thị <strong>@posts.Count</strong> trong tổng số <strong>@totalCount</strong> bài viết</span>
            <span>Trang @trang / @totalPages</span>
        </div>

        <section class="public-article-grid">
            @foreach (var item in posts)
            {
                <article class="public-article-card">
                    <a class="public-article-media" href="@PostHref(item)" aria-label="@item.Title">
                        @if (!string.IsNullOrWhiteSpace(item.CoverImageUrl))
                        {
                            <img src="@item.CoverImageUrl" alt="@item.Title" loading="lazy" />
                        }
                        else
                        {
                            <span class="material-symbols-outlined">image</span>
                        }
                    </a>

                    <div class="public-article-body">
                        <div class="public-article-meta">
                            @if (!string.IsNullOrWhiteSpace(item.CategoryName))
                            {
                                <a href="@CategoryHref(item)" class="public-section-label">@item.CategoryName</a>
                            }
                            @if (item.PublishAt.HasValue)
                            {
                                <span>@item.PublishAt.Value.ToString("dd/MM/yyyy")</span>
                            }
                            <span class="post-card-view-count">
                                <span class="material-symbols-outlined">visibility</span>
                                @FormatViews(item.ViewCount)
                            </span>
                        </div>

                        <h2><a href="@PostHref(item)">@item.Title</a></h2>

                        @if (!string.IsNullOrWhiteSpace(item.Summary))
                        {
                            <p>@item.Summary</p>
                        }

                        @if (item.Tags?.Any(x => !string.IsNullOrWhiteSpace(x.Slug)) == true)
                        {
                            <div class="public-tag-row">
                                @foreach (var tag in item.Tags.Where(x => !string.IsNullOrWhiteSpace(x.Slug)).Take(4))
                                {
                                    <a class="public-tag" href="@TagHref(tag)">@tag.TagName</a>
                                }
                            </div>
                        }
                    </div>

                    <div class="public-article-footer">
                        <a href="@PostHref(item)">
                            Đọc tiếp
                            <span class="material-symbols-outlined">arrow_forward</span>
                        </a>
                    </div>
                </article>
            }
        </section>

        @if (totalPages > 1)
        {
            <nav class="public-pager" aria-label="Phân trang">
                <button class="public-button public-button-ghost" @onclick="PrevPageAsync" disabled="@(trang <= 1)">
                    <span class="material-symbols-outlined">chevron_left</span>
                    Trước
                </button>
                <span>Trang @trang / @totalPages</span>
                <button class="public-button public-button-ghost" @onclick="NextPageAsync" disabled="@(trang >= totalPages)">
                    Sau
                    <span class="material-symbols-outlined">chevron_right</span>
                </button>
            </nav>
        }
    }
</div>

@code {
    private List<PublicPostListItem>? posts;
    private List<PublicPostCategoryItem>? categories;
    private string? keyword;
    private string? selectedCategoryId;
    private int trang = 1;
    private int pageSize = 10;
    private int totalCount;
    private int totalPages => Math.Max(1, (int)Math.Ceiling(totalCount / (double)pageSize));

    protected override async Task OnInitializedAsync()
    {
        categories = await PublicPostCategoryService.GetCategoriesAsync(PN_PublicVariables.MaTruong);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        totalCount = await PublicPostService.GetPostsCountAsync(PN_PublicVariables.MaTruong, keyword, selectedCategoryId);
        posts = await PublicPostService.GetPostsAsync(PN_PublicVariables.MaTruong, keyword, selectedCategoryId, trang, pageSize);
        if (posts != null)
        {
            foreach (var post in posts)
            {
                post.Tags = string.IsNullOrWhiteSpace(post.Id)
                    ? []
                    : await PublicPostTagService.GetTagsByPostIdAsync(post.Id);
            }
        }
    }

    private async Task SearchAsync()
    {
        trang = 1;
        await LoadAsync();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await SearchAsync();
    }

    private async Task SelectCategory(string? categoryId)
    {
        selectedCategoryId = categoryId;
        trang = 1;
        await LoadAsync();
    }

    private async Task ClearCategory()
    {
        selectedCategoryId = null;
        trang = 1;
        await LoadAsync();
    }

    private async Task ClearAll()
    {
        keyword = string.Empty;
        selectedCategoryId = null;
        trang = 1;
        await LoadAsync();
    }

    private async Task PrevPageAsync()
    {
        if (trang > 1)
        {
            trang--;
            await LoadAsync();
        }
    }

    private async Task NextPageAsync()
    {
        if (trang < totalPages)
        {
            trang++;
            await LoadAsync();
        }
    }

    private static string PostHref(PublicPostListItem item)
        => string.IsNullOrWhiteSpace(item.Slug) ? "/posts" : $"/posts/{item.Slug}";

    private static string CategoryHref(PublicPostListItem item)
        => string.IsNullOrWhiteSpace(item.CategorySlug) ? "/posts" : $"/posts/category/{item.CategorySlug}";

    private static string TagHref(PublicPostTagItem tag)
        => string.IsNullOrWhiteSpace(tag.Slug) ? "/posts" : $"/posts/tag/{tag.Slug}";

    private static string FormatViews(long views)
        => views < 1_000 ? $"{views:N0}" : $"{views / 1_000d:0.#}K";
}
