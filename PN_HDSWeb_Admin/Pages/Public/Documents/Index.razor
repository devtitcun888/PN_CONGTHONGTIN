@page "/documents"
@using PN_HDSWeb_Admin.Services.Public
@inject IPublicDocumentService PublicDocumentService
@inject IPublicDocumentTypeService PublicDocumentTypeService

<div class="public-article">
    <nav class="breadcrumb">
        <a href="/">Trang chủ</a>
        <span>/</span>
        <span>Văn bản công khai</span>
    </nav>

    <section class="content-card">
        <h1>Văn bản công khai</h1>
        <div class="search-panel">
            <input class="public-search-input" @bind="keyword" placeholder="Từ khóa" />
            <button class="public-search-btn" type="button" @onclick="SearchAsync">Lọc</button>
        </div>

        <div class="chip-group chip-group--wrap">
            <button type="button" class="chip @(string.IsNullOrWhiteSpace(selectedTypeId) ? "active" : string.Empty)" @onclick="ClearTypeFilter">Tất cả</button>
            @if (types != null)
            {
                @foreach (var type in types)
                {
                    <button type="button" class="chip @(selectedTypeId == type.Id ? "active" : string.Empty)" @onclick="() => SelectType(type.Id)">@type.TypeName</button>
                }
            }
        </div>
    </section>

    <section class="content-card">
        @if (documents == null)
        {
            <p>Đang tải...</p>
        }
        else if (!documents.Any())
        {
            <p>Không có văn bản phù hợp.</p>
        }
        else
        {
            <div class="search-result-list">
                @foreach (var item in documents)
                {
                    <article class="search-result-item">
                        <h3><a href="/documents/@item.Id">@item.DocTitle</a></h3>
                        <p>@item.DocNumber</p>
                        @if (!string.IsNullOrWhiteSpace(item.TypeName))
                        {
                            <p>@item.TypeName</p>
                        }
                    </article>
                }
            </div>

            <div class="pager">
                <button class="btn btn-secondary" @onclick="PrevPageAsync" disabled="@(trang <= 1)">Trước</button>
                <span>Trang @trang / @totalPages</span>
                <button class="btn btn-secondary" @onclick="NextPageAsync" disabled="@(trang >= totalPages)">Sau</button>
            </div>
        }
    </section>
</div>

@code {
    private List<PublicDocumentListItem>? documents;
    private List<PublicDocumentTypeItem>? types;
    private string? keyword;
    private string? selectedTypeId;
    private int trang = 1;
    private int pageSize = 10;
    private int totalCount;
    private int totalPages => Math.Max(1, (int)Math.Ceiling(totalCount / (double)pageSize));

    protected override async Task OnInitializedAsync()
    {
        types = await PublicDocumentTypeService.GetDocumentTypesAsync(PN_PublicVariables.MaTruong);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        totalCount = await PublicDocumentService.GetDocumentsCountAsync(PN_PublicVariables.MaTruong, keyword, selectedTypeId);
        documents = await PublicDocumentService.GetDocumentsAsync(PN_PublicVariables.MaTruong, keyword, selectedTypeId, trang, pageSize);
    }

    private async Task SearchAsync()
    {
        trang = 1;
        await LoadAsync();
    }

    private async Task SelectType(string? typeId)
    {
        selectedTypeId = typeId;
        trang = 1;
        await LoadAsync();
    }

    private async Task ClearTypeFilter()
    {
        selectedTypeId = null;
        trang = 1;
        await LoadAsync();
    }

    private async Task PrevPageAsync()
    {
        if (trang > 1)
        {
            trang--;
            await LoadAsync();
        }
    }

    private async Task NextPageAsync()
    {
        if (trang < totalPages)
        {
            trang++;
            await LoadAsync();
        }
    }
}
