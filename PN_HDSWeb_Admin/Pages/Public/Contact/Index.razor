@page "/contact"
@using PN_HDSWeb_Admin.Services.Public
@inject IPublicContactService PublicContactService

<div class="public-article">
    <nav class="breadcrumb">
        <a href="/">Trang chủ</a>
        <span>/</span>
        <span>Liên hệ</span>
    </nav>

    @if (!string.IsNullOrWhiteSpace(alertMessage))
    {
        <div class="toast @(isError ? "toast-error" : "toast-success")">
            @alertMessage
        </div>
    }

    <section class="content-grid">
        <div class="content-card">
            <h1>Liên hệ</h1>
            @if (contact == null)
            {
                <p>Đang tải...</p>
            }
            else
            {
                <p><strong>@contact.SchoolName</strong></p>
                <p>Địa chỉ: @contact.Address</p>
                <p>Điện thoại: @contact.Phone</p>
                <p>Email: @contact.Email</p>
                <p>Người phụ trách: @contact.LeaderName</p>
                <p>SĐT người phụ trách: @contact.LeaderPhone</p>
            }
        </div>

        <div class="content-card">
            <h2>Gửi liên hệ</h2>
            <div class="contact-form">
                <input class="admin-input" placeholder="Họ tên" @bind="form.SenderName" />
                <input class="admin-input" placeholder="Email" @bind="form.SenderEmail" />
                <input class="admin-input" placeholder="Số điện thoại" @bind="form.SenderPhone" />
                <input class="admin-input" placeholder="Tiêu đề" @bind="form.Subject" />
                <textarea class="admin-input" rows="6" placeholder="Nội dung" @bind="form.Message"></textarea>
                <button class="public-search-btn" @onclick="SendAsync" disabled="@isSubmitting">@(isSubmitting ? "Đang gửi..." : "Gửi liên hệ")</button>
            </div>
        </div>
    </section>
</div>

@code {
    private PublicContactInfo? contact;
    private PublicContactMessage form = new() { MaTruongBo = PN_PublicVariables.MaTruong };
    private string? alertMessage;
    private bool isError;
    private bool isSubmitting;

    protected override async Task OnInitializedAsync()
    {
        contact = await PublicContactService.GetContactAsync(PN_PublicVariables.MaTruong);
    }

    private async Task SendAsync()
    {
        if (string.IsNullOrWhiteSpace(form.SenderName) || string.IsNullOrWhiteSpace(form.Subject) || string.IsNullOrWhiteSpace(form.Message))
        {
            alertMessage = "Vui lòng nhập họ tên, tiêu đề và nội dung.";
            isError = true;
            return;
        }

        if (!string.IsNullOrWhiteSpace(form.SenderEmail) && !form.SenderEmail.Contains("@"))
        {
            alertMessage = "Email không hợp lệ.";
            isError = true;
            return;
        }

        try
        {
            isSubmitting = true;
            form.MaTruongBo = PN_PublicVariables.MaTruong;
            await PublicContactService.SendContactMessageAsync(form);
            alertMessage = "Đã gửi liên hệ thành công. Nhà trường sẽ phản hồi sớm nhất có thể.";
            isError = false;
            form = new PublicContactMessage { MaTruongBo = PN_PublicVariables.MaTruong };
        }
        catch
        {
            alertMessage = "Không thể gửi liên hệ lúc này. Vui lòng thử lại sau.";
            isError = true;
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
