@page "/"
@using PN_HDSWeb_Admin.Services.Public
@inject IPublicHomepageService HomepageService
@inject IPublicPostCategoryService PublicPostCategoryService

<div class="public-home public-home-layout">
    @if (model == null)
    {
        <div class="public-home-loading">Đang tải...</div>
    }
    else
    {
        <section class="home-hero-banner content-card">
            <div class="home-hero-copy">
                <span class="hero-kicker">Cổng thông tin điện tử</span>
                <h1>@(model.SiteTitle ?? model.SiteName ?? "Cổng thông tin của trường")</h1>
                <p>@(model.SiteSlogan ?? "Cập nhật nhanh các bài viết, thông báo và hoạt động của nhà trường.")</p>
            </div>
            @if (model.Banners?.Any() == true)
            {
                <div class="home-hero-banner-image">
                    <img src="@model.Banners.First().ImageUrl" alt="Banner" />
                </div>
            }
        </section>

        <section class="home-top-grid">
            <article class="home-featured-story content-card">
                @if (model.FeaturedPosts?.Any() == true)
                {
                    var featured = model.FeaturedPosts.First();
                    <a href="/posts/@featured.Slug" class="featured-link">
                        @if (!string.IsNullOrWhiteSpace(featured.CoverImageUrl))
                        {
                            <img src="@featured.CoverImageUrl" alt="@featured.Title" />
                        }
                        <div class="featured-overlay">
                            <span class="chip active">Tin nổi bật</span>
                            <h2>@featured.Title</h2>
                            <p>@featured.Summary</p>
                        </div>
                    </a>
                }
            </article>

            <div class="home-news-columns">
                <section class="content-card home-news-box">
                    <div class="section-head blue-head">
                        <h2>TIN NỔI BẬT</h2>
                        <a href="/posts">Xem thêm</a>
                    </div>
                    <div class="home-news-list">
                        @foreach (var item in model.FeaturedPosts.Take(5))
                        {
                            <article class="home-news-item">
                                <a href="/posts/@item.Slug">
                                    <span class="news-bullet">•</span>
                                    <span>@item.Title</span>
                                </a>
                            </article>
                        }
                    </div>
                </section>

                <section class="content-card home-news-box">
                    <div class="section-head red-head">
                        <h2>TIN MỚI NHẤT</h2>
                        <a href="/posts">Xem thêm</a>
                    </div>
                    <div class="home-news-list">
                        @foreach (var item in model.LatestPosts.Take(5))
                        {
                            <article class="home-news-item">
                                <a href="/posts/@item.Slug">
                                    <span class="news-bullet">•</span>
                                    <span>@item.Title</span>
                                </a>
                            </article>
                        }
                    </div>
                </section>
            </div>

            <aside class="home-sidebar">
                <section class="content-card sidebar-card">
                    <div class="section-head blue-head">
                        <h2>LIÊN KẾT WEBSITE</h2>
                    </div>
                    <div class="sidebar-links">
                            <a href="/posts">Bài viết</a>
                        <a href="/search">Tìm kiếm</a>
                        <a href="/documents">Văn bản công khai</a>
                        <a href="/organization">Cơ cấu tổ chức</a>
                    </div>
                </section>

                <section class="content-card sidebar-card">
                    <div class="section-head blue-head">
                        <h2>CHUYÊN MỤC</h2>
                    </div>
                    <div class="sidebar-tags">
                        @if (categories != null)
                        {
                            @foreach (var cat in categories.Take(6))
                            {
                                <a class="chip" href="/posts/category/@cat.Slug">@cat.CategoryName</a>
                            }
                        }
                    </div>
                </section>
            </aside>
        </section>

        <section class="content-grid home-bottom-grid">
            <section class="content-card">
                <div class="section-head blue-head">
                    <h2>TIN NHÀ TRƯỜNG</h2>
                    <a href="/posts">Xem tất cả</a>
                </div>
                <div class="home-card-grid">
                    @foreach (var item in model.LatestPosts.Take(4))
                    {
                        <article class="home-mini-card">
                            @if (!string.IsNullOrWhiteSpace(item.CoverImageUrl))
                            {
                                <img src="@item.CoverImageUrl" alt="@item.Title" />
                            }
                            <div>
                                <h3><a href="/posts/@item.Slug">@item.Title</a></h3>
                                <p>@item.Summary</p>
                            </div>
                        </article>
                    }
                </div>
            </section>

            <section class="content-card">
                <div class="section-head blue-head">
                    <h2>CHUYÊN MỤC BÀI VIẾT</h2>
                    <a href="/posts">Xem thêm</a>
                </div>
                <div class="sidebar-tags">
                    @if (categories != null)
                    {
                        @foreach (var cat in categories.Take(8))
                        {
                            <a class="chip" href="/posts/category/@cat.Slug">@cat.CategoryName</a>
                        }
                    }
                </div>
            </section>
        </section>
    }
</div>

@code {
    private PublicHomepageViewModel? model;
    private List<PublicPostCategoryItem>? categories;

    protected override async Task OnInitializedAsync()
    {
        model = await HomepageService.GetHomepageAsync(PN_PublicVariables.MaTruong);
        categories = await PublicPostCategoryService.GetCategoriesAsync(PN_PublicVariables.MaTruong);
    }
}
