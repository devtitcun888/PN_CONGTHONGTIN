@page "/"
@using PN_HDSWeb_Admin.Services.Public
@inject IPublicHomepageService HomepageService
@inject IPublicPostCategoryService PublicPostCategoryService
@inject IPublicDocumentService PublicDocumentService
@implements IAsyncDisposable
<div class="hp">

    @if (model == null)
    {
        <div class="hp-loading">
            <div class="hp-spinner"></div>
            <span>Đang tải nội dung...</span>
        </div>
    }
    else
    {
        var slides = (model.FeaturedPosts ?? new()).Take(6).ToList();
        var hasHeroIntro = model.SchoolIntro != null;
        var hasHeroSlider = slides.Any();

        @if (hasHeroSlider || hasHeroIntro)
        {
            <section class="hp-hero-grid @(!hasHeroSlider || !hasHeroIntro ? "single" : string.Empty)">
                @if (hasHeroSlider)
                {
                    <div class="hp-featured">
                        @for (int i = 0; i < slides.Count; i++)
                        {
                            var post = slides[i];
                            var idx  = i;
                            var slideImage = string.IsNullOrWhiteSpace(post.CoverImageUrl)
                                ? "/image/banner-holder.png"
                                : post.CoverImageUrl;
                            <div class="hp-slide @(i == activeSlide ? "active" : "")">
                                <img class="hp-slide-img" src="@slideImage" alt="@post.Title" data-fallback-src="/image/banner-holder.png" />
                                <div class="hp-slide-content">
                                    <div class="hp-slide-kicker">Tin nổi bật</div>
                                    <h1 class="hp-slide-title">@post.Title</h1>
                                    @if (!string.IsNullOrWhiteSpace(post.Summary))
                                    {
                                        <p class="hp-slide-summary">@post.Summary</p>
                                    }
                                    <a href="@PostHref(post)" class="hp-slide-btn">
                                        Đọc bài viết
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
                                    </a>
                                </div>
                            </div>
                        }

                        <div class="hp-dots">
                            @for (int i = 0; i < slides.Count; i++)
                            {
                                var idx = i;
                                <button class="hp-dot @(i == activeSlide ? "active" : "")"
                                        type="button" @onclick="() => GoToSlide(idx)"></button>
                            }
                        </div>

                        <button class="hp-arrow hp-arrow-prev" type="button" @onclick="PrevSlide">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>
                        </button>
                        <button class="hp-arrow hp-arrow-next" type="button" @onclick="NextSlide">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
                        </button>

                        <div class="hp-progress">
                            <div class="hp-progress-bar" @key="activeSlide"></div>
                        </div>
                    </div>
                }

                @if (model.SchoolIntro != null)
                {
                    <aside class="hp-school-card" aria-label="Thông tin nhà trường">
                        <div class="hp-school-top">
                            @if (!string.IsNullOrWhiteSpace(model.SchoolIntro.LogoUrl))
                            {
                                <img src="@model.SchoolIntro.LogoUrl" alt="@model.SchoolIntro.SchoolName" />
                            }
                            else
                            {
                                <span>@GetSchoolInitials(model.SchoolIntro.SchoolName)</span>
                            }
                            <div>
                                <p>Thông tin nhà trường</p>
                                <h2>@(model.SchoolIntro.SchoolName ?? "Nhà trường")</h2>
                            </div>
                        </div>

                        <p class="hp-school-intro">@SchoolIntroText</p>

                        <div class="hp-school-facts">
                            @if (!string.IsNullOrWhiteSpace(model.SchoolIntro.Address))
                            {
                                <div>
                                    <span class="material-symbols-outlined">location_on</span>
                                    <p>@model.SchoolIntro.Address</p>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(model.SchoolIntro.LevelText))
                            {
                                <div>
                                    <span class="material-symbols-outlined">school</span>
                                    <p>@model.SchoolIntro.LevelText</p>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(model.SchoolIntro.StudyTimeText))
                            {
                                <div>
                                    <span class="material-symbols-outlined">schedule</span>
                                    <p>@model.SchoolIntro.StudyTimeText</p>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(model.SchoolIntro.Phone))
                            {
                                <div>
                                    <span class="material-symbols-outlined">call</span>
                                    <p>@model.SchoolIntro.Phone</p>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(model.SchoolIntro.LeaderName))
                            {
                                <div>
                                    <span class="material-symbols-outlined">person</span>
                                    <p>@model.SchoolIntro.LeaderName</p>
                                </div>
                            }
                        </div>

                        <div class="hp-school-actions">
                            <a href="/about">Giới thiệu</a>
                            @if (!string.IsNullOrWhiteSpace(model.SchoolIntro.WebsiteUrl))
                            {
                                <a href="@model.SchoolIntro.WebsiteUrl" target="_blank" rel="noopener noreferrer">Website</a>
                            }
                        </div>
                    </aside>
                }
            </section>
        }
        else
        {
            <section class="hp-school-card hp-school-card-empty">
                <div class="hp-school-top">
                    <span>PN</span>
                    <div>
                        <p>Thông tin nhà trường</p>
                        <h2>Cổng thông tin điện tử</h2>
                    </div>
                </div>
                <p class="hp-school-intro">Chưa có dữ liệu giới thiệu để hiển thị trên trang chủ.</p>
            </section>
        }

        /* ── NỘI DUNG NỔI BẬT — horizontal auto-scroll cards ── */

            var spotlightPosts = (model.FeaturedPosts ?? new()).Take(6).ToList();
            var spotlightDocs  = (featuredDocuments ?? new()).Take(3).ToList();
            var hasSpotlight   = spotlightPosts.Any() || spotlightDocs.Any();


        @if (hasSpotlight)
        {
            <div class="hp-spotlight-section">
                <div class="hp-spotlight-header">
                    <div class="hp-spotlight-header-title">
                        <span class="hp-card-title-bar bar-blue"></span>
                        Nội dung nổi bật
                    </div>
                    <a class="hp-card-link" href="/posts">
                        Xem tất cả
                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
                    </a>
                </div>

                <div class="hp-scroll-track-wrap">
                    <!-- Auto-scroll: duplicate items for seamless loop -->
                    <div class="hp-scroll-track auto-scroll">
                        <div class="hp-scroll-inner">
                            @* First set *@
                            @foreach (var post in spotlightPosts)
                            {
                                <a class="hp-scard" href="@PostHref(post)">
                                    <div class="hp-scard-img-wrap">
                                        @if (!string.IsNullOrWhiteSpace(post.CoverImageUrl))
                                        {
                                            <img src="@post.CoverImageUrl" alt="@post.Title" />
                                        }
                                        else
                                        {
                                            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                                        }
                                    </div>
                                    <span class="hp-scard-badge badge-post">Bài viết</span>
                                    <p class="hp-scard-title">@post.Title</p>
                                    <span class="hp-scard-meta">Xem chi tiết →</span>
                                </a>
                            }
                            @foreach (var doc in spotlightDocs)
                            {
                                <a class="hp-scard hp-scard-doc" href="@GetDocumentHref(doc)">
                                    <div class="hp-scard-icon">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/><polyline points="13 2 13 9 20 9"/></svg>
                                    </div>
                                    <span class="hp-scard-badge badge-doc">Văn bản</span>
                                    <p class="hp-scard-title">@doc.DocTitle</p>
                                    <span class="hp-scard-meta">Văn bản công khai →</span>
                                </a>
                            }
                            @* Duplicate set for seamless loop *@
                            @foreach (var post in spotlightPosts)
                            {
                                <a class="hp-scard" href="@PostHref(post)" tabindex="-1" aria-hidden="true">
                                    <div class="hp-scard-img-wrap">
                                        @if (!string.IsNullOrWhiteSpace(post.CoverImageUrl))
                                        {
                                            <img src="@post.CoverImageUrl" alt="@post.Title" />
                                        }
                                        else
                                        {
                                            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                                        }
                                    </div>
                                    <span class="hp-scard-badge badge-post">Bài viết</span>
                                    <p class="hp-scard-title">@post.Title</p>
                                    <span class="hp-scard-meta">Xem chi tiết →</span>
                                </a>
                            }
                            @foreach (var doc in spotlightDocs)
                            {
                                <a class="hp-scard hp-scard-doc" href="@GetDocumentHref(doc)" tabindex="-1" aria-hidden="true">
                                    <div class="hp-scard-icon">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/><polyline points="13 2 13 9 20 9"/></svg>
                                    </div>
                                    <span class="hp-scard-badge badge-doc">Văn bản</span>
                                    <p class="hp-scard-title">@doc.DocTitle</p>
                                    <span class="hp-scard-meta">Văn bản công khai →</span>
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (model.FeatureDocumentsEnabled)
        {
            /* ── VĂN BẢN CÔNG KHAI NỔI BẬT ── */
            <div class="hp-card">
                <div class="hp-card-header">
                    <div class="hp-card-title">
                        <span class="hp-card-title-bar bar-red"></span>
                        Văn bản công khai nổi bật
                    </div>
                    <a class="hp-card-link" href="/documents">
                        Xem tất cả
                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
                    </a>
                </div>
                <div class="hp-card-body">
                    @if (featuredDocuments?.Any() == true)
                    {
                        <div class="hp-doc-grid">
                            @foreach (var doc in featuredDocuments)
                            {
                                <a class="hp-doc-card" href="@GetDocumentHref(doc)">
                                    <div class="hp-doc-badge">
                                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/><polyline points="13 2 13 9 20 9"/></svg>
                                        Văn bản
                                    </div>
                                    <div class="hp-doc-fallback">
                                        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/><polyline points="13 2 13 9 20 9"/></svg>
                                    </div>
                                    <h3 class="hp-doc-title">@doc.DocTitle</h3>
                                    <div class="hp-doc-meta">
                                        @if (!string.IsNullOrWhiteSpace(doc.DocNumber))
                                        {
                                            <span>Số: @doc.DocNumber</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(doc.TypeName))
                                        {
                                            <span>•</span>
                                            <span>@doc.TypeName</span>
                                        }
                                    </div>
                                    <div class="hp-doc-info">
                                        <span>Ngày ban hành: @FormatDate(doc.IssuedDate)</span>
                                        <span>Xem chi tiết →</span>
                                    </div>
                                </a>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="hp-loading u-min-h-140">Chưa có văn bản công khai nổi bật.</div>
                    }
                </div>
            </div>
        }

        /* ── MAIN 3-COL GRID ── */
        <div class="hp-grid">
            <div class="hp-card">
                <div class="hp-card-header">
                    <div class="hp-card-title">
                        <span class="hp-card-title-bar bar-blue"></span>
                        Tin nổi bật
                    </div>
                    <a class="hp-card-link" href="/posts">
                        Xem thêm
                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
                    </a>
                </div>
                <div class="hp-card-body">
                    <div class="hp-news-scroll">
                        <div class="hp-news-list">
                            @foreach (var item in (model.FeaturedPosts ?? new()).Take(10))
                            {
                                <div class="hp-news-item">
                                    @if (!string.IsNullOrWhiteSpace(item.CoverImageUrl))
                                    {
                                        <img class="hp-news-thumb" src="@item.CoverImageUrl" alt="@item.Title" />
                                    }
                                    else
                                    {
                                        <div class="hp-news-thumb-placeholder">
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                                        </div>
                                    }
                                    <div class="hp-news-info">
                                        <a class="hp-news-title" href="@PostHref(item)">@item.Title</a>
                                        <div class="hp-news-meta">
                                            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                                            @* @FormatDate(item.CreatedAt) *@
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="hp-card">
                <div class="hp-card-header">
                    <div class="hp-card-title">
                        <span class="hp-card-title-bar bar-red"></span>
                        Tin mới nhất
                    </div>
                    <a class="hp-card-link" href="/posts">
                        Xem thêm
                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
                    </a>
                </div>
                <div class="hp-card-body">
                    <div class="hp-bullet-scroll">
                        <div class="hp-bullet-list">
                            @foreach (var item in (model.LatestPosts ?? new()).Take(10))
                            {
                                <div class="hp-bullet-item">
                                    <a class="hp-bullet-link" href="@PostHref(item)">
                                        <span class="hp-bullet hp-bullet-red">›</span>
                                        <span>@item.Title</span>
                                    </a>
                                    <div class="hp-bullet-date">
                                        @* @FormatDate(item.CreatedAt) *@
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="hp-sidebar">
                <div class="hp-card">
                    <div class="hp-card-header">
                        <div class="hp-card-title">
                            <span class="hp-card-title-bar bar-green"></span>
                            Liên kết nhanh
                        </div>
                    </div>
                    <div class="hp-card-body">
                        <div class="hp-quick-links">
                            @foreach (var link in VisibleQuickLinks)
                            {
                                <a class="hp-quick-link" href="@link.Href">
                                    <div class="hp-quick-link-icon">
                                        @((MarkupString)link.IconSvg)
                                    </div>
                                    @link.Label
                                    <svg class="hp-quick-link-arrow" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
                                </a>
                            }
                        </div>
                    </div>
                </div>

                @if (categories?.Any() == true)
                {
                    <div class="hp-card">
                        <div class="hp-card-header">
                            <div class="hp-card-title">
                                <span class="hp-card-title-bar bar-gray"></span>
                                Chuyên mục
                            </div>
                        </div>
                        <div class="hp-card-body">
                            <div class="hp-cat-list">
                                @foreach (var cat in categories.Take(10))
                                {
                                    <a class="hp-cat-chip" href="@CategoryHref(cat)">@cat.CategoryName</a>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        /* ── BOTTOM: Tin nhà trường ── */
        @if (model.LatestPosts?.Any() == true)
        {
            <div class="hp-bottom">
                <div class="hp-card">
                    <div class="hp-card-header">
                        <div class="hp-card-title">
                            <span class="hp-card-title-bar bar-blue"></span>
                            Tin nhà trường
                        </div>
                        <a class="hp-card-link" href="/posts">Xem tất cả</a>
                    </div>
                    <div class="hp-card-body">
                        <div class="hp-mini-grid">
                            @foreach (var item in model.LatestPosts.Take(4))
                            {
                                <a class="hp-mini-card" href="@PostHref(item)">
                                    @if (!string.IsNullOrWhiteSpace(item.CoverImageUrl))
                                    {
                                        <img class="hp-mini-card-img" src="@item.CoverImageUrl" alt="@item.Title" />
                                    }
                                    else
                                    {
                                        <div class="hp-mini-card-img-placeholder">
                                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                                        </div>
                                    }
                                    <div class="hp-mini-card-body">
                                        <div class="hp-mini-card-title">@item.Title</div>
                                        @* <div class="hp-mini-card-date">@FormatDate(item.CreatedAt)</div> *@
                                    </div>
                                </a>
                            }
                        </div>
                    </div>
                </div>

                <div class="hp-card hp-doc-section">
                    <div class="hp-card-header">
                        <div class="hp-card-title">
                            <span class="hp-card-title-bar bar-red"></span>
                            Bài viết mới
                        </div>
                        <a class="hp-card-link" href="/posts">Xem thêm</a>
                    </div>
                    <div class="hp-card-body">
                        <div class="hp-bullet-list">
                            @foreach (var item in (model.LatestPosts ?? new()).Skip(4).Take(7))
                            {
                                <div class="hp-bullet-item">
                                    <a class="hp-bullet-link" href="@PostHref(item)">
                                        <span class="hp-bullet">›</span>
                                        <span>@item.Title</span>
                                    </a>
                                    <div class="hp-bullet-date">
                                        @* @FormatDate(item.CreatedAt) *@
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>

@code {
    private PublicHomepageViewModel? model;
    private List<PublicPostCategoryItem>? categories;
    private List<PublicDocumentListItem>? featuredDocuments;

    // ── Slider state ──
    private int activeSlide = 0;
    private int totalSlides = 0;
    private System.Threading.Timer? _timer;
    private bool _disposed;
    private const int SlideIntervalMs = 4500;

    // ── Quick links ──
    private readonly record struct QuickLink(string Label, string Href, string IconSvg);
    private readonly List<QuickLink> quickLinks = new()
    {
        new("Bài viết", "/posts",
            """<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>"""),
        new("Tìm kiếm", "/search",
            """<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>"""),
        new("Văn bản công khai", "/documents",
            """<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/><polyline points="13 2 13 9 20 9"/></svg>"""),
        new("Cơ cấu tổ chức", "/organization",
            """<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>"""),
    };

    private IEnumerable<QuickLink> VisibleQuickLinks
        => model?.FeatureSearchEnabled == false
            ? quickLinks.Where(link => !string.Equals(link.Href, "/search", StringComparison.OrdinalIgnoreCase))
            : quickLinks;

    private string SchoolIntroText
        => string.IsNullOrWhiteSpace(model?.SchoolIntro?.IntroText)
            ? "Thông tin tổng quan, địa chỉ liên hệ và các kênh chính thức của nhà trường được cập nhật từ dữ liệu trường học."
            : model!.SchoolIntro!.IntroText!;

    protected override async Task OnInitializedAsync()
    {
        model = await HomepageService.GetHomepageAsync(PN_PublicVariables.MaTruong);
        categories = await PublicPostCategoryService.GetCategoriesAsync(PN_PublicVariables.MaTruong);
        featuredDocuments = model.FeatureDocumentsEnabled
            ? await PublicDocumentService.GetDocumentsAsync(PN_PublicVariables.MaTruong, pageSize: Math.Clamp(model.HomepageDocumentsLimit, 1, 24))
            : [];
        totalSlides = model?.FeaturedPosts?.Take(6).Count() ?? 0;
    }

    private void StartTimer()
    {
        _timer = new System.Threading.Timer(_ =>
        {
            if (_disposed) return;
            InvokeAsync(() =>
            {
                activeSlide = (activeSlide + 1) % totalSlides;
                StateHasChanged();
            });
        }, null, SlideIntervalMs, SlideIntervalMs);
    }

    private void GoToSlide(int idx)
    {
        _timer?.Dispose();
        _timer = null;
        activeSlide = idx;
        if (totalSlides > 1) StartTimer();
    }

    private void PrevSlide() => GoToSlide((activeSlide - 1 + totalSlides) % totalSlides);
    private void NextSlide() => GoToSlide((activeSlide + 1) % totalSlides);

    private static string FormatDate(DateTime? dt)
        => dt.HasValue ? dt.Value.ToString("dd/MM/yyyy") : string.Empty;

    private static string GetDocumentHref(PublicDocumentListItem doc)
        => !string.IsNullOrWhiteSpace(doc.Id)
            ? $"/documents/{doc.Id}"
            : "/documents";

    private static string PostHref(PublicPostListItem post)
        => string.IsNullOrWhiteSpace(post.Slug) ? "/posts" : $"/posts/{post.Slug}";

    private static string PostHref(PublicPostItem post)
        => string.IsNullOrWhiteSpace(post.Slug) ? "/posts" : $"/posts/{post.Slug}";

    private static string CategoryHref(PublicPostCategoryItem category)
        => string.IsNullOrWhiteSpace(category.Slug) ? "/posts" : $"/posts/category/{category.Slug}";

    private static string GetSchoolInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
            return "PN";

        var words = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (words.Length == 0)
            return "PN";

        return string.Concat(words.TakeLast(Math.Min(2, words.Length)).Select(word => char.ToUpperInvariant(word[0])));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && totalSlides > 1)
        {
            StartTimer();
            await InvokeAsync(StateHasChanged);
        }
    }

    public ValueTask DisposeAsync()
    {
        _disposed = true;
        _timer?.Dispose();
        return ValueTask.CompletedTask;
    }
}
