@page "/"
@using PN_HDSWeb_Admin.Services.Public
@inject IPublicVehicleService VehicleService
@inject IPublicSiteSettingService SiteSettingService
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>@siteName — Thuê Xe Điện Nhanh, Sạch, Thông Minh</PageTitle>

<div class="ev-home">

    <!-- Floating particles -->
    <div class="ev-hero-particles" id="hero-particles">
        @for (int i = 0; i < 12; i++)
        {
            var delay = (i * 2).ToString(System.Globalization.CultureInfo.InvariantCulture);
            var dur = (15 + i * 3).ToString(System.Globalization.CultureInfo.InvariantCulture);
            var top = (i * 8).ToString(System.Globalization.CultureInfo.InvariantCulture);
            var left = (i * 8).ToString(System.Globalization.CultureInfo.InvariantCulture);
            <div class="ev-particle" style="width:@(8 + i * 2)px;height:@(8 + i * 2)px;top:@(top)%;left:@(left)%;animation-duration:@(dur)s;animation-delay:-@(delay)s;"></div>
        }
    </div>

    <!-- ===== HERO ===== -->
    <section class="ev-hero">
        <div class="ev-hero-bg-grid"></div>
        <div class="ev-hero__content">
            <!-- Badge -->
            <div class="ev-hero__badge" data-reveal="scale">
                <span class="ev-hero__badge-dot"></span>
                ⚡ Thuê xe điện thông minh · Sạch · Nhanh
            </div>

            <!-- Title -->
            <h1 class="ev-hero__title" data-reveal="left">
                Trải nghiệm<br />
                <span class="ev-hero__title-accent">xe điện</span> thế hệ mới
            </h1>

            <p class="ev-hero__sub" data-reveal="right">@siteSlogan — Đặt xe trong vài giây, nhận xe tận nơi, hành trình không khí thải.</p>

            <!-- Booking panel -->
            <div class="ev-booking-panel" data-reveal="up">
                <div class="ev-booking-panel__field">
                    <span class="ev-booking-panel__label">🚗 Loại xe</span>
                    <select @bind="filterLoai" class="ev-select" style="color:black">
                        <option value="">Tất cả xe</option>
                        <option value="scooter">🛵 Xe máy điện</option>
                        <option value="car">🚗 Ô tô điện</option>
                        <option value="bike">🚲 Xe đạp điện</option>
                        <option value="van">🚐 Van điện</option>
                    </select>
                </div>
                <div class="ev-booking-panel__field">
                    <span class="ev-booking-panel__label">📅 Ngày bắt đầu</span>
                    <input type="date" @bind="filterStart" class="ev-input" style="color:black" />
                </div>
                <div class="ev-booking-panel__field">
                    <span class="ev-booking-panel__label">🏁 Ngày kết thúc</span>
                    <input type="date" @bind="filterEnd" class="ev-input" style="color:black"   />
                </div>
                <button class="ev-btn ev-btn--primary ev-booking-panel__btn" @onclick="DoSearch">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
                    </svg>
                    Tìm xe
                </button>
            </div>

            <!-- Trust row -->
            <div class="ev-hero-trust">
                <div class="ev-hero-trust-item" data-reveal="left">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M9 12l2 2 4-4m6 2a9 9 0 1 1-18 0 9 9 0 0 1 18 0z"/></svg>
                    Đặt xe miễn phí
                </div>
                <div class="ev-hero-trust-item" data-reveal="up">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M9 12l2 2 4-4m6 2a9 9 0 1 1-18 0 9 9 0 0 1 18 0z"/></svg>
                    Hủy linh hoạt
                </div>
                <div class="ev-hero-trust-item" data-reveal="right">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M9 12l2 2 4-4m6 2a9 9 0 1 1-18 0 9 9 0 0 1 18 0z"/></svg>
                    Hỗ trợ 24/7
                </div>
                <div class="ev-hero-trust-item" data-reveal="up">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M9 12l2 2 4-4m6 2a9 9 0 1 1-18 0 9 9 0 0 1 18 0z"/></svg>
                    100% xe điện
                </div>
            </div>
        </div>
    </section>

    <!-- ===== STATS ===== -->
    <section class="ev-stats-section">
        <div class="ev-container">
            <div class="ev-stats-grid">
                <div class="ev-stat-item ev-reveal" data-reveal="left">
                    <span class="ev-stat-item__num ev-stat-item__num--blue">@vehicles.Count+</span>
                    <span class="ev-stat-item__label">Xe sẵn sàng</span>
                </div>
                <div class="ev-stat-item ev-reveal" data-reveal="up">
                    <span class="ev-stat-item__num ev-stat-item__num--green">0g</span>
                    <span class="ev-stat-item__label">CO₂ phát thải</span>
                </div>
                <div class="ev-stat-item ev-reveal" data-reveal="up">
                    <span class="ev-stat-item__num ev-stat-item__num--purple">24/7</span>
                    <span class="ev-stat-item__label">Hỗ trợ liên tục</span>
                </div>
                <div class="ev-stat-item ev-reveal" data-reveal="right">
                    <span class="ev-stat-item__num">100%</span>
                    <span class="ev-stat-item__label">Xe điện xanh</span>
                </div>
            </div>
        </div>
    </section>

    <!-- ===== VEHICLE LIST ===== -->
    <section class="ev-section ev-section--gray">
        <div class="ev-container">
            <div class="ev-section-header-row ev-reveal">
                <div>
                    <span class="ev-section__eyebrow">Xe sẵn sàng</span>
                    <h2 class="ev-section__title">Chọn xe phù hợp với bạn</h2>
                </div>
                <a href="/vehicles" class="ev-link-more">
                    Xem tất cả xe
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </a>
            </div>

            @if (loading)
            {
                <!-- Skeleton loading -->
                <div class="ev-vehicle-grid ev-stagger">
                    @for (int i = 0; i < 4; i++)
                    {
                        <div class="ev-skeleton-card">
                            <div class="ev-skeleton ev-skeleton-img"></div>
                            <div class="ev-skeleton-body">
                                <div class="ev-skeleton ev-skeleton-line ev-skeleton-line--sm" style="margin-bottom:8px"></div>
                                <div class="ev-skeleton ev-skeleton-line ev-skeleton-line--lg" style="margin-bottom:12px"></div>
                                <div class="ev-skeleton ev-skeleton-line ev-skeleton-line--sm"></div>
                            </div>
                        </div>
                    }
                </div>
            }
            else if (vehicles.Count == 0)
            {
                <div class="ev-empty ev-reveal">
                    <div class="ev-empty__icon">🔌</div>
                    <p>Hiện chưa có xe sẵn sàng. Vui lòng thử lại sau.</p>
                    <button class="ev-btn ev-btn--primary" @onclick="Reload">Tải lại</button>
                </div>
            }
            else
            {
                <div class="ev-vehicle-grid ev-stagger">
                    @foreach (var xe in vehicles.Take(8))
                    {
                        <div class="ev-vehicle-card ev-reveal" @onclick="() => GoToDetail(xe.Id)" data-tilt="true">
                            <!-- Image -->
                            <div class="ev-vehicle-card__img-wrap">
                                @if (!string.IsNullOrWhiteSpace(xe.HinhAnhChinh))
                                {
                                    <img src="@xe.HinhAnhChinh" alt="@xe.TenXe" loading="lazy" />
                                }
                                else
                                {
                                    <div class="ev-vehicle-card__img-placeholder">
                                        @LoaiXeIcon(xe.LoaiXe)
                                    </div>
                                }
                                <div class="ev-vehicle-card__status">
                                    <span class="ev-badge ev-badge--@xe.TinhTrang">
                                        @(xe.TinhTrang == "available" ? "✓ Sẵn sàng" : xe.TinhTrang)
                                    </span>
                                </div>
                                <div class="ev-vehicle-card__battery">
                                    <span class="ev-vehicle-card__battery-icon">⚡</span>
                                    @xe.PinPhanTram%
                                </div>
                            </div>

                            <!-- Body -->
                            <div class="ev-vehicle-card__body">
                                <div class="ev-vehicle-card__type">@LoaiXeLabel(xe.LoaiXe)</div>
                                <h3 class="ev-vehicle-card__name">@xe.TenXe</h3>

                                <div class="ev-vehicle-card__specs">
                                    @if (!string.IsNullOrWhiteSpace(xe.MauXe))
                                    {
                                        <span class="ev-vehicle-card__spec">🎨 @xe.MauXe</span>
                                    }
                                    @if (xe.KmHangLanSac > 0)
                                    {
                                        <span class="ev-vehicle-card__spec">🛣️ @xe.KmHangLanSac km</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(xe.HangXe))
                                    {
                                        <span class="ev-vehicle-card__spec">🏭 @xe.HangXe</span>
                                    }
                                </div>

                                <div class="ev-vehicle-card__price-row">
                                    @if (xe.GiaThueNgay > 0)
                                    {
                                        <span class="ev-price-day">@FormatVnd(xe.GiaThueNgay)<small>/ngày</small></span>
                                    }
                                </div>

                                <div class="ev-vehicle-card__actions">
                                    <button class="ev-btn ev-btn--primary ev-btn--sm"
                                            @onclick:stopPropagation="true"
                                            @onclick="() => GoToDetail(xe.Id)">
                                        Đặt ngay
                                    </button>
                                    <button class="ev-btn ev-btn--ghost ev-btn--sm"
                                            @onclick:stopPropagation="true"
                                            @onclick="() => GoToDetail(xe.Id)">
                                        Chi tiết
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- View all CTA -->
                @if (vehicles.Count > 8)
                {
                    <div style="text-align:center;margin-top:40px;" class="ev-reveal">
                        <a href="/vehicles" class="ev-btn ev-btn--outline ev-btn--lg">
                            Xem thêm @(vehicles.Count - 8) xe khác →
                        </a>
                    </div>
                }
            }
        </div>
    </section>

    <!-- ===== HOW IT WORKS ===== -->
    <section class="ev-section ev-section--white">
        <div class="ev-container">
            <div class="ev-section__header ev-reveal" style="text-align:center">
                <span class="ev-section__eyebrow">Đơn giản</span>
                <h2 class="ev-section__title">Đặt xe trong 3 bước</h2>
                <p class="ev-section__sub" style="margin:0 auto">
                    Quy trình thuê xe được tối ưu để bạn có thể đặt xe nhanh nhất có thể.
                </p>
            </div>

            <div class="ev-how-grid ev-stagger">
                <div class="ev-step-card ev-reveal" data-reveal="left">
                    <div class="ev-step-card__num">1</div>
                    <div class="ev-step-card__icon">🔍</div>
                    <h3>Chọn xe phù hợp</h3>
                    <p>Duyệt danh sách xe điện đa dạng, lọc theo loại, giá, khu vực và thời gian bạn muốn thuê.</p>
                </div>
                <div class="ev-step-card ev-reveal" data-reveal="up">
                    <div class="ev-step-card__num ev-step-card__num--2">2</div>
                    <div class="ev-step-card__icon">📝</div>
                    <h3>Đặt & xác nhận</h3>
                    <p>Nhập thông tin cá nhân, chọn thời gian thuê và nhận xác nhận đặt xe ngay lập tức.</p>
                </div>
                <div class="ev-step-card ev-reveal" data-reveal="right">
                    <div class="ev-step-card__num ev-step-card__num--3">3</div>
                    <div class="ev-step-card__icon">🚀</div>
                    <h3>Nhận xe & lên đường</h3>
                    <p>Nhận xe tại điểm hẹn, tận hưởng hành trình xanh và theo dõi đơn thuê realtime.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- ===== FEATURES ===== -->
    <section class="ev-section ev-section--gray">
        <div class="ev-container">
            <div class="ev-section__header ev-reveal" style="text-align:center">
                <span class="ev-section__eyebrow">Tại sao chọn chúng tôi</span>
                <h2 class="ev-section__title">Trải nghiệm thuê xe cao cấp</h2>
            </div>

            <div class="ev-features-grid ev-stagger">
                <div class="ev-feature-card ev-reveal" data-reveal="left">
                    <div class="ev-feature-card__icon ev-feature-card__icon--blue">⚡</div>
                    <div class="ev-feature-card__body">
                        <h4>100% Xe điện</h4>
                        <p>Tất cả phương tiện đều chạy điện, không khí thải, thân thiện môi trường.</p>
                    </div>
                </div>
                <div class="ev-feature-card ev-reveal" data-reveal="up">
                    <div class="ev-feature-card__icon ev-feature-card__icon--green">🌿</div>
                    <div class="ev-feature-card__body">
                        <h4>Xanh & Sạch</h4>
                        <p>Góp phần giảm thiểu ô nhiễm không khí, bảo vệ môi trường cho thế hệ tương lai.</p>
                    </div>
                </div>
                <div class="ev-feature-card ev-reveal" data-reveal="up">
                    <div class="ev-feature-card__icon ev-feature-card__icon--blue">🔒</div>
                    <div class="ev-feature-card__body">
                        <h4>An toàn & Bảo hiểm</h4>
                        <p>Xe được bảo dưỡng định kỳ, bảo hiểm đầy đủ, GPS theo dõi thời gian thực.</p>
                    </div>
                </div>
                <div class="ev-feature-card ev-reveal" data-reveal="right">
                    <div class="ev-feature-card__icon ev-feature-card__icon--green">💳</div>
                    <div class="ev-feature-card__body">
                        <h4>Giá minh bạch</h4>
                        <p>Không phụ phí ẩn. Giá thuê theo ngày được hiển thị rõ ràng từ trước.</p>
                    </div>
                </div>
                <div class="ev-feature-card ev-reveal" data-reveal="left">
                    <div class="ev-feature-card__icon ev-feature-card__icon--purple">📱</div>
                    <div class="ev-feature-card__body">
                        <h4>Theo dõi đơn realtime</h4>
                        <p>Kiểm tra trạng thái đơn thuê, lịch sử và thông tin xe mọi lúc mọi nơi.</p>
                    </div>
                </div>
                <div class="ev-feature-card ev-reveal" data-reveal="up">
                    <div class="ev-feature-card__icon ev-feature-card__icon--purple">🎯</div>
                    <div class="ev-feature-card__body">
                        <h4>Hỗ trợ 24/7</h4>
                        <p>Đội ngũ hỗ trợ luôn sẵn sàng giải quyết mọi vấn đề của bạn bất kỳ lúc nào.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ===== CTA ===== -->
    <section class="ev-section ev-section--white">
        <div class="ev-container">
            <div class="ev-cta-section ev-reveal">
                <h2>Sẵn sàng trải nghiệm?</h2>
                <p>Đặt xe điện ngay hôm nay — nhanh, sạch và hoàn toàn miễn phí đặt cọc.</p>
                <div class="ev-cta-actions">
                    <a href="/vehicles" class="ev-btn ev-btn--white ev-btn--lg">
                        🚗 Tìm xe ngay
                    </a>
                    <a href="/booking/track" class="ev-btn ev-btn--lg" style="background:rgba(255,255,255,0.15);color:white;border:1.5px solid rgba(255,255,255,0.3);">
                        📦 Tra cứu đơn
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- ===== CONTACT & TRACK ===== -->
    <section class="ev-contact-section">
        <div class="ev-container ev-contact-grid">
            <div class="ev-reveal">
                <h2>Liên hệ với chúng tôi</h2>
                <p class="ev-contact-sub">Hỗ trợ 24/7 — luôn sẵn sàng giúp bạn trên mọi hành trình</p>
                @if (!string.IsNullOrWhiteSpace(contactPhone))
                {
                    <div class="ev-contact-item">
                        📞 <a href="tel:@contactPhone">@contactPhone</a>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(contactEmail))
                {
                    <div class="ev-contact-item">
                        ✉️ <a href="mailto:@contactEmail">@contactEmail</a>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(contactAddress))
                {
                    <div class="ev-contact-item">📍 @contactAddress</div>
                }
            </div>
            <div class="ev-track-box ev-reveal">
                <h3>🔍 Tra cứu đơn thuê</h3>
                <p>Nhập mã đơn để xem trạng thái và thông tin đơn thuê của bạn</p>
                <div class="ev-track-input-group">
                    <input class="ev-input" @bind="trackCode" placeholder="VD: EV20260622001" />
                    <button class="ev-btn ev-btn--primary" @onclick="DoTrack">Tra cứu</button>
                </div>
            </div>
        </div>
    </section>

</div>

@code {
    private List<PublicVehicleItem> vehicles = [];
    private bool loading = true;
    private string siteName = "EV Rental";
    private string siteSlogan = "Đặt xe điện — Nhanh, sạch, thông minh";
    private string contactPhone = "";
    private string contactEmail = "";
    private string contactAddress = "";

    private string filterLoai = "";
    private DateTime filterStart = DateTime.Today;
    private DateTime filterEnd = DateTime.Today.AddDays(1);
    private string trackCode = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var settings = await SiteSettingService.GetSettingsAsync("xedien");
            siteName = GetSetting(settings, "site_name", "EV Rental");
            siteSlogan = GetSetting(settings, "site_slogan", "Đặt xe điện — Nhanh, sạch, thông minh");
            contactPhone = GetSetting(settings, "contact_phone", "");
            contactEmail = GetSetting(settings, "contact_email", "");
            contactAddress = GetSetting(settings, "contact_address", "");

            vehicles = await VehicleService.GetAvailableVehiclesAsync(new VehicleFilter());
        }
        catch { vehicles = []; }
        finally { loading = false; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("evPublic.init");
        }
    }

    private async Task Reload()
    {
        loading = true;
        try { vehicles = await VehicleService.GetAvailableVehiclesAsync(new VehicleFilter()); }
        catch { vehicles = []; }
        finally { loading = false; }
    }

    private void DoSearch()
    {
        var query = $"?loai={Uri.EscapeDataString(filterLoai)}&start={filterStart:yyyy-MM-dd}&end={filterEnd:yyyy-MM-dd}";
        Nav.NavigateTo("/vehicles" + query);
    }

    private void GoToDetail(int id) => Nav.NavigateTo($"/vehicles/{id}");

    private void DoTrack()
    {
        if (!string.IsNullOrWhiteSpace(trackCode))
            Nav.NavigateTo($"/booking/track?ma={Uri.EscapeDataString(trackCode.Trim())}");
    }

    private static string LoaiXeIcon(string? loai) => loai switch
    {
        "car"     => "🚗",
        "scooter" => "🛵",
        "bike"    => "🚲",
        "van"     => "🚐",
        _ => "⚡"
    };

    private static string LoaiXeLabel(string? loai) => loai switch
    {
        "car"     => "Ô tô điện",
        "scooter" => "Xe máy điện",
        "bike"    => "Xe đạp điện",
        "van"     => "Van điện",
        _ => "Xe điện"
    };

    private static string FormatVnd(decimal val) =>
        val.ToString("N0").Replace(",", ".") + "đ";

    private static string GetSetting(IReadOnlyDictionary<string, string> dict, string key, string fallback) =>
        dict.TryGetValue(key, out var v) && !string.IsNullOrWhiteSpace(v) ? v : fallback;
}
