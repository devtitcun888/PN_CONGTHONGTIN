@page "/vehicles"
@using PN_HDSWeb_Admin.Services.Public
@inject IPublicVehicleService VehicleService
@inject NavigationManager Nav

<PageTitle>Xe Điện Cho Thuê — Tìm xe phù hợp</PageTitle>

<div class="ev-page-vehicles">
    <div class="ev-container">

        <!-- ===== FILTER ===== -->
        <div class="ev-filter-bar">
            <h1 class="ev-page-title">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color:#2563EB">
                    <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
                </svg>
                Tìm xe điện
            </h1>

            <div class="ev-filter-row">
                <div class="ev-filter-item">
                    <label>Loại xe</label>
                    <select @bind="filterLoai" @bind:after="ApplyFilter" class="ev-select">
                        <option value="">Tất cả loại xe</option>
                        <option value="scooter">🛵 Xe máy điện</option>
                        <option value="car">🚗 Ô tô điện</option>
                        <option value="bike">🚲 Xe đạp điện</option>
                        <option value="van">🚐 Van điện</option>
                    </select>
                </div>
                <div class="ev-filter-item">
                    <label>Giá tối đa/ngày (đ)</label>
                    <input type="number" @bind="filterGiaMax" @bind:after="ApplyFilter"
                           class="ev-input" placeholder="Không giới hạn" min="0" step="100000" />
                </div>
                <div class="ev-filter-item">
                    <label>Ngày bắt đầu</label>
                    <input type="datetime-local" @bind="filterStart" @bind:after="ApplyFilter" class="ev-input" />
                </div>
                <div class="ev-filter-item">
                    <label>Ngày kết thúc</label>
                    <input type="datetime-local" @bind="filterEnd" @bind:after="ApplyFilter" class="ev-input" />
                </div>
                @if (IsFiltered())
                {
                    <button class="ev-btn ev-btn--ghost ev-filter-reset" @onclick="ResetFilter">
                        ✕ Xóa bộ lọc
                    </button>
                }
            </div>
        </div>

        <!-- ===== RESULTS ===== -->
        @if (loading)
        {
            <!-- Skeleton -->
            <div style="display:flex;flex-direction:column;gap:16px">
                @for (int i = 0; i < 3; i++)
                {
                    <div class="ev-vehicle-card--row" style="cursor:default;pointer-events:none">
                        <div class="ev-skeleton" style="height:160px"></div>
                        <div style="padding:20px;display:flex;flex-direction:column;gap:10px">
                            <div class="ev-skeleton ev-skeleton-line" style="height:12px;width:40%"></div>
                            <div class="ev-skeleton ev-skeleton-line" style="height:18px;width:70%"></div>
                            <div class="ev-skeleton ev-skeleton-line" style="height:12px;width:55%"></div>
                        </div>
                        <div style="padding:20px;min-width:180px;border-left:1px solid #E2E8F0;display:flex;flex-direction:column;gap:12px;align-items:flex-end">
                            <div class="ev-skeleton" style="height:24px;width:100px;border-radius:6px"></div>
                            <div class="ev-skeleton" style="height:38px;width:130px;border-radius:8px"></div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="ev-results-info">
                @if (IsFiltered())
                {
                    <span>Kết quả bộ lọc: </span>
                }
                Tìm thấy <strong>@vehicles.Count</strong> xe @(vehicles.Count == 1 ? "" : "phù hợp")
            </div>

            @if (vehicles.Count == 0)
            {
                <div class="ev-empty">
                    <div class="ev-empty__icon">🔌</div>
                    <p>Không tìm thấy xe phù hợp với điều kiện tìm kiếm.</p>
                    <button class="ev-btn ev-btn--primary" @onclick="ResetFilter">
                        Xem tất cả xe
                    </button>
                </div>
            }
            else
            {
                <div class="ev-vehicle-grid--list">
                    @foreach (var xe in vehicles)
                    {
                        <div class="ev-vehicle-card--row" @onclick="() => GoToDetail(xe.Id)">
                            <!-- Image -->
                            <div class="ev-vehicle-card__img-wrap">
                                @if (!string.IsNullOrWhiteSpace(xe.HinhAnhChinh))
                                {
                                    <img src="@xe.HinhAnhChinh" alt="@xe.TenXe" loading="lazy" />
                                }
                                else
                                {
                                    <div class="ev-vehicle-card__img-placeholder">
                                        @LoaiXeIcon(xe.LoaiXe)
                                    </div>
                                }
                            </div>

                            <!-- Info -->
                            <div class="ev-vehicle-card__body">
                                <div class="ev-vehicle-card__type-row">
                                    <span class="ev-tag">@LoaiXeLabel(xe.LoaiXe)</span>
                                    <span class="ev-badge ev-badge--@xe.TinhTrang">
                                        @(xe.TinhTrang == "available" ? "✓ Sẵn sàng" : xe.TinhTrang)
                                    </span>
                                </div>

                                <h2 class="ev-vehicle-card__name">@xe.TenXe</h2>

                                @if (!string.IsNullOrWhiteSpace(xe.BienSo))
                                {
                                    <div class="ev-bien-so">🔖 @xe.BienSo</div>
                                }

                                <div class="ev-vehicle-card__specs-row">
                                    @if (!string.IsNullOrWhiteSpace(xe.MauXe))
                                    { <span>🎨 @xe.MauXe</span> }
                                    @if (!string.IsNullOrWhiteSpace(xe.HangXe))
                                    { <span>🏭 @xe.HangXe</span> }
                                    <span>⚡ Pin: @xe.PinPhanTram%</span>
                                    @if (xe.KmHangLanSac > 0)
                                    { <span>🛣️ @xe.KmHangLanSac km/sạc</span> }
                                    @if (!string.IsNullOrWhiteSpace(xe.DiaChi))
                                    { <span>📍 @xe.DiaChi</span> }
                                </div>
                            </div>

                            <!-- Price + CTA -->
                            <div class="ev-vehicle-card__right">
                                <div class="ev-vehicle-card__price-block">
                                    @if (xe.GiaThueGio > 0)
                                    {
                                        <div class="ev-price-line">
                                            <span class="ev-price">@FormatVnd(xe.GiaThueGio)</span>
                                            <span class="ev-price-unit">/giờ</span>
                                        </div>
                                    }
                                    @if (xe.GiaThueNgay > 0)
                                    {
                                        <div class="ev-price-line">
                                            <span class="ev-price ev-price--day">@FormatVnd(xe.GiaThueNgay)</span>
                                            <span class="ev-price-unit">/ngày</span>
                                        </div>
                                    }
                                    @if (xe.DatCoc > 0)
                                    {
                                        <div class="ev-price-deposit">Đặt cọc: @FormatVnd(xe.DatCoc)</div>
                                    }
                                </div>
                                <button class="ev-btn ev-btn--primary"
                                        style="white-space:nowrap"
                                        @onclick:stopPropagation="true"
                                        @onclick="() => GoToDetail(xe.Id)">
                                    Xem & Đặt xe
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }
        }

    </div>
</div>

@code {
    [SupplyParameterFromQuery] public string? loai { get; set; }
    [SupplyParameterFromQuery] public string? start { get; set; }
    [SupplyParameterFromQuery] public string? end { get; set; }

    private List<PublicVehicleItem> vehicles = [];
    private bool loading = true;

    private string filterLoai = "";
    private decimal? filterGiaMax;
    private DateTime filterStart = DateTime.Now;
    private DateTime filterEnd = DateTime.Now.AddDays(1);

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrWhiteSpace(loai)) filterLoai = loai;
        if (DateTime.TryParse(start, out var s)) filterStart = s;
        if (DateTime.TryParse(end, out var e)) filterEnd = e;
        await LoadVehicles();
    }

    private async Task ApplyFilter() => await LoadVehicles();

    private async Task LoadVehicles()
    {
        loading = true;
        StateHasChanged();

        var filter = new VehicleFilter
        {
            LoaiXe   = filterLoai,
            GiaMax   = filterGiaMax,
            BatDauThue  = filterStart,
            KetThucThue = filterEnd
        };

        try { vehicles = await VehicleService.GetAvailableVehiclesAsync(filter); }
        catch { vehicles = []; }
        finally { loading = false; }
    }

    private async Task ResetFilter()
    {
        filterLoai  = "";
        filterGiaMax = null;
        filterStart  = DateTime.Now;
        filterEnd    = DateTime.Now.AddDays(1);
        await LoadVehicles();
    }

    private bool IsFiltered() =>
        !string.IsNullOrWhiteSpace(filterLoai) || filterGiaMax.HasValue;

    private void GoToDetail(int id) => Nav.NavigateTo($"/vehicles/{id}");

    private static string LoaiXeIcon(string? loai) => loai switch
    {
        "car" => "🚗", "scooter" => "🛵", "bike" => "🚲", "van" => "🚐", _ => "⚡"
    };

    private static string LoaiXeLabel(string? loai) => loai switch
    {
        "car" => "Ô tô điện", "scooter" => "Xe máy điện", "bike" => "Xe đạp điện", "van" => "Van điện", _ => "Xe điện"
    };

    private static string FormatVnd(decimal val) => val.ToString("N0").Replace(",", ".") + "đ";
}
