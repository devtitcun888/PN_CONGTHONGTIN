@page "/search"
@using Microsoft.AspNetCore.WebUtilities
@using PN_HDSWeb_Admin.Services.Public
@inject IPublicSearchService PublicSearchService
@inject NavigationManager Nav

<div class="public-article">
    <nav class="breadcrumb">
        <a href="/">Trang chủ</a>
        <span>/</span>
        <span>Tìm kiếm</span>
    </nav>

    <section class="content-card">
        <h1>Tìm kiếm</h1>
        <div class="search-panel">
            <input class="public-search-input" @bind="keyword" placeholder="Nhập từ khóa" />
            <button class="public-search-btn" @onclick="SearchAsync">Tìm</button>
        </div>
    </section>

    @if (result == null)
    {
        <p>Đang tải...</p>
    }
    else
    {
        <section class="content-grid">
            <div class="content-card">
                <h2>Bài viết</h2>
                @if (result.Posts.Any())
                {
                    <div class="search-result-list">
                        @foreach (var item in result.Posts)
                        {
                            <article class="search-result-item">
                                <h3><a href="/posts/@item.Slug">@item.Title</a></h3>
                                <p>@item.Summary</p>
                            </article>
                        }
                    </div>
                }
                else
                {
                    <p>Không có bài viết phù hợp.</p>
                }
            </div>

            <div class="content-card">
                <h2>Văn bản</h2>
                @if (result.Documents.Any())
                {
                    <div class="search-result-list">
                        @foreach (var item in result.Documents)
                        {
                            <article class="search-result-item">
                                <h3><a href="/documents/@item.Slug">@item.Title</a></h3>
                                <p>@item.Summary</p>
                            </article>
                        }
                    </div>
                }
                else
                {
                    <p>Không có văn bản phù hợp.</p>
                }
            </div>
        </section>
    }
</div>

@code {
    private string keyword = string.Empty;
    private PublicSearchResult? result;

    protected override async Task OnInitializedAsync()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);
        if (query.TryGetValue("q", out var q) && !string.IsNullOrWhiteSpace(q))
        {
            keyword = q.ToString();
            await SearchAsync();
        }
    }

    private async Task SearchAsync()
    {
        result = await PublicSearchService.SearchAsync(PN_PublicVariables.MaTruong, keyword);
    }
}
