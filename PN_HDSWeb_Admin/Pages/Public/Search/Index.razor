@page "/search"
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.AspNetCore.Components.Web
@using PN_HDSWeb_Admin.Services.Public
@inject IPublicSearchService PublicSearchService
@inject NavigationManager Nav

<div class="public-page public-search-page">
    <nav class="public-breadcrumb" aria-label="breadcrumb">
        <a href="/">Trang chủ</a>
        <span>/</span>
        <span>Tìm kiếm</span>
    </nav>

    <section class="public-page-head">
        <div>
            <div class="public-kicker">Tra cứu nội dung</div>
            <h1>Tìm kiếm</h1>
            <p>Tìm nhanh bài viết, thông báo và văn bản công khai trong cổng thông tin.</p>
        </div>
    </section>

    <section class="public-toolbar public-search-hero">
        <div class="public-search-field">
            <span class="material-symbols-outlined">search</span>
            <input class="public-input"
                   @bind="keyword"
                   @bind:event="oninput"
                   @onkeydown="HandleKeyDown"
                   placeholder="Nhập từ khóa tìm kiếm..." />
        </div>
        <button class="public-button public-button-primary" type="button" @onclick="SearchAsync">
            Tìm kiếm
        </button>
    </section>

    @if (isLoading)
    {
        <div class="public-state-card">
            <div class="spinner"></div>
            <p>Đang tải kết quả...</p>
        </div>
    }
    else if (result == null || string.IsNullOrWhiteSpace(keyword))
    {
        <div class="public-state-card">
            <span class="material-symbols-outlined">manage_search</span>
            <h2>Nhập từ khóa để bắt đầu</h2>
            <p>Kết quả sẽ hiển thị theo nhóm bài viết và văn bản.</p>
        </div>
    }
    else
    {
        var totalResults = result.Posts.Count + result.Documents.Count;
        <div class="public-results-summary">
            <span>Tìm thấy <strong>@totalResults</strong> kết quả cho "<strong>@keyword</strong>"</span>
        </div>

        <section class="public-results-grid">
            <div class="public-card">
                <div class="public-card-head">
                    <h2>Bài viết</h2>
                    <span>@result.Posts.Count</span>
                </div>
                @if (result.Posts.Any())
                {
                    <div class="public-result-list">
                        @foreach (var item in result.Posts)
                        {
                            <article class="public-result-item">
                                <span class="public-result-type">Bài viết</span>
                                <span class="post-card-view-count post-card-view-count-inline">
                                    <span class="material-symbols-outlined">visibility</span>
                                    @FormatViews(item.ViewCount)
                                </span>
                                <h3><a href="@PostHref(item)">@item.Title</a></h3>
                                @if (!string.IsNullOrWhiteSpace(item.Summary))
                                {
                                    <p>@item.Summary</p>
                                }
                            </article>
                        }
                    </div>
                }
                else
                {
                    <p class="public-empty-text">Không có bài viết phù hợp.</p>
                }
            </div>

            <div class="public-card">
                <div class="public-card-head">
                    <h2>Văn bản</h2>
                    <span>@result.Documents.Count</span>
                </div>
                @if (result.Documents.Any())
                {
                    <div class="public-result-list">
                        @foreach (var item in result.Documents)
                        {
                            <article class="public-result-item">
                                <span class="public-result-type">Văn bản</span>
                                <h3><a href="@DocumentHref(item)">@item.Title</a></h3>
                                @if (!string.IsNullOrWhiteSpace(item.Summary))
                                {
                                    <p>@item.Summary</p>
                                }
                            </article>
                        }
                    </div>
                }
                else
                {
                    <p class="public-empty-text">Không có văn bản phù hợp.</p>
                }
            </div>
        </section>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "q")]
    public string? QueryKeyword { get; set; }

    private string keyword = string.Empty;
    private string? loadedKeyword;
    private PublicSearchResult? result;
    private bool isLoading;

    protected override async Task OnParametersSetAsync()
    {
        var queryKeyword = GetQueryKeyword();
        if (!string.Equals(queryKeyword, loadedKeyword, StringComparison.Ordinal))
        {
            loadedKeyword = queryKeyword;
            keyword = queryKeyword;
            await ExecuteSearchAsync();
        }
    }

    private async Task SearchAsync()
    {
        var trimmed = keyword.Trim();
        var url = string.IsNullOrWhiteSpace(trimmed)
            ? "/search"
            : $"/search?q={Uri.EscapeDataString(trimmed)}";

        Nav.NavigateTo(url);
        if (string.Equals(trimmed, loadedKeyword, StringComparison.Ordinal))
            await ExecuteSearchAsync();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await SearchAsync();
    }

    private async Task ExecuteSearchAsync()
    {
        if (string.IsNullOrWhiteSpace(keyword))
        {
            result = new PublicSearchResult();
            isLoading = false;
            return;
        }

        isLoading = true;
        result = await PublicSearchService.SearchAsync(PN_PublicVariables.MaTruong, keyword.Trim());
        isLoading = false;
    }

    private string GetQueryKeyword()
    {
        if (!string.IsNullOrWhiteSpace(QueryKeyword))
            return QueryKeyword;

        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);
        return query.TryGetValue("q", out var q) ? q.ToString() : string.Empty;
    }

    private static string PostHref(PublicSearchItem item)
        => string.IsNullOrWhiteSpace(item.Slug) ? "/posts" : $"/posts/{item.Slug}";

    private static string DocumentHref(PublicSearchItem item)
        => string.IsNullOrWhiteSpace(item.Id) ? "/documents" : $"/documents/{item.Id}";

    private static string FormatViews(long views)
        => views < 1_000 ? $"{views:N0}" : $"{views / 1_000d:0.#}K";
}
