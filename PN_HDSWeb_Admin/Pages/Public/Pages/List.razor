@page "/about"
@using PN_HDSWeb_Admin.Services.Public
@inject IPublicStaticPageService PublicStaticPageService

<div class="public-page public-static-list-page">
    <nav class="public-breadcrumb" aria-label="breadcrumb">
        <a href="/">Trang chủ</a>
        <span>/</span>
        <span>Giới thiệu</span>
    </nav>

    <section class="public-page-head">
        <div>
            <div class="public-kicker">Thông tin nhà trường</div>
            <h1>Giới thiệu</h1>
            <p>Các trang thông tin nền tảng về đơn vị, tổ chức và hoạt động công khai.</p>
        </div>
    </section>

    <section class="public-card">
        @if (pages == null)
        {
            <div class="public-state-card public-state-card-inline">
                <div class="spinner"></div>
                <p>Đang tải danh sách trang...</p>
            </div>
        }
        else if (!pages.Any())
        {
            <p class="public-empty-text">Chưa có trang giới thiệu được công khai.</p>
        }
        else
        {
            <div class="public-link-grid">
                @foreach (var item in pages)
                {
                    <a class="public-link-card" href="@StaticPageHref(item)">
                        <span class="material-symbols-outlined">article</span>
                        <strong>@item.Title</strong>
                    </a>
                }
            </div>
        }
    </section>
</div>

@code {
    private List<PublicStaticPageMenuItem>? pages;

    protected override async Task OnInitializedAsync()
    {
        pages = await PublicStaticPageService.GetPagesByMenuAsync(PN_PublicVariables.MaTruong);
    }

    private static string StaticPageHref(PublicStaticPageMenuItem item)
        => string.IsNullOrWhiteSpace(item.Slug) ? "/about" : $"/pages/{item.Slug}";
}
