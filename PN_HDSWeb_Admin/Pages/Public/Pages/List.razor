@page "/about"
@using PN_HDSWeb_Admin.Services.Public
@inject IPublicStaticPageService PublicStaticPageService

<div class="public-article">
    <nav class="breadcrumb">
        <a href="/">Trang chủ</a>
        <span>/</span>
        <span>Giới thiệu</span>
    </nav>

    <section class="content-card">
        <h1>Giới thiệu</h1>
        <ul class="simple-list">
            @if (pages != null)
            {
                @foreach (var item in pages)
                {
                    <li><a href="/pages/@item.Slug">@item.Title</a></li>
                }
            }
        </ul>
    </section>
</div>

@code {
    private List<PublicStaticPageMenuItem>? pages;

    protected override async Task OnInitializedAsync()
    {
        pages = await PublicStaticPageService.GetPagesByMenuAsync(PN_PublicVariables.MaTruong);
    }
}
