        color: #94a3b8;
        letter-spacing: 0.4px;
        text-transform: uppercase;
        white-space: nowrap;
    }

    .loginP-help-box {
        text-align: center;
        padding: 14px 16px;
        border-radius: 12px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
    }

    .loginP-help-text {
        margin: 0;
        font-size: 14px;
        line-height: 1.6;
        color: #64748b;
    }
    /* --- LOGIN CARD --- */
