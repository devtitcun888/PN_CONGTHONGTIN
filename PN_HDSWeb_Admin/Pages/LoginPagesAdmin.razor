@* 
@namespace LoginComponent
@using Microsoft.Extensions.Logging
@using System.Net.Http.Headers
@using System.Text.Json
@using System.Text.Encodings.Web
@using System.Security.Cryptography
@using System.Text
@using Microsoft.AspNetCore.Identity
@using hDataLibraryN8
@using PN_HDSWeb_Admin.Authentication
@using PN_HDSWeb_Admin.Data.Services
@using PN_HDSWeb_Admin.Data.Model

@inject UserAccountService userAccountService
@inject IJSRuntime JS
@inject AuthenticationStateProvider authStateProvider
@inject NavigationManager navManager
@inject HttpContentService httpContent
@inject HttpClient httpClient
@inject TokenProvider TokenProvider
@inject UserState UserState
@inject IHttpContextAccessor httpContextAccessor

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@mdi/font@6.9.96/css/materialdesignicons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
    <div class="loginP-wrapper">
        <div class="loginP-container">
            <div class="loginP-card">
                <div class="loginP-header">
                    <div class="loginP-logo-area">
                        @if (PN_PublicVariables.CapHoc == "0")
                        {
                            <img class="loginP-app-logo" src="image/logo/logoH2.png" alt="Logo" />
                        }
                        else
                        {
                            <img class="loginP-app-logo" src="image/logo/logoHD.svg" alt="Logo" />
                        }
                    </div>

                    <h4 class="loginP-welcome-text">Đăng nhập</h4>
                    <p class="loginP-sub-text">Truy cập hệ thống quản lý</p>
                </div>

                <div class="loginP-body">
                    <div class="loginP-action-group">
                        <button @onclick="() => DirectToSSO(2)" class="loginP-btn-sso loginP-btn-sso-primary">
                            <span class="mdi mdi-shield-account-outline loginP-icon"></span>
                            <span>Đăng nhập SSO giáo viên</span>
                        </button>
                    </div>
                    <div class="loginP-help-box">
                        <p class="loginP-help-text">
                            Thầy/Cô quên mật khẩu vui lòng liên hệ nhà trường để được hỗ trợ.
                        </p>
                    </div>
                </div>
            </div>
            <div class="loginP-footer-info">
                <p>&copy; @DateTime.Now.Year - Hệ thống quản lý trường học TITKUL</p>
            </div>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="loginP-overlay-backdrop">
            <div class="loginP-loader-box">
                <div class="loginP-spinner"></div>
                <p>Đang xử lý...</p>
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(alertMessage))
    {
        <div class="loginP-toast-notification">
            <div class="loginP-toast-icon">
                <span class="mdi mdi-alert-circle-outline"></span>
            </div>
            <div class="loginP-toast-content">
                <span class="loginP-toast-title">Thông báo</span>
                <span class="loginP-toast-message">@alertMessage</span>
            </div>
            <button class="loginP-toast-close" @onclick="CloseAlert">
                <span class="mdi mdi-close"></span>
            </button>
        </div>
    }
</body>
</html>

<style>
    /* ============== LOGIN PAGE ============ */
    .loginP-wrapper * {
        box-sizing: border-box;
    }

    .loginP-wrapper {
        min-height: 100vh;
        width: 100%;
        background-image: url('../image/background.jpg');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        display: flex;
        justify-content: center;
        align-items: center;
        position: relative;
        font-family: 'Inter', sans-serif;
    }

    .loginP-wrapper::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 1;
    }

    .loginP-container {
        position: relative;
        z-index: 2;
        width: 100%;
        max-width: 440px;
        padding: 20px;
        animation: loginP-slideUp 0.6s ease-out;
    }
    .loginP-body {
    display: flex;
    flex-direction: column;
    gap: 20px;
    }

    .loginP-action-group {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .loginP-divider {
        display: flex;
        align-items: center;
        gap: 12px;
        margin: 4px 0;
    }

    .loginP-divider::before,
