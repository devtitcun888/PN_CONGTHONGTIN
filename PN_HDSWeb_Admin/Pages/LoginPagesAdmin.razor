</style>

@code {
    // Biến trạng thái
    private bool isLoading = false;
    private string alertMessage = string.Empty;
    private bool showAdminDropdown = false;
    private bool IsShowPass = false;

    // Model cho form admin
    private AdminLoginModel data = new AdminLoginModel();

    private readonly string defaultSchoolId = PN_PublicVariables.MaTruong;

    // Dữ liệu SSO
    private GetSSOLoginUrl ssoResponse = new GetSSOLoginUrl();
    private ThongTinTruongSSO? SSOData;

    public class AdminLoginModel
    {
        public string UserName { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }

    // Xử lý khi trang được khởi tạo
    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            var uri = navManager.ToAbsoluteUri(navManager.Uri);
            var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);

            if (query.ContainsKey("token"))
            {
                TokenProvider.AccessToken = query["token"];
                if (!string.IsNullOrEmpty(TokenProvider.AccessToken))
                {
                  await JS.InvokeVoidAsync("history.replaceState", null, "", "/login");

                    await GetSessionAndLogin(TokenProvider.AccessToken);
                    return;
                }
            }
        }
        catch (Exception ex)
        {
            ShowAlert("Da xay ra loi, vui long thu lai!");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    // Điều hướng SSO
    private async Task DirectToSSO(int type)
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            string currentUrl = navManager.Uri;
            ssoResponse = await httpContent.HandleDirectToSSO(type, currentUrl, defaultSchoolId);

            if (ssoResponse != null && !string.IsNullOrEmpty(ssoResponse.Result))
            {
                navManager.NavigateTo(ssoResponse.Result, true);
            }
            else
            {
                ShowAlert("Không thể kết nối với hệ thống SSO. Vui lòng thử lại sau.");
                isLoading = false;
            }
        }
        catch (Exception ex)
        {
            ShowAlert("Da xay ra loi, vui long thu lai!");
            isLoading = false;
        }
    }

    // Xử lý session từ token SSO trả về
    private async Task GetSessionAndLogin(string token)
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            var url = @"https://apigateway.hcm.edu.vn/SSO/CSDLAuth/getSessionData";

            var request = new HttpRequestMessage(HttpMethod.Get, url);
            request.Headers.Accept.Add(new MediaTypeWithQualityHeaderValue("text/plain"));
            request.Headers.Add("Token", token);

            var response = await httpClient.SendAsync(request);
            response.EnsureSuccessStatusCode();

            var responseContent = await response.Content.ReadAsStringAsync();

            var responseData = JsonSerializer.Deserialize<ApiResponseSingle<ThongTinTruongSSO>>(
                responseContent,
                new JsonSerializerOptions { PropertyNameCaseInsensitive = true }
            );

            if (responseData?.Result == null)
            {
                ShowAlert("Không lấy được dữ liệu SSO");
                return;
            }

            SSOData = responseData.Result;

            var data = new AccountData_
                {
                    UserName = (SSOData.UserName == "admin"
                        ? SSOData.UserName
                        : SSOData.UserID)?.ToLower(),

                    MaTruong = SSOData.SchoolId?.ToLower(),

                    Cap = GetCapFromSSO()
                };

            // Lưu session
            await TruongService.hSaveSessionAsync(
                token,
                data.UserName,
                SSOData.SchoolId
            );

            await AuthenticateSSOUser(data);
        }
        catch (Exception ex)
        {
            ShowAlert("Da xay ra loi, vui long thu lai!");
            isLoading = false;
        }
    }

    private string? GetCapFromSSO()
    {
        if (SSOData?.UserData != null && SSOData.UserData.Count > 0)
        {
            var firstItem = (JsonElement)SSOData.UserData[0];

            if (firstItem.TryGetProperty("MA_CAP_HOC", out var capElement))
            {
                return capElement.GetString();
            }
        }
        return null;
    }
    // Xác thực người dùng SSO
    private async Task AuthenticateSSOUser(AccountData_ data)
    {
        try
        {
            var userId = SSOData?.UserID;
            var schoolId = SSOData?.SchoolId;
            var userName = SSOData?.UserName;

            if (string.IsNullOrEmpty(schoolId))
            {
                ShowAlert("SchoolId không hợp lệ");
                return;
            }

            var thongTinTruong = await userAccountService
                .GetThongTinTruong(schoolId)
                .ConfigureAwait(false);

            if (thongTinTruong == null)
            {
                ShowAlert("Trường không tồn tại trong hệ thống");
                return;
            }

            UserSession session;

            // ================= ADMIN =================
            if (userName?.Equals("admin", StringComparison.OrdinalIgnoreCase) == true)
            {
                session = new UserSession
                    {
                        MaUser = SSOData.UserID,
                        MaTruongBo = thongTinTruong.MaTruongBo,
                        Role = "Administrator",
                        TenTruong = thongTinTruong.TenTruong,
                        UserName = userName,
                        Cap = thongTinTruong.Cap,
                        SessionId = Guid.NewGuid().ToString(),
                        ExpiryTime = DateTime.UtcNow.AddHours(8)
                    };
            }
            else
            {
                var thongTinNguoiDung = await userAccountService
                    .GetThongTinNguoiDung(userId)
                    .ConfigureAwait(false);

                if (thongTinNguoiDung == null)
                {
                    ShowAlert("Tài khoản không có quyền truy cập hệ thống");
                    return;
                }

                // ===== Lấy năm học =====
                var namHocHienTai = "";
                if (string.IsNullOrEmpty(namHocHienTai))
                {
                    var cauHinh = await TruongService.hGetCauHinhNamHoc(thongTinTruong.MaTruongBo);
                    DateTime today = DateTime.Today;

                    var namHoc = cauHinh
                        .FirstOrDefault(x => today >= x.NgayBatDau && today <= x.NgayKetThuc);

                    namHocHienTai = namHoc?.MaNamHoc ?? "2025-2026";
                }

                // ===== FIX CAP CHUẨN =====
                var capArray = thongTinTruong.Cap;

                // Nếu DB không có → fallback từ SSO
                if (capArray == null || capArray.Length == 0)
                {
                    capArray = !string.IsNullOrEmpty(data.Cap)
                        ? new[] { data.Cap }
                        : Array.Empty<string>();

                    // update lại object
                    thongTinTruong.Cap = capArray;
                }

                var capHocTruong = string.Join(",", capArray);

                var phanCong = await TruongService.hGetPhanCongCuaGiaoVien(
                    thongTinTruong.MaTruongBo,
                    capHocTruong,
                    namHocHienTai,
                    thongTinNguoiDung.MaSo
                );

                session = new UserSession
                    {
                        MaUser = thongTinNguoiDung.MaSo,
                        MaTruongBo = thongTinTruong.MaTruongBo,
                        Role = "GiaoVien",
                        TenTruong = thongTinTruong.TenTruong,
                        UserName = userId,
                        Cap = capArray, 
                        SessionId = Guid.NewGuid().ToString(),
                        ExpiryTime = DateTime.UtcNow.AddHours(8),
                        DanhSachLopChuNhiem = phanCong.ChuNhiemList,
                        DanhSachLopGiangDay = phanCong.GiangDayList
                    };
            }

            await ((CustomAuthenticationStateProvider)authStateProvider)
                .UpdateAuthenticationState(session);

            navManager.NavigateTo("/dashboard", true);
        }
        catch (Exception ex)
        {
            ShowAlert("Da xay ra loi, vui long thu lai!");
        }
        finally
        {
            if (!navManager.Uri.Contains("/dashboard"))
            {
                isLoading = false;
            }
        }
    }

    // Xử lý đăng nhập admin/local bằng dữ liệu l_user trong DB Index.
    private async Task Authenticate()
    {
        try
        {
            alertMessage = string.Empty;

            var username = data.UserName?.Trim();
            var password = data.Password ?? string.Empty;

            if (string.IsNullOrWhiteSpace(username) || string.IsNullOrWhiteSpace(password))
            {
                ShowAlert("Vui lòng nhập đầy đủ tên đăng nhập và mật khẩu.");
                return;
            }

            isLoading = true;
            StateHasChanged();

            var accounts = await TruongService.GetAccountDataAsync();
            var account = accounts.FirstOrDefault(x =>
                string.Equals(x.UserName?.Trim(), username, StringComparison.OrdinalIgnoreCase));

            if (account == null || !VerifyLocalPassword(account, password))
            {
                ShowAlert("Tên đăng nhập hoặc mật khẩu không đúng.");
                return;
            }

            var role = NormalizeRole(account.Roles);
            if (string.IsNullOrEmpty(role))
            {
                ShowAlert("Tài khoản chưa được gán quyền hợp lệ.");
                return;
            }

            var maTruongBo = string.IsNullOrWhiteSpace(account.MaTruongBo)
                ? PN_PublicVariables.MaTruong
                : account.MaTruongBo.Trim();

            var thongTinTruong = await userAccountService.GetThongTinTruong(maTruongBo);
            if (thongTinTruong == null)
            {
                ShowAlert("Không tìm thấy thông tin trường của tài khoản.");
                return;
            }

            var session = new UserSession
                {
                    MaUser = account.UserName,
                    MaTruongBo = thongTinTruong.MaTruongBo,
                    Role = role,
                    TenTruong = thongTinTruong.TenTruong,
                    UserName = account.UserName,
                    FullName = account.UserName,
                    Cap = thongTinTruong.Cap,
                    DeviceName = account.DeviceName,
                    SessionId = Guid.NewGuid().ToString(),
                    ExpiryTime = DateTime.UtcNow.AddHours(8)
                };

            await ((CustomAuthenticationStateProvider)authStateProvider)
                .UpdateAuthenticationState(session);

            navManager.NavigateTo("/dashboard", true);
        }
        catch (Exception ex)
        {
            ShowAlert($"Không thể đăng nhập admin. {ex.Message}");
        }
        finally
        {
            if (!navManager.Uri.Contains("/dashboard"))
            {
                isLoading = false;
                StateHasChanged();
            }
        }
    }

    private static bool VerifyLocalPassword(UserAccountData account, string password)
    {
        var storedPassword = account.Password?.Trim() ?? string.Empty;
        if (string.IsNullOrEmpty(storedPassword))
            return false;

        if (string.Equals(storedPassword, password, StringComparison.Ordinal))
            return true;

        if (IsSha256Hex(storedPassword))
        {
            var hash = Convert.ToHexString(SHA256.HashData(Encoding.UTF8.GetBytes(password)));
            return string.Equals(storedPassword, hash, StringComparison.OrdinalIgnoreCase);
        }

        if (IsMd5Hex(storedPassword))
        {
            var hash = Convert.ToHexString(System.Security.Cryptography.MD5.HashData(Encoding.UTF8.GetBytes(password)));
            return string.Equals(storedPassword, hash, StringComparison.OrdinalIgnoreCase);
        }

        try
        {
            var hasher = new PasswordHasher<UserAccountData>();
            var result = hasher.VerifyHashedPassword(account, storedPassword, password);
            return result == PasswordVerificationResult.Success ||
                   result == PasswordVerificationResult.SuccessRehashNeeded;
        }
        catch
        {
            return false;
        }
    }

    private static bool IsSha256Hex(string value)
    {
        return value.Length == 64 && value.All(Uri.IsHexDigit);
    }

    private static bool IsMd5Hex(string value)
    {
        return value.Length == 32 && value.All(Uri.IsHexDigit);
    }

    private static string NormalizeRole(string? role)
    {
        var normalized = (role ?? string.Empty).Trim();
        if (string.IsNullOrEmpty(normalized))
            return string.Empty;

        var upper = normalized.ToUpperInvariant();
        return upper switch
        {
            "ADMIN" or "ADMINISTRATOR" or "QUANTRI" or "QUAN_TRI" or "QUANTRIVIEN" => "Administrator",
            "GIAOVIEN" or "GIAO_VIEN" or "TEACHER" => "GiaoVien",
            "HOCSINH" or "HOC_SINH" or "STUDENT" => "HocSinh",
            "PHUHUYNH" or "PHU_HUYNH" or "PARENT" => "PhuHuynh",
            _ => normalized
        };
    }

