@code {
    [Parameter]
    public bool IsDisplayNavMenu { get; set; }
    [Parameter]
    public EventCallback<bool> IsOpenNavMenuChanged { get; set; }

    private void OnCloseNavMenu()
    {
        IsDisplayNavMenu = true;
        IsOpenNavMenuChanged.InvokeAsync(IsDisplayNavMenu);
    }
    private List<Feature> features = new();
    private List<PhanQuyen> phanquyens = new();
    private List<ChucNang> chucnangs = new();
    private List<MenuItem> MenuItems = new();
    private List<MenuItem> TeacherMenuItems = new();
    private string currentTabId = "";
    private string currentUserName = "";
    private List<MenuItem> Menus = new();
    private List<GiaoVien> giaoViens= new();
    private GiaoVien giaovien = new();

    private UserSession currentSession;
    public string token = "";
    private List<ssoSession> ssoSessions = new();


    protected override async Task OnInitializedAsync()
    {
        await Task.Delay(1000);
        features = await Data.Services.hGetFeatures();
        phanquyens = await TH_Service.hGetAuthorityAsync();
        currentTabId = await TabSessionService.GetOrCreateTabId();
        var now = DateTime.Now;
        // Lấy token SSO
        ssoSessions = await TH_Service.hGetSSOToken();
        token = ssoSessions
        .Where(s => s.start_time <= now && now <= s.end_time)
        .OrderByDescending(s => s.start_time) // Ưu tiên token mới hơn
        .FirstOrDefault()?.token_sso ?? "";
        //Temp
        await UpdateSessionInfo();
        giaoViens = await TH_Service.hGetGiaoVienDataAsync();
        giaovien = giaoViens.FirstOrDefault(g => g.ma_so == currentSession.MaUser);
        await UpdateMenuItems();

        TabSessionService.OnSessionChanged += OnSessionChanged;
    }

    private async Task UpdateSessionInfo()
    {
        currentSession = await TabSessionService.GetUserSession(currentTabId);
    }

    private async Task UpdateMenuItems()
    {
        if (currentSession?.Role == "Administrator")
        {
            Menus = await NavService.InitializeMenuItems(features);
        }
        else if (currentSession?.Role == "GiaoVien")
        {
            // chucnangs= await CheckAuthorUser(currentSession.MaUser);
            chucnangs = null;
            Menus = await NavService.InitializeTeacherMenuItems(features, chucnangs);
        }
        // Add other role-based menu initializations here if needed
    }

    private async void OnSessionChanged()
    {
        await UpdateSessionInfo();
        await UpdateMenuItems();
        await InvokeAsync(StateHasChanged);
    }
    private async Task InitializeMenuItems()
    {
        if (UserState.Role == "Administrator")
        {
            await NavService.InitializeMenuItemsAsync(features);
        }
        else if (UserState.Role == "GiaoVien")
        {
            await NavService.InitializeTeacherMenuItemsAsync(features);
        }
        // Add other role-specific initializations here if needed
    }
    private async void OnUserStateChanged()
    {
        await InitializeMenuItems();
        StateHasChanged();
    }
    public void Dispose()
    {
        UserState.OnChange -= OnUserStateChanged;
    }
    private async Task<List<ChucNang>> CheckAuthorUser(string maso)
    {
        var jschucnang = phanquyens.FirstOrDefault(p => p.quyen_person == maso)?.quyen_json;
        if (jschucnang != null)
        {
            var chucnangtmp = JsonConvert.DeserializeObject<object>(jschucnang);
            List<ChucNang> chucnanglist = JsonConvert.DeserializeObject<List<ChucNang>>(chucnangtmp.chucnang.ToString());

            return chucnanglist;
        }
        return null;
    }


    private async Task NavigateToComponent(string menuItemUrl)
    {
        try
        {
            NavManager.NavigateTo(menuItemUrl);
        }
        catch (Exception ex)
        {
            // Handle the error (e.g., display an error message)
            Console.WriteLine($"Error navigating to component: {ex.Message}");
        }
    }

    private int isDropdownVisible = 0;
    private bool isOpenDropdown = false;

    private void ToggleDropdown(int section)
    {
        if (isDropdownVisible == section)
        {
            isOpenDropdown = !isOpenDropdown;

        }
        else
        {
            isDropdownVisible = section;
            isOpenDropdown = true;
        }
        // isDropdownVisible = isDropdownVisible == section ? 0 : section;
    }

