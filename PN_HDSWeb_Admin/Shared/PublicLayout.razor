@inherits LayoutComponentBase
@implements IDisposable
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using PN_HDSWeb_Admin.Services.Public
@inject IPublicNavigationService PublicNavigationService
@inject IPublicStaticPageService PublicStaticPageService
@inject IPublicPostCategoryService PublicPostCategoryService
@inject IPublicDocumentTypeService PublicDocumentTypeService
@inject IJSRuntime JS
@inject NavigationManager Nav

<style>
    .public-header {
        position: sticky !important;
        top: 0 !important;
        z-index: 1000 !important;
        background: #ffffff !important;
        will-change: transform, box-shadow;
        transition: box-shadow .22s ease, background-color .22s ease;
    }

    .public-layout {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
    }

    .public-main {
        flex: 1;
        padding: 20px 0 40px;
        background: #f3f6fb;
    }

    .public-container {
        width: min(1200px, calc(100% - 32px));
        margin: 0 auto;
    }

    .public-footer {
        margin-top: auto;
        background: #0f172a;
        color: #cbd5e1;
        padding: 28px 0;
    }

    .public-footer-grid {
        width: min(1200px, calc(100% - 32px));
        margin: 0 auto;
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 20px;
    }

    .public-header.collapsed {
        box-shadow: 0 10px 30px rgba(15, 23, 42, .16) !important;
    }

    .public-header-banner {
        width: 100%;
        overflow: hidden;
        max-height: 220px;
        opacity: 1;
        transform: translateY(0) scaleY(1);
        transform-origin: top center;
        transition: max-height .38s cubic-bezier(.22, 1, .36, 1), opacity .28s ease, transform .38s cubic-bezier(.22, 1, .36, 1);
        will-change: max-height, opacity, transform;
    }

    .public-header-banner.collapsed {
        max-height: 0 !important;
        opacity: 0 !important;
        transform: translateY(-10px) scaleY(.96);
    }

    .public-banner-strip {
        width: 100%;
        max-height: 220px;
        aspect-ratio: 1200 / 220;
        overflow: hidden;
        background: linear-gradient(112deg, #395e77, #3587f5);
    }

    .public-banner-strip img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        object-position: center center;
        display: block;
    }

    .public-nav-label span {
        display: inline-flex;
        align-items: center;
        padding: 5px 10px;
        color: rgba(255,255,255,.82);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .08em;
        text-transform: uppercase;
        white-space: nowrap;
    }

    @@media (max-width: 900px) {
        .public-nav-label {
            display: none;
        }
    }
</style>

<div class="public-layout">
    <header class="public-header @(isHeaderCollapsed ? "collapsed" : string.Empty)">
        <div class="public-header-banner @(isHeaderCollapsed ? "collapsed" : string.Empty)">
            @if (modelBanner?.Any() == true)
            {
                <div class="public-banner-strip">
                    @foreach (var banner in modelBanner.Take(1))
                    {
                        <img src="@banner.ImageUrl" alt="@banner.Title" />
                    }
                </div>
            }
        </div>

        <nav class="public-nav @(isMobileMenuOpen ? "open" : string.Empty) @(isHeaderCollapsed ? "sticky" : string.Empty)">
            <button class="public-mobile-toggle" @onclick="ToggleMobileMenu">☰ Menu</button>
            <ul>
                <li class="nav-item @(IsActiveMenu("/") ? "active" : string.Empty)"><a href="/" title="Trang chủ">⌂</a></li>
                <li class="nav-item public-nav-label"><span>Trang chủ</span></li>
                @if (menus != null)
                {
                    @foreach (var item in menus.Where(x => string.IsNullOrWhiteSpace(x.ParentId)).OrderBy(x => x.SortOrder))
                    {
                        var href = GetMenuHref(item);
                        var active = IsActiveMenu(href);
                        var categoryChildren = GetPostCategoryChildrenForMenu(item);
                        var childMenus = menus.Where(x => x.ParentId == item.Id).OrderBy(x => x.SortOrder).ToList();
                        var hasDropdown = childMenus.Any() || categoryChildren.Any();
                        <li class="nav-item @(hasDropdown ? "has-dropdown" : string.Empty) @(active ? "active" : string.Empty)">
                            <a href="@href" target="@item.Target">@item.MenuName</a>
                            @if (hasDropdown)
                            {
                                <ul class="public-dropdown">
                                    @foreach (var child in childMenus)
                                    {
                                        var childHref = GetMenuHref(child);
                                        <li class="@(IsActiveMenu(childHref) ? "active" : string.Empty)"><a href="@childHref" target="@child.Target">@child.MenuName</a></li>
                                    }
                                    @foreach (var cat in categoryChildren)
                                    {
                                        <li><a href="/posts/category/@cat.Slug">@cat.CategoryName</a></li>
                                    }
                                </ul>
                            }
                        </li>
                    }
                }

                <li class="nav-item @(IsActiveMenu("/documents") ? "active" : string.Empty) has-dropdown">
                    <a href="/documents">Văn bản công khai</a>
                    @if (documentTypes != null && documentTypes.Any())
                    {
                        <ul class="public-dropdown">
                            <li><a href="/documents">Tất cả văn bản</a></li>
                            @foreach (var type in documentTypes)
                            {
                                <li><a href="/documents/type/@type.Slug">@type.TypeName</a></li>
                            }
                        </ul>
                    }
                </li>

                <li class="nav-item @(IsActiveMenu("/organization") ? "active" : string.Empty)">
                    <a href="/organization">Cơ cấu tổ chức</a>
                </li>

                @if (staticPages != null && staticPages.Any())
                {
                    <li class="nav-item has-dropdown">
                        <a href="#">Trang tĩnh</a>
                        <ul class="public-dropdown">
                            @foreach (var trang in staticPages)
                            {
                                <li><a href="/pages/@trang.Slug">@trang.Title</a></li>
                            }
                        </ul>
                    </li>
                }

                <li class="nav-item public-grid-trigger">
                    <a href="#" title="Danh mục">▦</a>
                </li>
            </ul>
        </nav>

        <div class="public-info-searchbar">
            <div class="public-info-date">Thứ @CurrentDateTimeText</div>
            <div class="public-info-spacer"></div>
            <div class="public-language-links">
                <a href="#">VN</a>
                <a href="#">EN</a>
            </div>
            <div class="public-search-mini">
                <input @bind="SearchKeyword" @bind:event="oninput" @onkeydown="HandleSearchKeyDown" placeholder="Từ khóa tìm kiếm..." />
                <button type="button" @onclick="GoSearch" title="Tìm kiếm">🔍</button>
            </div>
        </div>
    </header>

    <main class="public-main">
        <div class="public-container">
            @if (isLoading)
            {
                <div class="page-loading">
                    <div class="spinner"></div>
                    <p>Đang tải nội dung...</p>
                </div>
            }
            else
            {
                @Body
            }
        </div>
    </main>

    <footer class="public-footer">
        @if (footer != null)
        {
            <div class="public-footer-grid">
                <div class="footer-brand-block">
                    @if (!string.IsNullOrWhiteSpace(footer.LogoUrl))
                    {
                        <img class="footer-logo" src="@footer.LogoUrl" alt="@footer.SchoolName" />
                    }
                    <div>
                        <strong>@footer.SchoolName</strong>
                        <p>@footer.Address</p>
                        <p>@footer.Phone</p>
                    </div>
                </div>
                <div>
                    <p>Liên hệ người phụ trách: @footer.LeaderName</p>
                    <div class="footer-links">
                        @if (!string.IsNullOrWhiteSpace(footer.WebsiteUrl))
                        {
                            <a href="@footer.WebsiteUrl" target="_blank">Website</a>
                        }
                        @if (!string.IsNullOrWhiteSpace(footer.FacebookUrl))
                        {
                            <a href="@footer.FacebookUrl" target="_blank">Facebook</a>
                        }
                        @if (!string.IsNullOrWhiteSpace(footer.YoutubeUrl))
                        {
                            <a href="@footer.YoutubeUrl" target="_blank">YouTube</a>
                        }
                        @if (!string.IsNullOrWhiteSpace(footer.ZaloUrl))
                        {
                            <a href="@footer.ZaloUrl" target="_blank">Zalo</a>
                        }
                    </div>
                </div>
            </div>
        }
    </footer>
</div>

@code {
    private List<PublicNavItem>? menus;
    private List<PublicStaticPageMenuItem>? staticPages;
    private List<PublicPostCategoryItem>? postCategories;
    private List<PublicDocumentTypeItem>? documentTypes;
    private List<PublicBannerItem>? modelBanner;
    private PublicFooterInfo? footer;
    private string SearchKeyword = string.Empty;
    private bool isMobileMenuOpen;
    private bool isLoading = true;
    private bool isHeaderCollapsed;
    private DateTime currentDateTime = DateTime.Now;
    private System.Threading.Timer? clockTimer;
    private DotNetObjectReference<PublicLayout>? dotNetRef;
    private string CurrentDateTimeText => currentDateTime.ToString("dddd, dd/MM/yyyy HH:mm:ss", new System.Globalization.CultureInfo("vi-VN"));

    protected override async Task OnInitializedAsync()
    {
        menus = await PublicNavigationService.GetMenusAsync(PN_PublicVariables.MaTruong);
        staticPages = await PublicStaticPageService.GetPagesByMenuAsync(PN_PublicVariables.MaTruong);
        postCategories = await PublicPostCategoryService.GetCategoriesAsync(PN_PublicVariables.MaTruong);
        documentTypes = await PublicDocumentTypeService.GetDocumentTypesAsync(PN_PublicVariables.MaTruong);
        modelBanner = await PublicNavigationService.GetBannersAsync(PN_PublicVariables.MaTruong);
        footer = await PublicNavigationService.GetFooterAsync(PN_PublicVariables.MaTruong);
        clockTimer = new System.Threading.Timer(_ => InvokeAsync(() =>
        {
            currentDateTime = DateTime.Now;
            StateHasChanged();
        }), null, TimeSpan.Zero, TimeSpan.FromSeconds(1));
        isLoading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("publicHeader.init", dotNetRef);
        }
    }

    [JSInvokable]
    public void SetHeaderCollapsed(bool collapsed)
    {
        if (isHeaderCollapsed == collapsed)
            return;

        isHeaderCollapsed = collapsed;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        clockTimer?.Dispose();
        dotNetRef?.Dispose();
    }

    private void GoSearch()
    {
        var url = string.IsNullOrWhiteSpace(SearchKeyword) ? "/search" : $"/search?q={Uri.EscapeDataString(SearchKeyword)}";
        Nav.NavigateTo(url);
    }

    private void HandleSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            GoSearch();
    }

    private void ToggleMobileMenu() => isMobileMenuOpen = !isMobileMenuOpen;

    private List<PublicPostCategoryItem> GetPostCategoryChildrenForMenu(PublicNavItem menu)
    {
        if (postCategories == null || postCategories.Count == 0 || menu == null)
            return new List<PublicPostCategoryItem>();

        var categoryRootSlug = ResolveCategoryRootSlug(menu);
        if (string.IsNullOrWhiteSpace(categoryRootSlug))
            return new List<PublicPostCategoryItem>();

        var root = postCategories.FirstOrDefault(x => string.Equals(x.Slug, categoryRootSlug, StringComparison.OrdinalIgnoreCase));
        if (root?.Id == null)
            return new List<PublicPostCategoryItem>();

        return postCategories.Where(x => x.ParentId == root.Id).OrderBy(x => x.SortOrder).ToList();
    }

    private string GetMenuHref(PublicNavItem menu) => PublicNavigationService.ResolveMenuUrl(menu);

    private string? ResolveCategoryRootSlug(PublicNavItem menu)
    {
        if (!string.IsNullOrWhiteSpace(menu.PageSlug))
            return menu.PageSlug;

        var href = PublicNavigationService.ResolveMenuUrl(menu);
        if (href.Contains("/posts/category/", StringComparison.OrdinalIgnoreCase))
            return href.Split('/').LastOrDefault();

        var name = menu.MenuName?.Trim().ToLowerInvariant();
        return name switch
        {
            "tin tức" => "tin-tuc",
            "giới thiệu" => "gioi-thieu",
            "văn bản công khai" => "van-ban-cong-khai",
            "tuyển sinh" => "tuyen-sinh",
            "hoạt động" => "hoat-dong",
            _ => null
        };
    }

    private bool IsActiveMenu(string href)
    {
        var current = Nav.Uri;
        if (string.IsNullOrWhiteSpace(href)) return false;
        var absolute = Nav.ToAbsoluteUri(current);
        return absolute.AbsolutePath.TrimEnd('/').Equals(Nav.ToAbsoluteUri(href).AbsolutePath.TrimEnd('/'), StringComparison.OrdinalIgnoreCase);
    }
}
