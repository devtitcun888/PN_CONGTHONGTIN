@inherits LayoutComponentBase
@implements IDisposable
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Routing
@using PN_HDSWeb_Admin.Services.Public
@inject IPublicNavigationService PublicNavigationService
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>EV Rental — Thuê xe điện</PageTitle>

<div class="ev-public-layout">

    <!-- HEADER -->
    <header class="ev-site-header @(isScrolled ? "scrolled" : "")" id="site-header">
        <div class="ev-header-inner">

            <!-- Logo -->
            <a class="ev-brand" href="/" aria-label="Trang chủ">
                <div class="ev-brand-icon-wrap">⚡</div>
                <div class="ev-brand-text">
                    <strong>EV Rental</strong>
                    <small>Thuê xe điện</small>
                </div>
            </a>

            <!-- Nav desktop -->
            <nav class="ev-nav" aria-label="Điều hướng chính">
                <a href="/" class="ev-nav-link @(IsActive("/", exact: true) ? "active" : "")">
                    Trang chủ
                </a>
                <a href="/vehicles" class="ev-nav-link @(IsActive("/vehicles") ? "active" : "")">
                    Xe cho thuê
                </a>
                <a href="/booking/track" class="ev-nav-link @(IsActive("/booking/track") ? "active" : "")">
                    Tra cứu đơn
                </a>
            </nav>

            <!-- Actions -->
            <div class="ev-header-actions">
                <a href="/my-rentals" class="ev-btn ev-btn--ghost ev-btn--sm"
                   style="display:none" id="btn-my-rentals">
                    📋 Đơn của tôi
                </a>
                <a href="/login" class="ev-btn ev-btn--outline ev-btn--sm">
                    Đăng nhập
                </a>
                <a href="/vehicles" class="ev-btn ev-btn--primary ev-btn--sm">
                    Đặt xe ngay
                </a>
                <button class="ev-mobile-toggle" @onclick="ToggleMobileMenu" aria-label="Mở menu">
                    @if (isMobileMenuOpen) { <span>✕</span> } else { <span>☰</span> }
                </button>
            </div>
        </div>

        <!-- Mobile nav -->
        @if (isMobileMenuOpen)
        {
            <div class="ev-mobile-nav">
                <a href="/" class="ev-mobile-nav-link" @onclick="CloseMobileMenu">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>
                    Trang chủ
                </a>
                <a href="/vehicles" class="ev-mobile-nav-link" @onclick="CloseMobileMenu">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13" rx="2"/><path d="M16 8h4l3 5v4h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                    Xe cho thuê
                </a>
                <a href="/booking/track" class="ev-mobile-nav-link" @onclick="CloseMobileMenu">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                    Tra cứu đơn
                </a>
                <a href="/login" class="ev-mobile-nav-link" @onclick="CloseMobileMenu">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                    Đăng nhập
                </a>
                <div style="padding: 12px 16px;">
                    <a href="/vehicles" class="ev-btn ev-btn--primary ev-btn--full">🚗 Đặt xe ngay</a>
                </div>
            </div>
        }
    </header>

    <!-- MAIN -->
    <main class="ev-public-main">
        @Body
    </main>

    <!-- FOOTER -->
    <footer class="ev-site-footer">
        <div class="ev-footer-inner">
            <div class="ev-footer-brand">
                <div class="ev-footer-brand-logo">
                    <span>⚡</span>
                    <strong>EV Rental</strong>
                </div>
                <p>Dịch vụ thuê xe điện tiện lợi, sạch và hiện đại. Cam kết trải nghiệm tốt nhất cho mọi hành trình.</p>
            </div>

            <div class="ev-footer-links">
                <h4>Dịch vụ</h4>
                <a href="/vehicles">Tất cả xe cho thuê</a>
                <a href="/vehicles?loai=scooter">Xe máy điện</a>
                <a href="/vehicles?loai=car">Ô tô điện</a>
                <a href="/vehicles?loai=bike">Xe đạp điện</a>
            </div>

            <div class="ev-footer-links">
                <h4>Hỗ trợ</h4>
                <a href="/booking/track">Tra cứu đơn thuê</a>
                <a href="/login">Đăng nhập / Đăng ký</a>
                <a href="/my-rentals">Lịch sử thuê</a>
            </div>
        </div>

        <div class="ev-footer-bottom">
            <span>© @DateTime.Now.Year EV Rental. Tất cả quyền được bảo lưu.</span>
            <span style="display:flex;gap:16px;font-size:0.78rem;">
                <a href="#" style="color:inherit;">Điều khoản</a>
                <a href="#" style="color:inherit;">Bảo mật</a>
            </span>
        </div>
    </footer>
</div>

@code {
    private bool isMobileMenuOpen;
    private bool isScrolled;
    private DotNetObjectReference<PublicLayout>? dotNetRef;

    protected override void OnInitialized()
    {
        Nav.LocationChanged += HandleLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            dotNetRef = DotNetObjectReference.Create(this);
            try
            {
                await JS.InvokeVoidAsync("evPublic.initScrollHeader", dotNetRef);
            }
            catch { /* ignore if JS not ready */ }
        }
    }

    [JSInvokable]
    public void OnScrollChange(bool scrolled)
    {
        if (isScrolled != scrolled)
        {
            isScrolled = scrolled;
            InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        Nav.LocationChanged -= HandleLocationChanged;
        dotNetRef?.Dispose();
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        isMobileMenuOpen = false;
        _ = InvokeAsync(StateHasChanged);
    }

    private void ToggleMobileMenu() => isMobileMenuOpen = !isMobileMenuOpen;
    private void CloseMobileMenu() => isMobileMenuOpen = false;

    private bool IsActive(string path, bool exact = false)
    {
        try
        {
            var uri = Nav.ToAbsoluteUri(Nav.Uri);
            var current = uri.AbsolutePath.TrimEnd('/');
            var target = path.TrimEnd('/');
            if (string.IsNullOrEmpty(current)) current = "/";
            if (string.IsNullOrEmpty(target)) target = "/";
            if (exact) return string.Equals(current, target, StringComparison.OrdinalIgnoreCase);
            return current.StartsWith(target, StringComparison.OrdinalIgnoreCase);
        }
        catch { return false; }
    }
}
