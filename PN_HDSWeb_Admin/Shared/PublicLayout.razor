@inherits LayoutComponentBase
@implements IDisposable
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Routing
@using PN_HDSWeb_Admin.Services.Public
@inject IPublicNavigationService PublicNavigationService
@inject IPublicStaticPageService PublicStaticPageService
@inject IPublicPostCategoryService PublicPostCategoryService
@inject IPublicDocumentTypeService PublicDocumentTypeService
@inject NavigationManager Nav

<PageTitle>@BrandName</PageTitle>

<div class="public-layout">
    <header class="public-site-header">
        <div class="public-sticky-shell">
            <div class="public-nav-shell">
                <div class="public-container public-nav-inner">
                    <a class="public-brand" href="/" @onclick="CloseMobileMenu" aria-label="Trang chủ">
                        @if (!string.IsNullOrWhiteSpace(footer?.LogoUrl))
                        {
                            <img class="public-brand-logo" src="@footer.LogoUrl" alt="@BrandName" />
                        }
                        <span class="public-brand-text">
                            <strong>@BrandName</strong>
                            <span>@BrandTagline</span>
                        </span>
                    </a>

                    <button type="button"
                            class="public-mobile-toggle"
                            aria-expanded="@isMobileMenuOpen"
                            aria-label="Mở menu"
                            @onclick="ToggleMobileMenu">
                        <span class="material-symbols-outlined">menu</span>
                    </button>

                    <nav class="public-nav @(isMobileMenuOpen ? "open" : string.Empty)" aria-label="Điều hướng chính">
                        <ul>
                            <li class="nav-item @(IsActiveMenu("/") ? "active" : string.Empty)">
                                <a href="/" @onclick="CloseMobileMenu">Trang chủ</a>
                            </li>

                            @if (menus != null)
                            {
                                @foreach (var item in menus.Where(x => string.IsNullOrWhiteSpace(x.ParentId)).OrderBy(x => x.SortOrder))
                                {
                                    var href = NormalizePublicHref(GetMenuHref(item));
                                    var categoryChildren = GetPostCategoryChildrenForMenu(item);
                                    var childMenus = menus.Where(x => x.ParentId == item.Id).OrderBy(x => x.SortOrder).ToList();
                                    var hasDropdown = childMenus.Any() || categoryChildren.Any();
                                    var active = IsActiveMenu(href)
                                        || childMenus.Any(child => IsActiveMenu(NormalizePublicHref(GetMenuHref(child))))
                                        || categoryChildren.Any(cat => IsActiveMenu(PostCategoryHref(cat)));

                                    <li class="nav-item @(hasDropdown ? "has-dropdown" : string.Empty) @(active ? "active" : string.Empty)">
                                        @if (IsNavigableHref(href))
                                        {
                                            <a href="@href"
                                               target="@NormalizeTarget(item.Target)"
                                               rel="@GetRel(item.Target)"
                                               @onclick="CloseMobileMenu">@item.MenuName</a>
                                        }
                                        else
                                        {
                                            <button type="button" class="public-nav-link">@item.MenuName</button>
                                        }

                                        @if (hasDropdown)
                                        {
                                            <ul class="public-dropdown">
                                                @foreach (var child in childMenus)
                                                {
                                                    var childHref = NormalizePublicHref(GetMenuHref(child));
                                                    <li class="@(IsActiveMenu(childHref) ? "active" : string.Empty)">
                                                        @if (IsNavigableHref(childHref))
                                                        {
                                                            <a href="@childHref"
                                                               target="@NormalizeTarget(child.Target)"
                                                               rel="@GetRel(child.Target)"
                                                               @onclick="CloseMobileMenu">@child.MenuName</a>
                                                        }
                                                        else
                                                        {
                                                            <button type="button" class="public-dropdown-button">@child.MenuName</button>
                                                        }
                                                    </li>
                                                }

                                                @foreach (var cat in categoryChildren)
                                                {
                                                    var catHref = PostCategoryHref(cat);
                                                    <li class="@(IsActiveMenu(catHref) ? "active" : string.Empty)">
                                                        <a href="@catHref" @onclick="CloseMobileMenu">@cat.CategoryName</a>
                                                    </li>
                                                }
                                            </ul>
                                        }
                                    </li>
                                }
                            }

                            <li class="nav-item @(IsActiveMenu("/documents") ? "active" : string.Empty) has-dropdown">
                                <a href="/documents" @onclick="CloseMobileMenu">Văn bản</a>
                                @if (documentTypes != null && documentTypes.Any())
                                {
                                    <ul class="public-dropdown">
                                        <li class="@(NormalizePath(Nav.ToAbsoluteUri(Nav.Uri).AbsolutePath) == "/documents" ? "active" : string.Empty)">
                                            <a href="/documents" @onclick="CloseMobileMenu">Tất cả văn bản</a>
                                        </li>
                                        @foreach (var type in documentTypes)
                                        {
                                            var typeHref = DocumentTypeHref(type);
                                            <li class="@(IsActiveMenu(typeHref) ? "active" : string.Empty)">
                                                <a href="@typeHref" @onclick="CloseMobileMenu">@type.TypeName</a>
                                            </li>
                                        }
                                    </ul>
                                }
                            </li>

                            <li class="nav-item @(IsActiveMenu("/organization") ? "active" : string.Empty)">
                                <a href="/organization" @onclick="CloseMobileMenu">Tổ chức</a>
                            </li>

                            @if (staticPages != null && staticPages.Any())
                            {
                                var staticActive = staticPages.Any(trang => IsActiveMenu(StaticPageHref(trang)));
                                <li class="nav-item has-dropdown @(staticActive ? "active" : string.Empty)">
                                    <a href="/about" @onclick="CloseMobileMenu">Giới thiệu</a>
                                    <ul class="public-dropdown">
                                        <li class="@(IsActiveMenu("/about") ? "active" : string.Empty)">
                                            <a href="/about" @onclick="CloseMobileMenu">Tổng quan</a>
                                        </li>
                                        @foreach (var trang in staticPages)
                                        {
                                            var pageHref = StaticPageHref(trang);
                                            <li class="@(IsActiveMenu(pageHref) ? "active" : string.Empty)">
                                                <a href="@pageHref" @onclick="CloseMobileMenu">@trang.Title</a>
                                            </li>
                                        }
                                    </ul>
                                </li>
                            }
                        </ul>
                    </nav>

                    @if (footer?.FeatureSearchEnabled != false)
                    {
                        <div class="public-nav-actions">
                            <div class="public-search-mini">
                                <input @bind="SearchKeyword"
                                       @bind:event="oninput"
                                       @onkeydown="HandleSearchKeyDown"
                                       placeholder="Tìm kiếm..." />
                                <button type="button" @onclick="GoSearch" title="Tìm kiếm">
                                    <span class="material-symbols-outlined">search</span>
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </header>

    <main class="public-main">
        <div class="public-container">
            @if (isLoading)
            {
                <div class="page-loading">
                    <div class="spinner"></div>
                    <p>Đang tải nội dung...</p>
                </div>
            }
            else
            {
                @Body
            }
        </div>
    </main>

    <footer class="public-footer">
        @if (footer != null)
        {
            <div class="public-container public-footer-grid">
                <div class="footer-brand-block">
                    <div class="footer-brand-heading">
                        @if (footer.ShowLogo && !string.IsNullOrWhiteSpace(footer.LogoUrl))
                        {
                            <img class="footer-logo" src="@footer.LogoUrl" alt="@BrandName" />
                        }
                        <strong>@BrandName</strong>
                    </div>

                    <p>@FooterText</p>

                    @if (footer.ShowSocial && HasSocialLinks)
                    {
                        <div class="footer-socials">
                            @if (!string.IsNullOrWhiteSpace(footer.WebsiteUrl))
                            {
                                <a href="@footer.WebsiteUrl" target="_blank" rel="noopener noreferrer" aria-label="Website">
                                    <span class="material-symbols-outlined">language</span>
                                </a>
                            }
                            @if (!string.IsNullOrWhiteSpace(footer.FacebookUrl))
                            {
                                <a href="@footer.FacebookUrl" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
                                </a>
                            }
                            @if (!string.IsNullOrWhiteSpace(footer.YoutubeUrl))
                            {
                                <a href="@footer.YoutubeUrl" target="_blank" rel="noopener noreferrer" aria-label="YouTube">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46A2.78 2.78 0 0 0 1.46 6.42 29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58 2.78 2.78 0 0 0 1.95 1.96C5.12 20 12 20 12 20s6.88 0 8.59-.46a2.78 2.78 0 0 0 1.95-1.96A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58z"/><polygon fill="white" points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02"/></svg>
                                </a>
                            }
                            @if (!string.IsNullOrWhiteSpace(footer.ZaloUrl))
                            {
                                <a href="@footer.ZaloUrl" target="_blank" rel="noopener noreferrer" aria-label="Zalo">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><text x="2" y="18" font-size="16" font-weight="900" font-family="Arial,sans-serif">Z</text></svg>
                                </a>
                            }
                        </div>
                    }
                </div>

                @if (footer.ShowContact && HasContactInfo)
                {
                    <div class="footer-contact-block">
                        <h2>Liên hệ</h2>
                        @if (!string.IsNullOrWhiteSpace(footer.Address))
                        {
                            <p>
                                <span class="material-symbols-outlined">location_on</span>
                                @footer.Address
                            </p>
                        }
                        @if (!string.IsNullOrWhiteSpace(footer.Phone))
                        {
                            <p>
                                <span class="material-symbols-outlined">call</span>
                                @footer.Phone
                            </p>
                        }
                        @if (!string.IsNullOrWhiteSpace(footer.Email))
                        {
                            <p>
                                <span class="material-symbols-outlined">mail</span>
                                @footer.Email
                            </p>
                        }
                        @if (!string.IsNullOrWhiteSpace(footer.LeaderName))
                        {
                            <p>
                                <span class="material-symbols-outlined">person</span>
                                @footer.LeaderName
                            </p>
                        }
                    </div>
                }

                <div class="footer-links-block">
                    <h2>Truy cập nhanh</h2>
                    <div class="footer-links">
                        <a href="/posts">Bài viết</a>
                        <a href="/documents">Văn bản</a>
                        <a href="/organization">Tổ chức</a>
                        <a href="/about">Giới thiệu</a>
                        <a href="/contact">Liên hệ</a>
                    </div>
                </div>
            </div>

            <div class="public-container public-footer-bottom">
                <span>© @DateTime.Now.Year @BrandName. Tất cả quyền được bảo lưu.</span>
                <span>Cập nhật và vận hành bởi TITKUL.</span>
            </div>
        }
    </footer>
</div>

@code {
    private List<PublicNavItem>? menus;
    private List<PublicStaticPageMenuItem>? staticPages;
    private List<PublicPostCategoryItem>? postCategories;
    private List<PublicDocumentTypeItem>? documentTypes;
    private PublicFooterInfo? footer;
    private string SearchKeyword = string.Empty;
    private bool isMobileMenuOpen;
    private bool isLoading = true;

    private string BrandName => string.IsNullOrWhiteSpace(footer?.SchoolName) ? "Cổng thông tin" : footer!.SchoolName!;
    private string BrandTagline => string.IsNullOrWhiteSpace(footer?.SiteSlogan) ? "Cổng thông tin điện tử" : footer!.SiteSlogan!;
    private string FooterText => string.IsNullOrWhiteSpace(footer?.FooterText)
        ? "Cổng thông tin điện tử phục vụ công tác thông tin, truyền thông và công khai hoạt động của nhà trường."
        : footer!.FooterText!;
    private bool HasSocialLinks => footer != null
        && (!string.IsNullOrWhiteSpace(footer.WebsiteUrl)
            || !string.IsNullOrWhiteSpace(footer.FacebookUrl)
            || !string.IsNullOrWhiteSpace(footer.YoutubeUrl)
            || !string.IsNullOrWhiteSpace(footer.ZaloUrl));
    private bool HasContactInfo => footer != null
        && (!string.IsNullOrWhiteSpace(footer.Address)
            || !string.IsNullOrWhiteSpace(footer.Phone)
            || !string.IsNullOrWhiteSpace(footer.Email)
            || !string.IsNullOrWhiteSpace(footer.LeaderName));

    protected override async Task OnInitializedAsync()
    {
        Nav.LocationChanged += HandleLocationChanged;

        menus = await PublicNavigationService.GetMenusAsync(PN_PublicVariables.MaTruong);
        staticPages = await PublicStaticPageService.GetPagesByMenuAsync(PN_PublicVariables.MaTruong);
        postCategories = await PublicPostCategoryService.GetCategoriesAsync(PN_PublicVariables.MaTruong);
        documentTypes = await PublicDocumentTypeService.GetDocumentTypesAsync(PN_PublicVariables.MaTruong);
        footer = await PublicNavigationService.GetFooterAsync(PN_PublicVariables.MaTruong);

        isLoading = false;
    }

    public void Dispose()
    {
        Nav.LocationChanged -= HandleLocationChanged;
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        isMobileMenuOpen = false;
        _ = InvokeAsync(StateHasChanged);
    }

    private void GoSearch()
    {
        CloseMobileMenu();
        var url = string.IsNullOrWhiteSpace(SearchKeyword)
            ? "/search"
            : $"/search?q={Uri.EscapeDataString(SearchKeyword.Trim())}";

        Nav.NavigateTo(url);
    }

    private void HandleSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            GoSearch();
    }

    private void ToggleMobileMenu() => isMobileMenuOpen = !isMobileMenuOpen;

    private void CloseMobileMenu()
    {
        if (isMobileMenuOpen)
            isMobileMenuOpen = false;
    }

    private List<PublicPostCategoryItem> GetPostCategoryChildrenForMenu(PublicNavItem menu)
    {
        if (postCategories == null || postCategories.Count == 0)
            return [];

        var categoryRootSlug = ResolveCategoryRootSlug(menu);
        if (string.IsNullOrWhiteSpace(categoryRootSlug))
            return [];

        var root = postCategories.FirstOrDefault(x => string.Equals(x.Slug, categoryRootSlug, StringComparison.OrdinalIgnoreCase));
        if (root?.Id == null)
            return [];

        return postCategories.Where(x => x.ParentId == root.Id).OrderBy(x => x.SortOrder).ToList();
    }

    private string GetMenuHref(PublicNavItem menu) => PublicNavigationService.ResolveMenuUrl(menu);

    private string? ResolveCategoryRootSlug(PublicNavItem menu)
    {
        if (!string.IsNullOrWhiteSpace(menu.PageSlug))
            return menu.PageSlug;

        var href = NormalizePublicHref(PublicNavigationService.ResolveMenuUrl(menu));
        if (href.Contains("/posts/category/", StringComparison.OrdinalIgnoreCase))
            return href.Split('/', StringSplitOptions.RemoveEmptyEntries).LastOrDefault();

        var name = menu.MenuName?.Trim().ToLowerInvariant();
        return name switch
        {
            "tin tức" => "tin-tuc",
            "giới thiệu" => "gioi-thieu",
            "văn bản công khai" => "van-ban-cong-khai",
            "tuyển sinh" => "tuyen-sinh",
            "hoạt động" => "hoat-dong",
            _ => null
        };
    }

    private static string NormalizePublicHref(string? href)
    {
        if (string.IsNullOrWhiteSpace(href))
            return "/";

        var value = href.Trim();
        return value.Replace("/documents/type/", "/documents/by-type/", StringComparison.OrdinalIgnoreCase);
    }

    private static string PostCategoryHref(PublicPostCategoryItem item)
        => string.IsNullOrWhiteSpace(item.Slug) ? "/posts" : $"/posts/category/{item.Slug}";

    private static string DocumentTypeHref(PublicDocumentTypeItem item)
        => string.IsNullOrWhiteSpace(item.Slug) ? "/documents/types" : $"/documents/by-type/{item.Slug}";

    private static string StaticPageHref(PublicStaticPageMenuItem item)
        => string.IsNullOrWhiteSpace(item.Slug) ? "/about" : $"/pages/{item.Slug}";

    private static string? NormalizeTarget(string? target)
        => string.IsNullOrWhiteSpace(target) ? null : target;

    private static string? GetRel(string? target)
        => string.Equals(target, "_blank", StringComparison.OrdinalIgnoreCase) ? "noopener noreferrer" : null;

    private bool IsNavigableHref(string? href)
    {
        if (string.IsNullOrWhiteSpace(href))
            return false;

        var value = href.Trim();
        return value != "#" && !value.StartsWith("javascript:", StringComparison.OrdinalIgnoreCase);
    }

    private bool IsActiveMenu(string? href)
    {
        if (!IsNavigableHref(href))
            return false;

        try
        {
            var currentUri = Nav.ToAbsoluteUri(Nav.Uri);
            var targetUri = Nav.ToAbsoluteUri(NormalizePublicHref(href));

            if (!string.Equals(currentUri.Host, targetUri.Host, StringComparison.OrdinalIgnoreCase))
                return false;

            var currentPath = NormalizePath(currentUri.AbsolutePath);
            var targetPath = NormalizePath(targetUri.AbsolutePath);

            if (targetPath == "/")
                return currentPath == "/";

            return currentPath.Equals(targetPath, StringComparison.OrdinalIgnoreCase)
                || currentPath.StartsWith(targetPath + "/", StringComparison.OrdinalIgnoreCase);
        }
        catch
        {
            return false;
        }
    }

    private static string NormalizePath(string? path)
    {
        if (string.IsNullOrWhiteSpace(path))
            return "/";

        var normalized = path.Trim();
        if (!normalized.StartsWith('/'))
            normalized = "/" + normalized;

        return normalized.Length > 1 ? normalized.TrimEnd('/') : normalized;
    }
}
