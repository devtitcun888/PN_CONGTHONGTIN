@inherits LayoutComponentBase
@inject NavigationManager NavManager
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthStateProvider

<MudThemeProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<AuthorizeView>
    <Authorized>
        @if (IsLoading)
        {
            <div class="d-flex justify-content-center align-items-center vh-100">
                <Spinner Type="SpinnerType.Border" Size="SpinnerSize.Large" />
            </div>
        }
        else
        {
            <div class="layout-wrapper">
                <main class="layout-body">
                    <div class="layout-content @(IsHomePage ? string.Empty : "is-fluid")">
                        <div class="layout-viewport">
                            @Body
                        </div>
                    </div>
                </main>
            </div>
        }
    </Authorized>

    <NotAuthorized>
        <LoginComponent.LoginPagesAdmin />
    </NotAuthorized>
</AuthorizeView>

@code {
    protected bool IsLoading { get; set; }
    protected bool IsOpenMenu { get; set; } = true;

    private bool IsHomePage =>
        string.IsNullOrEmpty(NavManager.ToBaseRelativePath(NavManager.Uri)) ||
        NavManager.Uri.EndsWith("/", StringComparison.OrdinalIgnoreCase);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            if (!authState.User.Identity?.IsAuthenticated ?? true)
            {
                await JS.InvokeVoidAsync("hideAppLoading", 0);
            }
        }
        catch
        {
        }
    }

    protected async Task ShowLoading(int delay = 300)
    {
        IsLoading = true;
        StateHasChanged();
        await Task.Delay(delay);
        IsLoading = false;
        StateHasChanged();
    }

    protected void ToggleMenu()
    {
        IsOpenMenu = !IsOpenMenu;
    }
}
