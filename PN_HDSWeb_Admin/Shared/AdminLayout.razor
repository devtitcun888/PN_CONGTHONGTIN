@inherits LayoutComponentBase
@using PN_HDSWeb_Admin.Services.Public
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavManager
@inject IJSRuntime JS
@inject IPublicNavigationService PublicNavigationService

<AuthorizeView>
    <Authorized>
        <div class="admin-shell" id="adminShell">
            <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

            <aside class="admin-sidebar" id="adminSidebar">
                <div class="admin-brand">
                    @if (!string.IsNullOrWhiteSpace(adminSite?.LogoUrl))
                    {
                        <img class="admin-brand-logo" src="@adminSite.LogoUrl" alt="@AdminBrandName" />
                    }
                    else
                    {
                        <div class="admin-brand-badge">PN</div>
                    }
                    <div class="admin-brand-text">
                        <strong>@AdminBrandName</strong>
                        <span>@AdminBrandSubtitle</span>
                    </div>
                </div>

                <div class="admin-sidebar-inner">
                    <NavMenu />
                </div>

                <div class="admin-sidebar-footer">
                    <button class="sidebar-collapse-btn" id="sidebarCollapseBtn"
                            title="Thu gọn menu" aria-label="Thu gọn menu">
                        <span class="nav-icon">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                 stroke-linejoin="round">
                                <path d="M11 19l-7-7 7-7M18 19l-7-7 7-7"/>
                            </svg>
                        </span>
                        <span class="nav-label">Thu gọn</span>
                    </button>
                </div>
            </aside>

            <div class="admin-content-wrap">
                <header class="admin-topbar">
                   
                    <button class="admin-sidebar-toggle" id="mobileToggle"
                            type="button" aria-label="Mở menu">
                        <span></span>
                        <span></span>
                        <span></span>
                    </button>

                    <div class="admin-topbar-search">
                        <input type="search" placeholder="Tìm module, bài viết, văn bản..." />
                    </div>

                    <div class="admin-topbar-actions">
                        <a class="admin-pill-link outline" href="/" target="_blank">
                            ↗ Xem site
                        </a>
                        <a class="admin-pill-link" href="/logout">Đăng xuất</a>
                    </div>
                </header>

                <main class="admin-main">
                    @Body
                </main>
            </div>
        </div>

    </Authorized>
    <NotAuthorized>
        <div class="admin-login-guard">
            <div class="admin-login-card">
                <h4>Bạn cần đăng nhập để vào khu vực quản trị</h4>
                <p>Vui lòng xác thực để tiếp tục sử dụng hệ thống admin.</p>
                <a href="/login-admin" class="btn btn-primary">Đăng nhập</a>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private PublicFooterInfo? adminSite;

    private string AdminBrandName => string.IsNullOrWhiteSpace(adminSite?.SchoolName) ? "Cổng thông tin" : adminSite!.SchoolName!;
    private string AdminBrandSubtitle => string.IsNullOrWhiteSpace(adminSite?.SiteSlogan) ? "Admin Console" : adminSite!.SiteSlogan!;

    protected override async Task OnInitializedAsync()
    {
        adminSite = await PublicNavigationService.GetFooterAsync(PN_PublicVariables.MaTruong);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("adminSidebar.init");
        }
    }
}
